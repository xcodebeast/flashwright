+/// Original HTTP/1 response fields, retaining wire order and name casing.
+///
+/// Present only with `original-response-metadata` and `preserve_header_case(true)`.
+/// Values use the existing parser's whitespace/folding normalization. This is not
+/// a raw wire transcript. Trailers are excluded. The owned copy contains only the
+/// parsed status line and header block, never the receive buffer's body read-ahead.
+#[cfg(all(
+    feature = "original-response-metadata",
+    feature = "client",
+    feature = "http1"
+))]
+#[derive(Clone, Debug)]
+pub struct OriginalResponseHeaders {
+    block: Bytes,
+    fields: Vec<(std::ops::Range<usize>, std::ops::Range<usize>)>,
+}
+
+#[cfg(all(
+    feature = "original-response-metadata",
+    feature = "client",
+    feature = "http1"
+))]
+impl OriginalResponseHeaders {
+    /// Maximum copied status line and header block length.
+    pub const MAX_BLOCK_BYTES: usize = 256 * 1024;
+    /// Maximum retained initial response field count.
+    pub const MAX_FIELDS: usize = 1024;
+
+    pub(crate) fn new(block: &[u8], count: usize) -> Self {
+        Self {
+            block: Bytes::copy_from_slice(block),
+            fields: Vec::with_capacity(count),
+        }
+    }
+
+    pub(crate) fn append(&mut self, name: std::ops::Range<usize>, value: std::ops::Range<usize>) {
+        self.fields.push((name, value));
+    }
+
+    /// Iterates over original name bytes and parser-normalized value bytes.
+    pub fn iter(&self) -> impl ExactSizeIterator<Item = (&[u8], &[u8])> + '_ {
+        self.fields
+            .iter()
+            .map(|(name, value)| (&self.block[name.clone()], &self.block[value.clone()]))
+    }
+
+    /// Byte length of the compact owned status line and header block.
+    pub fn block_len(&self) -> usize {
+        self.block.len()
+    }
+
+    /// Original validated reason bytes, including Latin-1 text that httparse's
+    /// string view intentionally replaces with an empty string.
+    pub fn reason_phrase(&self) -> &[u8] {
+        let line = self
+            .block
+            .split(|byte| *byte == b'\n')
+            .find(|line| !line.is_empty() && *line != b"\r")
+            .unwrap_or_default();
+        let line = line.strip_suffix(b"\r").unwrap_or(line);
+        // HTTP/1.x and its first delimiter have already been validated. Preserve
+        // every reason byte after the three status digits and one space.
+        let Some(mut status) = line.get(9..) else {
+            return b"";
+        };
+        while let Some(rest) = status.strip_prefix(b" ") {
+            status = rest;
+        }
+        status
+            .get(3..)
+            .and_then(|tail| tail.strip_prefix(b" "))
+            .unwrap_or_default()
     }
 }
 
