  "controlledClock": {
    "path": "compatibility/evidence/resident-frame-pacing-exploration-2026-10-08/timer-probe.json",
    "sha256": "3868d5dced9dff8b81e58688322a9d1294bcf2735a3b38be7cbb59e421315588",
    "source": "compatibility/evidence/resident-frame-pacing-exploration-2026-10-08/frame-pacing-timer-probe.mjs",
    "sourceSha256": "f032e722c77c3db49f55a8de1bde653ea66399db6ef30776d29a0198143a5d96",
    "scope": "Controlled Node registry clock, synthetic predicate cost, fixed 16 ms frame grid and 1 ms minimum timer delay. Scheduling diagnostic only; no real-browser latency, CPU, semantics or speed claim."
  },
  "finding": "The current planner chooses the earliest individual due time. With 0.05 ms synthetic check duration, 32/128 checks use 425/524 timer callbacks per simulated second, versus 28 with simultaneous starts. Real instrumented quiet/property waits at 32/128 conditions also show 288\u2013424 timer callbacks over about two seconds, with thousands of deferred condition invalidations.",
  "interpretation": "Nearby check-start timestamps create separate eligibility times. The current scheduler repeatedly wakes for small subsets. This reproduces a scheduling mechanism; the proportion of real CPU cost and native selector queries attributable to it is not measured.",
  "next": "Coalesce nearby due conditions within a bounded window, while keeping full predicates, immediate event invalidation, fair batch yields, independent deadlines and generation ownership. Validate with staggered controlled clocks and repeat complete conformance and ordinary comparisons before acceptance.",
  "otherLead": "The pinned selector runtime enumerates all matches before applying nth. A restricted fresh-query fast path for a simple CSS first match may reduce single-condition cost, but ordering, shadow, syntax and full-predicate parity require proof before implementation.",
  "scope": "Nine instrumented browser launches, twelve original controlled-clock models and an eighteen-case candidate model are diagnostics, excluded from all 210 ordinary launch statistics.",
  "candidateProbe": {
    "path": "compatibility/evidence/resident-frame-pacing-exploration-2026-10-08/timer-probe-coalescing.json",
    "sha256": "18369d8cfa489cba005558a492531811089b33133a3a36f8714c83222ea6ba15",
    "source": "compatibility/evidence/resident-frame-pacing-exploration-2026-10-08/frame-pacing-coalescing-probe.mjs",
    "sourceSha256": "2d238bf0334a57ac3606a6ca02d42d9a99931464ed189ddc78c99d4781952f47",
    "candidateSource": "compatibility/evidence/resident-frame-pacing-exploration-2026-10-08/coalescing-candidate.js.txt",
    "candidateSourceSha256": "a3af3f33a007569f2d7aab1df311e4bab2c7c0c10b53d091ba562973e976d299",
    "cases": 18,
    "result": "Adding the existing four-millisecond batch budget as a due-time coalescing window reduces the staggered 32/128-condition model from 425/524 timer callbacks to 25/49. It also changes nominal late fallback spacing from at least 32 to at least 36 ms.",
    "scope": "Source-string candidate in the controlled Node model only. Not installed in the production runtime or binary; no browser conformance, CPU or speed acceptance."
  }
