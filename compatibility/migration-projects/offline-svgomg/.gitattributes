# Preserve every retained upstream byte regardless of consumer line-ending settings.
assets/** -text
licenses/** -text
tests/** -text
provenance/** -text

# These exact upstream notices retain CRLF and one trailing space respectively.
licenses/playwright.txt whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
licenses/inconsolata.txt whitespace=-blank-at-eol

# Authored fixture metadata has stable LF bytes.
.gitattributes text eol=lf
README.md text eol=lf
NOTICE.md text eol=lf
provenance.json text eol=lf
