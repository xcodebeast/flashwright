{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "paths": {
      /*
        The following two serve different purposes:
         - @foo/* is for importing types only,
         - .../lib/* means require dependency
      */
      "@dashboard/*": ["./packages/dashboard/src/*"],
      "@trace-viewer/*": ["./packages/trace-viewer/src/*"],
      "@html-reporter/*": ["./packages/html-reporter/src/*"],
      "@injected/*": ["./packages/injected/src/*"],
      "@isomorphic/*": ["./packages/isomorphic/*"],
      "@utils/*": ["./packages/utils/*"],
      "@protocol/*": ["./packages/protocol/src/*"],
      "@recorder/*": ["./packages/recorder/src/*"],
      "@testIsomorphic/*": ["./packages/playwright/src/isomorphic/*"],
      "@web/*": ["./packages/web/src/*"],
      // Flashwright: the hard forks in vendor/, mirroring "typeAliases" in utils/vendor/recipes.mjs.
      "zod": ["./vendor/zod/index.d.ts"],
      "zod/v4": ["./vendor/zod/index.d.ts"],
      "zod/v4/core": ["./vendor/zod/v4/core/index.d.ts"],
      "@modelcontextprotocol/sdk/*": ["./vendor/mcp-sdk/dist/esm/*"],
      "@zip.js/zip.js": ["./vendor/zip.js/index.d.ts"],
      "@zip.js/zip.js/lib/zip-core.js": ["./vendor/zip.js/index.d.ts"],
      "enquirer": ["./vendor/enquirer/index.d.ts"],
      "open": ["./vendor/open/index.d.ts"],
      "jest-message-util": ["./vendor/jest-message-util/build/index.d.ts"],
      "playwright-core/lib/*": ["./packages/playwright-core/src/*"],
      "playwright/lib/*": ["./packages/playwright/src/*"],
      "@playwright/*": ["./packages/playwright/src/*"],
    },
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "allowJs": false,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": false,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
  },
  "compileOnSave": true,
  "files": ["packages/html-reporter/tests/stories.d.ts"],
  "include": ["packages"],
  "exclude": [
    "packages/*/lib",
    "packages/extension",
    "packages/playwright-core/src/tools/skills",
  ]
}
