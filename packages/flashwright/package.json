{
  "name": "flashwright",
  "version": "0.0.0",
  "description": "Development preview of the Flashwright Rust browser engine",
  "type": "module",
  "main": "./dist/commonjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./package.json": "./package.json",
    "./test": {
      "import": {
        "types": "./dist/esm/test.d.ts",
        "default": "./dist/esm/test.js"
      },
      "require": {
        "types": "./dist/commonjs/test.d.ts",
        "default": "./dist/commonjs/test.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "22.x || 24.x"
  },
  "private": true,
  "dependencies": {
    "@flashwright/core": "0.0.0"
  },
  "peerDependencies": {
    "@flashwright/test": "0.0.0"
  },
  "peerDependenciesMeta": {
    "@flashwright/test": {
      "optional": true
    }
  }
}
