{
  "name": "@flashwright/test",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental Flashwright fixtures and assertions for the pinned Playwright Test runner",
  "type": "module",
  "main": "./dist/commonjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./reporter": {
      "import": {
        "types": "./dist/esm/reporter.d.ts",
        "default": "./dist/esm/reporter.js"
      },
      "require": {
        "types": "./dist/commonjs/reporter.d.ts",
        "default": "./dist/commonjs/reporter.js"
      }
    },
    "./package.json": "./package.json",
    "./independent": {
      "import": {
        "types": "./dist/esm/independent.d.ts",
        "default": "./dist/esm/independent.js"
      },
      "require": {
        "types": "./dist/commonjs/independent.d.ts",
        "default": "./dist/commonjs/independent.js"
      }
    }
  },
  "bin": {
    "flashwright": "./cli.cjs"
  },
  "files": [
    "dist",
    "cli.cjs"
  ],
  "engines": {
    "node": "22.x || 24.x"
  },
  "dependencies": {
    "@flashwright/runner": "0.0.0"
  }
}
