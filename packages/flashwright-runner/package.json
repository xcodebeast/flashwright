{
  "name": "@flashwright/runner",
  "version": "0.0.0",
  "private": true,
  "description": "Canonical runner adapter implementation for Flashwright public facades",
  "type": "module",
  "main": "./dist/commonjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./reporter": {
      "import": {
        "types": "./dist/esm/reporter.d.ts",
        "default": "./dist/esm/reporter.js"
      },
      "require": {
        "types": "./dist/commonjs/reporter.d.ts",
        "default": "./dist/commonjs/reporter.js"
      }
    },
    "./package.json": "./package.json",
    "./cli": "./cli.cjs"
  },
  "files": [
    "dist",
    "cli.cjs"
  ],
  "engines": {
    "node": "22.x || 24.x"
  },
  "dependencies": {
    "@flashwright/core": "0.0.0",
    "flashwright-upstream-runner": "npm:playwright@1.60.0",
    "playwright-core": "1.60.0"
  }
}
