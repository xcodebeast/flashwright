{
  "schemaVersion": 1,
  "date": "2026-10-21",
  "platform": "linux-x64",
  "status": "rejected-shared-browser-engineering-screen",
  "scope": "One suite-owned custom browser with one CDP WebSocket connection per independent driver, compared with direct-pipe browsers per worker. Same original application tests, fresh contexts, renderer reuse, fast frame scheduling and software video policy. No product adoption.",
  "design": {
    "ownership": "Workers retain independent Rust drivers and logical browser leases. Browser.close closes only that lease; the suite owner closes and awaits the actual browser after workers exit. CDP contexts retain disposeOnDetach.",
    "transport": "Private Bun pipe-to-WebSocket shim. The shared native browser uses loopback remote-debugging-port=0 instead of remote-debugging-pipe. Each driver gets a separate CDP session connection.",
    "clock": "Original watchdog owner launch through complete owner exit, including server, shared browser startup, workers, fixtures and all native browser shutdown. The matched screen overlaps browser startup with ordinary suite discovery.",
    "policyEvidence": "Shared-native executable/arguments come from shared-browser-launch.json. Per-worker wrapper logs record the requested pipe command before substitution and do not identify another native browser.",
    "limits": {
      "cpuCores": 4,
      "memoryGiB": 8,
      "swap": 0,
      "retries": 0
    }
  },
  "advancement": {
    "rule": "At least 20% lower complete time in both orders for both four-worker applications, with no more than 5% regression at one worker in either order.",
    "passed": false
  },
