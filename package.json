{
  "name": "flashwright-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": "22.x || 24.x",
    "bun": "1.4.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun tools/build-driver.mjs && bun tools/build-packages.mjs",
    "verify:core": "bun tools/verify-core.mjs",
    "test:navigation": "bun tools/run-navigation-tests.mjs",
    "test:locators": "bun tools/run-locator-tests.mjs",
    "test:native-runner": "bun tools/run-native-runner-tests.mjs",
    "test:assertions": "bun tools/run-assertion-tests.mjs",
    "test:conditions": "bun tools/run-condition-tests.mjs",
    "test:keyboard": "bun tools/run-keyboard-tests.mjs",
    "test:storage": "bun tools/run-storage-tests.mjs",
    "test:pointer": "bun tools/run-pointer-tests.mjs",
    "test:library": "bun tools/run-library-smoke.mjs",
    "test:lifecycle": "bun tools/run-lifecycle-tests.mjs",
    "test:packed": "bun tools/test-packed-package.mjs",
    "inventory": "bun tools/generate-inventory.mjs",
    "inventory:check": "bun tools/generate-inventory.mjs --check",
    "test:inventory": "bun test ./tools/test-parity-catalog.mjs",
    "test:competitors": "bun test ./tools/test-competitor-contract.mjs ./tools/test-cypress-contract.mjs ./tools/test-bun-webview-adapter.mjs ./tools/test-bun-webview-sampling.mjs",
    "baseline": "python3 tools/watchdog.py --timeout 600 --report-directory benchmarks/results/resources -- bun benchmarks/run.mjs",
    "test:runner-boundary": "bun tools/run-runner-boundary.mjs",
    "test:harness": "bun test ./tools/test-harness.mjs ./tools/test-protocol-profile.mjs ./tools/test-attachments.mjs ./tools/test-input-attachments.mjs",
    "typecheck": "bun tools/typecheck.mjs",
    "test:packed-runner": "bun tools/test-packed-runner.mjs",
    "test:migration": "bun tools/test-packed-migration.mjs",
    "benchmark:paired": "bun benchmarks/paired.mjs",
    "test:benchmark-contract": "bun tools/test-benchmark-contract.mjs",
    "benchmark:attribution": "bun benchmarks/attribution.mjs",
    "benchmark:residency": "bun benchmarks/residency.mjs",
    "benchmark:resident-load": "bun benchmarks/resident-load.mjs",
    "test:resident-load": "bun tools/test-resident-load.mjs",
    "test:screenshots": "bun tools/run-screenshot-tests.mjs",
    "test:diagnostics": "bun tools/run-diagnostic-tests.mjs",
    "test:handles": "bun tools/run-handle-tests.mjs",
    "test:console": "bun tools/run-console-tests.mjs",
    "test:platform-runtime": "bun tools/test-platform-runtime.mjs",
    "test:package-managers": "bun tools/test-package-managers.mjs",
    "build:release": "bun tools/build-driver.mjs --release && bun tools/build-packages.mjs",
    "test:devices": "bun tools/run-device-tests.mjs",
    "test:device-runner": "python3 tools/watchdog.py --timeout 180 --report-directory compatibility/evidence/resources -- bun tools/run-device-runner-tests.mjs",
    "test:fixture-core": "bun test ./tools/test-independent-fixtures.mjs && bun tools/run-independent-fixture-differential.mjs"
  },
  "devDependencies": {
    "@flashwright/test": "0.0.0",
    "@playwright/test": "1.60.0",
    "@types/node": "24.10.1",
    "flashwright": "0.0.0",
    "flashwright-upstream-runner": "npm:playwright@1.60.0",
    "playwright": "1.60.0",
    "playwright-core": "1.60.0",
    "typescript": "5.9.3"
  }
}
