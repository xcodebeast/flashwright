+bool V8InspectorImpl::lookupFlashwrightLocatorSource(
+    const String16& key, String16* source) {
+  if (key != m_flashwrightLocatorKey) return false;
+  *source = m_flashwrightLocatorSource;
+  return true;
+}
+
+bool V8InspectorImpl::cacheFlashwrightLocatorSource(
+    const String16& key, const String16& source) {
+  // The trusted CDP caller supplies a content identity. Reject inconsistent
+  // re-registration rather than silently aliasing different source bytes.
+  if (key == m_flashwrightLocatorKey && source != m_flashwrightLocatorSource)
+    return false;
+  m_flashwrightLocatorSource = source;
+  m_flashwrightLocatorKey = key;
+  return true;
+}
