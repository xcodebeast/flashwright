+// Copyright 2026 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "include/v8-context-retirement.h"
+
+#include "include/v8-isolate.h"
+#include "src/base/logging.h"
+#include "src/execution/isolate.h"
+#include "src/heap/heap.h"
+#include "src/tracing/trace-event.h"
+
+namespace v8 {
+namespace i = internal;
+
+void CollectGarbageAfterContextRetirement(Isolate* isolate,
+                                          int collection_count) {
+  CHECK_GE(collection_count, 1);
+  CHECK_LE(collection_count, 2);
+  CHECK_NOT_NULL(isolate);
+  Isolate::Scope isolate_scope(isolate);
+  auto* internal_isolate = reinterpret_cast<i::Isolate*>(isolate);
+  TRACE_EVENT0("v8", "V8.CollectGarbageAfterContextRetirement");
+  // A later pass can collect objects released by the first pass's weak
+  // callbacks. Memory reduction releases unused allocator pages; omitting the
+  // forced callback flag keeps normal bytecode aging enabled.
+  for (int collection = 0; collection < collection_count; ++collection) {
+    // Honor actual pressure before an ordinary collection resets its state.
+    internal_isolate->heap()->CheckMemoryPressure();
+    internal_isolate->heap()->PreciseCollectAllGarbage(
+        i::GCFlag::kReduceMemoryFootprint,
+        i::GarbageCollectionReason::kContextDisposal,
+        kNoGCCallbackFlags);
+  }
+}
+
