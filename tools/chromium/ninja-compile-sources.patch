-int NinjaMain::RunBuild(int argc, char** argv, Status* status) {
+int NinjaMain::RunBuild(int argc, char** argv, Status* status,
+                       bool compile_sources) {
+  if (compile_sources && argc == 0) {
+    status->Error("--compile-sources requires at least one source");
+    return 1;
+  }
   string err;
   vector<Node*> targets;
   if (!CollectTargetsFromArgs(argc, argv, &targets, &err)) {
     status->Error("%s", err.c_str());
     return 1;
+  }
+
+  if (compile_sources) {
+    set<string> objects;
+    set<Node*> sources(targets.begin(), targets.end());
+    for (set<Node*>::const_iterator source = sources.begin();
+         source != sources.end(); ++source) {
+      bool found = false;
+      const vector<Edge*>& edges = (*source)->out_edges();
+      for (size_t edge_index = 0; edge_index < edges.size(); ++edge_index) {
+        const vector<Node*>& outputs = edges[edge_index]->outputs_;
+        for (size_t output_index = 0; output_index < outputs.size();
+             ++output_index) {
+          const string& path = outputs[output_index]->path();
+          const size_t extension = path.find_last_of('.');
+          if (extension != string::npos &&
+              (path.compare(extension, string::npos, ".o") == 0 ||
+               path.compare(extension, string::npos, ".obj") == 0)) {
+            objects.insert(path);
+            found = true;
+          }
+        }
+      }
+      if (!found) {
+        status->Error("No compiled objects in the selected graph for %s",
+                      (*source)->path().c_str());
+        return 1;
+      }
+    }
+    targets.clear();
+    for (set<string>::const_iterator object = objects.begin();
+         object != objects.end(); ++object)
+      targets.push_back(state_.LookupNode(*object));
+    printf("Compiling %zu objects from %zu sources with %d jobs.\n",
+           targets.size(), sources.size(), config_.parallelism);
   }

   disk_interface_.AllowStatCache(g_experimental_statcache);
