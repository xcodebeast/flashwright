+// Preserve the timestamp when relinking the generator leaves its output
+// unchanged, so Ninja can avoid rebuilding every consumer of this header.
+bool WriteHeaderIfChanged(const char* header_filename) {
+  std::ostringstream generated_header;
+  GenerateHeader(generated_header);
+  const std::string contents = generated_header.str();
+  {
+    std::ifstream existing_header(header_filename);
+    if (existing_header) {
+      const std::string existing_contents(
+          (std::istreambuf_iterator<char>(existing_header)),
+          std::istreambuf_iterator<char>());
+      if (!existing_header.bad() && existing_contents == contents) {
+        return true;
+      }
+    }
+  }
+  std::ofstream output(header_filename);
+  output << contents;
+  output.close();
+  return output.good();
+}
