+TEST_P(SchedulerTest, FlashwrightDemandDrivenLateCommitResubscribes) {
+  scheduler_settings_.disable_frame_rate_limit = true;
+  SetUpScheduler(EXTERNAL_BFS);
+  base::test::ScopedFeatureList probe;
+  probe.InitFromCommandLine(
+      "FlashwrightDemandDrivenUncappedFrames,FlashwrightEarlyIdleFrameDeadline",
+      "");
+
+  scheduler_->SetNeedsBeginMainFrame();
+  EXPECT_TRUE(client_->HasAction("AddObserver(this)"));
+  client_->Reset();
+  AdvanceFrame();
+  EXPECT_TRUE(client_->HasAction("ScheduledActionSendBeginMainFrame"));
+  client_->Reset();
+  task_runner_->RunPendingTasks();
+  EXPECT_FALSE(client_->IsInsideBeginImplFrame());
+  EXPECT_FALSE(scheduler_->begin_frames_expected());
+  EXPECT_TRUE(client_->HasAction("RemoveObserver(this)"));
+  client_->Reset();
+
+  // The asynchronous commit must restore the subscription itself. Injecting
+  // another frame without checking the observer could hide a lost wakeup.
+  scheduler_->NotifyBeginMainFrameStarted(task_runner_->NowTicks());
+  scheduler_->NotifyReadyToCommit(nullptr);
+  EXPECT_TRUE(client_->HasAction("ScheduledActionCommit"));
+  EXPECT_TRUE(client_->HasAction("ScheduledActionPostCommit"));
+  EXPECT_TRUE(client_->HasAction("AddObserver(this)"));
+  EXPECT_TRUE(scheduler_->begin_frames_expected());
+  client_->Reset();
+  scheduler_->NotifyReadyToActivate();
+  EXPECT_TRUE(client_->HasAction("ScheduledActionActivateSyncTree"));
+  EXPECT_TRUE(scheduler_->begin_frames_expected());
+  client_->Reset();
+  AdvanceFrame();
+  task_runner_->RunPendingTasks();
+  EXPECT_TRUE(client_->HasAction("ScheduledActionDrawIfPossible"));
+  EXPECT_FALSE(scheduler_->begin_frames_expected());
+  EXPECT_TRUE(client_->HasAction("RemoveObserver(this)"));
+}
