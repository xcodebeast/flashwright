+  // Draw successfully.
+  client->SetDrawWillHappen(true);
+  EXPECT_SCOPED(AdvanceFrame());
+  task_runner_->RunPendingTasks();  // Run posted deadline.
+  EXPECT_EQ(3, client->num_draws());
+  EXPECT_TRUE(scheduler_->CommitPending());
+  EXPECT_FALSE(scheduler_->RedrawPending());
+  // Repeated failed draws leave another real main-frame request pending.
+  // Preserve that subscription even after the eventual successful draw.
+  EXPECT_TRUE(client->HasAction("ScheduledActionSendBeginMainFrame"));
