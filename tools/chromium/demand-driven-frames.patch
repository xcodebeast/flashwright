+TEST(SchedulerStateMachineTest, FlashwrightDemandDrivenPreservesRequiredWork) {
+  base::test::ScopedFeatureList probe;
+  probe.InitFromCommandLine("FlashwrightDemandDrivenUncappedFrames", "");
+  SchedulerSettings settings;
+  settings.disable_frame_rate_limit = true;
+  for (int demand = 0; demand < 8; ++demand) {
+    SCOPED_TRACE(demand);
+    StateMachine state(settings);
+    SET_UP_STATE(state);
+    state.SetBeginMainFrameState(SchedulerStateMachine::BeginMainFrameState::SENT);
+    EXPECT_FALSE(state.ShouldSubscribeToBeginFrames());
+    switch (demand) {
+      case 0: state.SetNeedsRedraw(true); break;
+      case 1: state.SetNeedsOneBeginImplFrame(true); break;
+      case 2: state.SetVideoNeedsBeginFrames(true); break;
+      case 3: state.SetHasPendingTree(true); break;
+      case 4: state.SetNeedsPrepareTiles(); break;
+      case 5: state.SetTreePrioritiesAndScrollState(SMOOTHNESS_TAKES_PRIORITY, true); break;
+      case 6: state.SetNeedsImplSideInvalidation(true); break;
+      case 7: state.SetNeedsBeginMainFrameForTest(true); break;
+    }
+    EXPECT_TRUE(state.ShouldSubscribeToBeginFrames());
+  }
+}
