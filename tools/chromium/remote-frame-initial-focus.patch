diff --git i/third_party/blink/renderer/core/page/focus_controller.cc w/third_party/blink/renderer/core/page/focus_controller.cc
index 1415662bd0..96c79a3d89 100644
--- i/third_party/blink/renderer/core/page/focus_controller.cc
+++ w/third_party/blink/renderer/core/page/focus_controller.cc
@@ -1836,8 +1836,14 @@ void FocusController::FocusHasChanged() {
 
   // Do not set a focused frame when being unfocused. This might reset
   // is_focused_ to true.
-  if (!focused_frame_ && focused)
-    SetFocusedFrame(page_->MainFrame());
+  if (!focused_frame_ && focused) {
+    // A remote main frame receives page focus replicated by the browser. Its
+    // initial default is not a new frame-focus request: echoing it can overwrite
+    // a newer focus change from another renderer while this renderer starts.
+    Frame* main_frame = page_->MainFrame();
+    SetFocusedFrame(main_frame,
+                    main_frame && main_frame->IsLocalFrame() /* notify_embedder */);
+  }
 
   // SetFocusedFrame above might reject to update focused_frame_, or
   // focused_frame_ might be changed by blur/focus event handlers.
