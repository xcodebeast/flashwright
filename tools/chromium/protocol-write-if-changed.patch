@@ -608,6 +608,26 @@
     return domain in self.generate_domains or domain in self.imported_domains
 
 
+def write_if_changed(file_name, content):
+  # Keep Ninja restat effective without suppressing case-only output renames.
+  exact_name_exists = os.path.basename(file_name) in os.listdir(
+      os.path.dirname(file_name) or ".")
+  if exact_name_exists:
+    try:
+      with open(file_name, "r", newline="") as existing:
+        if existing.read() == content.replace("\n", os.linesep):
+          return
+    except (OSError, UnicodeError):
+      pass
+  # Remove output file first to account for potential case changes.
+  try:
+    os.remove(file_name)
+  except OSError:
+    pass
+  with open(file_name, "w") as output:
+    output.write(content)
+
+
