diff --git 1/test/unittests/flashwright/sandbox-check-removal-unittest.cc 2/test/unittests/flashwright/sandbox-check-removal-unittest.cc
new file mode 100644
index 00000000..a02711d6
--- /dev/null
+++ 2/test/unittests/flashwright/sandbox-check-removal-unittest.cc
@@ -0,0 +1,228 @@
+// Copyright 2026 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "src/base/logging.h"
+#include "src/codegen/tnode.h"
+#include "src/sandbox/check.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+#ifndef V8_FLASHWRIGHT_REMOVE_SANDBOX_CHECKS
+#error "These controls require the explicitly selected check experiment."
+#endif
+#if defined(V8_ENABLE_SANDBOX) || defined(DEBUG)
+#error "These controls require the no-sandbox release operand path."
+#endif
+
+namespace v8::internal {
+namespace {
+
+struct BooleanProbe {
+  bool value;
+  int* conversions;
+  explicit operator bool() const {
+    ++*conversions;
+    return value;
+  }
+};
+
+struct NegationProbe {
+  int* negations;
+  bool operator!() const {
+    ++*negations;
+    return true;
+  }
+};
+
+class ComparisonProbe {
+ public:
+  ComparisonProbe(int value, int* comparisons)
+      : value_(value), comparisons_(comparisons) {}
+  ComparisonProbe(const ComparisonProbe&) = delete;
+
+#define DEFINE_COMPARISON(op)                            \
+  bool operator op(const ComparisonProbe& other) const { \
+    ++*comparisons_;                                     \
+    return value_ op other.value_;                       \
+  }
+  DEFINE_COMPARISON(==)
+  DEFINE_COMPARISON(!=)
+  DEFINE_COMPARISON(>)
+  DEFINE_COMPARISON(>=)
+  DEFINE_COMPARISON(<)
+  DEFINE_COMPARISON(<=)
+#undef DEFINE_COMPARISON
+
+ private:
+  int value_;
+  int* comparisons_;
+};
+
+class TemporaryConversionProbe {
+ public:
+  TemporaryConversionProbe(int value, int* conversions, int* destructions)
+      : value_(value),
+        conversions_(conversions),
+        destructions_(destructions) {}
+  TemporaryConversionProbe(const TemporaryConversionProbe&) = delete;
+  ~TemporaryConversionProbe() { ++*destructions_; }
+  operator int() const {
+    ++*conversions_;
+    return value_;
+  }
+
+ private:
+  int value_;
+  int* conversions_;
+  int* destructions_;
+};
+
+constexpr bool FalseChecksRemainConstantEvaluable() {
+  SBXCHECK(false);
+  SBXCHECK_EQ(1, 2);
+  SBXCHECK_BOUNDS(-1, 1);
+  SBXCHECK_IMPLIES(true, false);
+  return true;
+}
+static_assert(FalseChecksRemainConstantEvaluable());
+
+}  // namespace
+
+TEST(FlashwrightSandboxCheckRemovalTest, BooleanConversionAndNegation) {
+  int conversions = 0;
+  SBXCHECK((BooleanProbe{false, &conversions}));
+  EXPECT_EQ(conversions, 1);
+
+  int negations = 0;
+  // This type deliberately has operator! but no conversion to bool.
+  SBXCHECK((NegationProbe{&negations}));
+  EXPECT_EQ(negations, 1);
+}
+
+TEST(FlashwrightSandboxCheckRemovalTest,
+     AllComparisonOverloadsAndOperandsAreEvaluatedOnce) {
+  int lhs_calls = 0;
+  int rhs_calls = 0;
+  int comparisons = 0;
+  ComparisonProbe left(1, &comparisons);
+  ComparisonProbe right(2, &comparisons);
+  auto lhs = [&]() -> const ComparisonProbe& {
+    ++lhs_calls;
+    return left;
+  };
+  auto rhs = [&]() -> const ComparisonProbe& {
+    ++rhs_calls;
+    return right;
+  };
+  SBXCHECK_EQ(lhs(), rhs());
+  SBXCHECK_NE(lhs(), rhs());
+  SBXCHECK_GT(lhs(), rhs());
+  SBXCHECK_GE(lhs(), rhs());
+  SBXCHECK_LT(lhs(), rhs());
+  SBXCHECK_LE(lhs(), rhs());
+  EXPECT_EQ(lhs_calls, 6);
+  EXPECT_EQ(rhs_calls, 6);
+  EXPECT_EQ(comparisons, 6);
+}
+
+TEST(FlashwrightSandboxCheckRemovalTest,
+     ComparisonConversionsAndTemporaryLifetimes) {
+  int operand_calls = 0;
+  int conversions = 0;
+  int destructions = 0;
+  auto operand = [&](int value) {
+    ++operand_calls;
+    return TemporaryConversionProbe(value, &conversions, &destructions);
+  };
+  SBXCHECK_EQ(operand(1), operand(2));
+  EXPECT_EQ(operand_calls, 2);
+  EXPECT_EQ(conversions, 2);
+  EXPECT_EQ(destructions, 2);
+}
+
+TEST(FlashwrightSandboxCheckRemovalTest, BoundsOperandsAreEvaluatedOnce) {
+  int index_calls = 0;
+  int limit_calls = 0;
+  auto index = [&]() {
+    ++index_calls;
+    return -1;
+  };
+  auto limit = [&]() {
+    ++limit_calls;
+    return 1;
+  };
+  // Original CHECK_BOUNDS rejects -1 via unsigned conversion. The selected
+  // experiment evaluates the same converted comparison without terminating.
+  SBXCHECK_BOUNDS(index(), limit());
+  EXPECT_EQ(index_calls, 1);
+  EXPECT_EQ(limit_calls, 1);
+}
+
+TEST(FlashwrightSandboxCheckRemovalTest,
+     ImpliesPreservesBooleanConversionAndShortCircuit) {
+  int lhs_conversions = 0;
+  int rhs_calls = 0;
+  int rhs_conversions = 0;
+  auto rhs = [&]() {
+    ++rhs_calls;
+    return BooleanProbe{false, &rhs_conversions};
+  };
+  SBXCHECK_IMPLIES((BooleanProbe{false, &lhs_conversions}), rhs());
+  EXPECT_EQ(lhs_conversions, 1);
+  EXPECT_EQ(rhs_calls, 0);
+  EXPECT_EQ(rhs_conversions, 0);
+
+  SBXCHECK_IMPLIES((BooleanProbe{true, &lhs_conversions}), rhs());
+  EXPECT_EQ(lhs_conversions, 2);
+  EXPECT_EQ(rhs_calls, 1);
+  EXPECT_EQ(rhs_conversions, 1);
+}
+
+// Exercise the macro's C++ receiver/argument semantics independently of a
+// graph fixture. Actual graph node preservation is a separate execution gate.
+#include "src/codegen/define-code-stub-assembler-macros.inc"
+TEST(FlashwrightSandboxCheckRemovalTest,
+     CsaReceiverPredicateAndImplicitConversionRemain) {
+  int step = 0;
+  int receiver_step = 0;
+  int predicate_step = 0;
+  int conversion_step = 0;
+  int consume_step = 0;
+  struct ConditionProxy {
+    int* step;
+    int* conversion_step;
+    operator TNode<BoolT>() const {
+      *conversion_step = ++*step;
+      return {};
+    }
+  };
+  struct Receiver {
+    int* step;
+    int* consume_step;
+    void FlashwrightEvaluateSandboxCheck(TNode<BoolT> condition) {
+      USE(condition);
+      *consume_step = ++*step;
+    }
+  } recorder{&step, &consume_step};
+  auto receiver = [&]() {
+    receiver_step = ++step;
+    return &recorder;
+  };
+  auto predicate = [&]() {
+    predicate_step = ++step;
+    return ConditionProxy{&step, &conversion_step};
+  };
+  CSA_SBXCHECK(receiver(), predicate());
+  EXPECT_EQ(receiver_step, 1);
+  EXPECT_EQ(predicate_step, 2);
+  EXPECT_EQ(conversion_step, 3);
+  EXPECT_EQ(consume_step, 4);
+  EXPECT_EQ(step, 4);
+}
+#include "src/codegen/undef-code-stub-assembler-macros.inc"
+
+TEST(FlashwrightSandboxCheckRemovalTest, OrdinaryCheckStillTerminates) {
+  EXPECT_DEATH_IF_SUPPORTED({ CHECK(false); }, "");
+}
+
+}  // namespace v8::internal
