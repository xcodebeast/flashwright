+    v8::internal::OptimizingCompileTaskExecutor*);
+extern "C" void __wrap__ZN2v88internal29OptimizingCompileTaskExecutor13EnsureStartedEv(
+    v8::internal::OptimizingCompileTaskExecutor* executor) {
+  if (!FlashwrightDeferCompilerForDonor()) __real__ZN2v88internal29OptimizingCompileTaskExecutor13EnsureStartedEv(executor);
+}
