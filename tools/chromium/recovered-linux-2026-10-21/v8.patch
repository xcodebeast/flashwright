+  const Address field = reinterpret_cast<Address>(&storage);
+  const size_t value = std::numeric_limits<size_t>::max() >> 1;
+  WriteBoundedSizeField(field, value);
+  EXPECT_EQ(storage, value);
+  EXPECT_EQ(ReadBoundedSizeField(field), value);
