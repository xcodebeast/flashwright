+// Copyright 2023 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "src/base/platform/platform.h"
+
+namespace v8 {
+namespace base {
+
+namespace {
+
+// A pointer to current thread's stack beginning.
+thread_local void* thread_stack_start = nullptr;
+thread_local int thread_id = 0;
+
+}  // namespace
+
+// static
+Stack::StackSlot Stack::GetStackStartUnchecked() {
+  if (!thread_stack_start) {
+    thread_stack_start = ObtainCurrentThreadStackStart();
+  }
+  return thread_stack_start;
+}
+
+// static
+Stack::StackSlot Stack::GetStackStart() { return GetStackStartUnchecked(); }
+
+// static
+int OS::GetCurrentThreadId() {
+  if (!thread_id) thread_id = GetCurrentThreadIdInternal();
+  return thread_id;
+}
+
+// Private Linux fork feasibility hook. No scheduler/heap repair is implied.
+V8_BASE_EXPORT void FlashwrightInvalidateThreadIdAfterFork() {
+  thread_id = 0;
+  thread_stack_start = nullptr;
+}
+
+}  // namespace base
+}  // namespace v8
diff --git 1/flashwright_fork_probe/repair.cc 2/flashwright_fork_probe/repair.cc
new file mode 100644
index 00000000..62e3a89c
--- /dev/null
+++ 2/flashwright_fork_probe/repair.cc
@@ -0,0 +1,84 @@
+// Private component repair; not a general V8/Blink post-fork API.
+#include "include/v8-isolate.h"
+#include "src/init/isolate-group.h"
+#include "src/compiler-dispatcher/optimizing-compile-dispatcher.h"
+#include "src/base/utils/random-number-generator.h"
+#include "src/execution/isolate.h"
+#include "src/flags/flags.h"
+#include "src/heap/cppgc-js/cpp-heap.h"
+#include "src/heap/incremental-marking.h"
+#include "src/heap/heap.h"
+#include "src/heap/gc-tracer-inl.h"
+
+namespace v8::base {
+void FlashwrightInvalidateThreadIdAfterFork();
+}
+
+int ForkV8ThreadId() { return v8::base::OS::GetCurrentThreadId(); }
+
+void InvalidateForkThreadCache() {
+  v8::base::FlashwrightInvalidateThreadIdAfterFork();
+}
+
+void CheckForkHeapQuiescence(v8::Isolate* isolate) {
+  auto* internal = reinterpret_cast<v8::internal::Isolate*>(isolate);
+  auto* heap = internal->heap();
+  auto* cpp_heap = v8::internal::CppHeap::From(isolate->GetCppHeap());
+  CHECK(!heap->IsInGC());
+  CHECK(!heap->incremental_marking()->IsMarking());
+  CHECK(!heap->sweeping_in_progress());
+  // This feasibility probe accepts only a virgin donor. Requiring no prior
+  // collection or started tracer cycle avoids outstanding GC accounting; the
+  // tracer's direct state predicates exist only in DEBUG builds.
+  CHECK_EQ(heap->gc_count().value(), v8::internal::kInitialGCEpoch.value());
+  CHECK_EQ(heap->tracer()->CurrentEpoch(), 0u);
+  CHECK(!cpp_heap->in_atomic_pause());
+  CHECK(!cpp_heap->is_incremental_marking_in_progress());
+  CHECK(!cpp_heap->sweeper().IsSweepingInProgress());
+}
+
+void RebindForkHeap(v8::Isolate* isolate) {
+  CheckForkHeapQuiescence(isolate);
+  auto* internal = reinterpret_cast<v8::internal::Isolate*>(isolate);
+  auto* cpp_heap = v8::internal::CppHeap::From(isolate->GetCppHeap());
+  // Preserve the same C++ heap and its existing references. No GC is permitted
+  // in the detached interval. StartDetaching records the fresh kernel TID.
+  cpp_heap->StartDetachingIsolate();
+  cpp_heap->DetachIsolate();
+  cpp_heap->AttachIsolate(internal);
+  internal->heap()->SetStackStart();
+  CHECK(cpp_heap->CurrentThreadIsHeapThread());
+}
+
+bool ForkHeapThreadMatches(v8::Isolate* isolate) {
+  auto* heap = isolate->GetCppHeap();
+  CHECK_NOT_NULL(heap);
+  return v8::internal::CppHeap::From(heap)->CurrentThreadIsHeapThread();
+}
+
+void RepairForkRandomness(v8::Isolate* isolate, int64_t seed, int64_t fuzz_seed) {
+  auto* internal = reinterpret_cast<v8::internal::Isolate*>(isolate);
+  // Explicit deterministic seeds continue to mean deterministic execution.
+  if (!v8::internal::v8_flags.random_seed)
+    internal->random_number_generator()->SetSeed(seed);
+  if (!v8::internal::v8_flags.fuzzer_random_seed &&
+      !v8::internal::v8_flags.random_seed)
+    internal->fuzzer_rng()->SetSeed(fuzz_seed);
+}
+
+void ForceForkProbeGC(v8::Isolate* isolate) {
+  auto* heap = reinterpret_cast<v8::internal::Isolate*>(isolate)->heap();
+  v8::internal::EmbedderStackStateScope stack(
+      heap, v8::internal::EmbedderStackStateOrigin::kExplicitInvocation,
+      cppgc::EmbedderStackState::kNoHeapPointers);
+  heap->PreciseCollectAllGarbage(v8::internal::GCFlag::kNoFlags,
+      v8::internal::GarbageCollectionReason::kTesting, v8::kGCCallbackFlagForced);
+  heap->EnsureSweepingCompleted(
+      v8::internal::Heap::SweepingForcedFinalizationMode::kUnifiedHeap,
+      v8::internal::CompleteSweepingReason::kTesting);
+}
+
+void StartForkCompilerExecutor(v8::Isolate* isolate) {
+  auto* internal = reinterpret_cast<v8::internal::Isolate*>(isolate);
+  internal->isolate_group()->optimizing_compile_task_executor()->EnsureStarted();
+}
