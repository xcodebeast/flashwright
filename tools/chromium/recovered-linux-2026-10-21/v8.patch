+  const Address field = reinterpret_cast<Address>(&storage);
+  const Address first_pointer = reinterpret_cast<Address>(&first);
+  const Address second_pointer = reinterpret_cast<Address>(&second);
+  constexpr auto tag = kNativeContextMicrotaskQueueTag;
+  constexpr ExternalPointerTagRange range(tag, tag);
+  InitExternalPointerField<tag>(kNullAddress, field, IsolateForSandbox{},
+                                first_pointer);
+  EXPECT_EQ(storage, first_pointer);
+  EXPECT_EQ(ReadExternalPointerField<range>(field, IsolateForSandbox{}),
+            first_pointer);
