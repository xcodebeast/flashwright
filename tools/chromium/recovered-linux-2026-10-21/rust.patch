@@ -0,0 +1,384 @@
+//! Private experiment: transfer physical custody into one fresh native context.
+
+use super::*;
+use flashwright_browser::chromium::RendererReservation;
+use tokio::time::{Duration, sleep, timeout};
+
+pub(crate) struct Reservations {
+    pub enabled: bool,
+}
+
+impl Default for Reservations {
+    fn default() -> Self {
+        Self {
+            enabled: std::env::var("FLASHWRIGHT_RENDERER_RESERVATION").as_deref() == Ok("1"),
+        }
+    }
+}
+
+fn failure(message: &str) -> ErrorRecord {
+    ErrorRecord::new(ErrorCode::Protocol, "renderer.reservation", message)
+}
+
+fn record(value: Value) {
+    eprintln!("flashwright-renderer-reservation {value}");
+}
+
+async fn observe(browser: &Chromium, process: i64, action: &str) -> Result<Value, ErrorRecord> {
+    let response = browser
+        .connection
+        .call(
+            "SystemInfo.getFlashwrightRendererState",
+            json!({"processId": process, "action": action}),
+            None,
+        )
+        .await?;
+    response
+        .get("state")
+        .cloned()
+        .ok_or_else(|| failure("Missing renderer state"))
+}
+
+async fn require_transition(
+    browser: &Chromium,
+    process: i64,
+    action: &str,
+    phase: i64,
+) -> Result<Value, ErrorRecord> {
+    let state = observe(browser, process, action).await?;
+    if state["accepted"] != true || state["phase"] != phase {
+        return Err(failure(&format!("Renderer rejected {action}: {state}")));
+    }
+    Ok(state)
+}
+
+impl Engine {
+    /// End preparation once public-page allocation has ordinary native ownership.
+    /// All callers share the independent owner's reply, including after cancellation.
+    pub(crate) async fn release_renderer_preparation(
+        &self,
+        browser: &Arc<Chromium>,
+        context: &Context,
+        operation: &Operation,
+    ) -> Result<(), ErrorRecord> {
+        let mut completion = {
+            let mut completion = context.state.renderer_preparation_release.lock().unwrap();
+            if let Some(receiver) = completion.as_ref() {
+                receiver.clone()
+            } else {
+                if context.state.renderer_preparation.lock().unwrap().is_none() {
+                    return Ok(());
+                }
+                let browser = browser.clone();
+                let original_context = context.clone();
+                let (sender, receiver) = watch::channel(None);
+                tokio::spawn(async move {
+                    sender.send_replace(Some(
+                        finish_renderer_preparation(browser, original_context).await,
+                    ));
+                });
+                *completion = Some(receiver.clone());
+                receiver
+            }
+        };
+        operation
+            .wait(context.state.while_alive("context.newPage", async {
+                completion
+                    .wait_for(|result| result.is_some())
+                    .await
+                    .map_err(|_| failure("Preparation release owner was lost"))?;
+                completion
+                    .borrow()
+                    .as_ref()
+                    .expect("Preparation owner completed")
+                    .clone()
+            }))
+            .await
+    }
+
+    /// This runs within the original close owner, with context allocation excluded.
+    pub(crate) async fn reserve_retiring_renderer(
+        &self,
+        browser: &Chromium,
+        context: &Context,
+    ) -> Result<Option<RendererReservation>, ErrorRecord> {
+        let mut destination = None;
+        let attempt = timeout(
+            Duration::from_secs(12),
+            self.transfer_retiring_renderer(browser, context, &mut destination),
+        )
+        .await;
+        match attempt {
+            Ok(Ok(reservation)) => Ok(reservation),
+            Ok(Err(mut error)) => {
+                record(
+                    json!({"event": "failed", "context": context.protocol_identifier, "error": error.message}),
+                );
+                if let Some(destination) = destination {
+                    error.cleanup = Some(
+                        operation::dispose(browser, ResourceKind::Context, &destination)
+                            .await
+                            .into(),
+                    );
+                }
+                Err(error)
+            }
+            Err(_) => {
+                // A timed-out allocation or transfer may have committed. Retire the
+                // whole owned browser instead of abandoning unknown physical custody.
+                record(json!({"event": "timed-out", "context": context.protocol_identifier}));
+                let mut error =
+                    failure("Renderer transfer exceeded its private preparation budget");
+                error.cleanup = Some(match browser.close().await {
+                    Ok(()) => "browserClosedAfterTransferTimeout".into(),
+                    Err(cleanup) => format!("browserCleanupFailed: {}", cleanup.message).into(),
+                });
+                Err(error)
+            }
+        }
+    }
+
+    async fn transfer_retiring_renderer(
+        &self,
+        browser: &Chromium,
+        context: &Context,
+        destination: &mut Option<String>,
+    ) -> Result<Option<RendererReservation>, ErrorRecord> {
+        // Drain initial page creation; closure already prevents further admission.
+        let Ok(_configuration) = context.state.page_configuration.try_write() else {
+            record(
+                json!({"event": "ineligible-page-configuration", "context": context.protocol_identifier}),
+            );
+            return Ok(None);
+        };
+        let eligible = self
+            .registry
+            .lock()
+            .unwrap()
+            .contexts
+            .values()
+            .filter(|candidate| candidate.browser_identifier == context.browser_identifier)
+            .count()
+            == 1;
+        if !eligible {
+            record(
+                json!({"event": "ineligible-concurrent-contexts", "context": context.protocol_identifier}),
+            );
+            return Ok(None);
+        }
+        let inventory = browser
+            .connection
+            .call("Target.getBrowserContexts", json!({}), None)
+            .await?;
