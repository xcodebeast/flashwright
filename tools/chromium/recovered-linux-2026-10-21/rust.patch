+    }).unwrap();
+    let reply=tokio::time::timeout(std::time::Duration::from_secs(3),connection.call("Test.final",json!({}),None)).await.unwrap().unwrap();
+    assert_eq!(reply,json!({"terminal":true}));
+    assert_eq!(*observed.lock().unwrap(),(0..1000).collect::<Vec<u64>>());
+    server.await.unwrap();connection.close();
+}
