+    /// Private suite-owned browser transport: no subprocess or JavaScript bridge.
+    pub async fn connect_websocket(url: &str) -> Result<Self, ErrorRecord> {
+        use futures_util::{SinkExt, StreamExt};
+        use tokio::io::{AsyncBufReadExt, BufReader};
+        use tokio_tungstenite::tungstenite::{Message, protocol::WebSocketConfig};
+        let maximum = flashwright_protocol::attachment::MAXIMUM_ATTACHMENT_BYTES * 6 + 64 * 1024;
+        let mut config = WebSocketConfig::default();
+        config.max_message_size = Some(maximum);
+        config.max_frame_size = Some(maximum);
+        let (socket, _) = tokio_tungstenite::connect_async_with_config(url, Some(config), true)
+            .await.map_err(|error| protocol_error(error.to_string()))?;
+        let (mut sink, mut stream) = socket.split();
+        let (protocol, transport) = tokio::io::duplex(64 * 1024);
+        let (reader, writer) = tokio::io::split(protocol);
+        let (outgoing, mut incoming) = tokio::io::split(transport);
+        let connection = Self::new(reader, writer);
+        let weak = Arc::downgrade(&connection.inner);
+        let read_task = tokio::spawn(async move {
+            let result: std::io::Result<()> = async {
+                while let Some(message) = stream.next().await {
+                    match message.map_err(std::io::Error::other)? {
+                        Message::Text(text) => {
+                            incoming.write_all(text.as_bytes()).await?;
+                            incoming.write_all(&[0]).await?;
+                        }
+                        Message::Close(_) => break,
+                        Message::Ping(_) | Message::Pong(_) => {}
+                        _ => return Err(std::io::Error::other("Unexpected binary CDP frame")),
+                    }
+                }
+                Ok(())
+            }.await;
+            // Queue terminal failure behind all previously received bytes. The
+            // ordinary parser owns EOF publication after draining the duplex.
+            if let (Some(state), Err(error)) = (weak.upgrade(), result) {
+                *state.read_failure.lock().unwrap() = Some(protocol_error(error.to_string()));
+            }
+            drop(incoming);
+        });
+        let weak = Arc::downgrade(&connection.inner);
+        let write_task = tokio::spawn(async move {
+            let result: std::io::Result<()> = async {
+                let mut outgoing = BufReader::new(outgoing);
+                let mut frame = Vec::new();
+                loop {
+                    frame.clear();
+                    if outgoing.read_until(0, &mut frame).await? == 0 {break;}
+                    if frame.len() > maximum || frame.pop() != Some(0) {
+                        return Err(std::io::Error::other("Invalid outbound CDP frame"));
+                    }
+                    let text = String::from_utf8(std::mem::take(&mut frame)).map_err(std::io::Error::other)?;
+                    sink.send(Message::Text(text.into())).await.map_err(std::io::Error::other)?;
+                }
