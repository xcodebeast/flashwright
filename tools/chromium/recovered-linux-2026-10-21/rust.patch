+/// Serialization preserves the original hold identity through release or browser shutdown.
+async fn finish_renderer_preparation(
+    browser: Arc<Chromium>,
+    original_context: Context,
+) -> Result<(), ErrorRecord> {
+    // All hold acquisition, transfer and context disposal uses this same lock.
+    // An inspected host cannot be replaced by another held host on this connection.
+    let admission = tokio::select! {
+        biased;
+        _ = original_context.state.closure("renderer.reservation") => return Ok(()),
+        result = timeout(Duration::from_secs(12), browser.experimental_renderer_reservation.lock()) => result,
+    };
+    let _reservation = match admission {
+        Ok(reservation) => reservation,
+        Err(_) => {
+            let mut error = failure("Preparation release lock exceeded its private cleanup budget");
+            error.cleanup = Some(match browser.close().await {
+                Ok(()) => "browserClosedAfterPreparationLockTimeout".into(),
+                Err(cleanup) => format!("browserCleanupFailed: {}", cleanup.message).into(),
+            });
+            return Err(error);
+        }
+    };
+    if original_context.state.closed.borrow().is_some() {
+        return Ok(());
+    }
+    let preparation = original_context
+        .state
+        .renderer_preparation
+        .lock()
+        .unwrap()
+        .take();
+    let Some(preparation) = preparation else {
+        return Ok(());
+    };
+    let release = async {
+        if preparation.context_identifier != original_context.protocol_identifier {
+            return Err(failure("Preparation belongs to a different context"));
+        }
+        let state = observe(&browser, preparation.process_identifier, "inspect").await?;
+        if state["hostId"] != preparation.host_identifier
+            || state["processId"] != preparation.process_identifier
+            || state["retained"] != true
+        {
+            return Err(failure("Preparation host identity or hold changed"));
+        }
+        let physical = require_transition(
+            &browser,
+            preparation.process_identifier,
+            "control-inspect",
+            0,
+        )
+        .await?;
+        if physical["hostId"] != preparation.host_identifier
+            || physical["processId"] != preparation.process_identifier
+            || physical["connectionIdentity"] != preparation.connection_identifier
+        {
+            return Err(failure("Preparation physical connection changed"));
+        }
+        let released = observe(&browser, preparation.process_identifier, "release").await?;
+        if released["released"] != true {
+            return Err(failure("Preparation hold release was not acknowledged"));
+        }
+        record(
+            json!({"event": "preparation-released", "context": preparation.context_identifier,
+                    "process": preparation.process_identifier, "host": preparation.host_identifier,
+                    "connection": preparation.connection_identifier, "stateBeforeRelease": state}),
+        );
+        Ok(())
+    };
+    let result = match timeout(Duration::from_secs(12), release).await {
+        Ok(result) => result,
+        Err(_) => Err(failure(
+            "Preparation release exceeded its private cleanup budget",
+        )),
+    };
+    if let Err(mut error) = result {
+        // A missing acknowledgement must not leave uncertain custody usable.
+        record(
+            json!({"event": "preparation-release-failed", "context": preparation.context_identifier, "error": error.message}),
+        );
+        error.cleanup = Some(match browser.close().await {
+            Ok(()) => "browserClosedAfterPreparationReleaseFailure".into(),
+            Err(cleanup) => format!("browserCleanupFailed: {}", cleanup.message).into(),
+        });
+        return Err(error);
+    }
+    Ok(())
