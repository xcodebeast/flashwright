+async fn terminal_websocket_reply_and_event_precede_disconnect() {
+    let listener=tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let address=listener.local_addr().unwrap();
+    let server=tokio::spawn(async move {
+        let (stream,_)=listener.accept().await.unwrap();
+        let mut ws=tokio_tungstenite::accept_async(stream).await.unwrap();
+        let request=ws.next().await.unwrap().unwrap();
+        let request:serde_json::Value=serde_json::from_str(request.to_text().unwrap()).unwrap();
+        for sequence in 0..1000 {
+            ws.feed(Message::Text(json!({"method":"Test.ordered","params":{"sequence":sequence}}).to_string().into())).await.unwrap();
+        }
+        ws.feed(Message::Text(json!({"id":request["id"],"result":{"terminal":true}}).to_string().into())).await.unwrap();
+        ws.flush().await.unwrap();
+        ws.close(None).await.unwrap();
+    });
+    let connection=Connection::connect_websocket(&format!("ws://{address}")).await.unwrap();
+    let observed=Arc::new(Mutex::new(Vec::new()));let copy=observed.clone();
+    connection.observe_events(move |event|{
+        if event.method=="Test.ordered" {let value:serde_json::Value=serde_json::from_str(event.parameters.as_ref().unwrap().get()).unwrap();copy.lock().unwrap().push(value["sequence"].as_u64().unwrap());}
