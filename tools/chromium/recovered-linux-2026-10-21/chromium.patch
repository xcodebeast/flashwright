+    settings.wait_for_all_pipeline_stages_before_draw = excluded_mode == 1;
+    settings.using_synchronous_renderer_compositor = excluded_mode == 2;
+    StateMachine state(settings);
+    SET_UP_STATE(state);
+    state.SetNeedsBeginMainFrame(false);
+    state.IssueNextBeginImplFrame();
+    EXPECT_ACTION_UPDATE_STATE(
