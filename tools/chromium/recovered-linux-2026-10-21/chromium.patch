@@ -0,0 +1,163 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "flashwright_pointer_probe/pointer_sequence.h"
+
+#include <algorithm>
+#include <array>
+#include <numeric>
+#include <vector>
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace flashwright::native_action {
+namespace {
+TEST(PointerSequenceTest, SynchronousAckCannotReleaseForwardingCustody) {
+  for (bool success : {true, false}) {
+    PointerSequence sequence(1);
+    EXPECT_EQ(sequence.Issue(), 0);
+    sequence.Acknowledge(0, success);
+    EXPECT_TRUE(sequence.Pending());
+    EXPECT_FALSE(sequence.Complete());
+    EXPECT_FALSE(sequence.CanIssue());
+    sequence.Forwarded(0, true);
+    EXPECT_FALSE(sequence.Pending());
+    EXPECT_EQ(sequence.Complete(), success);
+  }
+}
+
+TEST(PointerSequenceTest, RejectedAndDestroyedRoutesSettleInEitherOrder) {
+  for (bool ack_first : {true, false}) {
+    PointerSequence sequence(3);
+    sequence.Issue();
+    if (ack_first) sequence.Acknowledge(0, false);
+    sequence.Forwarded(0, false);
+    EXPECT_FALSE(sequence.CanIssue());
+    EXPECT_EQ(sequence.Pending(), !ack_first);
+    if (!ack_first) sequence.Acknowledge(0, false);
+    EXPECT_FALSE(sequence.Pending());
+    EXPECT_FALSE(sequence.Complete());
+    EXPECT_FALSE(sequence.Pressed());
+  }
+}
+
+TEST(PointerSequenceTest, AllDoubleClickAckOrdersKeepDispatchOrderState) {
+  std::array<int, 5> order{0, 1, 2, 3, 4};
+  do {
+    PointerSequence sequence(5);
+    for (int step = 0; step < 5; ++step) {
+      ASSERT_EQ(sequence.Issue(), step);
+      sequence.Forwarded(step, true);
+    }
+    EXPECT_TRUE(sequence.Pressed());
+    for (int i = 0; i < 5; ++i) {
+      sequence.Acknowledge(order[i], true);
+      const bool final_release = std::find(order.begin(), order.begin() + i + 1,
+                                          4) != order.begin() + i + 1;
+      EXPECT_EQ(sequence.Pressed(), !final_release);
+      EXPECT_EQ(sequence.Complete(), i == 4);
+    }
+  } while (std::next_permutation(order.begin(), order.end()));
+}
+
+// Explore every legal synchronous/asynchronous ACK interleaving with the
+// ordered routing boundaries, including ACKs before Forwarded returns.
+void Explore(PointerSequence sequence, int issued, int route,
+             std::vector<int> pending, int* completed) {
+  EXPECT_EQ(sequence.Pending(), route >= 0 || !pending.empty());
+  if (sequence.Complete()) {
+    EXPECT_EQ(issued, 5);
+    EXPECT_EQ(route, -1);
+    EXPECT_TRUE(pending.empty());
+    EXPECT_FALSE(sequence.Pressed());
+    ++*completed;
+    return;
+  }
+  if (route >= 0) {
+    auto next = sequence;
+    next.Forwarded(route, true);
+    int next_route = -1;
+    auto next_pending = pending;
+    int next_issued = issued;
+    if (next.CanIssue()) {
+      next_route = next.Issue();
+      next_pending.push_back(next_route);
+      ++next_issued;
+    }
+    Explore(next, next_issued, next_route, next_pending, completed);
+  }
+  for (size_t i = 0; i < pending.size(); ++i) {
+    auto next = sequence;
+    next.Acknowledge(pending[i], true);
+    auto next_pending = pending;
+    next_pending.erase(next_pending.begin() + i);
+    Explore(next, issued, route, next_pending, completed);
+  }
+}
+TEST(PointerSequenceTest, ExhaustiveDoubleClickInterleavings) {
+  PointerSequence sequence(5);
+  sequence.Issue();
+  int completed = 0;
+  Explore(sequence, 1, 0, {0}, &completed);
+  EXPECT_GT(completed, 120);
+}
+
+TEST(PointerSequenceTest, EveryFailureIsStickyAfterLaterEventsForward) {
+  for (int fail = 0; fail < 5; ++fail) {
+    std::array<int, 5> order{0, 1, 2, 3, 4};
+    do {
+      PointerSequence sequence(5);
+      for (int step = 0; step < 5; ++step) {
+        sequence.Issue(); sequence.Forwarded(step, true);
+      }
+      for (int step : order) sequence.Acknowledge(step, step != fail);
+      EXPECT_FALSE(sequence.Pending());
+      EXPECT_FALSE(sequence.Complete());
+      EXPECT_FALSE(sequence.CanIssue());
+      EXPECT_EQ(sequence.Pressed(), fail == 4);
+    } while (std::next_permutation(order.begin(), order.end()));
+  }
+}
+
+TEST(PointerSequenceTest, CancellationKeepsEveryIssuedBoundary) {
+  for (int prefix = 1; prefix <= 5; ++prefix) {
+    for (bool before_forward : {true, false}) {
+      PointerSequence sequence(5);
+      for (int step = 0; step < prefix; ++step) {
+        sequence.Issue();
+        if (step != prefix - 1 || !before_forward)
+          sequence.Forwarded(step, true);
+      }
+      sequence.Stop();
+      for (int step = prefix - 1; step >= 0; --step) {
+        sequence.Acknowledge(step, true);
+        EXPECT_FALSE(sequence.Complete());
+        EXPECT_FALSE(sequence.CanIssue());
+      }
+      EXPECT_EQ(sequence.Pending(), before_forward);
+      if (before_forward) sequence.Forwarded(prefix - 1, true);
+      EXPECT_FALSE(sequence.Pending());
+      EXPECT_FALSE(sequence.CanIssue());
+      EXPECT_EQ(sequence.Pressed(), prefix % 2 == 0);
+    }
+  }
+}
+
+TEST(PointerSequenceTest, MaximumClickCountAndSynchronousDelivery) {
+  for (bool synchronous : {true, false}) {
+    PointerSequence sequence(201);
+    for (int step = 0; step < 201; ++step) {
+      ASSERT_EQ(sequence.Issue(), step);
+      if (synchronous) sequence.Acknowledge(step, true);
+      EXPECT_TRUE(sequence.Pending());
+      EXPECT_FALSE(sequence.Complete());
+      sequence.Forwarded(step, true);
+    }
+    if (!synchronous)
+      for (int step = 200; step >= 0; --step) sequence.Acknowledge(step, true);
+    EXPECT_TRUE(sequence.Complete());
+    EXPECT_FALSE(sequence.Pressed());
+    EXPECT_FALSE(sequence.CanIssue());
+  }
+}
+}  // namespace
+}  // namespace flashwright::native_action
