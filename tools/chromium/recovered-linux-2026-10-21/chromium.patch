new file mode 100644
index 0000000000..111555ed9f
--- /dev/null
+++ 2/content/browser/renderer_host/renderer_process_lifetime.cc
@@ -0,0 +1,97 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/public/browser/renderer_process_lifetime.h"
+
+#include <utility>
+
+#include "base/callback_list.h"
+#include "base/check.h"
+#include "base/memory/weak_ptr.h"
+#include "base/supports_user_data.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/render_process_host.h"
+
+namespace content {
+namespace {
+
+const int kRendererProcessLifetimeAssociationKey = 0;
+
+}  // namespace
+
+class RendererProcessLifetime::Impl {
+ public:
+  class HostAssociation final : public base::SupportsUserData::Data {
+   public:
+    explicit HostAssociation(base::WeakPtr<Impl> lifetime);
+    ~HostAssociation() override;
+
+    base::WeakPtr<Impl> lifetime;
+  };
+
+  Impl();
+  ~Impl();
+
+  bool ended = false;
+  std::unique_ptr<base::OnceClosureList> callbacks;
+  base::WeakPtrFactory<Impl> weak_ptr_factory{this};
+};
+
+RendererProcessLifetime::Impl::HostAssociation::HostAssociation(
+    base::WeakPtr<Impl> lifetime)
+    : lifetime(std::move(lifetime)) {}
+
+RendererProcessLifetime::Impl::HostAssociation::~HostAssociation() = default;
+
+RendererProcessLifetime::Impl::Impl()
+    : callbacks(std::make_unique<base::OnceClosureList>()) {}
+
+RendererProcessLifetime::Impl::~Impl() = default;
+
+RendererProcessLifetime::RendererProcessLifetime()
+    : implementation_(std::make_unique<Impl>()) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+}
+
+RendererProcessLifetime::~RendererProcessLifetime() {
+  End();
+}
+
+void RendererProcessLifetime::AttachToHost(RenderProcessHost& host) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  CHECK(!implementation_->ended);
+  host.SetUserData(&kRendererProcessLifetimeAssociationKey,
+                   std::make_unique<Impl::HostAssociation>(
+                       implementation_->weak_ptr_factory.GetWeakPtr()));
+}
+
+void RendererProcessLifetime::End() {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (implementation_->ended) {
+    return;
+  }
+  implementation_->ended = true;
+  implementation_->weak_ptr_factory.InvalidateWeakPtrs();
+
+  // A callback can release the lifetime owner or reenter End(). The notifying
+  // list must survive independently, and no lifetime state is accessed
+  // afterward.
+  auto callbacks = std::move(implementation_->callbacks);
+  callbacks->Notify();
+}
+
+// static
+base::CallbackListSubscription RendererProcessLifetime::Observe(
+    RenderProcessHost& host,
+    base::OnceClosure callback) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  auto* association = static_cast<Impl::HostAssociation*>(
+      host.GetUserData(&kRendererProcessLifetimeAssociationKey));
+  if (!association || !association->lifetime) {
+    return {};
+  }
+  return association->lifetime->callbacks->Add(std::move(callback));
+}
+
+}  // namespace content
diff --git 1/content/browser/renderer_host/renderer_process_owner.cc 2/content/browser/renderer_host/renderer_process_owner.cc
new file mode 100644
index 0000000000..0d54a7847f
