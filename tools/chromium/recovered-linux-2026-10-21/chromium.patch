+void Exercise(v8::Isolate* isolate, v8::Global<v8::UnboundScript>& compiled,
+              const char* mode, int index, bool managed, bool custom_spaces) {
+  if (managed) {
+    CHECK_EQ(ForkV8ThreadId(), syscall(SYS_gettid));
+    CHECK(ForkHeapThreadMatches(isolate));
+  }
+  v8::Isolate::Scope isolate_scope(isolate);
+  v8::HandleScope handles(isolate);
+  for (int realm = 0; realm < 2; ++realm) {
+    auto context = v8::Context::New(isolate);
+    v8::Context::Scope scope(context);
+    CHECK(Eval(isolate, "typeof globalThis.changed === 'undefined'")->IsTrue());
+    CHECK(compiled.Get(isolate)->BindToCurrentContext()->Run(context)
+        .ToLocalChecked()->IsUndefined());
+    CHECK_EQ(Eval(isolate, "f511(31)")->Int32Value(context).FromJust(), 542);
+    CHECK_EQ(Eval(isolate,
+        "globalThis.changed=1; let total=0; for(let i=0;i<30000;i++)"
+        "total+=f511(i); total")->IntegerValue(context).FromJust(),
+        465315000);
+    Eval(isolate, "globalThis.micro=0; Promise.resolve().then(()=>micro=19)");
+    isolate->PerformMicrotaskCheckpoint();
+    CHECK_EQ(Eval(isolate, "micro")->Int32Value(context).FromJust(), 19);
+    Eval(isolate, "globalThis.heap=Array.from({length:30000},(_,i)=>({i}));"
+                  "globalThis.heap=null");
+    isolate->LowMemoryNotification();
+    v8::TryCatch caught(isolate);
+    auto error_script = v8::Script::Compile(context,
+        Str(isolate, "throw new Error('fork-diagnostic')")).ToLocalChecked();
+    CHECK(error_script->Run(context).IsEmpty()); CHECK(caught.HasCaught());
+    auto stack = caught.StackTrace(context).ToLocalChecked();
+    v8::String::Utf8Value stack_string(isolate, stack);
+    CHECK(std::string(*stack_string).find("fork-diagnostic") != std::string::npos);
+    caught.Reset();
+    if (managed) {
+      CHECK_EQ(ForkV8ThreadId(), syscall(SYS_gettid));
+      CHECK(ForkHeapThreadMatches(isolate));
+      ExerciseManagedForkHeap(isolate, custom_spaces);
+      printf("{\"event\":\"managed\",\"pid\":%d,\"realm\":%d,\"customSpaces\":%s,\"allocations\":1002,\"retained\":2,\"finallyLive\":0,\"cppToJsRetainedAndReleased\":true}\n", getpid(), realm, custom_spaces ? "true" : "false");
+    }
+    auto random = Eval(isolate, "JSON.stringify([Math.random(),Math.random(),Math.random()])");
+    v8::String::Utf8Value random_string(isolate, random);
+    std::cout << "{\"event\":\"realm\",\"mode\":\"" << mode
+              << "\",\"child\":" << index << ",\"realm\":" << realm
+              << ",\"pid\":" << getpid() << ",\"random\":"
+              << *random_string << "}" << std::endl;
+  }
+  base::RunLoop reply;
+  bool worker_ran = false;
+  CHECK(base::ThreadPool::PostTaskAndReply(FROM_HERE,
+      base::BindOnce([](bool* ran){ *ran = true; }, &worker_ran),
+      reply.QuitClosure()));
+  reply.Run(); CHECK(worker_ran);
+  base::RunLoop().RunUntilIdle();
+}
