+#include "third_party/blink/public/public_buildflags.h"
+
+#if BUILDFLAG(IS_POSIX) && !BUILDFLAG(IS_ANDROID)
+#include "services/tracing/public/cpp/system_tracing_service.h"
+#endif
+
+#if BUILDFLAG(IS_ANDROID)
+#include "content/browser/font_unique_name_lookup/font_unique_name_lookup_service.h"
+#endif
+
+#if BUILDFLAG(IS_WIN)
+#include "content/browser/renderer_host/dwrite_font_proxy_impl_win.h"
+#endif
+
+#if BUILDFLAG(USE_MINIKIN_HYPHENATION)
+#include "content/browser/hyphenation/hyphenation_impl.h"
+#endif
+
+namespace content {
+
+class RendererProcessTransport::Impl final
+    : public memory_instrumentation::mojom::CoordinatorConnector,
+      public metrics::HistogramChildProcess,
+      public base::MemoryPressureListener {
+ public:
+  Impl(ChildProcessId child_process_id,
+       base::WeakPtr<RenderProcessHostImpl> original_host,
+       mojo::PendingRemote<mojom::ChildProcess> child_process,
+       mojo::PendingReceiver<mojom::ChildProcessHost> physical_host_receiver)
+      : child_process_id_(child_process_id),
+        child_process_(std::move(child_process)),
+        gpu_client_(std::make_unique<viz::GpuClient>(
+            std::make_unique<BrowserGpuClientDelegate>(),
+            child_process_id.GetUnsafeValue(),
+            ChildProcessHostImpl::ChildProcessUniqueIdToTracingProcessId(
+                child_process_id.GetUnsafeValue()),
+            /*enable_extra_handles_validation=*/false,
+            GetUIThreadTaskRunner({}))) {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    auto registry = std::make_unique<service_manager::BinderRegistry>();
+    RegisterMojoInterfaces(registry.get());
+    if (!RenderProcessHost::run_renderer_in_process()) {
+      memory_pressure_listener_registration_.emplace(
+          base::MemoryPressureListenerTag::kRenderProcessHostImpl, this);
+    }
+    auto unhandled_receiver_callback = base::BindPostTask(
+        GetUIThreadTaskRunner({}),
+        base::BindRepeating(
+            &RenderProcessHostImpl::OnBindHostReceiverAfterInterception,
+            original_host));
+    io_thread_host_impl_.emplace(GetIOThreadTaskRunner({}), child_process_id,
+                                 std::move(original_host), std::move(registry),
+                                 std::move(physical_host_receiver),
+                                 std::move(unhandled_receiver_callback));
+  }
+
+  ~Impl() override {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    OnProcessExited();
+    if (features::IsShaderDiskCacheEnabled(
+            base::CommandLine::ForCurrentProcess()) &&
+        GetGpuDiskCacheFactorySingleton()) {
+      gpu_client_->RemoveDiskCacheHandles();
+    }
+  }
+
+  mojom::ChildProcess* GetChildProcess() const {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    return child_process_.get();
+  }
+
+  viz::GpuClient* GetGpuClient() const {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    return gpu_client_.get();
+  }
+
+  void OnProcessLaunched(base::ProcessId process_id) {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    if (ended_) {
+      return;
+    }
+    CHECK_NE(process_id, base::kNullProcessId);
+    if (process_id_ != base::kNullProcessId) {
+      CHECK_EQ(process_id_, process_id);
+      return;
+    }
+    process_id_ = process_id;
+    gpu_client_->SetClientPid(process_id);
+    // GPU callbacks can synchronously release the launcher and end this
+    // lifetime while the public wrapper keeps the transport itself alive.
+    if (ended_) {
+      return;
+    }
+    if (coordinator_connector_receiver_.is_bound()) {
+      coordinator_connector_receiver_.Resume();
+    }
+    io_thread_host_impl_
+        ->AsyncCall(&RenderProcessHostImpl::IOThreadHostImpl::SetPid)
+        .WithArgs(process_id);
+    aec_dump_manager_->set_pid(process_id);
+    aec_dump_manager_->AutoStart();
+    tracing_registration_ = TracingServiceController::Get().RegisterClient(
+        process_id, base::BindRepeating(&Impl::BindTracedProcess,
+                                        weak_factory_.GetWeakPtr()));
+#if BUILDFLAG(IS_POSIX) && !BUILDFLAG(IS_ANDROID)
+    system_tracing_service_ = std::make_unique<tracing::SystemTracingService>();
+    child_process_->EnableSystemTracingService(
+        system_tracing_service_->BindAndPassPendingRemote());
+#endif
+  }
+
+  bool IsEnded() const {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    return ended_;
+  }
+
+  void AttachToHost(RenderProcessHost& host) {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    CHECK(!ended_);
+    lifetime_.AttachToHost(host);
+  }
+
+  void OnProcessExited() {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    if (ended_) {
+      return;
+    }
+    ended_ = true;
+    weak_factory_.InvalidateWeakPtrs();
+    memory_pressure_listener_registration_.reset();
+    tracing_registration_.reset();
+#if BUILDFLAG(IS_POSIX) && !BUILDFLAG(IS_ANDROID)
+    system_tracing_service_.reset();
+#endif
+    if (histograms_shared_) {
+      metrics::HistogramController::GetInstance()->NotifyChildDied(this);
+    }
+    aec_dump_manager_.reset();
+    coordinator_connector_receiver_.reset();
+    memory_consumer_registration_.RunAndReset();
+    io_thread_host_impl_.reset();
+    child_process_.reset();
+    // The public wrapper retains the transport across notification. Keep this
+    // last as observers may release their physical owner and reenter here.
+    lifetime_.End();
+  }
+
+  base::ReadOnlySharedMemoryRegion DuplicateLastForegroundTimeRegion(
+      base::TimeTicks initial_time) {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    CHECK(!ended_);
+    if (!last_foreground_time_region_) {
+      last_foreground_time_region_ =
+          base::AtomicSharedMemory<base::TimeTicks>::Create(initial_time);
+      CHECK(last_foreground_time_region_);
+    }
+    return last_foreground_time_region_->DuplicateReadOnlyRegion();
+  }
+
+  void SetLastForegroundTime(base::TimeTicks time) {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    if (ended_) {
+      return;
+    }
+    CHECK(last_foreground_time_region_);
+    // Readers depend only on the timestamp, not on other memory writes.
+    last_foreground_time_region_->WritableRef().store(
+        time, std::memory_order_relaxed);
+  }
+
+  void BindAecDumpManager(
+      mojo::PendingReceiver<blink::mojom::AecDumpManager> receiver) {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    if (!ended_) {
+      aec_dump_manager_->AddReceiver(std::move(receiver));
+    }
+  }
+
+  void StartAecDump(const base::FilePath& file_path) {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    if (!ended_) {
+      aec_dump_manager_->Start(file_path);
+    }
+  }
+
+  void StopAecDump() {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    if (!ended_) {
+      aec_dump_manager_->Stop();
+    }
+  }
+
+  void OnMemoryPressure(base::MemoryPressureLevel level) override {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+#if BUILDFLAG(IS_ANDROID) || BUILDFLAG(IS_CASTOS)
+    if (!ended_) {
+      child_process_->OnMemoryPressure(level);
+    }
+#endif
+  }
+
+  void CreateMetricsAllocator(bool is_webium_renderer) {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    CHECK(!ended_);
+    if (metrics_initialized_) {
+      CHECK_EQ(is_webium_renderer_, is_webium_renderer);
+      return;
+    }
+    metrics_initialized_ = true;
+    is_webium_renderer_ = is_webium_renderer;
+    if (!base::GlobalHistogramAllocator::Get()) {
+      return;
+    }
+    auto configuration = GetHistogramSharedMemoryConfig(PROCESS_TYPE_RENDERER);
+    CHECK(configuration);
+    auto shared_memory = base::HistogramSharedMemory::Create(
+        child_process_id_.GetUnsafeValue(), *configuration);
+    if (shared_memory) {
+      metrics_memory_region_ = base::MakeRefCounted<
+          base::RefCountedData<base::UnsafeSharedMemoryRegion>>(
+          std::move(shared_memory->region));
+      metrics_allocator_ = std::move(shared_memory->allocator);
+    }
+  }
+
+  scoped_refptr<base::RefCountedData<base::UnsafeSharedMemoryRegion>>
+  GetMetricsMemoryRegion() const {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    return metrics_memory_region_;
+  }
+
+  std::unique_ptr<base::PersistentMemoryAllocator> TakeMetricsAllocator() {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    return std::move(metrics_allocator_);
+  }
+
+  void ShareMetricsMemoryRegion() {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    if (ended_ || histograms_shared_) {
+      return;
+    }
+    histograms_shared_ = true;
+    auto memory_region =
+        metrics_memory_region_ &&
+                !base::HistogramSharedMemory::PassOnCommandLineIsEnabled(
+                    PROCESS_TYPE_RENDERER)
+            ? std::move(metrics_memory_region_->data)
+            : base::UnsafeSharedMemoryRegion();
+    metrics::HistogramController::GetInstance()->SetHistogramMemory(
+        this, std::move(memory_region),
+        metrics::HistogramController::ChildProcessMode::kGetHistogramData);
+    metrics_memory_region_.reset();
+  }
+
+ private:
+  void BindChildHistogramFetcherFactory(
+      mojo::PendingReceiver<metrics::mojom::ChildHistogramFetcherFactory>
+          receiver) override {
+    if (!ended_) {
+      child_process_->BindReceiver(std::move(receiver));
+    }
+  }
+
+  bool IsWebiumRenderer() const override { return is_webium_renderer_; }
+
+  void BindTracedProcess(
+      mojo::PendingReceiver<tracing::mojom::TracedProcess> receiver) {
+    if (!ended_) {
+      child_process_->BindReceiver(std::move(receiver));
+    }
+  }
+
+  template <typename InterfaceType>
+  void AddUIThreadInterface(
+      service_manager::BinderRegistry* registry,
+      base::RepeatingCallback<void(mojo::PendingReceiver<InterfaceType>)>
+          callback) {
+    registry->AddInterface(
+        base::BindRepeating(
+            [](base::WeakPtr<Impl> transport,
+               base::RepeatingCallback<void(
+                   mojo::PendingReceiver<InterfaceType>)> callback,
+               mojo::PendingReceiver<InterfaceType> receiver) {
+              if (transport) {
+                callback.Run(std::move(receiver));
+              }
+            },
+            weak_factory_.GetWeakPtr(), std::move(callback)),
+        GetUIThreadTaskRunner({}));
+  }
+
+  void RegisterMojoInterfaces(service_manager::BinderRegistry* registry) {
+    AddUIThreadInterface(registry,
+                         base::BindRepeating(&Impl::BindAecDumpManager,
+                                             weak_factory_.GetWeakPtr()));
+    AddUIThreadInterface(registry,
+                         base::BindRepeating(&Impl::BindMemoryConsumerRegistry,
+                                             weak_factory_.GetWeakPtr()));
+    AddUIThreadInterface(registry,
+                         base::BindRepeating(&Impl::BindCoordinatorConnector,
+                                             weak_factory_.GetWeakPtr()));
+    AddUIThreadInterface(
+        registry,
+        base::BindRepeating(
+            [](mojo::PendingReceiver<device::mojom::TimeZoneMonitor> receiver) {
+              GetDeviceService().BindTimeZoneMonitor(std::move(receiver));
+            }));
+    AddUIThreadInterface(
+        registry,
+        base::BindRepeating(
+            [](mojo::PendingReceiver<device::mojom::PowerMonitor> receiver) {
+              GetDeviceService().BindPowerMonitor(std::move(receiver));
+            }));
+    AddUIThreadInterface(
+        registry,
+        base::BindRepeating(
+            [](mojo::PendingReceiver<device::mojom::ScreenOrientationListener>
+                   receiver) {
+              GetDeviceService().BindScreenOrientationListener(
+                  std::move(receiver));
+            }));
+    AddUIThreadInterface(
+        registry,
+        base::BindRepeating(
+            [](mojo::PendingReceiver<viz::mojom::CompositingModeReporter>
+                   receiver) {
+              BrowserMainLoop::GetInstance()->GetCompositingModeReporter(
+                  std::move(receiver));
+            }));
+    AddUIThreadInterface(
+        registry,
+        base::BindRepeating(&viz::GpuClient::Add, gpu_client_->GetWeakPtr()));
+    AddUIThreadInterface(registry,
+                         base::BindRepeating(&FieldTrialRecorder::Create));
+
+    registry->AddInterface(
+        base::BindRepeating(&MimeRegistryImpl::Create),
+        base::ThreadPool::CreateSequencedTaskRunner(
+            {base::MayBlock(), base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN,
+             base::TaskPriority::USER_BLOCKING}));
+#if BUILDFLAG(USE_MINIKIN_HYPHENATION)
+#if !BUILDFLAG(IS_ANDROID)
+    hyphenation::HyphenationImpl::RegisterGetDictionary();
+#endif
+    registry->AddInterface(
+        base::BindRepeating(&hyphenation::HyphenationImpl::Create),
+        hyphenation::HyphenationImpl::GetTaskRunner());
+#endif
+#if BUILDFLAG(IS_ANDROID)
+    if (base::FeatureList::IsEnabled(features::kFontSrcLocalMatching)) {
+      registry->AddInterface(
+          base::BindRepeating(&FontUniqueNameLookupService::Create),
+          FontUniqueNameLookupService::GetTaskRunner());
+    }
+#endif
+#if BUILDFLAG(IS_WIN)
+    registry->AddInterface(
+        base::BindRepeating(&DWriteFontProxyImpl::Create),
+        base::ThreadPool::CreateSequencedTaskRunner(
+            {base::TaskPriority::USER_BLOCKING, base::MayBlock()}));
+#endif
+    registry->AddInterface(
+        base::BindRepeating(&GpuDataManagerImpl::BindReceiver));
+    registry->AddInterface(
+        base::BindRepeating(&metrics::CreateSingleSampleMetricsProvider));
+
+    // The registry and this state are deleted on IO, with registry deletion
+    // posted first so the unretained callback cannot outlive its target.
+    media_stream_track_metrics_host_.reset(new MediaStreamTrackMetricsHost());
+    registry->AddInterface(base::BindRepeating(
+        &MediaStreamTrackMetricsHost::BindReceiver,
+        base::Unretained(media_stream_track_metrics_host_.get())));
+  }
+
+  void BindMemoryConsumerRegistry(
+      mojo::PendingReceiver<mojom::ChildMemoryConsumerRegistryHost> receiver) {
+    auto registration = BrowserMemoryCoordinator::Get().BindForRendererProcess(
+        child_process_id_, std::move(receiver));
+    // A duplicate reports the coordinator's existing bad-message error and
+    // returns no lease. Do not release the original live registration then.
+    if (registration) {
+      memory_consumer_registration_ = std::move(registration);
+    }
+  }
+
+  void BindCoordinatorConnector(
+      mojo::PendingReceiver<memory_instrumentation::mojom::CoordinatorConnector>
+          receiver) {
+    coordinator_connector_receiver_.reset();
+    coordinator_connector_receiver_.Bind(std::move(receiver));
+    if (process_id_ == base::kNullProcessId) {
+      coordinator_connector_receiver_.Pause();
+    }
+  }
+
+  void RegisterCoordinatorClient(
+      mojo::PendingReceiver<memory_instrumentation::mojom::Coordinator>
+          receiver,
+      mojo::PendingRemote<memory_instrumentation::mojom::ClientProcess>
+          client_process) override {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    // Intentionally disallow non-browser processes from getting a Coordinator.
+    receiver.reset();
+    CHECK_NE(process_id_, base::kNullProcessId);
+    base::trace_event::MemoryDumpManager::GetInstance()
+        ->GetDumpThreadTaskRunner()
+        ->PostTask(
+            FROM_HERE,
+            base::BindOnce(
+                [](mojo::PendingReceiver<
+                       memory_instrumentation::mojom::Coordinator> receiver,
+                   mojo::PendingRemote<
+                       memory_instrumentation::mojom::ClientProcess>
+                       client_process,
+                   base::ProcessId process_id) {
+                  GetMemoryInstrumentationRegistry()->RegisterClientProcess(
+                      std::move(receiver), std::move(client_process),
+                      memory_instrumentation::mojom::ProcessType::RENDERER,
+                      process_id, /*service_name=*/std::nullopt);
+                },
+                std::move(receiver), std::move(client_process), process_id_));
+    coordinator_connector_receiver_.reset();
+  }
+
+  const ChildProcessId child_process_id_;
+  mojo::Remote<mojom::ChildProcess> child_process_;
+  const std::unique_ptr<viz::GpuClient> gpu_client_;
+  base::ScopedClosureRunner memory_consumer_registration_;
+  mojo::Receiver<memory_instrumentation::mojom::CoordinatorConnector>
+      coordinator_connector_receiver_{this};
+  base::ProcessId process_id_ = base::kNullProcessId;
+  bool ended_ = false;
+  RendererProcessLifetime lifetime_;
+  std::optional<base::AtomicSharedMemory<base::TimeTicks>>
+      last_foreground_time_region_;
+  std::unique_ptr<AecDumpManagerImpl> aec_dump_manager_ =
+      std::make_unique<AecDumpManagerImpl>();
+  std::optional<base::MemoryPressureListenerRegistration>
+      memory_pressure_listener_registration_;
+  std::unique_ptr<TracingServiceController::ClientRegistration>
+      tracing_registration_;
+#if BUILDFLAG(IS_POSIX) && !BUILDFLAG(IS_ANDROID)
+  std::unique_ptr<tracing::SystemTracingService> system_tracing_service_;
+#endif
+  bool metrics_initialized_ = false;
+  bool histograms_shared_ = false;
+  bool is_webium_renderer_ = false;
+  std::unique_ptr<base::PersistentMemoryAllocator> metrics_allocator_;
+  scoped_refptr<base::RefCountedData<base::UnsafeSharedMemoryRegion>>
+      metrics_memory_region_;
+
+  std::unique_ptr<MediaStreamTrackMetricsHost, BrowserThread::DeleteOnIOThread>
+      media_stream_track_metrics_host_;
+  // Destruction posts registry/receiver deletion before the metrics host above.
+  std::optional<base::SequenceBound<RenderProcessHostImpl::IOThreadHostImpl>>
+      io_thread_host_impl_;
+  base::WeakPtrFactory<Impl> weak_factory_{this};
+};
+
+RendererProcessTransport::RendererProcessTransport(
+    ChildProcessId child_process_id,
+    base::WeakPtr<RenderProcessHostImpl> original_host,
+    mojo::PendingRemote<mojom::ChildProcess> child_process,
+    mojo::PendingReceiver<mojom::ChildProcessHost> physical_host_receiver)
+    : base::RefCountedDeleteOnSequence<RendererProcessTransport>(
+          GetUIThreadTaskRunner({})),
+      implementation_(
+          std::make_unique<Impl>(child_process_id,
+                                 std::move(original_host),
+                                 std::move(child_process),
+                                 std::move(physical_host_receiver))) {}
+
+RendererProcessTransport::~RendererProcessTransport() {
+  // Notify before unique_ptr begins destroying Impl: reentrant terminal calls
+  // must still be able to inspect its ended state through implementation_.
+  implementation_->OnProcessExited();
+}
+
+mojom::ChildProcess* RendererProcessTransport::GetChildProcess() const {
+  return implementation_->GetChildProcess();
+}
+
+viz::GpuClient* RendererProcessTransport::GetGpuClient() const {
+  return implementation_->GetGpuClient();
+}
+
+void RendererProcessTransport::OnProcessLaunched(base::ProcessId process_id) {
+  // A terminal callback can reenter during final-reference destruction. Never
+  // acquire a new reference to an object whose destruction has already begun.
+  if (implementation_->IsEnded()) {
+    return;
+  }
+  // GPU initialization can invoke callbacks that release the original owners.
+  scoped_refptr<RendererProcessTransport> transport_lifetime(this);
+  implementation_->OnProcessLaunched(process_id);
+}
+
+void RendererProcessTransport::AttachToHost(RenderProcessHost& host) {
+  implementation_->AttachToHost(host);
+}
+
+void RendererProcessTransport::OnProcessExited() {
+  // A terminal callback can reenter during final-reference destruction. Never
+  // acquire a new reference to an object whose destruction has already begun.
+  if (implementation_->IsEnded()) {
+    return;
+  }
+  scoped_refptr<RendererProcessTransport> transport_lifetime(this);
+  implementation_->OnProcessExited();
+}
+
+base::ReadOnlySharedMemoryRegion
+RendererProcessTransport::DuplicateLastForegroundTimeRegion(
+    base::TimeTicks initial_time) {
+  return implementation_->DuplicateLastForegroundTimeRegion(initial_time);
+}
+
+void RendererProcessTransport::SetLastForegroundTime(base::TimeTicks time) {
+  implementation_->SetLastForegroundTime(time);
+}
+
+void RendererProcessTransport::BindAecDumpManager(
+    mojo::PendingReceiver<blink::mojom::AecDumpManager> receiver) {
+  implementation_->BindAecDumpManager(std::move(receiver));
+}
+
+void RendererProcessTransport::StartAecDump(const base::FilePath& file_path) {
+  implementation_->StartAecDump(file_path);
+}
+
+void RendererProcessTransport::StopAecDump() {
+  implementation_->StopAecDump();
+}
+
+void RendererProcessTransport::OnMemoryPressure(
+    base::MemoryPressureLevel level) {
+  implementation_->OnMemoryPressure(level);
+}
+
+void RendererProcessTransport::CreateMetricsAllocator(bool is_webium_renderer) {
+  implementation_->CreateMetricsAllocator(is_webium_renderer);
+}
+
+scoped_refptr<base::RefCountedData<base::UnsafeSharedMemoryRegion>>
+RendererProcessTransport::GetMetricsMemoryRegion() const {
+  return implementation_->GetMetricsMemoryRegion();
+}
+
+std::unique_ptr<base::PersistentMemoryAllocator>
+RendererProcessTransport::TakeMetricsAllocator() {
+  return implementation_->TakeMetricsAllocator();
+}
+
+void RendererProcessTransport::ShareMetricsMemoryRegion() {
+  implementation_->ShareMetricsMemoryRegion();
+}
+
+}  // namespace content
