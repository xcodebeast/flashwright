+#ifndef CONTENT_BROWSER_RENDERER_HOST_RENDERER_CONNECTION_DIAGNOSTIC_H_
+#define CONTENT_BROWSER_RENDERER_HOST_RENDERER_CONNECTION_DIAGNOSTIC_H_
