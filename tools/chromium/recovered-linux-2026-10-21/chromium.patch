@@ -0,0 +1,63 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/frame/flashwright_action_navigation.h"
+#include <limits>
+#include "third_party/blink/renderer/core/dom/document.h"
+#include "third_party/blink/renderer/core/frame/flashwright_action_executor.h"
+#include "third_party/blink/renderer/core/frame/local_frame.h"
+
+namespace blink {
+const char FlashwrightActionNavigation::kSupplementName[] =
+    "FlashwrightActionNavigation";
+
+FlashwrightActionNavigation::FlashwrightActionNavigation(Document& document)
+    : Supplement<Document>(document) {}
+
+bool FlashwrightActionNavigation::Add(Document& document,
+                                     FlashwrightActionExecutor* executor) {
+  auto* state = Supplement<Document>::From<FlashwrightActionNavigation>(document);
+  if (!state) {
+    state = MakeGarbageCollected<FlashwrightActionNavigation>(document);
+    ProvideTo(document, state);
+  }
+  if (state->observers_.size() >= 16)
+    return false;
+  state->observers_.insert(executor);
+  return true;
+}
+
+void FlashwrightActionNavigation::Remove(Document& document,
+                                        FlashwrightActionExecutor* executor) {
+  if (auto* state = Supplement<Document>::From<FlashwrightActionNavigation>(document))
+    state->observers_.erase(executor);
+}
+
+void FlashwrightActionNavigation::Requested(Frame* target,
+                                            NavigationPolicy policy) {
+  // The diagnostic controller currently owns an original local main document.
+  // Remote targets and other dispositions retain their ordinary browser path.
+  auto* frame = DynamicTo<LocalFrame>(target);
+  if (!frame || !frame->IsMainFrame() || policy != kNavigationPolicyCurrentTab)
+    return;
+  auto* document = frame->GetDocument();
+  if (!document || !document->IsActive())
+    return;
+  auto* state = Supplement<Document>::From<FlashwrightActionNavigation>(*document);
+  if (!state || state->observers_.empty())
+    return;
+  // Zero is an explicit exhausted sequence, never a wrapped valid intent.
+  const auto sequence = state->sequence_ == std::numeric_limits<uint64_t>::max()
+                            ? 0 : ++state->sequence_;
+  for (auto& observer : state->observers_) {
+    if (observer)
+      observer->NavigationRequested(sequence);
+  }
+}
+
+void FlashwrightActionNavigation::Trace(Visitor* visitor) const {
+  visitor->Trace(observers_);
+  Supplement<Document>::Trace(visitor);
+}
+}  // namespace blink
