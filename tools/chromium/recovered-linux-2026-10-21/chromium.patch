+
+ZygoteCommunication* SelectRendererProbeZygote(
+    const std::vector<std::string>& argv,
+    const base::FileHandleMappingVector& mapping) {
+  if (!g_renderer_probe_zygotes[0]) return nullptr;
+  static base::NoDestructor<std::array<std::optional<RendererProbeKey>, 2>> keys;
+  auto key = RendererKey(argv, mapping);
+  if (!key) {
+    std::fprintf(stderr, "FW_DONOR route=generic reason=unreadable-config\n");
+    return nullptr;
+  }
+  if ((*keys)[0] && std::getenv("FLASHWRIGHT_DONOR_FORCE_MISMATCH")) {
+    std::fprintf(stderr, "FW_DONOR route=generic reason=forced-mismatch\n");
+    return nullptr;
+  }
+  for (size_t i = 0; i < keys->size(); ++i) {
+    if ((*keys)[i] && *(*keys)[i] == *key) {
+      std::fprintf(stderr, "FW_DONOR route=donor slot=%zu reason=matching-config\n", i);
+      return g_renderer_probe_zygotes[i];
+    }
+  }
+  for (size_t i = 0; i < keys->size(); ++i) {
+    if ((*keys)[i]) continue;
+    (*keys)[i] = std::move(key);
+    std::fprintf(stderr, "FW_DONOR route=donor slot=%zu reason=first-config\n", i);
+    return g_renderer_probe_zygotes[i];
+  }
+  std::fprintf(stderr, "FW_DONOR route=generic reason=config-capacity\n");
+  if (std::getenv("FLASHWRIGHT_DONOR_DEBUG_CONFIG")) {
+    for (const auto& arg : key->argv)
+      std::fprintf(stderr, "FW_DONOR requested_arg=%s\n", arg.c_str());
+  }
+  return nullptr;
+}
+
+void CheckRendererProbeConfiguration(
