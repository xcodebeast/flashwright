@@ -0,0 +1,276 @@
+// Copyright 2026 The Flashwright Authors
+// Use of this private experiment is governed by the repository license.
+// The included Chromium source retains its original upstream copyright/license.
+
+// Source composition intentionally preserves and registers every upstream case.
+// Do not also compile this included .cc separately in this executable.
+#include "content/browser/child_process_security_policy_unittest.cc"  // nogncheck
+
+#include <array>
+
+#include "base/feature_list.h"
+#include "base/files/file.h"
+#include "base/memory/raw_ptr.h"
+#include "base/run_loop.h"
+#include "content/browser/isolation_context.h"
+#include "content/browser/url_info.h"
+#include "content/public/browser/storage_partition_config.h"
+#include "content/public/common/site_isolation_policy_buildflags.h"
+
+namespace content {
+namespace {
+
+constexpr bool kIdea02EnforcementRemoved =
+    BUILDFLAG(FLASHWRIGHT_REMOVE_SITE_ISOLATION_ENFORCEMENT);
+GURL Idea02UrlA() { return GURL("https://a.example.test/a"); }
+GURL Idea02UrlB() { return GURL("https://b.other.test/b"); }
+
+// Use the original fixture's UI/real-IO environment and clean every state even
+// if a fatal assertion returns early from a supplemental test.
+class Idea02ScopedPolicyProcess {
+ public:
+  explicit Idea02ScopedPolicyProcess(BrowserContext* browser_context,
+                                    bool assign_valid_lock = true)
+      : policy_(ChildProcessSecurityPolicyImpl::GetInstance()),
+        isolation_context_(
+            BrowsingInstanceId(1), browser_context, /*is_guest=*/false,
+            /*is_fenced=*/false,
+            OriginAgentClusterIsolationState::CreateForDefaultIsolation(
+                browser_context)) {
+    if (assign_valid_lock) {
+      policy_->AddForTesting(kRendererProcess, browser_context);
+    } else {
+      policy_->Add(kRendererProcess, browser_context);
+    }
+  }
+
+  Idea02ScopedPolicyProcess(const Idea02ScopedPolicyProcess&) = delete;
+  Idea02ScopedPolicyProcess& operator=(const Idea02ScopedPolicyProcess&) = delete;
+
+  ~Idea02ScopedPolicyProcess() {
+    policy_->Remove(kRendererProcess);
+    base::RunLoop run_loop;
+    GetIOThreadTaskRunner({})->PostTaskAndReply(
+        FROM_HERE, base::DoNothing(), run_loop.QuitClosure());
+    run_loop.Run();
+  }
+
+  ChildProcessSecurityPolicyImpl* policy() { return policy_; }
+  const IsolationContext& context() const { return isolation_context_; }
+
+  void LockTo(const GURL& url) {
+    policy_->LockProcessForTesting(isolation_context_, kRendererProcess, url);
+  }
+
+ private:
+  const raw_ptr<ChildProcessSecurityPolicyImpl> policy_;
+  const IsolationContext isolation_context_;
+};
+
+void Idea02ObserveFeatures(const std::string& prefix,
+                          bool expected_tracking,
+                          bool expected_enforcement) {
+  const bool tracking =
+      base::FeatureList::IsEnabled(features::kCommittedOriginTracking);
+  const bool enforcement =
+      base::FeatureList::IsEnabled(features::kCommittedOriginEnforcements);
+  EXPECT_EQ(expected_tracking, tracking);
+  EXPECT_EQ(expected_enforcement, enforcement);
+  testing::Test::RecordProperty(prefix + "tracking", tracking ? "true" : "false");
+  testing::Test::RecordProperty(prefix + "enforcement",
+                               enforcement ? "true" : "false");
+  testing::Test::RecordProperty("idea02_enforcement_removed",
+                               kIdea02EnforcementRemoved ? "true" : "false");
+}
+
+void Idea02ConfigureFallback(int mode,
+                            base::test::ScopedFeatureList& feature_list) {
+  if (mode == 1) {
+    feature_list.InitWithFeatures({features::kCommittedOriginTracking},
+                                  {features::kCommittedOriginEnforcements});
+  } else if (mode == 2) {
+    feature_list.InitWithFeatures({features::kCommittedOriginEnforcements},
+                                  {features::kCommittedOriginTracking});
+  }
+}
+
+void Idea02CheckFallback(BrowserContext* browser_context, int mode) {
+  SCOPED_TRACE(mode);
+  base::test::ScopedFeatureList feature_list;
+  Idea02ConfigureFallback(mode, feature_list);
+  Idea02ObserveFeatures("fallback_", mode != 2, mode != 1);
+  Idea02ScopedPolicyProcess process(browser_context);
+  auto* policy = process.policy();
+  process.LockTo(Idea02UrlA());
+  const ProcessLock actual = policy->GetProcessLock(kRendererProcess);
+  const ProcessLock foreign = ProcessLock::FromSiteInfo(
+      SiteInfo::CreateForTesting(process.context(), Idea02UrlB()));
+  ASSERT_TRUE(actual.IsLockedToSite());
+  ASSERT_NE(actual, foreign);
+  if (mode != 2) {
+    policy->AddCommittedOrigin(kRendererID, url::Origin::Create(Idea02UrlA()));
+  }
+  const auto origin_a = url::Origin::Create(Idea02UrlA());
+  const auto origin_b = url::Origin::Create(Idea02UrlB());
+  EXPECT_TRUE(policy->CanAccessDataForOrigin(kRendererID, origin_a));
+  EXPECT_TRUE(policy->HostsOrigin(kRendererID, origin_a));
+  EXPECT_EQ(kIdea02EnforcementRemoved,
+            policy->CanAccessDataForOrigin(kRendererID, origin_b));
+  EXPECT_EQ(kIdea02EnforcementRemoved,
+            policy->HostsOrigin(kRendererID, origin_b));
+}
+
+}  // namespace
+
+TEST_P(ChildProcessSecurityPolicyTest, Idea02DefaultActualWrongLockCommit) {
+  Idea02ObserveFeatures("default_", true, true);
+  Idea02ScopedPolicyProcess process(browser_context());
+  auto* policy = process.policy();
+  process.LockTo(Idea02UrlA());
+  const ProcessLock actual = policy->GetProcessLock(kRendererProcess);
+  const ProcessLock expected_a = ProcessLock::FromSiteInfo(
+      SiteInfo::CreateForTesting(process.context(), Idea02UrlA()));
+  const ProcessLock expected_b = ProcessLock::FromSiteInfo(
+      SiteInfo::CreateForTesting(process.context(), Idea02UrlB()));
+  ASSERT_TRUE(actual.IsLockedToSite());
+  ASSERT_EQ(actual, expected_a);
+  ASSERT_EQ(actual.GetProcessLockURL(), expected_a.GetProcessLockURL());
+  ASSERT_NE(actual, expected_b);
+  testing::Test::RecordProperty("idea02_actual_lock",
+                               actual.GetProcessLockURL().spec());
+  testing::Test::RecordProperty("idea02_foreign_lock",
+                               expected_b.GetProcessLockURL().spec());
+  ASSERT_FALSE(process.context().browsing_instance_id().is_null());
+  using AccessType = ChildProcessSecurityPolicyImpl::AccessType;
+  EXPECT_TRUE(policy->CanAccessOrigin(kRendererID,
+                                     url::Origin::Create(Idea02UrlA()),
+                                     AccessType::kCanCommitNewOrigin));
+  EXPECT_TRUE(policy->CanCommitURL(kRendererID, Idea02UrlA()));
+  EXPECT_EQ(kIdea02EnforcementRemoved,
+            policy->CanAccessOrigin(kRendererID,
+                                    url::Origin::Create(Idea02UrlB()),
+                                    AccessType::kCanCommitNewOrigin));
+  EXPECT_EQ(kIdea02EnforcementRemoved,
+            policy->CanCommitURL(kRendererID, Idea02UrlB()));
+  UrlInfo info = UrlInfo::CreateForTesting(Idea02UrlB());
+  info.origin = url::Origin::Create(Idea02UrlB());
+  EXPECT_EQ(kIdea02EnforcementRemoved
+                ? CanCommitStatus::CAN_COMMIT_ORIGIN_AND_URL
+                : CanCommitStatus::CANNOT_COMMIT_URL,
+            policy->CanCommitOriginAndUrl(kRendererID, process.context(), info));
+}
+
+TEST_P(ChildProcessSecurityPolicyTest, Idea02InconsistentUrlOriginRejected) {
+  Idea02ObserveFeatures("default_", true, true);
+  Idea02ScopedPolicyProcess process(browser_context());
+  auto* policy = process.policy();
+  process.LockTo(Idea02UrlA());
+  ASSERT_TRUE(policy->GetProcessLock(kRendererProcess).IsLockedToSite());
+  UrlInfo info = UrlInfo::CreateForTesting(Idea02UrlA());
+  info.origin = url::Origin::Create(Idea02UrlB());
+  EXPECT_EQ(CanCommitStatus::CANNOT_COMMIT_ORIGIN,
+            policy->CanCommitOriginAndUrl(kRendererID, process.context(), info));
+}
+
+TEST_P(ChildProcessSecurityPolicyTest, Idea02FilePermissionDenials) {
+  Idea02ObserveFeatures("default_", true, true);
+  Idea02ScopedPolicyProcess process(browser_context());
+  auto* policy = process.policy();
+  process.LockTo(Idea02UrlA());
+  ASSERT_TRUE(policy->GetProcessLock(kRendererProcess).IsLockedToSite());
+  const base::FilePath ungranted_file(FILE_PATH_LITERAL("/idea02-ungranted/file"));
+  const GURL ungranted_url("file:///idea02-ungranted/file");
+  EXPECT_FALSE(policy->CanReadFile(kRendererProcess, ungranted_file));
+  EXPECT_FALSE(policy->CanRequestURL(kRendererID, ungranted_url));
+  EXPECT_FALSE(policy->CanCommitURL(kRendererID, ungranted_url));
+  EXPECT_FALSE(policy->CanCommitURL(kRendererID, GURL()));
+}
+
+TEST_P(ChildProcessSecurityPolicyTest, Idea02InvalidSecurityStateAndLockDenied) {
+  Idea02ObserveFeatures("default_", true, true);
+  auto* policy = ChildProcessSecurityPolicyImpl::GetInstance();
+  const auto origin = url::Origin::Create(Idea02UrlA());
+  using AccessType = ChildProcessSecurityPolicyImpl::AccessType;
+  EXPECT_FALSE(policy->CanAccessOrigin(kRendererID, origin,
+                                      AccessType::kCanCommitNewOrigin));
+  EXPECT_FALSE(policy->CanAccessDataForOrigin(kRendererID, origin));
+  EXPECT_FALSE(policy->HostsOrigin(kRendererID, origin));
+  {
+    Idea02ScopedPolicyProcess process(browser_context(),
+                                      /*assign_valid_lock=*/false);
+    ASSERT_TRUE(policy->GetProcessLock(kRendererProcess).is_invalid());
+    EXPECT_FALSE(policy->CanAccessOrigin(kRendererID, origin,
+                                        AccessType::kCanCommitNewOrigin));
+    EXPECT_FALSE(policy->CanAccessDataForOrigin(kRendererID, origin));
+    EXPECT_FALSE(policy->HostsOrigin(kRendererID, origin));
+  }
+  EXPECT_TRUE(policy->GetProcessLock(kRendererProcess).is_invalid());
+  EXPECT_FALSE(policy->CanAccessDataForOrigin(kRendererID, origin));
+}
