+
+std::optional<RendererProbeKey> RendererKey(
+    const std::vector<std::string>& argv,
+    const base::FileHandleMappingVector& mapping) {
+  RendererProbeKey result;
+  for (const auto& arg : argv) {
+    // These carry per-process diagnostics/identity, not V8 configuration.
+    // Keep all unknown switches conservatively in the compatibility key.
+    if (arg.starts_with("--renderer-client-id=") ||
+        arg.starts_with("--launch-time-ticks=") ||
+        arg.starts_with("--trace-process-track-uuid=") ||
+        arg.starts_with("--metrics-shmem-handle="))
+      continue;
+    result.argv.push_back(arg);
+  }
+  bool found = false;
+  for (const auto& [fd, key] : mapping) {
+    if (key != kFieldTrialDescriptor) continue;
+    if (found) return std::nullopt;
+    found = true;
+    struct stat info;
+    if (fstat(fd, &info) || info.st_size < 0 || info.st_size > 4*1024*1024)
+      return std::nullopt;
+    result.field_trials.resize(info.st_size);
+    if (HANDLE_EINTR(pread(fd, result.field_trials.data(),
+                          result.field_trials.size(), 0)) != info.st_size)
+      return std::nullopt;
+  }
+  if (!found) return std::nullopt;
+  return result;
+}
 
