+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CONTENT_RENDERER_RENDERER_CONNECTION_CONTROL_H_
+#define CONTENT_RENDERER_RENDERER_CONNECTION_CONTROL_H_
+
+#include <memory>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/unguessable_token.h"
+#include "content/common/content_export.h"
+#include "content/common/renderer_connection_control.mojom.h"
+#include "mojo/public/cpp/bindings/receiver_set.h"
+
+namespace content {
+class RendererBrowserConnection;
+
+// One state machine per physical renderer, shared by every control receiver.
+// Owns successive logical connections while every old broker stays retired.
+class CONTENT_EXPORT RendererConnectionControl final
+    : public mojom::RendererConnectionControl {
+ public:
+  using RetireCallback =
+      base::RepeatingCallback<void(base::OnceCallback<void(bool)>)>;
+  using CreateConnectionCallback =
+      base::RepeatingCallback<std::unique_ptr<RendererBrowserConnection>(
+          mojom::RendererConnectionBootstrapPtr)>;
+  RendererConnectionControl(
+      std::unique_ptr<RendererBrowserConnection> connection,
+      RetireCallback retire,
+      CreateConnectionCallback create_connection = {});
+  RendererBrowserConnection& GetConnection() const;
+  void SetConfiguration(
+      mojom::RendererConnectionConfigurationPtr configuration);
+  bool MatchesConfiguration(
+      const mojom::RendererConnectionConfiguration& configuration) const;
+  ~RendererConnectionControl() override;
+  void Bind(mojo::PendingReceiver<mojom::RendererConnectionControl> receiver);
+  void Inspect(InspectCallback callback) override;
+  void PrepareDetach(const base::UnguessableToken& expected_identity,
+                     PrepareDetachCallback callback) override;
+  void Detach(const base::UnguessableToken& expected_identity,
+              DetachCallback callback) override;
+  void Attach(const base::UnguessableToken& expected_identity,
+              mojom::RendererConnectionBootstrapPtr bootstrap,
+              AttachCallback callback) override;
+
+ private:
+  mojom::RendererConnectionStatePtr State() const;
+  void DidRetire(PrepareDetachCallback callback, bool retired);
+
+  std::unique_ptr<RendererBrowserConnection> connection_;
+  base::UnguessableToken identity_;
+  const RetireCallback retire_;
+  const CreateConnectionCallback create_connection_;
+  mojom::RendererConnectionConfigurationPtr configuration_;
+  mojom::RendererConnectionPhase phase_ =
+      mojom::RendererConnectionPhase::kActive;
+  mojo::ReceiverSet<mojom::RendererConnectionControl> receivers_;
+  base::WeakPtrFactory<RendererConnectionControl> weak_factory_{this};
+};
+}  // namespace content
+#endif  // CONTENT_RENDERER_RENDERER_CONNECTION_CONTROL_H_
diff --git 1/content/renderer/renderer_worker_service_context.cc 2/content/renderer/renderer_worker_service_context.cc
new file mode 100644
index 0000000000..190a466927
--- /dev/null
+++ 2/content/renderer/renderer_worker_service_context.cc
@@ -0,0 +1,146 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/renderer/renderer_worker_service_context.h"
+
+#include <limits>
+#include <utility>
+
+#include "base/check.h"
+#include "base/check_op.h"
+#include "base/functional/bind.h"
+#include "third_party/blink/public/common/thread_safe_browser_interface_broker_proxy.h"
+
+namespace content {
+
+RendererWorkerServiceContext::RendererWorkerServiceContext(
+    scoped_refptr<blink::ThreadSafeBrowserInterfaceBrokerProxy> original_broker)
+    : original_broker_(std::move(original_broker)) {
+  CHECK(original_broker_);
+}
+
+RendererWorkerServiceContext::~RendererWorkerServiceContext() = default;
+
+scoped_refptr<blink::ThreadSafeBrowserInterfaceBrokerProxy>
+RendererWorkerServiceContext::GetOriginalBrowserInterfaceBroker() const {
+  return original_broker_;
+}
+
+bool RendererWorkerServiceContext::Initialize(
+    const std::vector<std::string>& cors_exempt_header_list) {
+  scoped_refptr<RendererWorkerServiceContext> keep_alive =
+      base::WrapRefCounted(this);
+  std::vector<base::OnceClosure> initialization_callbacks;
+  {
+    base::AutoLock lock(lock_);
+    if (retired_) {
+      return false;
+    }
+    CHECK(!cors_exempt_header_list_.has_value());
+    cors_exempt_header_list_ = cors_exempt_header_list;
+    initialization_callbacks.swap(pending_initialization_callbacks_);
+  }
+  for (auto& initialization_callback : initialization_callbacks) {
+    std::move(initialization_callback).Run();
+  }
+  return true;
+}
+
+std::optional<std::vector<std::string>>
+RendererWorkerServiceContext::GetCorsExemptHeaderList() const {
+  base::AutoLock lock(lock_);
+  if (retired_) {
+    return std::nullopt;
+  }
+  return cors_exempt_header_list_;
+}
+
+bool RendererWorkerServiceContext::IsRetired() const {
+  base::AutoLock lock(lock_);
+  return retired_;
+}
+
+void RendererWorkerServiceContext::RunWhenInitialized(
+    base::OnceClosure callback) {
+  CHECK(callback);
+  scoped_refptr<RendererWorkerServiceContext> keep_alive =
+      base::WrapRefCounted(this);
+  bool run_callback = false;
+  {
+    base::AutoLock lock(lock_);
+    if (!retired_ && !cors_exempt_header_list_) {
+      pending_initialization_callbacks_.push_back(std::move(callback));
+      return;
+    }
+    run_callback = !retired_;
+  }
+  if (run_callback) {
+    std::move(callback).Run();
+  } else {
+    callback.Reset();
+  }
+}
+
+std::optional<base::ScopedClosureRunner>
+RendererWorkerServiceContext::RegisterService(
+    base::OnceClosure retirement_callback) {
+  CHECK(retirement_callback);
+  uint64_t service_identifier;
+  {
+    base::AutoLock lock(lock_);
+    if (retired_) {
+      return std::nullopt;
+    }
+    CHECK_LT(next_service_identifier_, std::numeric_limits<uint64_t>::max());
+    service_identifier = next_service_identifier_++;
+    services_.emplace(service_identifier, std::move(retirement_callback));
+  }
+  return base::ScopedClosureRunner(
+      base::BindOnce(&RendererWorkerServiceContext::UnregisterService,
+                     base::WrapRefCounted(this), service_identifier));
+}
+
+void RendererWorkerServiceContext::Retire() {
+  scoped_refptr<RendererWorkerServiceContext> keep_alive =
+      base::WrapRefCounted(this);
+  std::vector<base::OnceClosure> retirement_callbacks;
+  std::vector<base::OnceClosure> initialization_callbacks;
+  {
+    base::AutoLock lock(lock_);
+    if (retired_) {
+      return;
+    }
+    retired_ = true;
+    initialization_callbacks.swap(pending_initialization_callbacks_);
+    retirement_callbacks.reserve(services_.size());
+    for (auto& [service_identifier, retirement_callback] : services_) {
+      retirement_callbacks.push_back(std::move(retirement_callback));
+    }
+  }
+  // Waiting receiver captures can query the context or release registrations
+  // during destruction, so release them only after dropping the lock.
+  initialization_callbacks.clear();
+  for (auto& retirement_callback : retirement_callbacks) {
+    std::move(retirement_callback).Run();
+  }
+}
+
+bool RendererWorkerServiceContext::IsRetirementComplete() const {
+  base::AutoLock lock(lock_);
+  return retired_ && services_.empty();
+}
+
+void RendererWorkerServiceContext::UnregisterService(
+    uint64_t service_identifier) {
+  std::map<uint64_t, base::OnceClosure>::node_type service;
+  {
+    base::AutoLock lock(lock_);
+    service = services_.extract(service_identifier);
+    CHECK(!service.empty());
+  }
+  // Destroy callback captures outside the lock: their destructors can release
+  // other registrations or query this context while a service is torn down.
+}
+
+}  // namespace content
