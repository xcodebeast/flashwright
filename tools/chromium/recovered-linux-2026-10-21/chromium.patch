+  StrictMock<MockRendererMemoryCoordinator> child_coordinator;
+  mojo::Receiver<mojom::ChildMemoryCoordinator> coordinator_receiver(
+      &child_coordinator);
+  auto registration = browser_coordinator_.BindForRendererProcess(
+      child_process_id, registry_remote.BindNewPipeAndPassReceiver());
+  RegisterConsumer(child_process_id, registry_remote, coordinator_receiver);
+
+  base::test::TestFuture<void> coordinator_disconnected;
+  coordinator_receiver.set_disconnect_handler(
+      coordinator_disconnected.GetCallback());
+  EXPECT_CALL(observer_, OnConsumerGroupRemoved(ConsumerId(), child_process_id))
+      .WillOnce([&](uint32_t, ChildProcessId) { registration.RunAndReset(); });
+
+  registry_remote.reset();
+  EXPECT_TRUE(coordinator_disconnected.Wait());
+  EXPECT_FALSE(registration);
+}
+
+}  // namespace
+}  // namespace content
