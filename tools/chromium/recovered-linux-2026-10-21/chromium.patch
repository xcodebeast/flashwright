+TEST_P(ChildProcessSecurityPolicyTest, Idea02CommittedOriginMismatchDefault) {
+  Idea02ObserveFeatures("default_", true, true);
+  Idea02ScopedPolicyProcess process(browser_context());
+  auto* policy = process.policy();
+  process.LockTo(Idea02UrlA());
+  ASSERT_TRUE(policy->GetProcessLock(kRendererProcess).IsLockedToSite());
+  const auto origin_a = url::Origin::Create(Idea02UrlA());
+  const auto origin_b = url::Origin::Create(Idea02UrlB());
+  EXPECT_FALSE(policy->CanAccessDataForOrigin(kRendererID, origin_a));
+  policy->AddCommittedOrigin(kRendererID, origin_a);
+  EXPECT_TRUE(policy->CanAccessDataForOrigin(kRendererID, origin_a));
+  EXPECT_TRUE(policy->HostsOrigin(kRendererID, origin_a));
+  EXPECT_FALSE(policy->CanAccessDataForOrigin(kRendererID, origin_b));
+  EXPECT_FALSE(policy->HostsOrigin(kRendererID, origin_b));
+}
+
+TEST_P(ChildProcessSecurityPolicyTest, Idea02RoleDataGuardsAcrossFeatureModes) {
+  for (int mode : std::array{0, 1, 2}) {
+    SCOPED_TRACE(mode);
+    base::test::ScopedFeatureList feature_list;
+    Idea02ConfigureFallback(mode, feature_list);
+    Idea02ObserveFeatures("role_mode_" + std::to_string(mode) + "_",
+                          mode != 2, mode != 1);
+    for (bool pdf : std::array{false, true}) {
+      SCOPED_TRACE(pdf);
+      Idea02ScopedPolicyProcess process(browser_context());
+      auto* policy = process.policy();
+      UrlInfoInit init(Idea02UrlA());
+      init.WithStoragePartitionConfig(
+          StoragePartitionConfig::CreateDefault(browser_context()));
+      if (pdf) {
+        init.WithIsPdf(true);
+      } else {
+        init.WithSandbox(true);
+      }
+      policy->LockProcess(process.context(), kRendererProcess,
+                          /*is_process_used=*/false,
+                          ProcessLock::FromSiteInfo(
+                              SiteInfo::Create(process.context(), UrlInfo(init))));
+      const ProcessLock lock = policy->GetProcessLock(kRendererProcess);
+      ASSERT_TRUE(lock.IsLockedToSite());
+      ASSERT_EQ(pdf, lock.is_pdf());
+      ASSERT_EQ(!pdf, lock.is_sandboxed());
+      const auto origin_a = url::Origin::Create(Idea02UrlA());
+      const auto origin_b = url::Origin::Create(Idea02UrlB());
+      if (mode != 2) {
+        policy->AddCommittedOrigin(kRendererID, origin_a);
+      }
+      EXPECT_FALSE(policy->CanAccessDataForOrigin(kRendererID, origin_a));
+      EXPECT_FALSE(policy->CanAccessDataForOrigin(kRendererID, origin_b));
+      if (!pdf) {
+        EXPECT_FALSE(policy->HostsOrigin(kRendererID, origin_a));
+      }
+    }
+  }
+}
