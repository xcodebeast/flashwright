+namespace {
+const char kFlashwrightTransferState[] = "flashwright-transfer-state";
+class FlashwrightTransferState final : public base::SupportsUserData::Data {
+ public:
+  FlashwrightTransferState();
+  ~FlashwrightTransferState() override;
+  bool transferred = false;
+  bool adopted = false;
+};
+FlashwrightTransferState::FlashwrightTransferState() = default;
+FlashwrightTransferState::~FlashwrightTransferState() = default;
+
+const char kFlashwrightAdoptedHostReservation[] =
+    "flashwright-adopted-host-reservation";
+class FlashwrightAdoptedHostReservation final
+    : public base::SupportsUserData::Data {
+ public:
+  explicit FlashwrightAdoptedHostReservation(
+      base::WeakPtr<RenderProcessHostImpl> host);
+  ~FlashwrightAdoptedHostReservation() override;
+  base::WeakPtr<RenderProcessHostImpl> host;
+};
+FlashwrightAdoptedHostReservation::FlashwrightAdoptedHostReservation(
+    base::WeakPtr<RenderProcessHostImpl> host)
+    : host(std::move(host)) {}
+FlashwrightAdoptedHostReservation::~FlashwrightAdoptedHostReservation() =
+    default;
+}  // namespace
+
+RenderProcessHost* RendererConnectionDiagnostic::TakeAdoptedHost(
+    SiteInstanceImpl& site) {
+  auto* context = site.GetBrowserContext();
+  auto* reservation = static_cast<FlashwrightAdoptedHostReservation*>(
+      context->GetUserData(kFlashwrightAdoptedHostReservation));
+  if (!reservation) {
+    return nullptr;
+  }
+  auto candidate = reservation->host;
+  if (candidate && !candidate->IsReady()) {
+    return nullptr;
+  }
+  // One normal allocation consumes this opportunity. An incompatible request
+  // falls through to Chromium's ordinary spare/new-process selection.
+  context->RemoveUserData(kFlashwrightAdoptedHostReservation);
+  if (!candidate || !IsAdopted(*candidate) ||
+      candidate->GetBrowserContext() != context ||
+      !candidate->renderer_process_owner_ ||
+      !candidate->renderer_process_owner_->CanTransferPhysicalCustody() ||
+      candidate->AreRefCountsDisabled() || candidate->shutdown_requested_ ||
+      candidate->fast_shutdown_started_ || candidate->deleting_soon_ ||
+      candidate->within_process_died_observer_ ||
+      !candidate->listeners_.IsEmpty() ||
+      candidate->GetRenderFrameHostCount() || candidate->pending_views_ ||
+      candidate->keep_alive_ref_count_ || candidate->worker_ref_count_ ||
+      candidate->shutdown_delay_ref_count_ ||
+      candidate->navigation_state_keepalive_count_ ||
+      candidate->pending_reuse_ref_count_ != 1 ||
+      !AgentSchedulingGroupHost::CanRebindBrowserConnection(*candidate) ||
+      !RenderProcessHostImpl::MayReuseAndIsSuitable(candidate.get(), &site)) {
+    return nullptr;
+  }
+  return candidate.get();
+}
+
+bool RendererConnectionDiagnostic::IsTransferred(
+    const RenderProcessHostImpl& host) {
+  auto* state = static_cast<FlashwrightTransferState*>(
+      host.GetUserData(kFlashwrightTransferState));
+  return state && state->transferred;
+}
+
+bool RendererConnectionDiagnostic::IsAdopted(
+    const RenderProcessHostImpl& host) {
+  auto* state = static_cast<FlashwrightTransferState*>(
+      host.GetUserData(kFlashwrightTransferState));
+  return state && state->adopted;
+}
+
+void RendererConnectionDiagnostic::ClearAdoption(RenderProcessHostImpl& host) {
+  host.RemoveUserData(kFlashwrightTransferState);
+}
+
+bool RendererConnectionDiagnostic::CommitAdoption(
+    RenderProcessHostImpl& successor) {
+  auto* original = host_.get();
+  if (!original || !original->GetProcess().IsValid() ||
+      original->GetProcess().Pid() != process_id_ ||
+      !original->renderer_process_owner_ ||
+      !original->renderer_process_owner_->CanTransferPhysicalCustody() ||
+      !original->sent_render_process_ready_ || original->shutdown_requested_ ||
+      original->fast_shutdown_started_ ||
+      original->within_process_died_observer_ || original->deleting_soon_ ||
+      !original->listeners_.IsEmpty() || original->GetRenderFrameHostCount() ||
+      original->pending_views_ || original->keep_alive_ref_count_ ||
+      original->worker_ref_count_ || original->shutdown_delay_ref_count_ ||
+      original->navigation_state_keepalive_count_ ||
+      original->pending_reuse_ref_count_ != 1 ||
+      !AgentSchedulingGroupHost::CanRebindBrowserConnection(*original) ||
+      successor.is_initialized_ || successor.renderer_process_owner_ ||
+      successor.AreRefCountsDisabled() || successor.deleting_soon_ ||
+      !successor.GetBrowserContext() ||
+      successor.GetBrowserContext()->ShutdownStarted() ||
+      !successor.listeners_.IsEmpty() || successor.GetRenderFrameHostCount() ||
+      successor.pending_views_ || successor.keep_alive_ref_count_ ||
+      successor.worker_ref_count_ || successor.shutdown_delay_ref_count_ ||
+      successor.navigation_state_keepalive_count_ ||
+      successor.pending_reuse_ref_count_ != 1 ||
+      !AgentSchedulingGroupHost::CanRebindBrowserConnection(successor)) {
+    return false;
+  }
+  for (auto iterator = RenderProcessHost::AllHostsIterator();
+       !iterator.IsAtEnd(); iterator.Advance()) {
+    auto* other = iterator.GetCurrentValue();
+    if (other != &successor &&
+        other->GetBrowserContext() == successor.GetBrowserContext()) {
+      return false;
+    }
+  }
+  successor.ResetIPC();
+  successor.mojo_invitation_ = {};
+  successor.renderer_process_transport_.reset();
+  auto successor_lifetime = successor.instance_weak_factory_.GetWeakPtr();
+  auto original_state = std::make_unique<FlashwrightTransferState>();
+  original_state->transferred = true;
+  original->SetUserData(kFlashwrightTransferState, std::move(original_state));
+  auto successor_state = std::make_unique<FlashwrightTransferState>();
+  successor_state->adopted = true;
+  successor.SetUserData(kFlashwrightTransferState, std::move(successor_state));
+
+  original->is_dead_ = true;
+  original->flashwright_connection_admission_closed_ = true;
+  original->flashwright_connection_operation_pending_ = false;
+  owns_operation_ = false;
+  original->within_process_died_observer_ = true;
+  successor.renderer_process_owner_ =
+      std::move(original->renderer_process_owner_);
+  successor.renderer_process_transport_ =
+      std::move(original->renderer_process_transport_);
+  original->ResetIPC();
+  host_ = successor_lifetime;
+  adoption_committed_ = true;
+  owns_operation_ = true;
+  successor.renderer_process_transport_->AttachToHost(successor);
+  successor.is_initialized_ = true;
+  successor.is_dead_ = false;
+  successor.sent_process_launched_ = true;
+  successor.sent_render_process_ready_ = false;
+  successor.process_launched_time_ = original->process_launched_time_;
+  successor.last_init_time_ = base::TimeTicks::Now();
+  successor.priority_ = original->priority_;
+  // A fresh logical host cannot make a used physical process eligible for a
+  // stronger site lock. Keep Chromium's ordinary used-process restrictions.
+  successor.is_unused_ = original->is_unused_;
+  successor.GetBrowserContext()->SetUserData(
+      kFlashwrightAdoptedHostReservation,
+      std::make_unique<FlashwrightAdoptedHostReservation>(successor_lifetime));
+  successor.InitializeBrowserConnection(
+      std::move(browser_host_), std::move(worker_service_), channel_.PassPipe(),
+      /*pause_for_launch=*/false);
+
+  // This is logical retirement, never an OS-death path. The old host loses
+  // access to the process before any observer can request Cleanup or reentry.
+  ChildProcessTerminationInfo retired;
+  retired.status = base::TERMINATION_STATUS_NORMAL_TERMINATION;
+  retired.exit_code = 0;
+  for (auto& observer : original->observers_) {
+    observer.RenderProcessExited(original, retired);
+  }
+  original->within_process_died_observer_ = false;
+  if (original->delayed_cleanup_needed_) {
+    original->Cleanup();
+  }
+  if (!successor_lifetime) {
+    return false;
+  }
+  GetContentClient()->browser()->RenderProcessWillLaunch(&successor);
+  if (!successor_lifetime) {
+    return false;
+  }
+  successor.CreateMessageFilters();
+  successor.RegisterMojoInterfaces();
+  if (!successor_lifetime) {
+    return false;
+  }
