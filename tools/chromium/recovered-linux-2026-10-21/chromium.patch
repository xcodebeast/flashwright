diff --git 1/flashwright_pointer_probe/action_journal.cc 2/flashwright_pointer_probe/action_journal.cc
new file mode 100644
index 0000000000..2466d8e19d
--- /dev/null
+++ 2/flashwright_pointer_probe/action_journal.cc
@@ -0,0 +1,255 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flashwright_pointer_probe/action_journal.h"
+
+#include <limits>
+#include <utility>
+
+#include "base/check.h"
+#include "base/check_op.h"
+
+namespace flashwright::native_action {
+
+ActionJournal::Entry::Entry() = default;
+ActionJournal::Entry::~Entry() = default;
+ActionJournal::Entry::Entry(Entry&&) = default;
+
+ActionJournal::ActionJournal(size_t active_limit,
+                             size_t completed_limit,
+                             size_t work_limit)
+    : active_limit_(active_limit),
+      completed_limit_(completed_limit),
+      work_limit_(work_limit) {
+  CHECK_GT(active_limit_, 0u);
+  CHECK_GT(completed_limit_, 0u);
+  CHECK_GT(work_limit_, 0u);
+}
+ActionJournal::~ActionJournal() = default;
+
+void ActionJournal::Expire(Entry& entry, base::TimeTicks now) {
+  if (entry.outcome == Outcome::kPending && !entry.deadline.is_null() &&
+      now >= entry.deadline) {
+    entry.outcome = Outcome::kTimedOut;
+  }
+}
+
+ActionJournal::Snapshot ActionJournal::Read(const Entry& entry) {
+  return {entry.owner, entry.outcome, entry.owner_active, entry.input_started,
+          entry.work.size()};
+}
+
+ActionJournal::Entry* ActionJournal::FindActive(Id id, Owner owner) {
+  auto found = active_.find(id);
+  return found != active_.end() && found->second.owner == owner ? &found->second
+                                                                : nullptr;
+}
+
+ActionJournal::Admission ActionJournal::Admit(Id id,
+                                              Owner owner,
+                                              base::TimeTicks deadline,
+                                              base::TimeTicks now) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!id || owner.is_empty() || now.is_null()) {
+    return Admission::kInvalid;
+  }
+  if (active_.contains(id)) {
+    return Admission::kExistingActive;
+  }
+  if (completed_.contains(id)) {
+    return Admission::kExistingComplete;
+  }
+  if (id <= high_watermark_) {
+    return Admission::kStaleId;
+  }
+  if (active_.size() >= active_limit_) {
+    return Admission::kAtCapacity;
+  }
+  Entry entry;
+  entry.owner = owner;
+  entry.deadline = deadline;
+  Expire(entry, now);
+  active_.emplace(id, std::move(entry));
+  high_watermark_ = id;
+  return Admission::kAccepted;
+}
+
+std::optional<ActionJournal::Snapshot> ActionJournal::Inspect(Id id) const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (auto found = active_.find(id); found != active_.end()) {
+    return Read(found->second);
+  }
+  if (auto found = completed_.find(id); found != completed_.end()) {
+    return found->second;
+  }
+  return std::nullopt;
+}
+
+std::optional<ActionJournal::WorkToken>
+ActionJournal::Issue(Id id, Owner owner, WorkKind kind, base::TimeTicks now) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto* entry = FindActive(id, owner);
+  if (!entry || now.is_null() || !next_ticket_) {
+    return std::nullopt;
+  }
+  if (kind != WorkKind::kPrepare && kind != WorkKind::kInputSequence &&
+      kind != WorkKind::kCleanup) {
+    return std::nullopt;
+  }
+  Expire(*entry, now);
+  if (entry->work.size() >= work_limit_) {
+    return std::nullopt;
+  }
+  if (kind != WorkKind::kCleanup &&
+      (entry->outcome != Outcome::kPending || !entry->owner_active ||
+       !entry->work.empty() || entry->input_started)) {
+    return std::nullopt;
+  }
+  const uint64_t ticket = next_ticket_;
+  next_ticket_ =
+      ticket == std::numeric_limits<uint64_t>::max() ? 0 : ticket + 1;
+  entry->work.emplace(ticket, kind);
+  if (kind == WorkKind::kInputSequence) {
+    entry->input_started = true;
+  }
+  return WorkToken{session_, owner, id, ticket, kind};
+}
+
+bool ActionJournal::Settle(const WorkToken& token) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (token.session != session_) {
+    return false;
+  }
+  auto* entry = FindActive(token.operation, token.owner);
+  if (!entry) {
+    return false;
+  }
+  auto found = entry->work.find(token.ticket);
+  if (found == entry->work.end() || found->second != token.kind) {
+    return false;
+  }
+  entry->work.erase(found);
+  return true;
+}
+
+bool ActionJournal::Cancel(Id id, Owner owner, base::TimeTicks now) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto* entry = FindActive(id, owner);
+  if (!entry || now.is_null()) {
+    return false;
+  }
+  Expire(*entry, now);
+  if (entry->outcome != Outcome::kPending) {
+    return false;
+  }
+  entry->outcome = Outcome::kCancelled;
+  return true;
+}
+
+bool ActionJournal::Expire(Id id, Owner owner, base::TimeTicks now) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto* entry = FindActive(id, owner);
+  if (!entry || now.is_null() || entry->outcome != Outcome::kPending) {
+    return false;
+  }
+  Expire(*entry, now);
+  return entry->outcome == Outcome::kTimedOut;
+}
+
+bool ActionJournal::RetireOwner(Owner owner) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  bool changed = false;
+  for (auto& [id, entry] : active_) {
+    if (entry.owner == owner && entry.owner_active) {
+      entry.owner_active = false;
+      if (entry.outcome == Outcome::kPending) {
+        entry.outcome = Outcome::kOwnerGone;
+      }
+      changed = true;
+    }
+  }
+  return changed;
+}
+
+bool ActionJournal::Handoff(Id id, Owner owner, base::TimeTicks now) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto* entry = FindActive(id, owner);
+  if (!entry || now.is_null()) {
+    return false;
+  }
+  Expire(*entry, now);
+  if (entry->outcome != Outcome::kPending || !entry->input_started) {
+    return false;
+  }
+  entry->outcome = Outcome::kHandedOff;
+  return true;
+}
+
+bool ActionJournal::Finish(Id id,
+                           Owner owner,
+                           bool succeeded,
+                           base::TimeTicks now) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto* entry = FindActive(id, owner);
+  if (!entry || now.is_null()) {
+    return false;
+  }
+  Expire(*entry, now);
+  if (entry->outcome != Outcome::kPending) {
+    return false;
+  }
+  if (succeeded &&
+      (!entry->owner_active || !entry->input_started || !entry->work.empty())) {
+    return false;
+  }
+  entry->outcome = succeeded ? Outcome::kSucceeded : Outcome::kFailed;
+  return true;
+}
+
+bool ActionJournal::FinishWithoutInput(Id id,
+                                      Owner owner,
+                                      bool succeeded,
+                                      base::TimeTicks now) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto* entry = FindActive(id, owner);
+  if (!entry || now.is_null()) {
+    return false;
+  }
+  Expire(*entry, now);
+  if (entry->outcome != Outcome::kPending || !entry->owner_active ||
+      entry->input_started || !entry->work.empty()) {
+    return false;
+  }
+  entry->outcome = succeeded ? Outcome::kSucceeded : Outcome::kFailed;
+  return true;
+}
+
+bool ActionJournal::Release(Id id, Owner owner) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto found = active_.find(id);
+  if (found == active_.end() || found->second.owner != owner ||
+      found->second.outcome == Outcome::kPending ||
+      !found->second.work.empty()) {
+    return false;
+  }
+  completed_.emplace(id, Read(found->second));
+  completed_order_.push_back(id);
+  active_.erase(found);
+  while (completed_order_.size() > completed_limit_) {
+    completed_.erase(completed_order_.front());
+    completed_order_.pop_front();
+  }
+  return true;
+}
+
+size_t ActionJournal::active_count() const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  return active_.size();
+}
+size_t ActionJournal::completed_count() const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  return completed_.size();
+}
+
+}  // namespace flashwright::native_action
diff --git 1/flashwright_pointer_probe/action_journal.h 2/flashwright_pointer_probe/action_journal.h
new file mode 100644
index 0000000000..b5949e70ca
--- /dev/null
+++ 2/flashwright_pointer_probe/action_journal.h
@@ -0,0 +1,134 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef FLASHWRIGHT_POINTER_PROBE_ACTION_JOURNAL_H_
+#define FLASHWRIGHT_POINTER_PROBE_ACTION_JOURNAL_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <map>
+#include <optional>
+
+#include "base/sequence_checker.h"
+#include "base/time/time.h"
+#include "base/unguessable_token.h"
+
+namespace flashwright::native_action {
+
+// Browser-sequence bookkeeping only. The controller must bind Owner to the
+// original document/endpoint and retain actual callbacks and cleanup resources.
+// Retiring an Owner is deliberately not evidence that its work has settled.
+class ActionJournal {
+ public:
+  using Id = uint64_t;
+  using Owner = base::UnguessableToken;
+  enum class Admission {
+    kAccepted,
+    kExistingActive,
+    kExistingComplete,
+    kStaleId,
+    kAtCapacity,
+    kInvalid,
+  };
+  enum class Outcome {
+    kPending,
+    kSucceeded,
+    kFailed,
+    kCancelled,
+    kTimedOut,
+    kOwnerGone,
+    kHandedOff,
+  };
+  enum class WorkKind { kPrepare, kInputSequence, kCleanup };
+
+  struct WorkToken {
+    base::UnguessableToken session;
+    Owner owner;
+    Id operation;
+    uint64_t ticket;
+    WorkKind kind;
+  };
+  struct Snapshot {
+    Owner owner;
+    Outcome outcome;
+    bool owner_active;
+    bool input_started;
+    size_t unsettled_work;
+  };
+
+  explicit ActionJournal(size_t active_limit = 16,
+                         size_t completed_limit = 128,
+                         size_t work_limit = 8);
+  ~ActionJournal();
+  ActionJournal(const ActionJournal&) = delete;
+  ActionJournal& operator=(const ActionJournal&) = delete;
+
+  // IDs are positive, strictly increasing within this session. Null deadline
+  // means explicitly unbounded. An accepted already-expired ID stays consumed.
+  Admission Admit(Id id,
+                  Owner owner,
+                  base::TimeTicks deadline,
+                  base::TimeTicks now);
+  std::optional<Snapshot> Inspect(Id id) const;
+
+  // Issue before submitting work. Prepare/input require a live, pending owner.
+  // Cleanup may run after logical retirement but always targets the old Owner.
+  // A ticket is custody, not proof that input reached an application.
+  std::optional<WorkToken> Issue(Id id,
+                                 Owner owner,
+                                 WorkKind kind,
+                                 base::TimeTicks now);
+  bool Settle(const WorkToken& token);
+  bool Expire(Id id, Owner owner, base::TimeTicks now);
+  bool Cancel(Id id, Owner owner, base::TimeTicks now);
+  bool RetireOwner(Owner owner);
+  // Input custody may continue after handoff. This is not semantic success;
+  // original work must still settle before Release, and cleanup stays allowed.
+  bool Handoff(Id id, Owner owner, base::TimeTicks now);
+  bool Finish(Id id, Owner owner, bool succeeded, base::TimeTicks now);
+  // Renderer checks/trial can finish without inventing an input work ticket.
+  bool FinishWithoutInput(Id id,
+                          Owner owner,
+                          bool succeeded,
+                          base::TimeTicks now);
+
+  // The controller calls Release only after finishing all semantic cleanup.
+  // This layer additionally refuses release while original work is unsettled.
+  bool Release(Id id, Owner owner);
+  size_t active_count() const;
+  size_t completed_count() const;
+
+ private:
+  struct Entry {
+    Entry();
+    ~Entry();
+    Entry(Entry&&);
+    Entry(const Entry&) = delete;
+    Entry& operator=(const Entry&) = delete;
+    Owner owner;
+    base::TimeTicks deadline;
+    Outcome outcome = Outcome::kPending;
+    bool owner_active = true;
+    bool input_started = false;
+    std::map<uint64_t, WorkKind> work;
+  };
+  static void Expire(Entry& entry, base::TimeTicks now);
+  static Snapshot Read(const Entry& entry);
+  Entry* FindActive(Id id, Owner owner);
+
+  const base::UnguessableToken session_ = base::UnguessableToken::Create();
+  const size_t active_limit_;
+  const size_t completed_limit_;
+  const size_t work_limit_;
+  Id high_watermark_ = 0;
+  uint64_t next_ticket_ = 1;
+  std::map<Id, Entry> active_;
+  std::map<Id, Snapshot> completed_;
+  std::deque<Id> completed_order_;
+  SEQUENCE_CHECKER(sequence_checker_);
+};
+
+}  // namespace flashwright::native_action
+#endif  // FLASHWRIGHT_POINTER_PROBE_ACTION_JOURNAL_H_
diff --git 1/flashwright_pointer_probe/action_journal_test.cc 2/flashwright_pointer_probe/action_journal_test.cc
new file mode 100644
index 0000000000..6c6df9aec5
--- /dev/null
+++ 2/flashwright_pointer_probe/action_journal_test.cc
@@ -0,0 +1,459 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flashwright_pointer_probe/action_journal.h"
+
+#include <limits>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace flashwright::native_action {
+namespace {
+using Admission = ActionJournal::Admission;
+using Outcome = ActionJournal::Outcome;
+using WorkKind = ActionJournal::WorkKind;
+
+base::TimeTicks At(int milliseconds) {
+  return base::TimeTicks() + base::Milliseconds(milliseconds);
+}
+
+class ActionJournalTest : public testing::Test {
+ protected:
+  void Admit(uint64_t id, base::TimeTicks deadline = base::TimeTicks()) {
+    ASSERT_EQ(journal.Admit(id, owner, deadline, At(1)), Admission::kAccepted);
+  }
+  void CancelAndRelease(uint64_t id) {
+    ASSERT_TRUE(journal.Cancel(id, owner, At(2)));
+    ASSERT_TRUE(journal.Release(id, owner));
+  }
+  ActionJournal journal{2, 2, 3};
+  const ActionJournal::Owner owner = base::UnguessableToken::Create();
+  const ActionJournal::Owner successor = base::UnguessableToken::Create();
+};
+
+TEST_F(ActionJournalTest, InputRequiresOriginalPreparationToSettle) {
+  Admit(1);
+  auto prepare = journal.Issue(1, owner, WorkKind::kPrepare, At(2));
+  ASSERT_TRUE(prepare);
+  EXPECT_FALSE(journal.Issue(1, owner, WorkKind::kInputSequence, At(3)));
+  EXPECT_FALSE(journal.Finish(1, owner, true, At(3)));
+  EXPECT_TRUE(journal.Settle(*prepare));
+  auto input = journal.Issue(1, owner, WorkKind::kInputSequence, At(4));
+  ASSERT_TRUE(input);
+  EXPECT_FALSE(journal.Finish(1, owner, true, At(5)));
+  EXPECT_TRUE(journal.Settle(*input));
+  EXPECT_TRUE(journal.Finish(1, owner, true, At(6)));
+  EXPECT_TRUE(journal.Release(1, owner));
+  EXPECT_EQ(journal.Inspect(1)->outcome, Outcome::kSucceeded);
+}
+
+TEST_F(ActionJournalTest, DuplicateAdmissionCannotRebindOwnerOrDeadline) {
+  Admit(1, At(5));
+  EXPECT_EQ(journal.Admit(1, successor, At(1000), At(2)),
+            Admission::kExistingActive);
+  EXPECT_EQ(journal.Inspect(1)->owner, owner);
+  EXPECT_FALSE(journal.Issue(1, successor, WorkKind::kInputSequence, At(3)));
+  EXPECT_TRUE(journal.Expire(1, owner, At(5)));
+  EXPECT_EQ(journal.Inspect(1)->outcome, Outcome::kTimedOut);
+}
+
+TEST_F(ActionJournalTest, AlreadyExpiredAdmissionConsumesIdentity) {
+  Admit(1, At(1));
+  EXPECT_EQ(journal.Inspect(1)->outcome, Outcome::kTimedOut);
+  EXPECT_FALSE(journal.Issue(1, owner, WorkKind::kInputSequence, At(2)));
+  EXPECT_TRUE(journal.Release(1, owner));
+  EXPECT_EQ(journal.Admit(1, owner, At(1000), At(3)),
+            Admission::kExistingComplete);
+}
+
+TEST_F(ActionJournalTest, DeadlineBetweenPreparationAndInputSuppressesInput) {
+  Admit(1, At(5));
+  auto prepare = journal.Issue(1, owner, WorkKind::kPrepare, At(2));
+  ASSERT_TRUE(prepare);
+  EXPECT_TRUE(journal.Settle(*prepare));
+  EXPECT_FALSE(journal.Issue(1, owner, WorkKind::kInputSequence, At(5)));
+  EXPECT_FALSE(journal.Inspect(1)->input_started);
+  EXPECT_EQ(journal.Inspect(1)->outcome, Outcome::kTimedOut);
+}
+
+TEST_F(ActionJournalTest, TimeoutDoesNotSettleOutstandingPreparation) {
+  Admit(1, At(5));
+  auto prepare = journal.Issue(1, owner, WorkKind::kPrepare, At(2));
+  ASSERT_TRUE(prepare);
+  EXPECT_TRUE(journal.Expire(1, owner, At(5)));
+  EXPECT_EQ(journal.Inspect(1)->unsettled_work, 1u);
+  EXPECT_FALSE(journal.Release(1, owner));
+  EXPECT_TRUE(journal.Settle(*prepare));
+  EXPECT_TRUE(journal.Release(1, owner));
+}
+
+TEST_F(ActionJournalTest, CancellationBeforeDispatchSuppressesInput) {
+  Admit(1);
+  auto prepare = journal.Issue(1, owner, WorkKind::kPrepare, At(2));
+  ASSERT_TRUE(prepare);
+  EXPECT_TRUE(journal.Cancel(1, owner, At(3)));
+  EXPECT_TRUE(journal.Settle(*prepare));
+  EXPECT_FALSE(journal.Issue(1, owner, WorkKind::kInputSequence, At(4)));
+  EXPECT_FALSE(journal.Inspect(1)->input_started);
+  EXPECT_EQ(journal.Inspect(1)->outcome, Outcome::kCancelled);
+}
+
+TEST_F(ActionJournalTest, CancellationAfterInputRetainsDeliveryUncertainty) {
+  Admit(1);
+  auto input = journal.Issue(1, owner, WorkKind::kInputSequence, At(2));
+  ASSERT_TRUE(input);
+  EXPECT_TRUE(journal.Cancel(1, owner, At(3)));
+  EXPECT_TRUE(journal.Inspect(1)->input_started);
+  EXPECT_EQ(journal.Inspect(1)->unsettled_work, 1u);
+  EXPECT_FALSE(journal.Release(1, owner));
+  EXPECT_FALSE(journal.Issue(1, owner, WorkKind::kInputSequence, At(4)));
+  EXPECT_TRUE(journal.Settle(*input));
+  EXPECT_EQ(journal.Inspect(1)->outcome, Outcome::kCancelled);
+  EXPECT_TRUE(journal.Release(1, owner));
+}
+
+TEST_F(ActionJournalTest, RetirementDoesNotImpersonateTransportSettlement) {
+  Admit(1);
+  auto input = journal.Issue(1, owner, WorkKind::kInputSequence, At(2));
+  ASSERT_TRUE(input);
+  EXPECT_TRUE(journal.RetireOwner(owner));
+  EXPECT_EQ(journal.Inspect(1)->outcome, Outcome::kOwnerGone);
+  EXPECT_EQ(journal.Inspect(1)->unsettled_work, 1u);
+  EXPECT_FALSE(journal.Release(1, owner));
+  EXPECT_FALSE(journal.Finish(1, owner, true, At(4)));
+  EXPECT_TRUE(journal.Settle(*input));
+  EXPECT_TRUE(journal.Release(1, owner));
+}
+
+TEST_F(ActionJournalTest, OldReplyCannotSettleSuccessorWork) {
+  Admit(1);
+  auto old = journal.Issue(1, owner, WorkKind::kPrepare, At(2));
+  ASSERT_TRUE(old);
+  EXPECT_TRUE(journal.RetireOwner(owner));
+  ASSERT_EQ(journal.Admit(2, successor, {}, At(3)), Admission::kAccepted);
+  auto next = journal.Issue(2, successor, WorkKind::kPrepare, At(4));
+  ASSERT_TRUE(next);
+  auto wrong = *old;
+  wrong.operation = 2;
+  wrong.ticket = next->ticket;
+  EXPECT_FALSE(journal.Settle(wrong));
+  EXPECT_EQ(journal.Inspect(2)->unsettled_work, 1u);
+  EXPECT_TRUE(journal.Settle(*old));
+  EXPECT_TRUE(journal.Release(1, owner));
+  EXPECT_TRUE(journal.Settle(*next));
+  EXPECT_EQ(journal.Inspect(2)->outcome, Outcome::kPending);
+}
+
+TEST_F(ActionJournalTest, IdenticalTicketNumbersInOtherSessionsDoNotMatch) {
+  Admit(1);
+  ActionJournal other;
+  ASSERT_EQ(other.Admit(1, owner, {}, At(1)), Admission::kAccepted);
+  auto ours = journal.Issue(1, owner, WorkKind::kPrepare, At(2));
+  auto theirs = other.Issue(1, owner, WorkKind::kPrepare, At(2));
+  ASSERT_TRUE(ours);
+  ASSERT_TRUE(theirs);
+  ASSERT_EQ(ours->ticket, theirs->ticket);
+  EXPECT_FALSE(journal.Settle(*theirs));
+  EXPECT_EQ(journal.Inspect(1)->unsettled_work, 1u);
+  EXPECT_TRUE(journal.Settle(*ours));
+  EXPECT_TRUE(other.Settle(*theirs));
+}
+
+TEST_F(ActionJournalTest, DuplicateAndWrongKindRepliesCannotReturnExtraCredit) {
+  Admit(1);
+  auto prepare = journal.Issue(1, owner, WorkKind::kPrepare, At(2));
+  ASSERT_TRUE(prepare);
+  auto wrong = *prepare;
+  wrong.kind = WorkKind::kInputSequence;
+  EXPECT_FALSE(journal.Settle(wrong));
+  EXPECT_TRUE(journal.Settle(*prepare));
+  EXPECT_FALSE(journal.Settle(*prepare));
+  EXPECT_EQ(journal.Inspect(1)->unsettled_work, 0u);
+}
+
+TEST_F(ActionJournalTest, CleanupRetainsOriginalOwnerAfterRetirement) {
+  Admit(1);
+  auto prepare = journal.Issue(1, owner, WorkKind::kPrepare, At(2));
+  ASSERT_TRUE(prepare);
+  EXPECT_TRUE(journal.RetireOwner(owner));
+  EXPECT_FALSE(journal.Issue(1, successor, WorkKind::kCleanup, At(3)));
+  auto cleanup = journal.Issue(1, owner, WorkKind::kCleanup, At(3));
+  ASSERT_TRUE(cleanup);
+  EXPECT_FALSE(journal.Release(1, owner));
+  EXPECT_TRUE(journal.Settle(*cleanup));
+  EXPECT_FALSE(journal.Release(1, owner));
