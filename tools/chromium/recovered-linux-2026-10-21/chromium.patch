+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef FLASHWRIGHT_POINTER_PROBE_POINTER_SEQUENCE_H_
+#define FLASHWRIGHT_POINTER_PROBE_POINTER_SEQUENCE_H_
+
+#include <algorithm>
+#include <bitset>
+#include "base/check.h"
+
+namespace flashwright::native_action {
+// Forwarding is ordered; acknowledgements may be synchronous or reordered.
+// Both the forward-return boundary and every original ACK retain custody.
+class PointerSequence {
+ public:
+  explicit PointerSequence(int total) : total_(total) {
+    CHECK(total > 0 && total <= 201);
+  }
+  bool CanIssue() const {
+    return !stopped_ && route_ == -1 && issued_ < total_;
+  }
+  int Issue() {
+    CHECK(CanIssue());
+    route_ = issued_++;
+    ++pending_;
+    return route_;
+  }
+  void Forwarded(int step, bool forwarded) {
+    CHECK(route_ == step);
+    route_ = -1;
+    if (!forwarded) {
+      Stop();
+      return;
+    }
+    ++forwarded_;
+    if (step > 0 && step % 2 == 1)
+      last_press_ = step;
+  }
+  void Acknowledge(int step, bool acknowledged) {
+    CHECK(step >= 0 && step < issued_ && !acknowledged_.test(step));
+    acknowledged_.set(step);
+    CHECK(pending_ > 0);
+    --pending_;
+    if (!acknowledged) {
+      Stop();
+    } else if (step > 0 && step % 2 == 0) {
+      last_release_ = std::max(last_release_, step);
+    }
+  }
+  void Stop() { stopped_ = true; }
+  bool Pending() const { return route_ != -1 || pending_ != 0; }
+  bool Complete() const {
+    return !stopped_ && forwarded_ == total_ && !Pending();
+  }
+  bool Pressed() const { return last_press_ > last_release_; }
+
+ private:
+  const int total_;
+  int issued_ = 0;
+  int forwarded_ = 0;
+  int route_ = -1;
+  int pending_ = 0;
+  int last_press_ = -1;
+  int last_release_ = -1;
+  bool stopped_ = false;
+  std::bitset<201> acknowledged_;
+};
+}  // namespace flashwright::native_action
+#endif
diff --git 1/flashwright_pointer_probe/pointer_sequence_test.cc 2/flashwright_pointer_probe/pointer_sequence_test.cc
