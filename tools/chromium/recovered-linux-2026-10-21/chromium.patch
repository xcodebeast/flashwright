+
+namespace content {
+class RenderProcessHost;
+class RenderProcessHostImpl;
+class RendererProcessTransport;
+class SiteInstanceImpl;
+
+// Private diagnostic only. Each operation binds through the physical process
+// pipe and retains the exact logical host weak identity across async replies.
+class RendererConnectionDiagnostic
+    : public base::RefCounted<RendererConnectionDiagnostic> {
+ public:
+  using Callback =
+      base::OnceCallback<void(bool, mojom::RendererConnectionStatePtr)>;
+  using ReplyInterceptor = base::OnceCallback<void(base::OnceClosure)>;
+  RendererConnectionDiagnostic(RenderProcessHostImpl& host, Callback callback);
+  static RenderProcessHost* TakeAdoptedHost(SiteInstanceImpl& site);
+  static bool IsTransferred(const RenderProcessHostImpl& host);
+  static bool IsAdopted(const RenderProcessHostImpl& host);
+  static void ClearAdoption(RenderProcessHostImpl& host);
+  static void Run(RenderProcessHost& host,
+                  const std::string& action,
+                  Callback callback,
+                  ReplyInterceptor reply_interceptor = {});
+
+ private:
+  friend class base::RefCounted<RendererConnectionDiagnostic>;
+  ~RendererConnectionDiagnostic();
+  void DidInspect(const std::string& action,
+                  mojom::RendererConnectionStatePtr state);
+  void BeginAdopt(const std::string& context_id,
+                  mojom::RendererConnectionStatePtr state);
+  bool CommitAdoption(RenderProcessHostImpl& successor);
+  void ReleaseSuccessorHold();
+  void BeginAttach(bool incompatible, mojom::RendererConnectionStatePtr state);
+  void DidAttach(bool accepted, mojom::RendererConnectionStatePtr state);
+  void ContinueAttach(bool accepted, mojom::RendererConnectionStatePtr state);
+  void DidInitialize(mojom::RendererConnectionStatePtr state,
+                     mojom::FlashwrightRendererStatePtr initialized);
+  void ContinueInitialize(mojom::RendererConnectionStatePtr state,
+                          mojom::FlashwrightRendererStatePtr initialized);
+  void Finish(bool accepted, mojom::RendererConnectionStatePtr state);
+
+  base::WeakPtr<RenderProcessHostImpl> host_;
+  int successor_host_id_ = -1;
+  bool owns_successor_hold_ = false;
+  bool adoption_committed_ = false;
+  scoped_refptr<RendererProcessTransport> dispatched_adoption_transport_;
+  const base::ProcessId process_id_;
+  Callback callback_;
+  enum class HeldReplyStage { kNone, kAttach, kInitialize };
+  HeldReplyStage held_reply_stage_ = HeldReplyStage::kNone;
+  ReplyInterceptor reply_interceptor_;
+  bool owns_operation_ = false;
+  mojo::Remote<mojom::RendererConnectionControl> remote_;
+  base::OneShotTimer deadline_;
+  mojo::PendingRemote<IPC::mojom::ChannelBootstrap> channel_;
+  mojo::PendingReceiver<mojom::ChildProcessHost> browser_host_;
+  mojo::PendingRemote<mojom::RendererWorkerService> worker_service_;
+};
+
+}  // namespace content
+#endif  // CONTENT_BROWSER_RENDERER_HOST_RENDERER_CONNECTION_DIAGNOSTIC_H_
