+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CONTENT_RENDERER_RENDERER_WORKER_SERVICE_DISPATCHER_H_
+#define CONTENT_RENDERER_RENDERER_WORKER_SERVICE_DISPATCHER_H_
+
+#include <optional>
+
+#include "base/functional/callback_helpers.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/sequence_checker.h"
+#include "content/common/content_export.h"
+#include "content/common/renderer_worker_service.mojom.h"
+#include "mojo/public/cpp/bindings/binder_map.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+
+namespace content {
+
+class RendererWorkerServiceContext;
+
+// Dispatches one logical browser connection's worker requests on renderer IO.
+// Every binder retains its original service context and dispatch task runner.
+class CONTENT_EXPORT RendererWorkerServiceDispatcher final
+    : public mojom::RendererWorkerService {
+ public:
+  RendererWorkerServiceDispatcher(
+      scoped_refptr<RendererWorkerServiceContext> service_context,
+      mojo::BinderMap binders,
+      mojo::PendingReceiver<mojom::RendererWorkerService> receiver);
+  ~RendererWorkerServiceDispatcher() override;
+
+  RendererWorkerServiceDispatcher(const RendererWorkerServiceDispatcher&) =
+      delete;
+  RendererWorkerServiceDispatcher& operator=(
+      const RendererWorkerServiceDispatcher&) = delete;
+
+  void BindReceiver(mojo::GenericPendingReceiver receiver) override;
+
+  // Releases the pipe and binder captures before finishing this exact context's
+  // registration. Repeated retirement or disconnect notifications are harmless.
+  void Close();
+
+ private:
+  void OnDisconnected();
+
+  SEQUENCE_CHECKER(sequence_checker_);
+  const scoped_refptr<RendererWorkerServiceContext> service_context_;
+  // Declaration order also keeps registration alive through member teardown.
+  std::optional<base::ScopedClosureRunner> service_registration_;
+  mojo::BinderMap binders_;
+  mojo::Receiver<mojom::RendererWorkerService> receiver_{this};
+  base::WeakPtrFactory<RendererWorkerServiceDispatcher> weak_factory_{this};
+};
+
+}  // namespace content
+
+#endif  // CONTENT_RENDERER_RENDERER_WORKER_SERVICE_DISPATCHER_H_
