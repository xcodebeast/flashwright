+TEST_F(ResourceCacheOwnerTest, ServiceWorkerPartitionsRetainBrokerOwner) {
+  auto original_broker = CreateBroker();
+  auto successor_broker = CreateBroker();
+  platform_->SelectBroker(original_broker);
+  auto* first_properties =
+      MakeGarbageCollected<TestResourceFetcherProperties>();
+  first_properties->SetControllerServiceWorkerMode(
+      mojom::ControllerServiceWorkerMode::kControlled);
+  first_properties->SetServiceWorkerId(41);
+  auto* first_fetcher = CreateFetcher(*first_properties);
+  auto* second_properties =
+      MakeGarbageCollected<TestResourceFetcherProperties>();
+  second_properties->SetControllerServiceWorkerMode(
+      mojom::ControllerServiceWorkerMode::kControlled);
+  second_properties->SetServiceWorkerId(42);
+  auto* second_fetcher = CreateFetcher(*second_properties);
+  auto* default_fetcher = CreateFetcher();
+
+  auto* first_resource = FetchStaticImage(first_fetcher);
+  auto* second_resource = FetchStaticImage(second_fetcher);
+  auto* skipped_resource = FetchStaticImage(first_fetcher, true);
+  auto* default_resource = FetchStaticImage(default_fetcher);
+  ExpectLoadedImage(first_resource);
+  ExpectLoadedImage(second_resource);
+  ExpectLoadedImage(skipped_resource);
+  ExpectLoadedImage(default_resource);
+  ASSERT_TRUE(first_resource);
+  ASSERT_TRUE(second_resource);
+  ASSERT_TRUE(skipped_resource);
+  EXPECT_NE(first_resource, second_resource);
+  EXPECT_NE(first_resource, skipped_resource);
+  EXPECT_EQ(skipped_resource, default_resource);
+  EXPECT_EQ(skipped_resource, FetchStaticImage(second_fetcher, true));
+  EXPECT_EQ(
+      ResourceCacheIdentifierForOwner(*original_broker, String::Number(41)),
+      first_resource->CacheIdentifier());
+  EXPECT_EQ(ResourceCacheIdentifierForOwner(
+                *original_broker, MemoryCache::DefaultCacheIdentifier()),
+            skipped_resource->CacheIdentifier());
+
+  platform_->SelectBroker(successor_broker);
+  auto* successor_fetcher = CreateFetcher(*first_properties);
+  auto* successor_resource = FetchStaticImage(successor_fetcher);
+  ExpectLoadedImage(successor_resource);
+  ASSERT_TRUE(successor_resource);
+  EXPECT_NE(first_resource, successor_resource);
+  EXPECT_NE(first_resource->CacheIdentifier(),
+            successor_resource->CacheIdentifier());
+  EXPECT_EQ(
+      ResourceCacheIdentifierForOwner(*successor_broker, String::Number(41)),
+      successor_resource->CacheIdentifier());
+}
+
+}  // namespace
