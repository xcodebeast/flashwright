+
+#ifndef CONTENT_RENDERER_FRAME_ROUTING_INFO_PROVIDER_H_
+#define CONTENT_RENDERER_FRAME_ROUTING_INFO_PROVIDER_H_
+
+#include <deque>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "content/common/content_export.h"
+#include "content/common/render_message_filter.mojom.h"
+#include "mojo/public/cpp/bindings/remote.h"
+
+namespace blink {
+class ThreadSafeBrowserInterfaceBrokerProxy;
+}
+
+namespace content {
+
+// Allocates frame identities from one original browser host. Cache refills and
+// their replies stay with this provider even when another provider is created.
+class CONTENT_EXPORT FrameRoutingInfoProvider {
+ public:
+  FrameRoutingInfoProvider(
+      scoped_refptr<blink::ThreadSafeBrowserInterfaceBrokerProxy>
+          original_process_broker,
+      bool use_cache);
+  ~FrameRoutingInfoProvider();
+
+  FrameRoutingInfoProvider(const FrameRoutingInfoProvider&) = delete;
+  FrameRoutingInfoProvider& operator=(const FrameRoutingInfoProvider&) = delete;
+
+  mojom::FrameRoutingInfoPtr GenerateFrameRoutingInfo();
+  // A retained group cannot allocate identities after its connection dies.
+  base::RepeatingCallback<mojom::FrameRoutingInfoPtr()>
+  GetRoutingInformationCallback();
+  void FlushForTesting();
+
+ private:
+  mojom::RenderMessageFilter* GetMessageFilter();
+  void RequestCacheRefill();
+  void PopulateCache(
+      std::vector<mojom::FrameRoutingInfoPtr> routing_information_batch);
+
+  const scoped_refptr<blink::ThreadSafeBrowserInterfaceBrokerProxy>
+      original_process_broker_;
+  const bool use_cache_;
+  mojo::Remote<mojom::RenderMessageFilter> message_filter_;
+  std::deque<mojom::FrameRoutingInfoPtr> cached_routing_information_;
+  bool refill_pending_ = false;
+  base::WeakPtrFactory<FrameRoutingInfoProvider> weak_factory_{this};
+};
+
+}  // namespace content
+
+#endif  // CONTENT_RENDERER_FRAME_ROUTING_INFO_PROVIDER_H_
