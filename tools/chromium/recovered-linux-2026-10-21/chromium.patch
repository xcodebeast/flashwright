+void RenderThreadImpl::GetFlashwrightRendererState(
+    GetFlashwrightRendererStateCallback callback) {
+  class FrameCounter final : public RenderFrameVisitor {
+   public:
+    bool Visit(RenderFrame* frame) override {
+      ++count;
+      return true;
+    }
+    uint32_t count = 0;
+  } frame_counter;
+  RenderFrame::ForEach(&frame_counter);
+  auto state = mojom::FlashwrightRendererState::New();
+  state->frames = frame_counter.count;
+  state->views = static_cast<uint32_t>(blink::WebView::GetWebViewCount());
+  state->workers = blink::FlashwrightWorkerThreadCount();
+  state->scheduling_groups = static_cast<uint32_t>(
+      connection_control_->GetConnection().SchedulingGroupCount());
+  std::move(callback).Run(std::move(state));
+}
