+  auto key = RendererKey(argv, mapping);
+  CHECK(key.has_value());
+  if (!expected->has_value()) {
+    *expected = std::move(key);
+  } else {
+    CHECK(**expected == *key) << "Renderer donor configuration changed";
+  }
+}
