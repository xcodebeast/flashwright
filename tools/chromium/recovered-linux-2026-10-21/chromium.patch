+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+module content.mojom;
+
+import "mojo/public/mojom/base/unguessable_token.mojom";
+import "content/common/child_process.mojom";
+import "content/common/renderer_worker_service.mojom";
+import "ipc/ipc.mojom";
+import "third_party/blink/public/mojom/cpu_performance.mojom";
+import "third_party/blink/public/mojom/origin_trials/origin_trials_settings.mojom";
+import "third_party/blink/public/mojom/user_agent/user_agent_metadata.mojom";
+
+enum RendererConnectionPhase {
+  kActive,
+  kPreparing,
+  kPrepared,
+  kDetached,
+  kFailed,
+};
+
+struct RendererConnectionConfiguration {
+  string user_agent;
+  blink.mojom.UserAgentMetadata user_agent_metadata;
+  array<string> cors_exempt_header_list;
+  blink.mojom.OriginTrialsSettings? origin_trials_settings;
+  blink.mojom.PerformanceTier cpu_performance_tier;
+};
+
+struct RendererConnectionBootstrap {
+  int32 client_id;
+  RendererConnectionConfiguration configuration;
+  pending_receiver<IPC.mojom.ChannelBootstrap> channel;
+  pending_remote<ChildProcessHost> browser_host;
+  pending_receiver<RendererWorkerService> worker_service;
+};
+
+struct RendererConnectionState {
+  mojo_base.mojom.UnguessableToken connection_identity;
+  RendererConnectionPhase phase;
+  RendererConnectionConfiguration? configuration;
+};
+
+// Process-owned control, independent of the logical Renderer SyncChannel.
+// Successors receive fresh endpoints and must match retained configuration.
+// The first attachment implementation is restricted to the same logical host.
+interface RendererConnectionControl {
+  Inspect() => (RendererConnectionState state);
+  PrepareDetach(mojo_base.mojom.UnguessableToken expected_identity)
+      => (bool accepted, RendererConnectionState state);
+  // The browser must close its old ChannelProxy before submitting Detach.
+  Detach(mojo_base.mojom.UnguessableToken expected_identity)
+      => (bool accepted, RendererConnectionState state);
+  Attach(mojo_base.mojom.UnguessableToken expected_identity,
+         RendererConnectionBootstrap bootstrap)
+      => (bool accepted, RendererConnectionState state);
+};
