+TEST(SchedulerStateMachineTest, FlashwrightEarlyIdleDeadlineRequiresBothGates) {
+  using Deadline = SchedulerStateMachine::BeginImplFrameDeadlineMode;
+  for (bool enabled : {false, true}) {
+    for (bool uncapped : {false, true}) {
+      base::test::ScopedFeatureList features;
+      features.InitWithFeatureState(
+          ::features::kFlashwrightEarlyIdleFrameDeadline, enabled);
+      SchedulerSettings settings;
+      settings.disable_frame_rate_limit = uncapped;
+      StateMachine state(settings);
+      SET_UP_STATE(state);
+      EXPECT_EQ(Deadline::NONE, state.CurrentBeginImplFrameDeadlineMode());
+      state.SetNeedsBeginMainFrame(false);
+      state.IssueNextBeginImplFrame();
+      EXPECT_ACTION_UPDATE_STATE(
+          SchedulerStateMachine::Action::SEND_BEGIN_MAIN_FRAME);
+      EXPECT_EQ(enabled && uncapped ? Deadline::IMMEDIATE : Deadline::LATE,
+                state.CurrentBeginImplFrameDeadlineMode());
+      // Merely asking for a deadline cannot consume a pending action.
+      state.NotifyReadyToCommit();
+      EXPECT_EQ(enabled && uncapped ? Deadline::IMMEDIATE : Deadline::LATE,
+                state.CurrentBeginImplFrameDeadlineMode());
+      EXPECT_ACTION(SchedulerStateMachine::Action::COMMIT);
+      EXPECT_ACTION(SchedulerStateMachine::Action::COMMIT);
+      EXPECT_ACTION_UPDATE_STATE(SchedulerStateMachine::Action::COMMIT);
+      EXPECT_ACTION_UPDATE_STATE(SchedulerStateMachine::Action::POST_COMMIT);
+      state.NotifyReadyToActivate();
+      EXPECT_ACTION_UPDATE_STATE(
+          SchedulerStateMachine::Action::ACTIVATE_SYNC_TREE);
+      // Commit and activation remain available inside the current frame.
+      EXPECT_IMPL_FRAME_STATE(
+          SchedulerStateMachine::BeginImplFrameState::INSIDE_BEGIN_FRAME);
+      state.OnBeginImplFrameDeadline();
+      EXPECT_ACTION_UPDATE_STATE(SchedulerStateMachine::Action::DRAW_IF_POSSIBLE);
+    }
+  }
+}
+
+TEST(SchedulerStateMachineTest, FlashwrightEarlyIdleDeadlineKeepsWorkletWait) {
+  using Deadline = SchedulerStateMachine::BeginImplFrameDeadlineMode;
+  base::test::ScopedFeatureList features;
+  features.InitAndEnableFeature(::features::kFlashwrightEarlyIdleFrameDeadline);
+  SchedulerSettings settings;
+  settings.disable_frame_rate_limit = true;
+  StateMachine state(settings);
+  SET_UP_STATE(state);
+  state.SetNeedsBeginMainFrame(false);
+  state.IssueNextBeginImplFrame();
+  EXPECT_ACTION_UPDATE_STATE(SchedulerStateMachine::Action::SEND_BEGIN_MAIN_FRAME);
+  state.NotifyAnimationWorkletStateChange(
+      SchedulerStateMachine::AnimationWorkletState::PROCESSING,
+      SchedulerStateMachine::TreeType::ACTIVE);
+  EXPECT_EQ(Deadline::LATE, state.CurrentBeginImplFrameDeadlineMode());
+  state.SetNeedsRedraw(true);
+  EXPECT_EQ(Deadline::REGULAR, state.CurrentBeginImplFrameDeadlineMode());
+  state.SetNeedsRedraw(false);
+  state.NotifyAnimationWorkletStateChange(
+      SchedulerStateMachine::AnimationWorkletState::IDLE,
+      SchedulerStateMachine::TreeType::ACTIVE);
+  EXPECT_EQ(Deadline::IMMEDIATE, state.CurrentBeginImplFrameDeadlineMode());
+}
+
+TEST(SchedulerStateMachineTest, FlashwrightEarlyIdleDeadlineKeepsDemandAndHiddenState) {
