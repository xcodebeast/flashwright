+class SelectableCacheOwnerPlatform final : public FetchTestingPlatformSupport {
+ public:
+  SelectableCacheOwnerPlatform()
+      : forwarding_broker_(
+            FetchTestingPlatformSupport::GetBrowserInterfaceBroker()) {}
+
+  ThreadSafeBrowserInterfaceBrokerProxy* GetBrowserInterfaceBroker() override {
+    return selected_broker_ ? selected_broker_.get() : forwarding_broker_.get();
+  }
+
+  void SelectBroker(
+      scoped_refptr<ThreadSafeBrowserInterfaceBrokerProxy> broker) {
+    selected_broker_ = std::move(broker);
+  }
+
+  scoped_refptr<CacheOwnerTestBroker> CreateBroker(
+      scoped_refptr<base::RefCountedData<int>> destruction_count) {
+    return base::MakeRefCounted<CacheOwnerTestBroker>(forwarding_broker_,
