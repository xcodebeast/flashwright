+                *widget, *event, unused));
+            widget->ForwardFlashwrightMouseEvent(
+                *event,
+                base::BindOnce(
+                    [](base::OnceCallback<void(Response, FlashwrightMouseAck)>
+                           reply,
+                       FlashwrightMouseAck result) {
+                      std::move(reply).Run(Response::Success(), result);
+                    },
+                    std::move(reply)));
+            // May reenter or dispose the handler/widget. Touch neither after it.
+            std::move(forwarded).Run(true);
+          },
+          handler, owner, generation, std::move(admission), std::move(event),
+          std::move(reply), std::move(forwarded)));
