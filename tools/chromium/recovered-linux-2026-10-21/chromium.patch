@@ -0,0 +1,183 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef CONTENT_RENDERER_RENDERER_BROWSER_CONNECTION_H_
+#define CONTENT_RENDERER_RENDERER_BROWSER_CONNECTION_H_
+
+#include <memory>
+#include <set>
+
+#include "base/clang_profiling_buildflags.h"
+#include "base/containers/unique_ptr_adapters.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ref.h"
+#include "base/memory/scoped_refptr.h"
+#include "build/build_config.h"
+#include "content/common/content_export.h"
+#include "content/common/renderer.mojom.h"
+#include "content/common/renderer_host.mojom.h"
+#include "content/renderer/frame_routing_info_provider.h"
+#include "ipc/ipc_listener.h"
+#include "mojo/public/cpp/bindings/associated_receiver.h"
+#include "mojo/public/cpp/bindings/associated_remote.h"
+#include "mojo/public/cpp/system/message_pipe.h"
+#include "third_party/blink/public/common/associated_interfaces/associated_interface_registry.h"
+
+namespace base {
+class SingleThreadTaskRunner;
+class WaitableEvent;
+}  // namespace base
+namespace mojo {
+class BinderMap;
+}
+namespace IPC {
+class SyncChannel;
+class UrgentMessageObserver;
+}  // namespace IPC
+namespace blink {
+class ThreadSafeBrowserInterfaceBrokerProxy;
+}
+namespace content {
+class AgentSchedulingGroup;
+class RenderThread;
+class RenderThreadObserver;
+class RendererWorkerServiceContext;
+
+// One browser connection owns its broker, frame identities and scheduling
+// groups. The initial connection still shares the process lifetime. This class
+// does not admit successor connections or reset process-global configuration.
+class CONTENT_EXPORT RendererBrowserConnection final : public mojom::Renderer,
+                                                       public IPC::Listener {
+ public:
+  RendererBrowserConnection(
+      RenderThread& render_thread,
+      mojom::Renderer& physical_renderer,
+      scoped_refptr<blink::ThreadSafeBrowserInterfaceBrokerProxy>
+          original_broker,
+      mojo::PendingAssociatedRemote<mojom::RendererHost> renderer_host,
+      bool use_frame_routing_cache);
+  ~RendererBrowserConnection() override;
+  RendererBrowserConnection(const RendererBrowserConnection&) = delete;
+  RendererBrowserConnection& operator=(const RendererBrowserConnection&) =
+      delete;
+
+  void InitializeChannel(
+      mojo::ScopedMessagePipeHandle bootstrap,
+      scoped_refptr<base::SingleThreadTaskRunner> io_task_runner,
+      scoped_refptr<base::SingleThreadTaskRunner> dispatch_task_runner,
+      base::WaitableEvent* shutdown_event,
+      IPC::UrgentMessageObserver* urgent_message_observer,
+      base::RepeatingClosure channel_error_callback);
+  void InitializeWorkerServices(
+      mojo::ScopedMessagePipeHandle receiver,
+      mojo::BinderMap binders,
+      scoped_refptr<base::SingleThreadTaskRunner> io_task_runner);
+  IPC::SyncChannel* GetChannel();
+  blink::AssociatedInterfaceRegistry* GetAssociatedInterfaceRegistry();
+  blink::ThreadSafeBrowserInterfaceBrokerProxy*
+  GetOriginalBrowserInterfaceBroker() const;
+  scoped_refptr<RendererWorkerServiceContext> GetWorkerServiceContext() const;
+  // Call only after all views close. Refuses atomically if a group still
+  // retains a frame; successful retirement permanently closes document
+  // admission.
+  bool RetireDocumentAdmission();
+  // Called after document teardown, or during terminal connection destruction.
+  void RetireExecutionContextServices();
+  // Fence the old Renderer receiver only after document and service retirement.
+  // The caller must additionally complete the process-wide Blink worker fence.
+  bool PrepareForDetach();
+  // Reclaim closed documents only after process-wide worker retirement.
+  bool ReclaimRetiredDocumentMemory();
+  // Browser-side ChannelProxy teardown must precede this call. Destruction
+  // closes the channel once and leaves the physical control pipe unaffected.
+  void Detach();
+  void AddObserver(RenderThreadObserver* observer);
+  void RemoveObserver(RenderThreadObserver* observer);
+
+  void Bind(mojo::PendingAssociatedReceiver<mojom::Renderer> receiver,
+            scoped_refptr<base::SingleThreadTaskRunner> task_runner);
+  mojom::RendererHost* GetRendererHost();
+  mojom::FrameRoutingInfoPtr GenerateFrameRoutingInfo();
+  size_t SchedulingGroupCount() const;
+
+  void CreateAgentSchedulingGroup(
+      mojo::PendingReceiver<IPC::mojom::ChannelBootstrap> bootstrap) override;
+  void CreateAssociatedAgentSchedulingGroup(
+      mojo::PendingAssociatedReceiver<mojom::AgentSchedulingGroup> receiver)
+      override;
+  void GetFlashwrightRendererState(
+      GetFlashwrightRendererStateCallback callback) override;
+  void RetireFlashwrightWorkers(
+      RetireFlashwrightWorkersCallback callback) override;
+  void TransferSharedLastForegroundTime(
+      base::ReadOnlySharedMemoryRegion last_foreground_time_region) override;
+  void OnNetworkConnectionChanged(
+      net::NetworkChangeNotifier::ConnectionType type,
+      double max_bandwidth_mbps) override;
+  void OnNetworkQualityChanged(net::EffectiveConnectionType type,
+                               base::TimeDelta http_rtt,
+                               base::TimeDelta transport_rtt,
+                               double bandwidth_kbps) override;
+#if BUILDFLAG(IS_ANDROID)
+  void SetWebKitSharedTimersSuspended(bool suspend) override;
+#endif
+  void InitializeRenderer(
+      const std::string& user_agent,
+      const blink::UserAgentMetadata& user_agent_metadata,
+      const std::vector<std::string>& cors_exempt_header_list,
+      blink::mojom::OriginTrialsSettingsPtr origin_trial_settings,
+      blink::mojom::PerformanceTier cpu_performance_tier,
+      uint64_t trace_id) override;
+#if BUILDFLAG(IS_MAC)
+  void UpdateScrollbarTheme(
+      mojom::UpdateScrollbarThemeParamsPtr params) override;
+#endif
+#if BUILDFLAG(IS_MAC)
+  void OnSystemColorsChanged(int32_t aqua_color_variant) override;
+#endif
+  void UpdateSystemColorInfo(
+      mojom::UpdateSystemColorInfoParamsPtr params) override;
+  void PurgePluginListCache() override;
+  void PurgeResourceCache(PurgeResourceCacheCallback callback) override;
+  void SetProcessState(base::Process::Priority priority,
+                       mojom::RenderProcessVisibleState visible_state) override;
+  void SetIsLockedToSite() override;
+#if BUILDFLAG(CLANG_PROFILING_INSIDE_SANDBOX)
+  void WriteClangProfilingProfile(
+      WriteClangProfilingProfileCallback callback) override;
+#endif
+  void SetIsWebSecurityDisabled(bool value) override;
+  void SetIsIsolatedContext(bool value) override;
+  void SetWebUIResourceUrlToCodeCacheMap(
+      const base::flat_map<GURL, int>& resource_map) override;
+
+ private:
+  // IPC::Listener:
+  void OnAssociatedInterfaceRequest(
+      const std::string& interface_name,
+      mojo::ScopedInterfaceEndpointHandle handle) override;
+  void OnChannelError() override;
+
+  struct WorkerServiceDispatcherOwner;
+
+  bool document_admission_retired_ = false;
+  bool detach_prepared_ = false;
+
+  const raw_ref<RenderThread> render_thread_;
+  const raw_ref<mojom::Renderer> physical_renderer_;
+  const scoped_refptr<blink::ThreadSafeBrowserInterfaceBrokerProxy>
+      original_broker_;
+  const scoped_refptr<RendererWorkerServiceContext> worker_service_context_;
+  std::unique_ptr<WorkerServiceDispatcherOwner> worker_service_dispatcher_;
+  mojo::AssociatedRemote<mojom::RendererHost> renderer_host_;
+  FrameRoutingInfoProvider frame_routing_info_provider_;
+  // Destroy groups before their frame allocator and original broker.
+  std::set<std::unique_ptr<AgentSchedulingGroup>, base::UniquePtrComparator>
+      agent_scheduling_groups_;
+  mojo::AssociatedReceiver<mojom::Renderer> renderer_receiver_{this};
+  blink::AssociatedInterfaceRegistry associated_interfaces_;
+  base::RepeatingClosure channel_error_callback_;
+  std::unique_ptr<IPC::SyncChannel> channel_;
+};
+}  // namespace content
+#endif  // CONTENT_RENDERER_RENDERER_BROWSER_CONNECTION_H_
