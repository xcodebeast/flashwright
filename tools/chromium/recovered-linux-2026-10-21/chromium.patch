+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_BLOB_BLOB_REGISTRY_OWNER_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_BLOB_BLOB_REGISTRY_OWNER_H_
+
+#include "base/synchronization/lock.h"
+#include "base/task/single_thread_task_runner.h"
+#include "mojo/public/cpp/bindings/shared_remote.h"
+#include "third_party/blink/public/mojom/blob/blob_registry.mojom-blink.h"
+#include "third_party/blink/renderer/platform/platform_export.h"
+#include "third_party/blink/renderer/platform/wtf/cross_thread_functional.h"
+#include "third_party/blink/renderer/platform/wtf/thread_safe_ref_counted.h"
+
+namespace blink {
+
+class BlobDataHandle;
+class ThreadSafeBrowserInterfaceBrokerProxy;
+
+// Retains one registration endpoint across delayed work and derived blobs.
+// An owner never reconnects through the current process broker.
+class PLATFORM_EXPORT BlobRegistryOwner
+    : public ThreadSafeRefCounted<BlobRegistryOwner> {
+ public:
+  static scoped_refptr<BlobRegistryOwner> Capture(
+      ThreadSafeBrowserInterfaceBrokerProxy& broker);
+
+  ~BlobRegistryOwner();
+
+  bool Register(mojo::PendingReceiver<mojom::blink::Blob> receiver,
+                const String& identifier,
+                const String& content_type,
+                Vector<mojom::blink::DataElementPtr> elements) const;
+
+  // Replies and disconnect failures run on the initiating sequence. If that
+  // sequence has shut down, the cross-thread callback is discarded safely.
+  void RegisterFromStream(
+      const String& content_type,
+      mojo::ScopedDataPipeConsumerHandle data,
+      CrossThreadOnceFunction<void(const scoped_refptr<BlobDataHandle>&)>
+          callback) const;
+
+ private:
+  explicit BlobRegistryOwner(
+      mojo::PendingRemote<mojom::blink::BlobRegistry> registry);
+
+  mojo::SharedRemote<mojom::blink::BlobRegistry> CopyRegistry() const;
+
+  // SharedRemote wrappers are not thread-safe. Each call takes its own copy,
+  // then releases this lock before a synchronous call can dispatch other work.
+  const scoped_refptr<base::SingleThreadTaskRunner> registry_task_runner_;
+  mutable base::Lock registry_lock_;
+  const mojo::SharedRemote<mojom::blink::BlobRegistry> registry_
+      GUARDED_BY(registry_lock_);
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_BLOB_BLOB_REGISTRY_OWNER_H_
