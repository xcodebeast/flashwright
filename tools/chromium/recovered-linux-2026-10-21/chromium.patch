+v8::Local<v8::String> Str(v8::Isolate* isolate, const std::string& value) {
+  return v8::String::NewFromUtf8(isolate, value.c_str()).ToLocalChecked();
+}
+
+v8::Local<v8::Value> Eval(v8::Isolate* isolate, const std::string& source) {
+  auto context = isolate->GetCurrentContext();
+  return v8::Script::Compile(context, Str(isolate, source)).ToLocalChecked()
+      ->Run(context).ToLocalChecked();
+}
