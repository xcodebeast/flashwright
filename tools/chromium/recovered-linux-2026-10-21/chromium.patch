+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+module blink.mojom;
+
+import "mojo/public/mojom/base/string16.mojom";
+import "third_party/blink/public/mojom/tokens/tokens.mojom";
+import "ui/gfx/geometry/mojom/geometry.mojom";
+
+enum FlashwrightActionPhase {
+  kPrepare,
+  kReadiness,
+  kArm,
+  kFinish,
+  kCleanup,
+  kPrepareAndArm,
+};
+
+struct FlashwrightActionPoint {
+  double x;
+  double y;
+};
+
+struct FlashwrightActionRequest {
+  uint64 serial;
+  string token;
+  FlashwrightActionPhase phase;
+  array<uint16> selector_request;
+  double? deadline_epoch_ms;
+  string action;
+  bool force;
+  bool trial;
+  bool? checked;
+  uint32 click_count = 1;
+  bool defer_readiness;
+  FlashwrightActionPoint? point;
+  uint32 scroll_alignment = 0;
+  // The host owns the resident token before dispatch and cleans it even if
+  // the reply is lost. Release only native phase bookkeeping on settlement.
+  bool host_owned = false;
+};
+
+enum FlashwrightActionStatus {
+  kReady,
+  kSuccess,
+  kRetry,
+  kExpired,
+  kError,
+  kOwnerGone,
+  kResourceLimit,
+};
+
+struct FlashwrightActionResult {
+  FlashwrightActionStatus status;
+  mojo_base.mojom.String16 detail;
+  FlashwrightActionPoint? point;
+};
+
+// One receiver is bound to one original Document. Initialize only selects an
+// already-existing inspector utility world; it never installs application code.
+// The browser controller owns action identity, deadlines, input and navigation.
+interface FlashwrightNavigationClient {
+  // Same associated route as executor replies; an intent is not a commit.
+  Requested(uint64 sequence);
+};
+
+interface FlashwrightActionExecutor {
+  Initialize(DocumentToken expected_document, int32 execution_context_id)
+      => (bool ready);
+  ObserveNavigation(pending_associated_remote<FlashwrightNavigationClient> client)
+      => (bool ready);
+  Run(FlashwrightActionRequest request) => (FlashwrightActionResult result);
+};
