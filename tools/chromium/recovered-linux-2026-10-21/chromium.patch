+class CacheOwnerTestBroker final
+    : public ThreadSafeBrowserInterfaceBrokerProxy {
+ public:
+  CacheOwnerTestBroker(
+      scoped_refptr<ThreadSafeBrowserInterfaceBrokerProxy> forwarding_broker,
+      scoped_refptr<base::RefCountedData<int>> destruction_count)
+      : forwarding_broker_(std::move(forwarding_broker)),
+        destruction_count_(std::move(destruction_count)) {}
+
+  ~CacheOwnerTestBroker() override { ++destruction_count_->data; }
+
+ protected:
+  void GetInterfaceImpl(mojo::GenericPendingReceiver receiver) override {
+    forwarding_broker_->GetInterface(std::move(receiver));
