+bool AgentSchedulingGroup::CanRetireDocumentAdmission() const {
+  return listener_map_.empty() && pending_unload_acknowledgements_ == 0;
+}
+
+void AgentSchedulingGroup::RetireDocumentAdmission() {
+  CHECK(CanRetireDocumentAdmission());
+  if (document_admission_retired_) {
+    return;
+  }
+  document_admission_retired_ = true;
+  // Destruction detaches the channel listener synchronously, including posted
+  // errors and interface requests. Explicit Close before reset would close
+  // twice.
+  if (channel_) {
+    channel_.reset();
+  }
+  receiver_.reset();
+  host_remote_.reset();
+  route_provider_receiver_.reset();
+  associated_interface_provider_receivers_.Clear();
+  pending_receivers_.clear();
+}
+
+mojom::FrameRoutingInfoPtr AgentSchedulingGroup::GenerateFrameRoutingInfo() {
+  if (document_admission_retired_) {
+    return nullptr;
+  }
+  return generate_frame_routing_info_.Run();
+}
