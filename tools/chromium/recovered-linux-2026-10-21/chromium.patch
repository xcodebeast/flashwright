+              state.CurrentBeginImplFrameDeadlineMode());
+  }
+}
+
+TEST(SchedulerStateMachineTest, FlashwrightEarlyIdleDeadlineKeepsQuietScrollWait) {
+  using Deadline = SchedulerStateMachine::BeginImplFrameDeadlineMode;
+  base::test::ScopedFeatureList features;
+  features.InitAndEnableFeature(::features::kFlashwrightEarlyIdleFrameDeadline);
+  SchedulerSettings settings;
+  settings.disable_frame_rate_limit = true;
+  settings.scroll_deadline_mode_enabled = true;
+  StateMachine state(settings);
+  SET_UP_STATE(state);
+  state.SetNeedsRedraw(false);
+  state.SetActiveTreeNeedsFirstDraw(false);
+  state.SetNeedsBeginMainFrame(false);
+  state.IssueNextBeginImplFrame();
+  state.set_is_scrolling(true);
+  state.set_waiting_for_scroll_event(true);
+  EXPECT_TRUE(state.ShouldWaitForScrollEvent());
+  EXPECT_FALSE(state.ShouldSendBeginMainFrame());
+  EXPECT_EQ(Deadline::LATE, state.CurrentBeginImplFrameDeadlineMode());
+  state.set_waiting_for_scroll_event(false);
+  EXPECT_TRUE(state.ShouldSendBeginMainFrame());
+  EXPECT_EQ(Deadline::IMMEDIATE, state.CurrentBeginImplFrameDeadlineMode());
+}
+
+TEST(SchedulerStateMachineTest, FlashwrightEarlyIdleDeadlineKeepsLateCommitProgress) {
+  using Action = SchedulerStateMachine::Action;
+  base::test::ScopedFeatureList features;
+  features.InitAndEnableFeature(::features::kFlashwrightEarlyIdleFrameDeadline);
+  SchedulerSettings settings;
+  settings.disable_frame_rate_limit = true;
+  StateMachine state(settings);
+  SET_UP_STATE(state);
+  state.SetNeedsBeginMainFrame(false);
+  state.IssueNextBeginImplFrame();
+  EXPECT_ACTION_UPDATE_STATE(Action::SEND_BEGIN_MAIN_FRAME);
+  // End the idle frame before the renderer's asynchronous commit arrives.
+  state.OnBeginImplFrameDeadline();
+  EXPECT_ACTION_UPDATE_STATE(Action::NONE);
+  EXPECT_IMPL_FRAME_STATE(SchedulerStateMachine::BeginImplFrameState::IDLE);
+  state.NotifyReadyToCommit();
+  EXPECT_ACTION_UPDATE_STATE(Action::COMMIT);
+  EXPECT_ACTION_UPDATE_STATE(Action::POST_COMMIT);
+  state.NotifyReadyToActivate();
+  EXPECT_ACTION_UPDATE_STATE(Action::ACTIVATE_SYNC_TREE);
+  EXPECT_TRUE(state.BeginFrameNeeded());
+  state.IssueNextBeginImplFrame();
+  state.OnBeginImplFrameDeadline();
+  EXPECT_ACTION_UPDATE_STATE(Action::DRAW_IF_POSSIBLE);
+}
