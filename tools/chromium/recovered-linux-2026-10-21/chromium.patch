+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CONTENT_RENDERER_RENDERER_WORKER_SERVICE_CONTEXT_H_
+#define CONTENT_RENDERER_RENDERER_WORKER_SERVICE_CONTEXT_H_
+
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/functional/callback_helpers.h"
+#include "base/memory/ref_counted.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/synchronization/lock.h"
+#include "base/thread_annotations.h"
+#include "content/common/content_export.h"
+
+namespace blink {
+class ThreadSafeBrowserInterfaceBrokerProxy;
+}
+
+namespace content {
+
+// Carries one browser connection's worker configuration and terminal admission
+// gate across worker startup and teardown sequences. Retaining an old context
+// never redirects its broker or registration to a successor connection.
+class CONTENT_EXPORT RendererWorkerServiceContext final
+    : public base::RefCountedThreadSafe<RendererWorkerServiceContext> {
+ public:
+  explicit RendererWorkerServiceContext(
+      scoped_refptr<blink::ThreadSafeBrowserInterfaceBrokerProxy>
+          original_broker);
+  RendererWorkerServiceContext(const RendererWorkerServiceContext&) = delete;
+  RendererWorkerServiceContext& operator=(const RendererWorkerServiceContext&) =
+      delete;
+
+  scoped_refptr<blink::ThreadSafeBrowserInterfaceBrokerProxy>
+  GetOriginalBrowserInterfaceBroker() const;
+
+  // Initializes once, independently of binder registration. Retirement takes
+  // precedence over initialization and permanently refuses later configuration.
+  bool Initialize(const std::vector<std::string>& cors_exempt_header_list);
+  std::optional<std::vector<std::string>> GetCorsExemptHeaderList() const;
+  bool IsRetired() const;
+
+  // Runs on the caller's sequence if initialized, otherwise on the sequence
+  // that initializes this context. Retirement destroys waiting callbacks.
+  // Notification is not admission: creation must recheck this exact context.
+  void RunWhenInitialized(base::OnceClosure callback);
+
+  // Admission may precede initialization. Each accepted service must retain its
+  // runner until teardown finishes. The callback must post to the service's own
+  // sequence with a weak receiver; it can run on whichever sequence retires us.
+  // The runner retains this exact context and may be released on any sequence.
+  std::optional<base::ScopedClosureRunner> RegisterService(
+      base::OnceClosure retirement_callback);
+
+  // Closes admission before invoking callbacks, without the context lock held.
+  // Callback dispatch does not release the accepted service identities.
+  void Retire();
+  bool IsRetirementComplete() const;
+
+ private:
+  friend class base::RefCountedThreadSafe<RendererWorkerServiceContext>;
+  ~RendererWorkerServiceContext();
+
+  void UnregisterService(uint64_t service_identifier);
+
+  const scoped_refptr<blink::ThreadSafeBrowserInterfaceBrokerProxy>
+      original_broker_;
+  mutable base::Lock lock_;
+  std::optional<std::vector<std::string>> cors_exempt_header_list_
+      GUARDED_BY(lock_);
+  std::vector<base::OnceClosure> pending_initialization_callbacks_
+      GUARDED_BY(lock_);
+  bool retired_ GUARDED_BY(lock_) = false;
+  uint64_t next_service_identifier_ GUARDED_BY(lock_) = 0;
+  std::map<uint64_t, base::OnceClosure> services_ GUARDED_BY(lock_);
+};
+
+}  // namespace content
+
+#endif  // CONTENT_RENDERER_RENDERER_WORKER_SERVICE_CONTEXT_H_
