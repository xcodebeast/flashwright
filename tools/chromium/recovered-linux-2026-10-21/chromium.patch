+++ 2/content/browser/renderer_host/renderer_process_owner.cc
@@ -0,0 +1,198 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/browser/renderer_host/renderer_process_owner.h"
+
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/memory/read_only_shared_memory_region.h"
+#include "base/memory/unsafe_shared_memory_region.h"
+#include "base/task/bind_post_task.h"
+#include "content/browser/renderer_host/renderer_process_transport.h"
+#include "content/public/browser/browser_task_traits.h"
+#include "content/public/browser/sandboxed_process_launcher_delegate.h"
+#include "content/public/common/content_switches.h"
+#include "content/public/common/result_codes.h"
+
+namespace content {
+
+RendererProcessOwner::RendererProcessOwner(
+    std::unique_ptr<SandboxedProcessLauncherDelegate> delegate,
+    std::unique_ptr<base::CommandLine> command_line,
+    ChildProcessId child_process_id,
+    base::WeakPtr<RendererProcessOwnerClient> client,
+    mojo::OutgoingInvitation invitation,
+    mojo::ProcessErrorCallback diagnostic_callback,
+    std::unique_ptr<ChildProcessLauncherFileData> file_data,
+    scoped_refptr<base::RefCountedData<base::UnsafeSharedMemoryRegion>>
+        histogram_memory_region,
+    scoped_refptr<base::RefCountedData<base::ReadOnlySharedMemoryRegion>>
+        trace_config_memory_region,
+    scoped_refptr<base::RefCountedData<base::UnsafeSharedMemoryRegion>>
+        trace_output_memory_region,
+    RendererProcessTransport* transport)
+    : client_(std::move(client)), transport_(transport) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  auto process_error_callback =
+      CreateProcessErrorCallback(std::move(diagnostic_callback));
+  launcher_ = std::make_unique<ChildProcessLauncher>(
+      std::move(delegate), std::move(command_line), child_process_id, this,
+      std::move(invitation), process_error_callback, std::move(file_data),
+      std::move(histogram_memory_region), std::move(trace_config_memory_region),
+      std::move(trace_output_memory_region));
+}
+
+mojo::ProcessErrorCallback RendererProcessOwner::CreateProcessErrorCallback(
+    mojo::ProcessErrorCallback diagnostic_callback) {
+  auto terminate_original_process = base::BindPostTask(
+      GetUIThreadTaskRunner({}),
+      base::BindRepeating(&RendererProcessOwner::OnFatalProcessError,
+                          weak_factory_.GetWeakPtr()));
+  return base::BindRepeating(
+      [](mojo::ProcessErrorCallback diagnostics,
+         base::RepeatingClosure terminate_original_process,
+         const std::string& error) {
+        // Preserve the original diagnostic thread, crash keys and host ID. The
+        // transport owns this callback beyond the launcher's lifetime, so only
+        // the posted weak callback may access the physical owner.
+        if (diagnostics) {
+          diagnostics.Run(error);
+        }
+        terminate_original_process.Run();
+      },
+      std::move(diagnostic_callback), std::move(terminate_original_process));
+}
+
+RendererProcessOwner::~RendererProcessOwner() {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (transport_) {
+    transport_->OnProcessExited();
+  }
+}
+
+bool RendererProcessOwner::IsStarting() {
+  return launcher_->IsStarting();
+}
+
+bool RendererProcessOwner::CanTransferPhysicalCustody() {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  return launch_notification_completed_ && !launcher_->IsStarting() &&
+         launcher_->GetProcess().IsValid() && !fatal_error_pending_ &&
+         !termination_requested_;
+}
+
+const base::Process& RendererProcessOwner::GetProcess() const {
+  return launcher_->GetProcess();
+}
+
+ChildProcessTerminationInfo RendererProcessOwner::GetChildTerminationInfo(
+    bool known_dead) {
+  return launcher_->GetChildTerminationInfo(known_dead);
+}
+
+bool RendererProcessOwner::Terminate(int exit_code) {
+  const bool requested = launcher_->Terminate(exit_code);
+  termination_requested_ |= requested;
+  return requested;
+}
+
+#if BUILDFLAG(IS_ANDROID)
+void RendererProcessOwner::SetRenderProcessPriority(
+    const RenderProcessPriority& priority) {
+  launcher_->SetRenderProcessPriority(priority);
+}
+
+base::android::ChildBindingState
+RendererProcessOwner::GetEffectiveChildBindingState() {
+  return launcher_->GetEffectiveChildBindingState();
+}
+
+void RendererProcessOwner::DumpProcessStack() {
+  launcher_->DumpProcessStack();
+}
+#else
+void RendererProcessOwner::SetProcessPriority(
+    base::Process::Priority priority) {
+  launcher_->SetProcessPriority(priority);
+}
+#endif
+
+ChildProcessLauncher::Client* RendererProcessOwner::ReplaceClientForTest(
+    ChildProcessLauncher::Client* client) {
+  return launcher_->ReplaceClientForTest(client);
+}
+
+void RendererProcessOwner::OnProcessLaunched() {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (transport_) {
+    auto still_alive = weak_factory_.GetWeakPtr();
+    transport_->OnProcessLaunched(launcher_->GetProcess().Pid());
+    if (!still_alive) {
+      return;
+    }
+  }
+  if (fatal_error_pending_) {
+    auto still_alive = weak_factory_.GetWeakPtr();
+    OnFatalProcessError();
+    if (!still_alive) {
+      return;
+    }
+  }
+  // IsStarting() is already false during this callback. Keep transfer closed
+  // until all original launch observers return; they may destroy this owner.
+  auto still_alive = weak_factory_.GetWeakPtr();
+  if (client_) {
+    client_->OnProcessLaunched();
+  }
+  if (still_alive) {
+    launch_notification_completed_ = true;
+  }
+}
+
+void RendererProcessOwner::OnProcessLaunchFailed(int error_code) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (client_) {
+    client_->OnProcessLaunchFailed(error_code);
+  }
+}
+
+#if BUILDFLAG(IS_ANDROID)
+bool RendererProcessOwner::CanUseWarmUpConnection() {
+  return client_ && client_->CanUseWarmUpConnection();
+}
+
+bool RendererProcessOwner::HasSpareRendererPriority() {
+  return client_ && client_->HasSpareRendererPriority();
+}
+
+void RendererProcessOwner::OnSpareRendererPriorityGraduated(bool is_alive) {
+  if (client_) {
+    client_->OnSpareRendererPriorityGraduated(is_alive);
+  }
+}
+#endif
+
+void RendererProcessOwner::OnFatalProcessError() {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          switches::kDisableKillAfterBadIPC)) {
+    return;
+  }
+  const bool notify_client = !fatal_error_pending_;
+  fatal_error_pending_ = true;
+  if (notify_client && client_) {
+    auto still_alive = weak_factory_.GetWeakPtr();
+    client_->OnProcessFatalError();
+    if (!still_alive) {
+      return;
+    }
+  }
+  if (!launcher_->IsStarting() && !termination_requested_) {
+    Terminate(RESULT_CODE_KILLED_BAD_MESSAGE);
+  }
+}
+
+}  // namespace content
