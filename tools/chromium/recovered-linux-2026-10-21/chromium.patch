diff --git 1/gin/renderer_adoption_probe.cc 2/gin/renderer_adoption_probe.cc
new file mode 100644
index 0000000000..11cc3a5b30
--- /dev/null
+++ 2/gin/renderer_adoption_probe.cc
@@ -0,0 +1,241 @@
+// Private child-local adoption control. This file performs no fork and supplies
+// no performance evidence. Normal renderer configuration precedes this hook.
+#include "gin/renderer_adoption_probe.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/check.h"
+#include "base/rand_util.h"
+#include "base/check_op.h"
+#include "base/no_destructor.h"
+#include "base/process/process_handle.h"
+#include "base/synchronization/lock.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/threading/platform_thread.h"
+#include "base/time/time.h"
+#include "v8/include/v8-cppgc.h"
+
+void InvalidateForkThreadCache() __attribute__((weak));
+void RebindForkHeap(v8::Isolate*) __attribute__((weak));
+void RepairForkRandomness(v8::Isolate*, int64_t, int64_t) __attribute__((weak));
+void CheckForkHeapQuiescence(v8::Isolate*) __attribute__((weak));
+
+bool FlashwrightDeferCompilerForDonor() {
+  return gin::RendererDonorIsPreparing();
+}
+void StartForkCompilerExecutor(v8::Isolate*) __attribute__((weak));
+
+namespace gin {
+namespace {
+class DeferredRunner final : public base::SingleThreadTaskRunner {
+ public:
+  bool PostDelayedTask(const base::Location& from, base::OnceClosure task,
+                       base::TimeDelta delay) override {
+    return Post(from, std::move(task), delay, false);
+  }
+  bool PostNonNestableDelayedTask(const base::Location& from,
+                                  base::OnceClosure task,
+                                  base::TimeDelta delay) override {
+    return Post(from, std::move(task), delay, true);
+  }
+  bool RunsTasksInCurrentSequence() const override {
+    base::AutoLock hold(lock_);
+    return target_ ? target_->RunsTasksInCurrentSequence()
+                   : thread_ == base::PlatformThread::CurrentRef();
+  }
+  void RebindAfterFork() {
+    base::AutoLock hold(lock_);
+    CHECK(!target_);
+    thread_ = base::PlatformThread::CurrentRef();
+  }
+  void Activate(scoped_refptr<base::SingleThreadTaskRunner> target) {
+    CHECK(target);
+    base::AutoLock hold(lock_);
+    CHECK(!target_);
+    target_ = std::move(target);
+    for (auto& entry : pending_)
+      CHECK(Forward(entry.from, std::move(entry.task),
+                    std::max(base::TimeDelta(), entry.due-base::TimeTicks::Now()),
+                    entry.non_nestable));
+    pending_.clear();
+  }
+ private:
+  ~DeferredRunner() override = default;
+  struct Entry {
+    base::Location from;
+    base::OnceClosure task;
+    base::TimeTicks due;
+    bool non_nestable;
+  };
+  bool Forward(const base::Location& from, base::OnceClosure task,
+               base::TimeDelta delay, bool non_nestable) {
+    return non_nestable
+        ? target_->PostNonNestableDelayedTask(from, std::move(task), delay)
+        : target_->PostDelayedTask(from, std::move(task), delay);
+  }
+  bool Post(const base::Location& from, base::OnceClosure task,
+            base::TimeDelta delay, bool non_nestable) {
+    base::AutoLock hold(lock_);
+    if (target_) return Forward(from, std::move(task), delay, non_nestable);
+    pending_.push_back({from, std::move(task), base::TimeTicks::Now()+delay,
+                        non_nestable});
+    return true;
+  }
+  mutable base::Lock lock_;
+  base::PlatformThreadRef thread_ = base::PlatformThread::CurrentRef();
+  scoped_refptr<base::SingleThreadTaskRunner> target_;
+  std::vector<Entry> pending_;
+};
+
+struct ProbeState {
+  bool donor_preparing = false;
+  bool preparing = false;
+  bool prepared = false;
+  base::ProcessId prepared_pid = 0;
+  bool pending = false;
+  scoped_refptr<DeferredRunner> runners[3];
+  std::unique_ptr<IsolateHolder> holder;
+  std::unique_ptr<v8::Isolate::CreateParams> expected;
+};
+
+ProbeState& State() {
+  static base::NoDestructor<ProbeState> state;
+  return *state;
+}
+}  // namespace
+
+bool RendererAdoptionIsPreparing() { return State().preparing; }
+bool RendererDonorIsPreparing() { return State().donor_preparing; }
+void SetRendererDonorPreparation(bool value) {
+  CHECK_NE(State().donor_preparing, value);
+  State().donor_preparing = value;
+}
+
+bool RendererAdoptionIsInherited() {
+  return State().pending && State().prepared_pid != base::GetCurrentProcId();
+}
+
+v8::CppHeap* PreparedRendererCppHeap() {
+  auto& state = State();
+  return state.pending ? state.holder->isolate()->GetCppHeap() : nullptr;
+}
+
+void StartInheritedRendererCompiler() {
+  if (!RendererAdoptionIsInherited()) return;
+  CHECK(StartForkCompilerExecutor);
+  StartForkCompilerExecutor(State().holder->isolate());
+  std::fprintf(stderr, "FW_INHERIT compiler-start child=%d\n",
+               base::GetCurrentProcId());
+}
+
+void CheckRendererAdoptionQuiescence() {
+  CHECK(State().pending);
+  CHECK(CheckForkHeapQuiescence);
+  CheckForkHeapQuiescence(State().holder->isolate());
+}
+
+void RepairRendererAdoptionAfterFork() {
+  CHECK(RendererAdoptionIsInherited());
+  auto& state = State();
+  InvalidateForkThreadCache();
+  RebindForkHeap(state.holder->isolate());
+  RepairForkRandomness(state.holder->isolate(), base::RandUint64(),
+                       base::RandUint64());
+  for (auto& runner : state.runners) runner->RebindAfterFork();
+  std::fprintf(stderr, "FW_INHERIT donor=%d child=%d isolate=%p heap=%p\n",
+      state.prepared_pid, base::GetCurrentProcId(),
+      static_cast<void*>(state.holder->isolate()),
+      static_cast<void*>(state.holder->isolate()->GetCppHeap()));
+}
+
+void PrepareRendererAdoptionProbe(
+    v8::CreateHistogramCallback create_histogram,
+    v8::AddHistogramSampleCallback add_sample,
+    std::unique_ptr<v8::CppHeap>* cpp_heap) {
+  const char* enabled = std::getenv("FLASHWRIGHT_RENDERER_ADOPTION_PROBE");
+  if (!enabled || std::string_view(enabled) != "1") return;
+  auto& state = State();
+  if (state.pending) {
+    CHECK(!*cpp_heap);
+    return;
+  }
+  CHECK(!state.prepared);
+  CHECK(*cpp_heap);
+  state.preparing = true;
+  for (auto& runner : state.runners)
+    runner = base::MakeRefCounted<DeferredRunner>();
+  auto params = IsolateHolder::getDefaultIsolateParams();
+  params->allow_atomics_wait = false;
+  params->create_histogram_callback = create_histogram;
+  params->add_histogram_sample_callback = add_sample;
+  params->cpp_heap = cpp_heap->release();
+  state.expected = std::make_unique<v8::Isolate::CreateParams>(*params);
+  state.holder = std::make_unique<IsolateHolder>(state.runners[0],
+      IsolateHolder::kSingleThread, IsolateHolder::IsolateType::kBlinkMainThread,
+      std::move(params), IsolateHolder::IsolateCreationMode::kNormal,
+      state.runners[1], state.runners[2]);
+  state.preparing = false;
+  state.prepared_pid = base::GetCurrentProcId();
+  state.prepared = state.pending = true;
+  std::fprintf(stderr, "FW_ADOPTION prepared pid=%d isolate=%p heap=%p\n",
+      base::GetCurrentProcId(), static_cast<void*>(state.holder->isolate()),
+      static_cast<void*>(state.holder->isolate()->GetCppHeap()));
+  if (std::getenv("FLASHWRIGHT_RENDERER_ADOPTION_BAD_PARAMS"))
+    state.expected->allow_atomics_wait = true;
+}
+
+std::unique_ptr<IsolateHolder> TakeRendererAdoptionProbe(
+    const v8::Isolate::CreateParams& params,
+    IsolateHolder::AccessMode access_mode,
+    IsolateHolder::IsolateType isolate_type,
+    IsolateHolder::IsolateCreationMode creation_mode,
+    scoped_refptr<base::SingleThreadTaskRunner> runner,
+    scoped_refptr<base::SingleThreadTaskRunner> user_visible,
+    scoped_refptr<base::SingleThreadTaskRunner> best_effort) {
+  auto& state = State();
+  if (!state.pending) return nullptr;
+  CHECK_EQ(access_mode, IsolateHolder::kSingleThread);
+  CHECK_EQ(isolate_type, IsolateHolder::IsolateType::kBlinkMainThread);
+  CHECK_EQ(creation_mode, IsolateHolder::IsolateCreationMode::kNormal);
+  CHECK(!params.cpp_heap);
+  const auto& expected = *state.expected;
+  CHECK_EQ(state.holder->isolate()->GetCppHeap(), expected.cpp_heap);
+#define MATCH_FIELD(name) CHECK(params.name == expected.name)
+  MATCH_FIELD(code_event_handler);
+  MATCH_FIELD(snapshot_blob);
+  MATCH_FIELD(counter_lookup_callback);
+  MATCH_FIELD(create_histogram_callback);
+  MATCH_FIELD(add_histogram_sample_callback);
+  MATCH_FIELD(array_buffer_allocator);
+  MATCH_FIELD(array_buffer_allocator_shared);
+  MATCH_FIELD(external_references);
+  MATCH_FIELD(allow_atomics_wait);
+  MATCH_FIELD(fatal_error_callback);
+  MATCH_FIELD(oom_error_callback);
+#undef MATCH_FIELD
+#define MATCH_CONSTRAINT(name) CHECK_EQ(params.constraints.name(), expected.constraints.name())
+  MATCH_CONSTRAINT(stack_limit);
+  MATCH_CONSTRAINT(code_range_size_in_bytes);
+  MATCH_CONSTRAINT(max_old_generation_size_in_bytes);
+  MATCH_CONSTRAINT(max_young_generation_size_in_bytes);
+  MATCH_CONSTRAINT(initial_old_generation_size_in_bytes);
+  MATCH_CONSTRAINT(initial_young_generation_size_in_bytes);
+  MATCH_CONSTRAINT(physical_memory_size_in_bytes);
+#undef MATCH_CONSTRAINT
+  state.pending = false;
+  state.runners[0]->Activate(std::move(runner));
+  state.runners[1]->Activate(std::move(user_visible));
+  state.runners[2]->Activate(std::move(best_effort));
+  std::fprintf(stderr, "FW_ADOPTION adopted pid=%d isolate=%p heap=%p\n",
+      base::GetCurrentProcId(), static_cast<void*>(state.holder->isolate()),
+      static_cast<void*>(state.holder->isolate()->GetCppHeap()));
+  state.expected.reset();
+  for (auto& deferred : state.runners) deferred.reset();
+  return std::move(state.holder);
+}
+}  // namespace gin
