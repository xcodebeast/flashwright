+class ResourceCacheOwnerTest : public testing::Test {
+ protected:
+  ResourceCacheOwnerTest()
+      : scoped_memory_cache_(MakeGarbageCollected<MemoryCache>(
+            task_environment_.GetMainThreadTaskRunner())) {}
+
+  scoped_refptr<CacheOwnerTestBroker> CreateBroker() {
+    return platform_->CreateBroker(
+        base::MakeRefCounted<base::RefCountedData<int>>(0));
+  }
+
+  ResourceFetcher* CreateFetcher() {
+    return CreateFetcher(
+        *MakeGarbageCollected<TestResourceFetcherProperties>());
+  }
+
+  ResourceFetcher* CreateFetcher(
+      const TestResourceFetcherProperties& properties) {
+    return MakeGarbageCollected<ResourceFetcher>(ResourceFetcherInit(
+        Platform::Current()->GetBrowserInterfaceBroker(),
+        properties.MakeDetachable(), MakeGarbageCollected<MockFetchContext>(),
+        base::MakeRefCounted<scheduler::FakeTaskRunner>(),
+        base::MakeRefCounted<scheduler::FakeTaskRunner>(),
+        MakeGarbageCollected<TestLoaderFactory>(
+            platform_->GetURLLoaderMockFactory()),
+        MakeGarbageCollected<MockContextLifecycleNotifier>(), nullptr));
+  }
+
+  ImageResource* FetchStaticImage(ResourceFetcher* fetcher,
+                                  bool skip_service_worker = false) {
+    ResourceRequest request{KURL(kStaticImageURL)};
+    request.SetSkipServiceWorker(skip_service_worker);
+    FetchParameters parameters =
+        FetchParameters::CreateForTest(std::move(request));
+    return ImageResource::Fetch(parameters, fetcher);
+  }
+
+  void ExpectLoadedImage(ImageResource* resource) {
+    ASSERT_TRUE(resource);
+    EXPECT_TRUE(resource->IsLoaded());
+    EXPECT_FALSE(resource->ErrorOccurred());
+    ASSERT_TRUE(resource->GetContent()->HasImage());
+    EXPECT_EQ(gfx::Size(1, 1), resource->GetContent()->GetImage()->Size());
+    EXPECT_EQ(AtomicString("image/gif"), resource->GetResponse().MimeType());
+    EXPECT_TRUE(MemoryCache::Get()->Contains(resource));
+  }
+
+  test::TaskEnvironment task_environment_;
+  ScopedTestingPlatformSupport<SelectableCacheOwnerPlatform> platform_;
+  ScopedMemoryCacheForTesting scoped_memory_cache_;
+};
