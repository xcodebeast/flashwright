+std::unique_ptr<RendererBrowserConnection>
+RenderThreadImpl::CreateFlashwrightConnection(
+    mojom::RendererConnectionBootstrapPtr bootstrap) {
+  // The browser admits physical policy compatibility before a fresh logical
+  // host supplies its own namespace. Primordial GPU identity stays physical.
+  if (IsSingleProcess() || bootstrap->client_id <= 0) {
+    return nullptr;
+  }
+  for (auto& observer : observers_) {
+    if (&observer != variations_observer_.get()) {
+      return nullptr;
+    }
+  }
+  if (!blink::ReopenFlashwrightWorkerAdmission()) {
+    return nullptr;
+  }
+  mojo::SharedRemote<mojom::ChildProcessHost> browser_host(
+      std::move(bootstrap->browser_host), GetIOTaskRunner());
+  auto connection = std::make_unique<RendererBrowserConnection>(
+      *this, *this, CreateBrowserInterfaceBrokerProxy(std::move(browser_host)),
+      mojo::PendingAssociatedRemote<mojom::RendererHost>(),
+      base::FeatureList::IsEnabled(features::kFrameRoutingCache));
+  connection->InitializeChannel(
+      bootstrap->channel.PassPipe(), GetIOTaskRunner(),
+      main_thread_scheduler_->DeprecatedDefaultTaskRunner(),
+      ChildProcess::current()->GetShutDownEvent(), main_thread_scheduler_.get(),
+      base::BindRepeating(&RenderThreadImpl::OnChannelError,
+                          weak_factory_.GetWeakPtr()));
+  for (auto& observer : observers_) {
+    connection->AddObserver(&observer);
+  }
+  mojo::BinderMap worker_binders;
+  ExposeRendererWorkerInterfacesToBrowser(connection->GetWorkerServiceContext(),
+                                          GetIOTaskRunner(), &worker_binders);
+  connection->InitializeWorkerServices(bootstrap->worker_service.PassPipe(),
+                                       std::move(worker_binders),
+                                       GetIOTaskRunner());
+  if (bootstrap->client_id != client_id_ &&
+      !blink::InstallFlashwrightStorageOwner(
+          *connection->GetOriginalBrowserInterfaceBroker())) {
+    return nullptr;
+  }
+  client_id_ = bootstrap->client_id;
+  return connection;
+}
+
+void RenderThreadImpl::RetireFlashwrightConnection(
+    RetireFlashwrightWorkersCallback callback) {
+  RetireFlashwrightWorkers(base::BindOnce(
+      [](base::WeakPtr<RenderThreadImpl> thread,
+         RetireFlashwrightWorkersCallback callback, bool retired) {
+        if (!thread) {
+          return;
+        }
+        if (retired) {
+          retired = thread->connection_control_->GetConnection()
+                        .ReclaimRetiredDocumentMemory();
+        }
+        if (retired) {
+          for (auto& observer : thread->observers_) {
+            thread->connection_control_->GetConnection().RemoveObserver(
+                &observer);
+          }
+        }
+        std::move(callback).Run(retired);
+      },
+      weak_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void RenderThreadImpl::RetireFlashwrightWorkers(
+    RetireFlashwrightWorkersCallback callback) {
+  class FramePresence final : public RenderFrameVisitor {
+   public:
+    bool Visit(RenderFrame* frame) override {
+      found = true;
+      return false;
+    }
+    bool found = false;
+  } frames;
+  RenderFrame::ForEach(&frames);
+  if (frames.found || blink::WebView::GetWebViewCount() != 0 ||
+      !connection_control_->GetConnection().RetireDocumentAdmission()) {
+    std::move(callback).Run(false);
+    return;
+  }
+  connection_control_->GetConnection().RetireExecutionContextServices();
+  blink::BeginFlashwrightWorkerRetirement();
+  PollFlashwrightWorkerRetirement(base::TimeTicks::Now() + base::Seconds(5),
+                                  std::move(callback));
+}
+
+void RenderThreadImpl::PollFlashwrightWorkerRetirement(
+    base::TimeTicks deadline,
+    RetireFlashwrightWorkersCallback callback) {
+  PollWorkerServiceRetirement(
+      connection_control_->GetConnection().GetWorkerServiceContext(), deadline,
+      std::move(callback));
+}
