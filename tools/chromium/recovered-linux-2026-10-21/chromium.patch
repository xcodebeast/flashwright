+namespace {
+
+// The side table preserves the public broker layout. Entries exist exactly for
+// a broker lifetime; pointer reuse never reuses an identity or retains a
+// broker.
+struct BrokerLifetime {
+  BrokerLifetime();
+  ~BrokerLifetime();
+  const base::UnguessableToken identity;
+  bool retired = false;
+};
+
+BrokerLifetime::BrokerLifetime() : identity(base::UnguessableToken::Create()) {}
+BrokerLifetime::~BrokerLifetime() = default;
+
+struct BrokerIdentityRegistry {
+  base::Lock lock;
+  std::map<const ThreadSafeBrowserInterfaceBrokerProxy*, BrokerLifetime>
+      identities GUARDED_BY(lock);
+};
+
+BrokerIdentityRegistry& GetBrokerIdentityRegistry() {
+  static base::NoDestructor<BrokerIdentityRegistry> registry;
+  return *registry;
+}
+
+}  // namespace
+
+ThreadSafeBrowserInterfaceBrokerProxy::ThreadSafeBrowserInterfaceBrokerProxy() {
+  auto& registry = GetBrokerIdentityRegistry();
+  base::AutoLock lock(registry.lock);
+  CHECK(registry.identities.try_emplace(this).second);
+}
 
 ThreadSafeBrowserInterfaceBrokerProxy::
-    ~ThreadSafeBrowserInterfaceBrokerProxy() = default;
+    ~ThreadSafeBrowserInterfaceBrokerProxy() {
+  auto& registry = GetBrokerIdentityRegistry();
+  base::AutoLock lock(registry.lock);
+  CHECK(registry.identities.erase(this) == 1);
+}
+
+base::UnguessableToken BrowserInterfaceBrokerIdentity(
+    const ThreadSafeBrowserInterfaceBrokerProxy& broker) {
+  auto& registry = GetBrokerIdentityRegistry();
+  base::AutoLock lock(registry.lock);
+  auto entry = registry.identities.find(&broker);
+  CHECK(entry != registry.identities.end());
+  return entry->second.identity;
+}
+
+void RetireBrowserInterfaceBroker(
+    const ThreadSafeBrowserInterfaceBrokerProxy& broker) {
+  auto& registry = GetBrokerIdentityRegistry();
+  base::AutoLock lock(registry.lock);
+  auto entry = registry.identities.find(&broker);
+  CHECK(entry != registry.identities.end());
+  entry->second.retired = true;
+}
+
+bool IsBrowserInterfaceBrokerRetired(
+    const ThreadSafeBrowserInterfaceBrokerProxy& broker) {
+  auto& registry = GetBrokerIdentityRegistry();
+  base::AutoLock lock(registry.lock);
+  auto entry = registry.identities.find(&broker);
+  CHECK(entry != registry.identities.end());
+  return entry->second.retired;
+}
 
