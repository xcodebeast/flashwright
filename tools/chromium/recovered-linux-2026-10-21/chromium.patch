diff --git 1/content/browser/devtools/protocol/flashwright_navigation_observer.cc 2/content/browser/devtools/protocol/flashwright_navigation_observer.cc
new file mode 100644
index 0000000000..6ff4998ce5
--- /dev/null
+++ 2/content/browser/devtools/protocol/flashwright_navigation_observer.cc
@@ -0,0 +1,368 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/browser/devtools/protocol/flashwright_navigation_observer.h"
+
+#include <stddef.h>
+
+#include <limits>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/strings/string_number_conversions.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "net/http/http_response_headers.h"
+
+namespace content::protocol {
+namespace {
+constexpr size_t kMaximumRecords = 256;
+constexpr size_t kMaximumNavigations = 256;
+
+FrameTreeNodeId OriginalRootId(WebContents* contents,
+                              const WeakDocumentPtr& owner) {
+  auto* frame = owner.AsRenderFrameHostIfValid();
+  if (!contents || !frame || frame != contents->GetPrimaryMainFrame() ||
+      !frame->IsActive() || !frame->IsRenderFrameLive() ||
+      frame->GetOutermostMainFrame() != frame) {
+    return FrameTreeNodeId();
+  }
+  return frame->GetFrameTreeNodeId();
+}
+
+base::DictValue Event(const char* kind) {
+  base::DictValue record;
+  record.Set("kind", kind);
+  return record;
+}
+
+void IncrementSaturating(uint64_t& value) {
+  if (value != std::numeric_limits<uint64_t>::max()) {
+    ++value;
+  }
+}
+}  // namespace
+
+FlashwrightNavigationObserver::ModalSnapshot::ModalSnapshot(
+    const base::UnguessableToken& token,
+    std::optional<PendingNavigation> original)
+    : frame_token(token), pending(std::move(original)) {}
+FlashwrightNavigationObserver::ModalSnapshot::~ModalSnapshot() = default;
+
+FlashwrightNavigationObserver::FlashwrightNavigationObserver(
+    WebContents* contents,
+    WeakDocumentPtr owner,
+    int execution_context_id)
+    : WebContentsObserver(contents),
+      owner_(std::move(owner)),
+      execution_context_id_(execution_context_id),
+      root_frame_tree_node_id_(OriginalRootId(contents, owner_)) {
+  RefreshOwner();
+}
+
+FlashwrightNavigationObserver::~FlashwrightNavigationObserver() = default;
+
+mojo::PendingAssociatedRemote<blink::mojom::FlashwrightNavigationClient>
+FlashwrightNavigationObserver::Bind() {
+  if (!RefreshOwner() || bound_once_) {
+    Record(Event("bindRejected"));
+    return {};
+  }
+  bound_once_ = true;
+  auto remote = receiver_.BindNewEndpointAndPassRemote();
+  receiver_.set_disconnect_handler(base::BindOnce(
+      &FlashwrightNavigationObserver::Disconnected,
+      weak_factory_.GetWeakPtr()));
+  Record(Event("bound"));
+  return remote;
+}
+
+void FlashwrightNavigationObserver::Requested(uint64_t sequence) {
+  if (sequence == 0) {
+    invalid_or_exhausted_intent_ = true;
+  } else if (sequence <= latest_request_serial_) {
+    non_monotonic_intent_ = true;
+  }
+  if (!RefreshOwner() || !bound_once_ || disconnected_ || sequence == 0 ||
+      sequence <= latest_request_serial_) {
+    auto record = Event("requestRejected");
+    record.Set("requestSerial", base::NumberToString(sequence));
+    Record(std::move(record));
+    return;
+  }
+  auto record = Event("requested");
+  record.Set("requestSerial", base::NumberToString(sequence));
+  if (pending_) {
+    record.Set("supersededRequestSerial",
+               base::NumberToString(pending_->request_serial));
+    if (pending_->navigation_id) {
+      record.Set("supersededNavigationId",
+                 base::NumberToString(*pending_->navigation_id));
+    }
+  }
+  latest_request_serial_ = sequence;
+  pending_ = PendingNavigation{sequence, std::nullopt};
+  Record(std::move(record));
+}
+
+void FlashwrightNavigationObserver::BeforeUnloadOpened(
+    const base::UnguessableToken& frame_token) {
+  if (!RefreshOwner() || frame_token.is_empty() || modal_) {
+    Record(Event("modalOpeningRejected"));
+    return;
+  }
+  modal_.emplace(frame_token, pending_);
+  auto record = Event("beforeunloadOpened");
+  record.Set("frameToken", frame_token.ToString());
+  record.Set("hadPending", pending_.has_value());
+  if (pending_) {
+    record.Set("requestSerial", base::NumberToString(pending_->request_serial));
+    if (pending_->navigation_id) {
+      record.Set("navigationId",
+                 base::NumberToString(*pending_->navigation_id));
+    }
+  }
+  Record(std::move(record));
+}
+
+void FlashwrightNavigationObserver::DialogClosed(
+    const base::UnguessableToken& frame_token,
+    bool accepted) {
+  const bool owner_alive = RefreshOwner();
+  if (!modal_ || modal_->frame_token != frame_token) {
+    auto record = Event("modalClosingUnmatched");
+    record.Set("accepted", accepted);
+    Record(std::move(record));
+    return;
+  }
+  auto record = Event("beforeunloadClosed");
+  record.Set("frameToken", frame_token.ToString());
+  record.Set("accepted", accepted);
+  // Native ID state is part of the snapshot: an ID arriving after opening is
+  // unmatched ordering, not permission to cancel a different native attempt.
+  const bool cancelled = !accepted && owner_alive && modal_->pending &&
+                         modal_->pending->request_serial != 0 &&
+                         !modal_->pending->navigation_id &&
+                         pending_ == modal_->pending;
+  record.Set("cancelled", cancelled);
+  record.Set("ownerAlive", owner_alive);
+  if (modal_->pending) {
+    record.Set("requestSerial",
+               base::NumberToString(modal_->pending->request_serial));
+    if (modal_->pending->navigation_id) {
+      record.Set("navigationId",
+                 base::NumberToString(*modal_->pending->navigation_id));
+    }
+  }
+  modal_.reset();
+  if (cancelled) {
+    pending_.reset();
+  }
+  Record(std::move(record));
+}
+
+void FlashwrightNavigationObserver::DidStartNavigation(
+    NavigationHandle* navigation) {
+  if (!IsOriginalRootNavigation(navigation) || !RefreshOwner()) {
+    return;
+  }
+  const int64_t id = navigation->GetNavigationId();
+  if (navigations_.contains(id)) {
+    auto record = Event("duplicateStart");
+    record.Set("navigationId", base::NumberToString(id));
+    Record(std::move(record));
+    return;
+  }
+  if (navigations_.size() == kMaximumNavigations) {
+    overflow_ = true;
+    tracking_overflow_ = true;
+    IncrementSaturating(dropped_starts_);
+    // Do not let a previously tracked terminal clear this newer native ID.
+    // Its untracked finish cannot settle pending state; overflow is explicit.
+    pending_ = PendingNavigation{pending_ ? pending_->request_serial : 0, id};
+    auto record = Event("navigationTrackingOverflow");
+    record.Set("navigationId", base::NumberToString(id));
+    Record(std::move(record));
+    return;
+  }
+  const uint64_t serial = pending_ ? pending_->request_serial : 0;
+  navigations_.emplace(id, serial);
+  if (observed_navigation_ids_.size() < kMaximumRecords) {
+    observed_navigation_ids_.Append(base::NumberToString(id));
+  } else {
+    overflow_ = true;
+  }
+  pending_ = PendingNavigation{serial, id};
+  auto record = Event("navigationStarted");
+  record.Set("navigationId", base::NumberToString(id));
+  record.Set("requestSerial", base::NumberToString(serial));
+  record.Set("sameDocument", navigation->IsSameDocument());
+  Record(std::move(record));
+}
+
+void FlashwrightNavigationObserver::DidFinishNavigation(
+    NavigationHandle* navigation) {
+  if (!IsOriginalRootNavigation(navigation)) {
+    return;
+  }
+  RefreshOwner();
+  const int64_t id = navigation->GetNavigationId();
+  auto found = navigations_.find(id);
+  if (found == navigations_.end()) {
+    auto record = Event("navigationFinishedUnpaired");
+    record.Set("navigationId", base::NumberToString(id));
+    Record(std::move(record));
+    return;
+  }
+  const uint64_t serial = found->second;
+  navigations_.erase(found);
+  const bool cleared = pending_ && pending_->navigation_id == id &&
+                       pending_->request_serial == serial;
+  if (cleared) {
+    pending_.reset();
+  }
+  auto record = Event("navigationFinished");
+  record.Set("navigationId", base::NumberToString(id));
+  record.Set("requestSerial", base::NumberToString(serial));
+  record.Set("clearedPending", cleared);
+  record.Set("sameDocument", navigation->IsSameDocument());
+  record.Set("committed", navigation->HasCommitted());
+  record.Set("download", navigation->IsDownload());
+  record.Set("errorPage", navigation->IsErrorPage());
+  record.Set("netError", static_cast<int>(navigation->GetNetErrorCode()));
+  if (const auto* headers = navigation->GetResponseHeaders()) {
+    record.Set("responseCode", headers->response_code());
+  }
+  Record(std::move(record));
+}
+
+void FlashwrightNavigationObserver::PrimaryPageChanged(Page&) {
+  RefreshOwner();
+}
+
+void FlashwrightNavigationObserver::RenderFrameHostChanged(RenderFrameHost*,
+                                                           RenderFrameHost*) {
+  RefreshOwner();
+}
+
+void FlashwrightNavigationObserver::RenderFrameDeleted(RenderFrameHost* frame) {
+  if (owner_.AsRenderFrameHostIfValid() == frame) {
+    LoseOwner();
+  } else {
+    RefreshOwner();
+  }
+}
+
+void FlashwrightNavigationObserver::WebContentsDestroyed() {
+  LoseOwner();
+  Observe(nullptr);
+}
+
+bool FlashwrightNavigationObserver::OwnerIsCurrentlyPrimary() const {
+  auto* frame = owner_.AsRenderFrameHostIfValid();
+  return execution_context_id_ > 0 && root_frame_tree_node_id_ &&
+         web_contents() && frame && frame->IsActive() &&
+         frame->IsRenderFrameLive() &&
+         frame == web_contents()->GetPrimaryMainFrame() &&
+         frame->GetFrameTreeNodeId() == root_frame_tree_node_id_ &&
+         frame->GetOutermostMainFrame() == frame;
+}
+
+bool FlashwrightNavigationObserver::RefreshOwner() {
+  if (!owner_lost_ && !OwnerIsCurrentlyPrimary()) {
+    LoseOwner();
+  }
+  return !owner_lost_;
+}
+
+void FlashwrightNavigationObserver::LoseOwner() {
+  if (owner_lost_) {
+    return;
+  }
+  owner_lost_ = true;
+  receiver_.reset();
+  // Pending intent/native IDs are not terminal evidence. Keep them for native
+  // finish callbacks and the diagnostic snapshot, even after logical loss.
+  Record(Event("ownerLost"));
+}
+
+bool FlashwrightNavigationObserver::IsOriginalRootNavigation(
+    NavigationHandle* navigation) const {
+  return root_frame_tree_node_id_ && navigation->IsInPrimaryMainFrame() &&
+         navigation->IsInOutermostMainFrame() &&
+         navigation->GetFrameTreeNodeId() == root_frame_tree_node_id_;
+}
+
+void FlashwrightNavigationObserver::Disconnected() {
+  disconnected_ = true;
+  receiver_.reset();
+  // Associated endpoint loss says nothing about observed native navigation.
+  Record(Event("disconnected"));
+}
+
+void FlashwrightNavigationObserver::SetChangedCallback(base::RepeatingClosure callback) {
+  changed_ = std::move(callback);
+}
+
+void FlashwrightNavigationObserver::Record(base::DictValue record) {
+  IncrementSaturating(record_serial_);
+  if (records_.size() == kMaximumRecords) {
+    overflow_ = true;
+    IncrementSaturating(dropped_records_);
+    if (changed_) changed_.Run();
+    return;
+  }
+  record.Set("recordSerial", base::NumberToString(record_serial_));
+  records_.Append(std::move(record));
+  if (changed_) changed_.Run();
+}
+
+bool FlashwrightNavigationObserver::CanRetire() {
+  return !RefreshOwner() && navigations_.empty() && !pending_ && !modal_ &&
+         !tracking_overflow_ && !invalid_or_exhausted_intent_ &&
+         !non_monotonic_intent_;
+}
+
+base::DictValue FlashwrightNavigationObserver::Snapshot() {
+  const bool owner_alive = RefreshOwner();
+  base::DictValue result;
+  result.Set("ownerAlive", owner_alive);
+  result.Set("executionContextId", execution_context_id_);
+  result.Set("rootFrameTreeNodeId", root_frame_tree_node_id_.value());
+  result.Set("bound", receiver_.is_bound());
+  result.Set("disconnected", disconnected_);
+  result.Set("pending", pending_.has_value());
+  result.Set("latestRequestSerial",
+             base::NumberToString(latest_request_serial_));
+  if (pending_) {
+    result.Set("pendingRequestSerial",
+               base::NumberToString(pending_->request_serial));
+    if (pending_->navigation_id) {
+      result.Set("pendingNavigationId",
+                 base::NumberToString(*pending_->navigation_id));
+    }
+  }
+  result.Set("modalOpen", modal_.has_value());
+  result.Set("overflow", overflow_);
+  result.Set("trackingOverflow", tracking_overflow_);
+  result.Set("invalidOrExhaustedIntent", invalid_or_exhausted_intent_);
+  result.Set("nonMonotonicIntent", non_monotonic_intent_);
+  result.Set("droppedRecords", base::NumberToString(dropped_records_));
+  result.Set("droppedStarts", base::NumberToString(dropped_starts_));
+  result.Set("association", "pendingSerialObservedAtNativeStart");
+  result.Set("observedNavigationIds", observed_navigation_ids_.Clone());
+  base::ListValue active;
+  for (const auto& [id, serial] : navigations_) {
+    base::DictValue entry;
+    entry.Set("navigationId", base::NumberToString(id));
+    entry.Set("requestSerial", base::NumberToString(serial));
+    active.Append(std::move(entry));
+  }
+  result.Set("activeNavigations", std::move(active));
+  result.Set("records", records_.Clone());
+  return result;
+}
+
+}  // namespace content::protocol
