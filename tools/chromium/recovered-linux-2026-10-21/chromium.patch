+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/execution_context/execution_context_process_service_owner.h"
+
+#include <utility>
+
+#include "base/check.h"
+#include "third_party/blink/public/common/thread_safe_browser_interface_broker_proxy.h"
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "third_party/blink/renderer/platform/blob/blob_registry_owner.h"
+
+namespace blink {
+
+const char ExecutionContextProcessServiceOwner::kSupplementName[] =
+    "ExecutionContextProcessServiceOwner";
+
+void ExecutionContextProcessServiceOwner::Install(
+    ExecutionContext& context,
+    scoped_refptr<ThreadSafeBrowserInterfaceBrokerProxy> broker) {
+  DCHECK(context.IsContextThread());
+  CHECK(broker);
+  CHECK(
+      !Supplement<ExecutionContext>::From<ExecutionContextProcessServiceOwner>(
+          context));
+  Supplement<ExecutionContext>::ProvideTo(
+      context, MakeGarbageCollected<ExecutionContextProcessServiceOwner>(
+                   context, std::move(broker)));
+}
+
+ExecutionContextProcessServiceOwner& ExecutionContextProcessServiceOwner::From(
+    ExecutionContext& context) {
+  DCHECK(context.IsContextThread());
+  auto* owner =
+      Supplement<ExecutionContext>::From<ExecutionContextProcessServiceOwner>(
+          context);
+  CHECK(owner);
+  return *owner;
+}
+
+ExecutionContextProcessServiceOwner::ExecutionContextProcessServiceOwner(
+    ExecutionContext& context,
+    scoped_refptr<ThreadSafeBrowserInterfaceBrokerProxy> broker)
+    : Supplement<ExecutionContext>(context), broker_(std::move(broker)) {
+  CHECK(broker_);
+}
+
+ExecutionContextProcessServiceOwner::~ExecutionContextProcessServiceOwner() =
+    default;
+
+scoped_refptr<ThreadSafeBrowserInterfaceBrokerProxy>
+ExecutionContextProcessServiceOwner::Broker() const {
+  DCHECK(GetSupplementable()->IsContextThread());
+  return broker_;
+}
+
+scoped_refptr<BlobRegistryOwner>
+ExecutionContextProcessServiceOwner::GetBlobRegistryOwner() {
+  DCHECK(GetSupplementable()->IsContextThread());
+  if (!blob_registry_owner_) {
+    blob_registry_owner_ = BlobRegistryOwner::Capture(*broker_);
+  }
+  return blob_registry_owner_;
+}
+
+void ExecutionContextProcessServiceOwner::Trace(Visitor* visitor) const {
+  Supplement<ExecutionContext>::Trace(visitor);
+}
+
+}  // namespace blink
