+// found in the LICENSE file.
+
+#ifndef CONTENT_BROWSER_RENDERER_HOST_FLASHWRIGHT_MOUSE_ACK_H_
+#define CONTENT_BROWSER_RENDERER_HOST_FLASHWRIGHT_MOUSE_ACK_H_
+
+#include <optional>
+
+#include "third_party/blink/public/common/input/web_mouse_event.h"
+#include "third_party/blink/public/mojom/input/input_event_result.mojom-shared.h"
+
+namespace content {
+
+// Native dispatch evidence only. Even a renderer ACK does not establish that
+// the intended DOM node received input; the action's hit guard owns that fact.
+struct FlashwrightMouseAck {
+  enum class Disposition {
+    kAcknowledged,
+    kIgnored,
+    kIntercepted,
+    kUncertain,
+  };
+  FlashwrightMouseAck(
+      Disposition disposition = Disposition::kUncertain,
+      blink::mojom::InputEventResultSource source =
+          blink::mojom::InputEventResultSource::kUnknown,
+      blink::mojom::InputEventResultState state =
+          blink::mojom::InputEventResultState::kUnknown,
+      std::optional<blink::WebMouseEvent> event = std::nullopt);
+  FlashwrightMouseAck(const FlashwrightMouseAck&);
+  FlashwrightMouseAck(FlashwrightMouseAck&&);
+  FlashwrightMouseAck& operator=(const FlashwrightMouseAck&);
+  FlashwrightMouseAck& operator=(FlashwrightMouseAck&&);
+  ~FlashwrightMouseAck();
+  Disposition disposition = Disposition::kUncertain;
+  blink::mojom::InputEventResultSource source =
+      blink::mojom::InputEventResultSource::kUnknown;
+  blink::mojom::InputEventResultState state =
+      blink::mojom::InputEventResultState::kUnknown;
+  // Preserve the router's acknowledged event for ACK-time drag handling,
+  // including its timestamp used to identify the drag-starting movement.
+  std::optional<blink::WebMouseEvent> event;
+};
+
+}  // namespace content
+
+#endif  // CONTENT_BROWSER_RENDERER_HOST_FLASHWRIGHT_MOUSE_ACK_H_
diff --git 1/content/browser/renderer_host/flashwright_topology_trace.h 2/content/browser/renderer_host/flashwright_topology_trace.h
new file mode 100644
index 0000000000..beff29bf98
--- /dev/null
+++ 2/content/browser/renderer_host/flashwright_topology_trace.h
@@ -0,0 +1,265 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CONTENT_BROWSER_RENDERER_HOST_FLASHWRIGHT_TOPOLOGY_TRACE_H_
+#define CONTENT_BROWSER_RENDERER_HOST_FLASHWRIGHT_TOPOLOGY_TRACE_H_
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <string>
+#include <utility>
+
+#include "base/trace_event/typed_macros.h"
+
+namespace content::flashwright_topology {
+
+// Private, browser-UI-sequence diagnostics only. No cache, endpoint ownership,
+// policy query, clock conversion, or alternate topology path is introduced.
+inline bool Enabled() {
+  return TRACE_EVENT_CATEGORY_ENABLED("navigation.debug");
+}
+
+enum class Mutation {
+  kFrameStructure,
+  kOpenerOrName,
+  kProxyMap,
+  kProxyLiveness,
+  kViewLifetime,
+  kGroupLifetime,
+  kGroupBindingOrStoredPage,
+  kZeroLifetimeCount,
+};
+
+enum class Counter {
+  kOpenerNodes,
+  kOpenerEdges,
+  kOriginalOpeners,
+  kNamedNodes,
+  kOpenerTrees,
+  kBacklinks,
+  kWalkCalls,
+  kWalkNodes,
+  kSameGroupNodes,
+  kDeadSourceSkips,
+  kOuterDelegateSkips,
+  kOuterDelegatePasses,
+  kProxyRequests,
+  kLiveProxyHits,
+  kProxyAllocations,
+  kProxyRevivals,
+  kViewCreateRequests,
+  kViewInitCalls,
+  kProxyInitCalls,
+  kBatchCalls,
+  kBatchChildren,
+  kBatchMessages,
+  kBacklinkRepairs,
+  kCount,
+};
+
+struct Navigation {
+  int64_t id = 0;
+  int frame = -1;
+};
+
+struct Pass {
+  uint64_t id = 0;
+  int64_t navigation_id = 0;
+  uint64_t mutation_mask = 0;
+  uint64_t epoch_start = 0;
+  std::array<uint64_t, static_cast<size_t>(Counter::kCount)> counters{};
+  bool saturated = false;
+  bool nested_pass = false;
+};
+
+// Inline TLS is shared by the participating translation units. State is fixed
+// size, process/thread local and non-owning; no per-frame registry is retained.
+inline thread_local Navigation navigation;
+inline thread_local Pass pass;
+inline thread_local uint64_t serial = 0;
+inline thread_local uint64_t mutation_epoch = 0;
+inline thread_local bool epoch_saturated = false;
+
+inline void Bump(Mutation kind) {
+  if (!Enabled()) {
+    return;
+  }
+  if (mutation_epoch == std::numeric_limits<uint64_t>::max()) {
+    epoch_saturated = true;
+  } else {
+    ++mutation_epoch;
+  }
+  if (pass.id) {
+    pass.mutation_mask |= uint64_t{1} << static_cast<unsigned>(kind);
+  }
+}
+
+inline void Count(Counter kind, uint64_t amount = 1) {
+  if (!pass.id || pass.navigation_id != navigation.id) {
+    return;
+  }
+  auto& value = pass.counters[static_cast<size_t>(kind)];
+  if (amount > std::numeric_limits<uint64_t>::max() - value) {
+    pass.saturated = true;
+  } else {
+    value += amount;
+  }
+}
+
+class NavigationScope {
+ public:
+  NavigationScope(int64_t id, int frame) : enabled_(Enabled()) {
+    if (!enabled_) {
+      return;
+    }
+    previous_ = navigation;
+    navigation = {id, frame};
+    TRACE_EVENT_BEGIN("navigation.debug", "Topology.NavigationDispatch",
+                      "navigation_id", id, "frame", frame);
+  }
+  ~NavigationScope() {
+    if (!enabled_) {
+      return;
+    }
+    TRACE_EVENT_END("navigation.debug");
+    navigation = previous_;
+  }
+  NavigationScope(const NavigationScope&) = delete;
+  NavigationScope& operator=(const NavigationScope&) = delete;
+
+ private:
+  const bool enabled_;
+  Navigation previous_;
+};
+
+struct Identity {
+  int64_t frame;
+  int64_t root;
+  int64_t old_site_instance;
+  int64_t new_site_instance;
+  int64_t old_group;
+  int64_t new_group;
+  int64_t old_browsing_instance;
+  int64_t new_browsing_instance;
+  int64_t old_process;
+  int64_t new_process;
+  int64_t old_routing;
+  uint64_t exclusions;
+};
+
+// Exclusions: initial=1, changed group=2, changed BI=4, changed BCS=8,
+// recovery=16, inactive=32, dead frame=64, non-primary tree=128,
+// non-live view=256, source has descendants=512, unowned dispatch=1024.
+// These are necessary observations, never an optimization authorization.
+class PreparationScope {
+ public:
+  PreparationScope(const Identity& identity, const std::string& document)
+      : previous_(pass) {
+    previous_.nested_pass |= previous_.id != 0;
+    pass = {};
+    if (serial == std::numeric_limits<uint64_t>::max()) {
+      pass.saturated = true;
+    } else {
+      ++serial;
+    }
+    pass.id = serial;
+    pass.navigation_id = navigation.id;
+    pass.epoch_start = mutation_epoch;
+    TRACE_EVENT_BEGIN(
+        "navigation.debug", "Topology.Prepare", "pass_id", pass.id,
+        "navigation_id", navigation.id, "epoch_start", mutation_epoch,
+        "document", document, "identity", [&](perfetto::TracedValue value) {
+          auto dict = std::move(value).WriteDictionary();
+          dict.Add("frame", identity.frame);
+          dict.Add("root", identity.root);
+          dict.Add("old_site_instance", identity.old_site_instance);
+          dict.Add("new_site_instance", identity.new_site_instance);
+          dict.Add("old_group", identity.old_group);
+          dict.Add("new_group", identity.new_group);
+          dict.Add("old_browsing_instance", identity.old_browsing_instance);
+          dict.Add("new_browsing_instance", identity.new_browsing_instance);
+          dict.Add("old_process", identity.old_process);
+          dict.Add("new_process", identity.new_process);
+          dict.Add("old_routing", identity.old_routing);
+          dict.Add("exclusions", identity.exclusions);
+        });
+  }
+  ~PreparationScope() {
+    TRACE_EVENT_END(
+        "navigation.debug", "pass_id", pass.id, "epoch_end", mutation_epoch,
+        "changed_topology_during_pass", mutation_epoch != pass.epoch_start,
+        "mutation_mask", pass.mutation_mask, "saturated",
+        pass.saturated || epoch_saturated, "nested_pass", pass.nested_pass,
+        "counts", [&](perfetto::TracedValue value) {
+          auto dict = std::move(value).WriteDictionary();
+          dict.Add("opener_nodes",
+                   pass.counters[static_cast<size_t>(Counter::kOpenerNodes)]);
+          dict.Add("opener_edges",
+                   pass.counters[static_cast<size_t>(Counter::kOpenerEdges)]);
+          dict.Add(
+              "original_openers",
+              pass.counters[static_cast<size_t>(Counter::kOriginalOpeners)]);
+          dict.Add("named_nodes",
+                   pass.counters[static_cast<size_t>(Counter::kNamedNodes)]);
+          dict.Add("opener_trees",
+                   pass.counters[static_cast<size_t>(Counter::kOpenerTrees)]);
+          dict.Add("backlinks",
+                   pass.counters[static_cast<size_t>(Counter::kBacklinks)]);
+          dict.Add("walk_calls",
+                   pass.counters[static_cast<size_t>(Counter::kWalkCalls)]);
+          dict.Add("walk_nodes",
+                   pass.counters[static_cast<size_t>(Counter::kWalkNodes)]);
+          dict.Add(
+              "same_group_nodes",
+              pass.counters[static_cast<size_t>(Counter::kSameGroupNodes)]);
+          dict.Add(
+              "dead_source_skips",
+              pass.counters[static_cast<size_t>(Counter::kDeadSourceSkips)]);
+          dict.Add(
+              "outer_delegate_skips",
+              pass.counters[static_cast<size_t>(Counter::kOuterDelegateSkips)]);
+          dict.Add("outer_delegate_passes",
+                   pass.counters[static_cast<size_t>(
+                       Counter::kOuterDelegatePasses)]);
+          dict.Add("proxy_requests",
+                   pass.counters[static_cast<size_t>(Counter::kProxyRequests)]);
+          dict.Add("live_proxy_hits",
+                   pass.counters[static_cast<size_t>(Counter::kLiveProxyHits)]);
+          dict.Add(
+              "proxy_allocations",
+              pass.counters[static_cast<size_t>(Counter::kProxyAllocations)]);
+          dict.Add("proxy_revivals",
+                   pass.counters[static_cast<size_t>(Counter::kProxyRevivals)]);
+          dict.Add(
+              "view_create_requests",
+              pass.counters[static_cast<size_t>(Counter::kViewCreateRequests)]);
+          dict.Add("view_init_calls",
+                   pass.counters[static_cast<size_t>(Counter::kViewInitCalls)]);
+          dict.Add(
+              "proxy_init_calls",
+              pass.counters[static_cast<size_t>(Counter::kProxyInitCalls)]);
+          dict.Add("batch_calls",
+                   pass.counters[static_cast<size_t>(Counter::kBatchCalls)]);
+          dict.Add("batch_children",
+                   pass.counters[static_cast<size_t>(Counter::kBatchChildren)]);
+          dict.Add("batch_messages",
+                   pass.counters[static_cast<size_t>(Counter::kBatchMessages)]);
+          dict.Add(
+              "backlink_repairs",
+              pass.counters[static_cast<size_t>(Counter::kBacklinkRepairs)]);
+        });
+    pass = previous_;
+  }
+  PreparationScope(const PreparationScope&) = delete;
+  PreparationScope& operator=(const PreparationScope&) = delete;
+
+ private:
+  Pass previous_;
+};
+
+}  // namespace content::flashwright_topology
+
+#endif  // CONTENT_BROWSER_RENDERER_HOST_FLASHWRIGHT_TOPOLOGY_TRACE_H_
