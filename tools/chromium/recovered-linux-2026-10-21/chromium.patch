new file mode 100644
index 0000000000..64ce4ede67
--- /dev/null
+++ 2/content/renderer/frame_routing_info_provider.cc
@@ -0,0 +1,99 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/renderer/frame_routing_info_provider.h"
+
+#include <utility>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "third_party/blink/public/common/thread_safe_browser_interface_broker_proxy.h"
+
+namespace content {
+
+FrameRoutingInfoProvider::FrameRoutingInfoProvider(
+    scoped_refptr<blink::ThreadSafeBrowserInterfaceBrokerProxy>
+        original_process_broker,
+    bool use_cache)
+    : original_process_broker_(std::move(original_process_broker)),
+      use_cache_(use_cache) {
+  CHECK(original_process_broker_);
+  if (use_cache_) {
+    RequestCacheRefill();
+  }
+}
+
+FrameRoutingInfoProvider::~FrameRoutingInfoProvider() = default;
+
+base::RepeatingCallback<mojom::FrameRoutingInfoPtr()>
+FrameRoutingInfoProvider::GetRoutingInformationCallback() {
+  return base::BindRepeating(
+      [](base::WeakPtr<FrameRoutingInfoProvider> original_provider)
+          -> mojom::FrameRoutingInfoPtr {
+        return original_provider ? original_provider->GenerateFrameRoutingInfo()
+                                 : nullptr;
+      },
+      weak_factory_.GetWeakPtr());
+}
+
+void FrameRoutingInfoProvider::FlushForTesting() {
+  if (message_filter_) {
+    message_filter_.FlushForTesting();
+  }
+}
+
+mojom::RenderMessageFilter* FrameRoutingInfoProvider::GetMessageFilter() {
+  if (!message_filter_) {
+    original_process_broker_->GetInterface(
+        message_filter_.BindNewPipeAndPassReceiver());
+  }
+  return message_filter_.get();
+}
+
+mojom::FrameRoutingInfoPtr
+FrameRoutingInfoProvider::GenerateFrameRoutingInfo() {
+  if (!use_cache_) {
+    mojom::FrameRoutingInfoPtr routing_information;
+    if (!GetMessageFilter()->GenerateSingleFrameRoutingInfo(
+            &routing_information)) {
+      return nullptr;
+    }
+    return routing_information;
+  }
+
+  if (cached_routing_information_.empty()) {
+    std::vector<mojom::FrameRoutingInfoPtr> routing_information_batch;
+    if (!GetMessageFilter()->GenerateFrameRoutingInfos(
+            &routing_information_batch) ||
+        routing_information_batch.empty()) {
+      return nullptr;
+    }
+    for (auto& routing_information : routing_information_batch) {
+      cached_routing_information_.push_back(std::move(routing_information));
+    }
+  }
+
+  auto routing_information = std::move(cached_routing_information_.front());
+  cached_routing_information_.pop_front();
+  if (!refill_pending_ && cached_routing_information_.size() <= 2) {
+    RequestCacheRefill();
+  }
+  return routing_information;
+}
+
+void FrameRoutingInfoProvider::RequestCacheRefill() {
+  refill_pending_ = true;
+  GetMessageFilter()->GenerateFrameRoutingInfos(base::BindOnce(
+      &FrameRoutingInfoProvider::PopulateCache, weak_factory_.GetWeakPtr()));
+}
+
+void FrameRoutingInfoProvider::PopulateCache(
+    std::vector<mojom::FrameRoutingInfoPtr> routing_information_batch) {
+  refill_pending_ = false;
+  for (auto& routing_information : routing_information_batch) {
+    cached_routing_information_.push_back(std::move(routing_information));
+  }
+}
+
+}  // namespace content
