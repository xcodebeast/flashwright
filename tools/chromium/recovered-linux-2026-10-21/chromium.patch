diff --git 1/third_party/blink/renderer/core/inspector/flashwright_capability_record.h 2/third_party/blink/renderer/core/inspector/flashwright_capability_record.h
new file mode 100644
index 0000000000..9fd7454c06
--- /dev/null
+++ 2/third_party/blink/renderer/core/inspector/flashwright_capability_record.h
@@ -0,0 +1,28 @@
+// Private native discovery and violation diagnostics.
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_INSPECTOR_FLASHWRIGHT_CAPABILITY_RECORD_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_INSPECTOR_FLASHWRIGHT_CAPABILITY_RECORD_H_
+#include "third_party/blink/public/common/storage_key/flashwright_capability_ledger.h"
+#include "third_party/blink/renderer/bindings/core/v8/capture_source_location.h"
+#include "third_party/blink/renderer/core/frame/local_dom_window.h"
+#include "third_party/blink/renderer/core/dom/document.h"
+namespace blink::flashwright {
+inline void RecordExecutionCapability(bool excluded, std::string_view capability,
+                                     std::string_view operation, ExecutionContext* context,
+                                     base::DictValue details = {}) {
+  if (!ShouldRecordCapability(excluded)) return;
+  CapabilityRecordTransaction transaction;
+  auto* source = CaptureSourceLocation(context);
+  const std::string script_url = source->Url().Utf8();
+  details.Set("scriptUrl", script_url.substr(0, 4096));
+  details.Set("scriptUrlTruncated", script_url.size() > 4096);
+  details.Set("line", static_cast<int>(source->LineNumber()));
+  details.Set("column", static_cast<int>(source->ColumnNumber()));
+  details.Set("executionContext", context->GetExecutionContextToken().ToString());
+  if (auto* window = DynamicTo<LocalDOMWindow>(context)) {
+    if (window->document()) details.Set("document", window->document()->Token().ToString());
+  }
+  RecordCapability(excluded, capability, operation, context->Url().GetString().Utf8(),
+                   "document-url", std::move(details), &transaction);
+}
+}  // namespace blink::flashwright
+#endif
diff --git 1/third_party/blink/renderer/core/inspector/flashwright_indexeddb_discovery.h 2/third_party/blink/renderer/core/inspector/flashwright_indexeddb_discovery.h
new file mode 100644
index 0000000000..a7f0c2cca5
--- /dev/null
+++ 2/third_party/blink/renderer/core/inspector/flashwright_indexeddb_discovery.h
@@ -0,0 +1,38 @@
+// Private IndexedDB dependency discovery; no exclusion policy is admitted.
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_INSPECTOR_FLASHWRIGHT_INDEXEDDB_DISCOVERY_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_INSPECTOR_FLASHWRIGHT_INDEXEDDB_DISCOVERY_H_
+#include "third_party/blink/renderer/core/inspector/flashwright_capability_record.h"
+#include "third_party/blink/public/common/storage_key/flashwright_indexeddb_policy.h"
+#include "third_party/blink/renderer/platform/bindings/exception_state.h"
+#include "third_party/blink/renderer/bindings/core/v8/v8_throw_dom_exception.h"
+namespace blink::flashwright {
+inline void RecordIndexedDBUse(std::string_view operation,
+                               ExecutionContext* context) {
+  if (!ShouldRecordCapability(ExcludeIndexedDB())) return;
+  base::DictValue details;
+  details.Set("realm", context->IsWindow() ? "window" : "worker");
+  RecordExecutionCapability(ExcludeIndexedDB(), "storage.indexedDB", operation, context,
+                            std::move(details));
+}
+inline bool CheckIndexedDBAccess(std::string_view operation,
+                                 ExecutionContext* context,
+                                 ExceptionState& exception_state) {
+  RecordIndexedDBUse(operation, context);
+  if (!ExcludeIndexedDB()) return true;
+  exception_state.ThrowDOMException(DOMExceptionCode::kNotSupportedError,
+      "FlashwrightCapabilityError: storage.indexedDB: IndexedDB access excluded");
+  return false;
+}
+// These existing native getters are also called by the inspector. Its entry
+// guard rejects before calling them, so this overload executes in a JS getter.
+inline bool CheckIndexedDBAccess(std::string_view operation,
+                                 ExecutionContext* context) {
+  RecordIndexedDBUse(operation, context);
+  if (!ExcludeIndexedDB()) return true;
+  V8ThrowDOMException::Throw(context->GetIsolate(),
+      DOMExceptionCode::kNotSupportedError,
+      "FlashwrightCapabilityError: storage.indexedDB: IndexedDB access excluded");
+  return false;
+}
+}  // namespace blink::flashwright
+#endif
diff --git 1/third_party/blink/renderer/core/inspector/flashwright_service_worker_access.h 2/third_party/blink/renderer/core/inspector/flashwright_service_worker_access.h
new file mode 100644
index 0000000000..572d87acf0
--- /dev/null
+++ 2/third_party/blink/renderer/core/inspector/flashwright_service_worker_access.h
@@ -0,0 +1,22 @@
+// Private native service-worker acquisition guard and discovery.
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_INSPECTOR_FLASHWRIGHT_SERVICE_WORKER_ACCESS_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_INSPECTOR_FLASHWRIGHT_SERVICE_WORKER_ACCESS_H_
+#include "third_party/blink/renderer/core/inspector/flashwright_capability_record.h"
+#include "third_party/blink/public/common/storage_key/flashwright_service_worker_policy.h"
+#include "third_party/blink/renderer/platform/bindings/exception_state.h"
+namespace blink::flashwright {
+inline bool CheckServiceWorkerAccess(ExecutionContext* context,
+                                    ExceptionState& exception_state) {
+  const bool excluded = ExcludeServiceWorkers();
+  base::DictValue details;
+  details.Set("realm", context->IsWindow() ? "window" : "worker");
+  RecordExecutionCapability(excluded, "network.serviceWorker",
+                            "navigator.serviceWorker", context,
+                            std::move(details));
+  if (!excluded) return true;
+  exception_state.ThrowDOMException(DOMExceptionCode::kNotSupportedError,
+      "FlashwrightCapabilityError: network.serviceWorker: service worker access excluded");
+  return false;
+}
+}  // namespace blink::flashwright
+#endif
