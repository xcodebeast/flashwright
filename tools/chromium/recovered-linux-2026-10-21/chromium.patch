+}
+
+TEST(SchedulerStateMachineTest, FlashwrightEarlyIdleDeadlineExcludesOtherSchedulers) {
+  using Deadline = SchedulerStateMachine::BeginImplFrameDeadlineMode;
+  base::test::ScopedFeatureList features;
+  features.InitAndEnableFeature(::features::kFlashwrightEarlyIdleFrameDeadline);
+  for (int excluded_mode = 0; excluded_mode < 3; ++excluded_mode) {
