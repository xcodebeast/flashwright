+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_FLASHWRIGHT_ACTION_EXECUTOR_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_FLASHWRIGHT_ACTION_EXECUTOR_H_
+
+#include "base/containers/span.h"
+#include "third_party/blink/public/mojom/frame/flashwright_action.mojom-blink.h"
+#include "third_party/blink/renderer/core/execution_context/execution_context_lifecycle_observer.h"
+#include "third_party/blink/renderer/platform/bindings/trace_wrapper_v8_reference.h"
+#include "third_party/blink/renderer/platform/heap/self_keep_alive.h"
+#include "third_party/blink/renderer/platform/mojo/heap_mojo_associated_receiver.h"
+#include "third_party/blink/renderer/platform/mojo/heap_mojo_associated_remote.h"
+#include "third_party/blink/renderer/platform/wtf/hash_map.h"
+#include "third_party/blink/renderer/platform/wtf/hash_set.h"
+
+namespace blink {
+
+class Document;
+class LocalFrame;
+class ScriptState;
+class ScriptValue;
+
+class FlashwrightActionExecutor final
+    : public GarbageCollected<FlashwrightActionExecutor>,
+      public ExecutionContextLifecycleObserver,
+      public mojom::blink::FlashwrightActionExecutor {
+ public:
+  static void Bind(
+      LocalFrame*,
+      mojo::PendingAssociatedReceiver<mojom::blink::FlashwrightActionExecutor>);
+  FlashwrightActionExecutor(
+      Document&,
+      mojo::PendingAssociatedReceiver<mojom::blink::FlashwrightActionExecutor>);
+  ~FlashwrightActionExecutor() override;
+  void Trace(Visitor*) const override;
+  void ContextDestroyed() override;
+  void Initialize(const DocumentToken&, int32_t, InitializeCallback) override;
+  void Run(mojom::blink::FlashwrightActionRequestPtr, RunCallback) override;
+  void ObserveNavigation(
+      mojo::PendingAssociatedRemote<mojom::blink::FlashwrightNavigationClient>,
+      ObserveNavigationCallback) override;
+  void NavigationRequested(uint64_t);
+
+ private:
+  class Settled;
+  enum class Stage {
+    kPreparing,
+    kNeedsReadiness,
+    kReady,
+    kArmed,
+    kClosing,
+    kRetired,
+    kFailed
+  };
+  struct Attempt {
+    Stage stage = Stage::kPreparing;
+    bool busy = false;
+    bool cleanup_pending = false;
+    bool force = false;
+    bool host_owned = false;
+    uint32_t scroll_alignment = 0;
+    bool has_point = false;
+    double x = 0;
+    double y = 0;
+  };
+  bool OriginalDocumentIsLive() const;
+  bool OriginalWorldIsLive() const;
+  void Disconnect();
+  void DisconnectNavigation();
+  void Settle(uint64_t,
+              const String& token,
+              mojom::blink::FlashwrightActionPhase,
+              bool deferred,
+              bool fulfilled,
+              ScriptState*,
+              ScriptValue);
+  void CleanupToken(const String&);
+  void CompletePreparation(uint64_t, const String&, ScriptState*);
+  mojom::blink::FlashwrightActionResultPtr Geometry(const String&,
+                                                    bool,
+                                                    uint32_t);
+  void ObservePromise(uint64_t,
+                      const String&,
+                      mojom::blink::FlashwrightActionPhase,
+                      bool,
+                      ScriptState*,
+                      bool,
+                      v8::Local<v8::Value>);
+  void Deliver(uint64_t,
+               const String&,
+               mojom::blink::FlashwrightActionPhase,
+               bool,
+               bool,
+               mojom::blink::FlashwrightActionResultPtr);
+  v8::MaybeLocal<v8::Value> Call(const char*, base::span<v8::Local<v8::Value>>);
+
+  Member<Document> document_;
+  Member<ScriptState> script_state_;
+  TraceWrapperV8Reference<v8::Object> runtime_;
+  HeapMojoAssociatedReceiver<mojom::blink::FlashwrightActionExecutor,
+                             FlashwrightActionExecutor>
+      receiver_;
+  HeapMojoAssociatedRemote<mojom::blink::FlashwrightNavigationClient>
+      navigation_client_;
+  SelfKeepAlive<FlashwrightActionExecutor> keep_alive_;
+  HashMap<String, Attempt> attempts_;
+  HashMap<uint64_t, RunCallback> pending_;
+  uint64_t last_serial_ = 0;
+  bool initialized_ = false;
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_FLASHWRIGHT_ACTION_EXECUTOR_H_
diff --git 1/third_party/blink/renderer/core/frame/flashwright_action_geometry.cc 2/third_party/blink/renderer/core/frame/flashwright_action_geometry.cc
new file mode 100644
index 0000000000..dde8808bea
--- /dev/null
+++ 2/third_party/blink/renderer/core/frame/flashwright_action_geometry.cc
@@ -0,0 +1,188 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+
+#include "third_party/blink/renderer/bindings/core/v8/v8_binding_for_core.h"
+#include "third_party/blink/renderer/bindings/core/v8/v8_node.h"
+#include "third_party/blink/renderer/core/dom/document.h"
+#include "third_party/blink/renderer/core/frame/flashwright_action_executor.h"
+#include "third_party/blink/renderer/core/frame/local_dom_window.h"
+#include "third_party/blink/renderer/core/frame/local_frame.h"
+#include "third_party/blink/renderer/core/inspector/inspector_dom_agent.h"
+#include "third_party/blink/renderer/core/inspector/inspector_highlight.h"
+#include "third_party/blink/renderer/platform/bindings/script_state.h"
+
+namespace blink {
+namespace {
+using Phase = mojom::blink::FlashwrightActionPhase;
+using Status = mojom::blink::FlashwrightActionStatus;
+using Result = mojom::blink::FlashwrightActionResult;
+
+mojom::blink::FlashwrightActionResultPtr Failure(bool force,
+                                                 const String& detail) {
+  return Result::New(force ? Status::kError : Status::kRetry, detail, nullptr);
+}
+}  // namespace
+
+mojom::blink::FlashwrightActionResultPtr FlashwrightActionExecutor::Geometry(
+    const String& token,
+    bool force,
+    uint32_t alignment) {
+  auto* state = script_state_.Get();
+  ScriptState::Scope scope(state);
+  auto* isolate = state->GetIsolate();
+  v8::TryCatch catcher(isolate);
+  auto live = [&] { return OriginalWorldIsLive() && script_state_ == state; };
+  auto gone = [] {
+    return Result::New(Status::kOwnerGone, String(""), nullptr);
+  };
+  std::array<v8::Local<v8::Value>, 1> token_argument{V8String(isolate, token)};
+  v8::Local<v8::Value> value;
+  const bool got_element =
+      Call("pointerElement", token_argument).ToLocal(&value);
+  if (!live()) {
+    return gone();
+  }
+  if (!got_element || !V8Node::HasInstance(isolate, value)) {
+    return Failure(false, "element detached or attempt expired");
+  }
+  Node* node = V8Node::ToWrappable(isolate, value);
+  if (!node || &node->GetDocument() != document_ || !node->isConnected()) {
+    return Failure(false, "element detached or attempt expired");
+  }
+  if (alignment == 0) {
+    // Share the actual DOM-domain implementation; no protocol reentry and no
+    // separately maintained approximation of native scroll behavior.
+    const auto response =
+        InspectorDOMAgent::ScrollNodeIntoViewIfNeeded(node, nullptr);
+    if (!live()) {
+      return gone();
+    }
+    if (!response.IsSuccess()) {
+      if (response.Message() == "Node does not have a layout object") {
+        return Failure(force, "Element is not visible");
+      }
+      if (response.Message() == "Node is detached from document") {
+        return Failure(false, "element detached");
+      }
+      return Result::New(Status::kError, String::FromUtf8(response.Message()),
+                         nullptr);
+    }
+  } else {
+    const std::array<const char*, 4> alignments{"", "end", "center", "start"};
+    std::array<v8::Local<v8::Value>, 2> arguments{
+        V8String(isolate, token), V8String(isolate, alignments[alignment])};
+    v8::Local<v8::Value> ignored;
+    const bool scrolled = Call("scrollPointer", arguments).ToLocal(&ignored);
+    if (!live()) {
+      return gone();
+    }
+    if (!scrolled) {
+      return Result::New(Status::kError, String("Resident scroll failed"),
+                         nullptr);
+    }
+  }
+  node->GetDocument().EnsurePaintLocationDataValidForNode(
+      node, DocumentUpdateReason::kInspector);
+  if (!live()) {
+    return gone();
+  }
+  if (!node->isConnected() || &node->GetDocument() != document_) {
+    return Failure(false, "element detached");
+  }
+  std::unique_ptr<protocol::Array<protocol::Array<double>>> quads;
+  if (!InspectorHighlight::GetContentQuads(node, &quads)) {
+    return Result::New(Status::kError,
+                       String("Could not compute content quads."), nullptr);
+  }
+  const double width = std::max(0, document_->domWindow()->innerWidth());
+  const double height = std::max(0, document_->domWindow()->innerHeight());
+  if (!live()) {
+    return gone();
+  }
+  for (const auto& quad : *quads) {
+    if (quad->size() != 8) {
+      continue;
+    }
+    std::array<double, 4> x, y;
+    bool finite = true;
+    for (size_t index = 0; index < 4; ++index) {
+      finite &= std::isfinite((*quad)[index * 2]) &&
+                std::isfinite((*quad)[index * 2 + 1]);
+      x[index] = std::clamp((*quad)[index * 2], 0.0, width);
+      y[index] = std::clamp((*quad)[index * 2 + 1], 0.0, height);
+    }
+    double area = 0, center_x = 0, center_y = 0;
+    for (size_t index = 0; index < 4; ++index) {
+      const auto next = (index + 1) % 4;
+      area += (x[index] * y[next] - x[next] * y[index]) / 2;
+      center_x += x[index] / 4;
+      center_y += y[index] / 4;
+    }
+    if (finite && std::abs(area) > 0.99) {
+      return Result::New(Status::kReady, String(""),
+                         mojom::blink::FlashwrightActionPoint::New(
+                             std::trunc(center_x * 100) / 100,
+                             std::trunc(center_y * 100) / 100));
+    }
+  }
+  return Failure(
+      force,
+      "Element is outside of the viewport or has no visible content quad");
+}
+
+void FlashwrightActionExecutor::CompletePreparation(uint64_t serial,
+                                                    const String& token,
+                                                    ScriptState* state) {
+  const auto initial = attempts_.find(token);
+  CHECK(initial != attempts_.end());
+  const bool force = initial->value.force;
+  const auto alignment = initial->value.scroll_alignment;
+  auto geometry = Geometry(token, force, alignment);
+  if (!OriginalWorldIsLive() || script_state_ != state) {
+    Disconnect();
+    return;
+  }
+  auto found = attempts_.find(token);
+  if (found == attempts_.end() || !pending_.Contains(serial)) {
+    return;
+  }
+  if (geometry->status != Status::kReady ||
+      found->value.stage != Stage::kPreparing) {
+    if (geometry->status == Status::kReady) {
+      geometry = Result::New(Status::kExpired, String(""), nullptr);
+    }
+    Deliver(serial, token, Phase::kPrepareAndArm, false, true,
+            std::move(geometry));
+    return;
+  }
+  auto& attempt = found->value;
+  attempt.x = geometry->point->x;
+  attempt.y = geometry->point->y;
+  attempt.has_point = true;
+  attempt.stage = Stage::kArmed;
+  ScriptState::Scope scope(state);
+  auto* isolate = state->GetIsolate();
+  auto context = state->GetContext();
+  v8::TryCatch catcher(isolate);
+  auto point = v8::Object::New(isolate);
+  point
+      ->CreateDataProperty(context, V8String(isolate, "x"),
+                           v8::Number::New(isolate, attempt.x))
+      .Check();
+  point
+      ->CreateDataProperty(context, V8String(isolate, "y"),
+                           v8::Number::New(isolate, attempt.y))
+      .Check();
+  std::array<v8::Local<v8::Value>, 2> arguments{V8String(isolate, token),
+                                                point};
+  v8::Local<v8::Value> value;
+  const bool invoked = Call("armPointer", arguments).ToLocal(&value);
+  ObservePromise(serial, token, Phase::kArm, false, state, invoked, value);
+}
+
+}  // namespace blink
