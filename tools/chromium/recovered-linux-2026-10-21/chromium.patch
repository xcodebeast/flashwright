+  ResourceRequest original_request(url);
+  original_request.SetKnownTransparentPlaceholderImageIndex(0);
+  FetchParameters original_parameters =
+      FetchParameters::CreateForTest(std::move(original_request));
+  auto* original_resource =
+      ImageResource::Fetch(original_parameters, original_fetcher);
+  ExpectLoadedImage(original_resource);
+  ASSERT_TRUE(original_resource);
+  EXPECT_EQ(0u, original_resource->GetResourceRequest()
+                    .GetKnownTransparentPlaceholderImageIndex());
+  EXPECT_EQ(ResourceStatus::kCached, original_resource->GetStatus());
+  EXPECT_EQ(ResourceCacheIdentifierForOwner(
+                *original_broker, MemoryCache::DefaultCacheIdentifier()),
+            original_resource->CacheIdentifier());
+  EXPECT_EQ(original_resource,
+            MemoryCache::Get()->ResourceForURL(
+                url, original_fetcher->GetCacheIdentifier(url, false)));
+  EXPECT_FALSE(MemoryCache::Get()->ResourceForURLForTesting(url));
+
+  ResourceRequest successor_request(url);
+  successor_request.SetKnownTransparentPlaceholderImageIndex(0);
+  FetchParameters successor_parameters =
+      FetchParameters::CreateForTest(std::move(successor_request));
+  auto* successor_resource =
+      ImageResource::Fetch(successor_parameters, successor_fetcher);
+  ExpectLoadedImage(successor_resource);
+  ASSERT_TRUE(successor_resource);
+  EXPECT_NE(original_resource, successor_resource);
+  EXPECT_EQ(ResourceCacheIdentifierForOwner(
+                *successor_broker, MemoryCache::DefaultCacheIdentifier()),
+            successor_resource->CacheIdentifier());
+  EXPECT_EQ(original_resource,
+            ImageResource::Fetch(original_parameters, original_fetcher));
