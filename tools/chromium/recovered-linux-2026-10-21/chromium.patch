diff --git 1/third_party/blink/public/common/storage_key/flashwright_capability_ledger.h 2/third_party/blink/public/common/storage_key/flashwright_capability_ledger.h
new file mode 100644
index 0000000000..259a7b9fb7
--- /dev/null
+++ 2/third_party/blink/public/common/storage_key/flashwright_capability_ledger.h
@@ -0,0 +1,156 @@
+// Private Linux diagnostic experiment. No ledger is enabled by default.
+#ifndef THIRD_PARTY_BLINK_PUBLIC_COMMON_STORAGE_KEY_FLASHWRIGHT_CAPABILITY_LEDGER_H_
+#define THIRD_PARTY_BLINK_PUBLIC_COMMON_STORAGE_KEY_FLASHWRIGHT_CAPABILITY_LEDGER_H_
+#include <cerrno>
+#include <atomic>
+#include <chrono>
+#include <thread>
+#include <cstdlib>
+#include <string>
+#include <string_view>
+#include <fcntl.h>
+#include <sys/file.h>
+#include <sys/stat.h>
+#include <sys/mman.h>
+#include <signal.h>
+#include <optional>
+#include <unistd.h>
+#include "base/check.h"
+#include "third_party/blink/public/common/storage_key/flashwright_capability_retirement.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/memory/raw_ptr.h"
+#include "base/json/json_writer.h"
+#include "base/values.h"
+namespace blink::flashwright {
+inline const char* CapabilityLedgerPath() {
+  static const char* path = std::getenv("FLASHWRIGHT_CAPABILITY_LEDGER");
+  return path;
+}
+inline bool ShouldRecordCapability(bool excluded) {
+  static const bool discovery = [] {
+    const char* value = std::getenv("FLASHWRIGHT_CAPABILITY_DISCOVERY");
+    return value && std::string_view(value) == "1";
+  }();
+  return CapabilityLedgerPath() && (excluded || discovery);
+}
+// Fixed Linux x64 shared state: magic, active writers, completed records,
+// completed violations. Updates use lock-free interprocess 64-bit atomics.
+// A killed renderer cannot clear its active count through a destructor.
+inline void CapabilityLedgerRequire(bool condition) {
+  if (condition) return;
+  const char* expected_group = std::getenv("FLASHWRIGHT_CAPABILITY_OWNER_GROUP");
+  int group = 0;
+  if (expected_group && base::StringToInt(expected_group, &group) && group == getpgrp() && group > 1)
+    kill(-getpgrp(), SIGKILL);
+  _exit(87);
+}
+class CapabilityRecordTransaction {
+ public:
+  CapabilityRecordTransaction() {
+    const char* path = std::getenv("FLASHWRIGHT_CAPABILITY_LEDGER_STATE");
+    const char* identity = std::getenv("FLASHWRIGHT_CAPABILITY_LEDGER_STATE_IDENTITY");
+    CapabilityLedgerRequire(path && identity);
+    int fd;
+    do { fd = open(path, O_RDWR | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK); }
+    while (fd < 0 && errno == EINTR);
+    CapabilityLedgerRequire(fd >= 0);
+    struct stat info;
+    CapabilityLedgerRequire(fstat(fd, &info) == 0 && S_ISREG(info.st_mode) &&
+                            info.st_uid == geteuid() && (info.st_mode & 077) == 0 && info.st_size == 32);
+    CapabilityLedgerRequire(std::to_string(info.st_dev) + ":" + std::to_string(info.st_ino) == identity);
+    if (LedgerRetirementEnabled()) LockLedgerState(fd, LOCK_SH);
+    void* mapping = mmap(nullptr, 32, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    CapabilityLedgerRequire(mapping != MAP_FAILED);
+    state_fd_ = fd;
+    state_ = static_cast<State*>(mapping);
+    CapabilityLedgerRequire(__atomic_load_n(&state_->magic, __ATOMIC_SEQ_CST) == 0x46574c4544474552ULL);
+    __atomic_fetch_add(&state_->active, 1, __ATOMIC_SEQ_CST);
+  }
+  CapabilityRecordTransaction(const CapabilityRecordTransaction&) = delete;
+  ~CapabilityRecordTransaction() {
+    CapabilityLedgerRequire(committed_);
+    CapabilityLedgerRequire(munmap(state_.get(), 32) == 0);
+    CapabilityLedgerRequire(close(state_fd_) == 0);
+  }
+  void Commit(bool excluded) {
+    CapabilityLedgerRequire(!committed_);
+    __atomic_fetch_add(&state_->completed, 1, __ATOMIC_SEQ_CST);
+    if (excluded) __atomic_fetch_add(&state_->violations, 1, __ATOMIC_SEQ_CST);
+    __atomic_fetch_sub(&state_->active, 1, __ATOMIC_SEQ_CST);
+    committed_ = true;
+  }
+ private:
+  struct State { uint64_t magic, active, completed, violations; };
+  static_assert(sizeof(State) == 32);
+  static_assert(__atomic_always_lock_free(8, nullptr));
+  raw_ptr<State> state_ = nullptr;
+  bool committed_ = false;
+  int state_fd_ = -1;
+};
+inline void RecordCapability(bool excluded, std::string_view capability,
+                             std::string_view operation, std::string_view location,
+                             std::string_view location_kind = "document-url",
+                             base::DictValue details = {},
+                             CapabilityRecordTransaction* transaction = nullptr) {
+  if (!ShouldRecordCapability(excluded)) return;
+  std::optional<CapabilityRecordTransaction> local;
+  if (!transaction) { local.emplace(); transaction = &*local; }
+  static std::atomic<unsigned> count{0};
+  CHECK_LT(count.fetch_add(1, std::memory_order_relaxed), 10000u);
+  static const char* attempt = std::getenv("FLASHWRIGHT_CAPABILITY_ATTEMPT");
+  static const char* policy = std::getenv("FLASHWRIGHT_CAPABILITY_POLICY");
+  static const char* identity = std::getenv("FLASHWRIGHT_CAPABILITY_LEDGER_IDENTITY");
+  CHECK(attempt && policy && identity);
+  base::DictValue event;
+  event.Set("attempt", attempt);
+  event.Set("policy", policy);
+  event.Set("details", std::move(details));
+  event.Set("schemaVersion", 1);
+  event.Set("kind", excluded ? "violation" : "use");
+  event.Set("capability", capability);
+  event.Set("operation", operation);
+  event.Set("location", location.substr(0, 4096));
+  event.Set("locationKind", location_kind);
+  event.Set("locationTruncated", location.size() > 4096);
+  event.Set("process", static_cast<int>(getpid()));
+  auto serialized = base::WriteJson(event);
+  CHECK(serialized);
+  serialized->push_back('\n');
+  CHECK_LT(serialized->size(), 16384u);
+  // A private original owner precreates this regular file. Missing or damaged
+  // evidence must terminate the renderer rather than make a caught use pass.
+  int fd;
+  do { fd = open(CapabilityLedgerPath(), O_WRONLY | O_APPEND | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK); }
+  while (fd < 0 && errno == EINTR);
+  CHECK_GE(fd, 0);
+  struct stat info;
+  CHECK_EQ(fstat(fd, &info), 0);
+  CHECK(S_ISREG(info.st_mode));
+  CHECK_EQ(info.st_uid, geteuid());
+  CHECK_EQ(std::to_string(info.st_dev) + ":" + std::to_string(info.st_ino), identity);
+  CHECK_EQ(info.st_mode & 077, 0u);
+  int locked;
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(250);
+  do {
+    locked = flock(fd, LOCK_EX | LOCK_NB);
+    if (locked == 0) break;
+    CHECK(errno == EINTR || errno == EWOULDBLOCK);
+    CHECK(std::chrono::steady_clock::now() < deadline);
+    std::this_thread::sleep_for(std::chrono::milliseconds(1));
+  } while (true);
+  CHECK_EQ(locked, 0);
+  CHECK_EQ(fstat(fd, &info), 0);
+  CHECK_LT(info.st_size + static_cast<off_t>(serialized->size()), 64 * 1024 * 1024);
+  std::string_view remaining(*serialized);
+  while (!remaining.empty()) {
+    ssize_t written = write(fd, remaining.data(), remaining.size());
+    if (written < 0 && errno == EINTR) continue;
+    CHECK_GT(written, 0);
+    remaining.remove_prefix(static_cast<size_t>(written));
+  }
+  CHECK_EQ(flock(fd, LOCK_UN), 0);
+  CHECK_EQ(close(fd), 0);
+  transaction->Commit(excluded);
+}
+}  // namespace blink::flashwright
+#endif
diff --git 1/third_party/blink/public/common/storage_key/flashwright_capability_retirement.h 2/third_party/blink/public/common/storage_key/flashwright_capability_retirement.h
new file mode 100644
index 0000000000..02a750c646
--- /dev/null
+++ 2/third_party/blink/public/common/storage_key/flashwright_capability_retirement.h
@@ -0,0 +1,86 @@
+// Private Linux recorder experiment; inactive without explicit policy.
+#ifndef THIRD_PARTY_BLINK_PUBLIC_COMMON_STORAGE_KEY_FLASHWRIGHT_CAPABILITY_RETIREMENT_H_
+#define THIRD_PARTY_BLINK_PUBLIC_COMMON_STORAGE_KEY_FLASHWRIGHT_CAPABILITY_RETIREMENT_H_
+#include <cerrno>
+#include <chrono>
+#include <cstdlib>
+#include <string>
+#include <string_view>
+#include <thread>
+#include <fcntl.h>
+#include <poll.h>
+#include <sys/file.h>
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+#include "base/check.h"
+namespace blink::flashwright {
+inline bool LedgerRetirementEnabled() {
+  static const bool enabled = [] {
+    const char* value = std::getenv("FLASHWRIGHT_CAPABILITY_RETIREMENT_GUARD");
+    return value && std::string_view(value) == "1" && std::getenv("FLASHWRIGHT_CAPABILITY_LEDGER");
+  }();
+  return enabled;
+}
+inline void LockLedgerState(int fd, int operation) {
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(2);
+  while (flock(fd, operation | LOCK_NB) != 0) {
+    CHECK(errno == EINTR || errno == EWOULDBLOCK);
+    CHECK(std::chrono::steady_clock::now() < deadline);
+    std::this_thread::sleep_for(std::chrono::milliseconds(1));
+  }
+}
+// The renderer IO disconnect path exits itself independently of browser-side
+// termination. Keep this lock until _exit closes all process descriptors.
+inline void PrepareCapabilitySelfRetirement() {
+  if (!LedgerRetirementEnabled()) return;
+  const char* path = std::getenv("FLASHWRIGHT_CAPABILITY_LEDGER_STATE");
+  const char* identity = std::getenv("FLASHWRIGHT_CAPABILITY_LEDGER_STATE_IDENTITY");
+  CHECK(path && identity);
+  int fd = open(path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK);
+  CHECK_GE(fd, 0);
+  struct stat info;
+  CHECK_EQ(fstat(fd, &info), 0);
+  CHECK(S_ISREG(info.st_mode) && info.st_size == 32 && info.st_uid == geteuid() && (info.st_mode & 077) == 0);
+  CHECK_EQ(std::to_string(info.st_dev) + ":" + std::to_string(info.st_ino), identity);
+  LockLedgerState(fd, LOCK_EX);
+  // Intentionally retained: releasing it before immediate process exit would
+  // admit another writer between the drain and that exit.
+}
+class CapabilityProcessRetirement {
+ public:
+  explicit CapabilityProcessRetirement(pid_t pid) {
+    if (!LedgerRetirementEnabled()) return;
+    // A pidfd keeps exit observation tied to this process even if its numeric
+    // PID is later reused. No shared lock is released before that exit.
+    process_fd_ = syscall(SYS_pidfd_open, pid, 0);
+    if (process_fd_ < 0 && errno == ESRCH) return;
+    CHECK_GE(process_fd_, 0);
+    const char* path = std::getenv("FLASHWRIGHT_CAPABILITY_LEDGER_STATE");
+    const char* identity = std::getenv("FLASHWRIGHT_CAPABILITY_LEDGER_STATE_IDENTITY");
+    CHECK(path && identity);
+    state_fd_ = open(path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK);
+    CHECK_GE(state_fd_, 0);
+    struct stat info;
+    CHECK_EQ(fstat(state_fd_, &info), 0);
+    CHECK(S_ISREG(info.st_mode) && info.st_size == 32 && info.st_uid == geteuid() && (info.st_mode & 077) == 0);
+    CHECK_EQ(std::to_string(info.st_dev) + ":" + std::to_string(info.st_ino), identity);
+    LockLedgerState(state_fd_, LOCK_EX);
+  }
+  CapabilityProcessRetirement(const CapabilityProcessRetirement&) = delete;
+  ~CapabilityProcessRetirement() {
+    if (process_fd_ < 0) return;
+    struct pollfd event = {process_fd_, POLLIN, 0};
+    int status;
+    do { status = poll(&event, 1, 2000); } while (status < 0 && errno == EINTR);
+    CHECK_EQ(status, 1);
+    CHECK(event.revents & POLLIN);
+    CHECK_EQ(close(process_fd_), 0);
+    CHECK_EQ(close(state_fd_), 0);
+  }
+ private:
+  int process_fd_ = -1;
+  int state_fd_ = -1;
+};
+}  // namespace blink::flashwright
+#endif
