diff --git 1/third_party/blink/flashwright_fork_probe/managed.cc 2/third_party/blink/flashwright_fork_probe/managed.cc
new file mode 100644
index 0000000000..bd615b8056
--- /dev/null
+++ 2/third_party/blink/flashwright_fork_probe/managed.cc
@@ -0,0 +1,149 @@
+// Private unified-heap ownership and tracing checks, with real Blink spaces.
+#include <atomic>
+#include "base/check.h"
+#include "base/check_op.h"
+#include "gin/public/v8_platform.h"
+#include "third_party/blink/renderer/platform/heap/custom_spaces.h"
+#include "v8/include/cppgc/allocation.h"
+#include "v8/include/cppgc/member.h"
+#include "v8/include/cppgc/visitor.h"
+#include "v8/include/v8.h"
+#include "v8/include/v8-cppgc.h"
+
+void ForceForkProbeGC(v8::Isolate*);
+namespace {
+bool omit_member_trace = false;
+bool omit_js_trace = false;
+}
+
+void ConfigureManagedForkProbe(bool omit_member, bool omit_js) {
+  omit_member_trace = omit_member;
+  omit_js_trace = omit_js;
+}
+
+template<bool custom>
+class Payload final : public v8::Object::Wrappable {
+ public:
+  explicit Payload(int value) : value(value) { ++live; }
+  ~Payload() { --live; }
+  void Trace(cppgc::Visitor* visitor) const override {
+    if (!omit_member_trace) visitor->Trace(child);
+    if (!omit_js_trace) visitor->Trace(js);
+  }
+  int value;
+  cppgc::Member<Payload> child;
+  v8::TracedReference<v8::Object> js;
+  static inline std::atomic<int> live{0};
+};
+
+namespace cppgc {
+template<> struct SpaceTrait<Payload<true>> { using Space = blink::NodeSpace; };
+}
+
+std::unique_ptr<v8::CppHeap> CreateBlinkConfiguredForkHeap() {
+  return v8::CppHeap::Create(gin::V8Platform::Get(),
+      v8::CppHeapCreateParams(blink::CustomSpaces::CreateCustomSpaces()));
+}
+
+struct Graph {
+  v8::Global<v8::Object> root;
+  v8::Global<v8::Object> weak_js;
+};
+
+template<bool custom> Graph* inherited = nullptr;
+
+template<bool custom>
+void Populate(v8::Isolate* isolate, Graph& graph) {
+  using Node = Payload<custom>;
+  CHECK_EQ(Node::live.load(), 0);
+  auto context = isolate->GetCurrentContext();
+  auto& allocation = isolate->GetCppHeap()->GetAllocationHandle();
+  {
+    v8::HandleScope temporary(isolate);
+    auto* node = cppgc::MakeGarbageCollected<Node>(allocation, 27);
+    node->child = cppgc::MakeGarbageCollected<Node>(allocation, 91);
+    auto js = v8::Object::New(isolate);
+    CHECK(js->Set(context, v8::String::NewFromUtf8Literal(isolate, "sentinel"),
+                  v8::Integer::New(isolate, 163)).FromJust());
+    node->child->js.Reset(isolate, js);
+    graph.weak_js.Reset(isolate, js);
+    graph.weak_js.SetWeak();
+    auto function = v8::FunctionTemplate::New(isolate)
+        ->GetFunction(context).ToLocalChecked();
+    auto wrapper = function->NewInstance(context).ToLocalChecked();
+    v8::Object::Wrap<v8::CppHeapPointerTag::kDefaultTag>(isolate, wrapper, node);
+    graph.root.Reset(isolate, wrapper);
+  }
+}
+
+template<bool custom>
+void CollectAndCheck(v8::Isolate* isolate, Graph& graph) {
+  using Node = Payload<custom>;
+  auto context = isolate->GetCurrentContext();
+  ForceForkProbeGC(isolate);
+  CHECK_EQ(Node::live.load(), 2);
+  CHECK(!graph.weak_js.IsEmpty());
+  {
+    v8::HandleScope temporary(isolate);
+    auto* node = v8::Object::Unwrap<v8::CppHeapPointerTag::kDefaultTag, Node>(
+        isolate, graph.root.Get(isolate));
+    CHECK(node);
+    CHECK_EQ(node->value, 27);
+    CHECK_EQ(node->child->value, 91);
+    CHECK(node->child->js.Get(isolate)->StrictEquals(graph.weak_js.Get(isolate)));
+    CHECK_EQ(node->child->js.Get(isolate)->Get(context,
+        v8::String::NewFromUtf8Literal(isolate, "sentinel"))
+        .ToLocalChecked()->Int32Value(context).FromJust(), 163);
+  }
+  graph.root.Reset();
+  ForceForkProbeGC(isolate);
+  CHECK_EQ(Node::live.load(), 0);
+  CHECK(graph.weak_js.IsEmpty());
+}
+
+template<bool custom>
+void Exercise(v8::Isolate* isolate) {
+  Graph graph;
+  Populate<custom>(isolate, graph);
+  for (int i = 0; i < 1000; ++i)
+    cppgc::MakeGarbageCollected<Payload<custom>>(
+        isolate->GetCppHeap()->GetAllocationHandle(), i);
+  CollectAndCheck<custom>(isolate, graph);
+}
+
+void ExerciseManagedForkHeap(v8::Isolate* isolate, bool custom) {
+  if (custom) Exercise<true>(isolate);
+  else Exercise<false>(isolate);
+}
+
+void PrepareManagedForkHeap(v8::Isolate* isolate, bool custom) {
+  v8::Isolate::Scope entered(isolate);
+  v8::HandleScope handles(isolate);
+  auto context = v8::Context::New(isolate);
+  v8::Context::Scope scope(context);
+  if (custom) {
+    CHECK(!inherited<true>);
+    inherited<true> = new Graph;
+    Populate<true>(isolate, *inherited<true>);
+  } else {
+    CHECK(!inherited<false>);
+    inherited<false> = new Graph;
+    Populate<false>(isolate, *inherited<false>);
+  }
+}
+
+void CheckInheritedManagedForkHeap(v8::Isolate* isolate, bool custom) {
+  v8::Isolate::Scope entered(isolate);
+  v8::HandleScope handles(isolate);
+  auto context = v8::Context::New(isolate);
+  v8::Context::Scope scope(context);
+  if (custom) {
+    CollectAndCheck<true>(isolate, *inherited<true>);
+    delete inherited<true>;
+    inherited<true> = nullptr;
+  } else {
+    CollectAndCheck<false>(isolate, *inherited<false>);
+    delete inherited<false>;
+    inherited<false> = nullptr;
+  }
+}
