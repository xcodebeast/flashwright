+      generation != handler->flashwright_generation_ ||
+      frame->GetOutermostMainFrame() != frame || !widget || !widget->delegate() ||
+      !widget->GetView() || !widget->delegate()->GetInputEventRouter() ||
+      handler->drag_controller_.IsDragging()) {
+    std::move(callback).Run(
+        Response::ServerError("Routed mouse owner unavailable or dragging"),
+        FlashwrightMouseAck());
+    return;
+  }
