+TEST_F(ResourceCacheOwnerTest, SameBrokerFetchersShareStaticImage) {
+  auto broker = CreateBroker();
+  platform_->SelectBroker(broker);
+  auto* first_fetcher = CreateFetcher();
+  auto* second_fetcher = CreateFetcher();
+
+  auto* first_resource = FetchStaticImage(first_fetcher);
+  auto* second_resource = FetchStaticImage(second_fetcher);
+  ExpectLoadedImage(first_resource);
+  ExpectLoadedImage(second_resource);
+  ASSERT_TRUE(first_resource);
+  EXPECT_EQ(kNotFound, first_resource->GetResourceRequest()
+                           .GetKnownTransparentPlaceholderImageIndex());
+  EXPECT_EQ(first_resource, second_resource);
+  EXPECT_EQ(ResourceCacheIdentifierForOwner(
+                *broker, MemoryCache::DefaultCacheIdentifier()),
+            first_resource->CacheIdentifier());
+}
+
+TEST_F(ResourceCacheOwnerTest, DifferentBrokersKeepStaticImagesSeparate) {
+  auto first_broker = CreateBroker();
+  auto second_broker = CreateBroker();
+  platform_->SelectBroker(first_broker);
+  auto* first_fetcher = CreateFetcher();
+  auto* first_resource = FetchStaticImage(first_fetcher);
+  platform_->SelectBroker(second_broker);
+  auto* second_fetcher = CreateFetcher();
+  auto* second_resource = FetchStaticImage(second_fetcher);
+
+  ExpectLoadedImage(first_resource);
+  ExpectLoadedImage(second_resource);
+  ASSERT_TRUE(first_resource);
+  ASSERT_TRUE(second_resource);
+  EXPECT_NE(first_resource, second_resource);
+  EXPECT_NE(first_resource->CacheIdentifier(),
+            second_resource->CacheIdentifier());
+  EXPECT_EQ(first_resource, FetchStaticImage(first_fetcher));
+  EXPECT_EQ(second_resource, FetchStaticImage(second_fetcher));
+}
+
+TEST_F(ResourceCacheOwnerTest, PlatformSwitchPreservesOriginalFetcherOwner) {
+  auto original_broker = CreateBroker();
+  auto successor_broker = CreateBroker();
+  platform_->SelectBroker(original_broker);
+  auto* original_fetcher = CreateFetcher();
+  const KURL url(kStaticImageURL);
+  const String original_identifier =
+      original_fetcher->GetCacheIdentifier(url, false);
+  auto* original_resource = FetchStaticImage(original_fetcher);
+
+  platform_->SelectBroker(successor_broker);
+  auto* successor_fetcher = CreateFetcher();
+  auto* successor_resource = FetchStaticImage(successor_fetcher);
+  auto* original_resource_after_switch = FetchStaticImage(original_fetcher);
+  ExpectLoadedImage(original_resource);
+  ExpectLoadedImage(successor_resource);
+  ExpectLoadedImage(original_resource_after_switch);
+  ASSERT_TRUE(original_resource);
+  ASSERT_TRUE(successor_resource);
+  EXPECT_EQ(original_identifier,
+            original_fetcher->GetCacheIdentifier(url, false));
+  EXPECT_EQ(original_identifier, original_resource->CacheIdentifier());
+  EXPECT_EQ(original_resource, original_resource_after_switch);
+  EXPECT_NE(original_resource, successor_resource);
+  EXPECT_NE(original_identifier, successor_resource->CacheIdentifier());
