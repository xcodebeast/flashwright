+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CONTENT_BROWSER_RENDERER_HOST_RENDERER_PROCESS_OWNER_H_
+#define CONTENT_BROWSER_RENDERER_HOST_RENDERER_PROCESS_OWNER_H_
+
+#include <memory>
+
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "content/browser/child_process_launcher.h"
+#include "content/browser/renderer_host/renderer_process_owner_client.h"
+#include "content/common/content_export.h"
+
+namespace content {
+
+class RendererProcessTransport;
+
+// Owns one physical renderer launch, including its asynchronous termination and
+// platform process bookkeeping. Launch notifications retain their original
+// logical client; process-fatal errors do not depend on that client surviving.
+// Retains the primordial transport through launcher destruction. Logical
+// browser connections still belong to the original RenderProcessHostImpl.
+class CONTENT_EXPORT RendererProcessOwner final
+    : public ChildProcessLauncher::Client {
+ public:
+  RendererProcessOwner(
+      std::unique_ptr<SandboxedProcessLauncherDelegate> delegate,
+      std::unique_ptr<base::CommandLine> command_line,
+      ChildProcessId child_process_id,
+      base::WeakPtr<RendererProcessOwnerClient> client,
+      mojo::OutgoingInvitation invitation,
+      mojo::ProcessErrorCallback diagnostic_callback,
+      std::unique_ptr<ChildProcessLauncherFileData> file_data,
+      scoped_refptr<base::RefCountedData<base::UnsafeSharedMemoryRegion>>
+          histogram_memory_region,
+      scoped_refptr<base::RefCountedData<base::ReadOnlySharedMemoryRegion>>
+          trace_config_memory_region,
+      scoped_refptr<base::RefCountedData<base::UnsafeSharedMemoryRegion>>
+          trace_output_memory_region,
+      RendererProcessTransport* transport = nullptr);
+  RendererProcessOwner(const RendererProcessOwner&) = delete;
+  RendererProcessOwner& operator=(const RendererProcessOwner&) = delete;
+  ~RendererProcessOwner() override;
+
+  bool IsStarting();
+
+  // UI-only launch/termination admission. The caller must separately prove
+  // logical retirement and configuration compatibility. Moving this owner
+  // never redirects its original callbacks; late fatal errors still kill it.
+  bool CanTransferPhysicalCustody();
+  const base::Process& GetProcess() const;
+  ChildProcessTerminationInfo GetChildTerminationInfo(bool known_dead);
+  bool Terminate(int exit_code);
+
+#if BUILDFLAG(IS_ANDROID)
+  void SetRenderProcessPriority(const RenderProcessPriority& priority);
+  base::android::ChildBindingState GetEffectiveChildBindingState();
+  void DumpProcessStack();
+#else
+  void SetProcessPriority(base::Process::Priority priority);
+#endif
+
+  ChildProcessLauncher::Client* ReplaceClientForTest(
+      ChildProcessLauncher::Client* client);
+
+ private:
+  friend class RendererProcessOwnerTest;
+
+  mojo::ProcessErrorCallback CreateProcessErrorCallback(
+      mojo::ProcessErrorCallback diagnostic_callback);
+
+  void OnProcessLaunched() override;
+  void OnProcessLaunchFailed(int error_code) override;
+#if BUILDFLAG(IS_ANDROID)
+  bool CanUseWarmUpConnection() override;
+  bool HasSpareRendererPriority() override;
+  void OnSpareRendererPriorityGraduated(bool is_alive) override;
+#endif
+
+  // Runs on UI even when the invitation reports its error on another thread.
+  void OnFatalProcessError();
+
+  const base::WeakPtr<RendererProcessOwnerClient> client_;
+  // Declared before launcher_ so physical IPC/services outlive its destruction.
+  const scoped_refptr<RendererProcessTransport> transport_;
+  std::unique_ptr<ChildProcessLauncher> launcher_;
+  bool launch_notification_completed_ = false;
+  bool fatal_error_pending_ = false;
+  bool termination_requested_ = false;
+  base::WeakPtrFactory<RendererProcessOwner> weak_factory_{this};
+};
+
+}  // namespace content
+
+#endif  // CONTENT_BROWSER_RENDERER_HOST_RENDERER_PROCESS_OWNER_H_
