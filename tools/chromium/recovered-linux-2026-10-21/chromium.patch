+
+#include "third_party/blink/renderer/core/frame/flashwright_action_executor.h"
+
+#include "third_party/blink/renderer/core/frame/flashwright_action_navigation.h"
+
+#include <cmath>
+#include <limits>
+#include <utility>
+
+#include "third_party/blink/renderer/bindings/core/v8/local_window_proxy.h"
+#include "third_party/blink/renderer/bindings/core/v8/script_promise.h"
+#include "third_party/blink/renderer/bindings/core/v8/v8_binding_for_core.h"
+#include "third_party/blink/renderer/bindings/core/v8/v8_script_runner.h"
+#include "third_party/blink/renderer/bindings/core/v8/window_proxy_manager.h"
+#include "third_party/blink/renderer/core/dom/document.h"
+#include "third_party/blink/renderer/core/frame/local_dom_window.h"
+#include "third_party/blink/renderer/core/frame/local_frame.h"
+#include "third_party/blink/renderer/platform/bindings/dom_wrapper_world.h"
+#include "third_party/blink/renderer/platform/bindings/script_state.h"
+#include "third_party/blink/renderer/platform/wtf/functional.h"
+#include "v8/include/v8-inspector.h"
+
+namespace blink {
+namespace {
+using Phase = mojom::blink::FlashwrightActionPhase;
+using Status = mojom::blink::FlashwrightActionStatus;
+using Result = mojom::blink::FlashwrightActionResult;
+
+mojom::blink::FlashwrightActionResultPtr Reply(
+    Status status,
+    const String& detail = String()) {
+  return Result::New(status, detail.IsNull() ? String("") : detail, nullptr);
+}
+
+v8::Local<v8::Value> Property(ScriptState* state,
+                              v8::Local<v8::Object> object,
+                              const char* name) {
+  if (!state->ContextIsValid()) {
+    return v8::Undefined(state->GetIsolate());
+  }
+  v8::Local<v8::Value> value;
+  if (!object->Get(state->GetContext(), V8String(state->GetIsolate(), name))
+           .ToLocal(&value)) {
+    return v8::Undefined(state->GetIsolate());
+  }
+  return value;
+}
+
+String StringValue(ScriptState* state, v8::Local<v8::Value> value) {
+  if (!value->IsString()) {
+    return String();
+  }
+  return ToCoreString(state->GetIsolate(), value.As<v8::String>());
+}
+
+// Resident pointer diagnostics use the existing exact UTF-16 value codec.
+String Detail(ScriptState* state, v8::Local<v8::Value> value) {
+  if (!value->IsObject()) {
+    return String();
+  }
+  auto units = Property(state, value.As<v8::Object>(), "units");
+  if (!units->IsArray()) {
+    return String();
+  }
+  auto array = units.As<v8::Array>();
+  if (array->Length() > 100000) {
+    return "Native action diagnostic exceeds its bound";
+  }
+  Vector<UChar> result;
+  result.ReserveInitialCapacity(array->Length());
+  for (uint32_t index = 0; index < array->Length(); ++index) {
+    v8::Local<v8::Value> unit;
+    if (!array->Get(state->GetContext(), index).ToLocal(&unit) ||
+        !unit->IsUint32()) {
+      return "Invalid native action diagnostic";
+    }
+    const auto number = unit.As<v8::Uint32>()->Value();
+    if (number > 65535) {
+      return "Invalid native action diagnostic";
+    }
+    result.push_back(static_cast<UChar>(number));
+  }
+  return String(result);
+}
+}  // namespace
+
+class FlashwrightActionExecutor::Settled final
+    : public ThenCallable<IDLAny, Settled> {
+ public:
+  Settled(FlashwrightActionExecutor* executor,
+          uint64_t serial,
+          const String& token,
+          Phase phase,
+          bool deferred,
+          bool fulfilled)
+      : executor_(executor),
+        serial_(serial),
+        token_(token),
+        phase_(phase),
+        deferred_(deferred),
+        fulfilled_(fulfilled) {}
+  void React(ScriptState* state, ScriptValue value) {
+    executor_->Settle(serial_, token_, phase_, deferred_, fulfilled_, state,
+                      value);
+  }
+  void Trace(Visitor* visitor) const override {
+    visitor->Trace(executor_);
+    ThenCallable<IDLAny, Settled>::Trace(visitor);
+  }
+
+ private:
+  Member<FlashwrightActionExecutor> executor_;
+  const uint64_t serial_;
+  const String token_;
+  const Phase phase_;
+  const bool deferred_;
+  const bool fulfilled_;
+};
+
+void FlashwrightActionExecutor::Bind(
+    LocalFrame* frame,
+    mojo::PendingAssociatedReceiver<mojom::blink::FlashwrightActionExecutor>
+        receiver) {
+  if (!frame || !frame->GetDocument() || !frame->GetDocument()->IsActive()) {
+    return;
+  }
+  MakeGarbageCollected<FlashwrightActionExecutor>(*frame->GetDocument(),
+                                                  std::move(receiver));
+}
+
+FlashwrightActionExecutor::FlashwrightActionExecutor(
+    Document& document,
+    mojo::PendingAssociatedReceiver<mojom::blink::FlashwrightActionExecutor>
+        receiver)
+    : ExecutionContextLifecycleObserver(document.GetExecutionContext()),
+      document_(&document),
+      receiver_(this, document.GetExecutionContext()),
+      navigation_client_(document.GetExecutionContext()),
+      keep_alive_(this) {
+  receiver_.Bind(std::move(receiver),
+                 document.GetTaskRunner(TaskType::kInternalDefault));
+  receiver_.set_disconnect_handler(BindOnce(
+      &FlashwrightActionExecutor::Disconnect, WrapWeakPersistent(this)));
+}
+
+FlashwrightActionExecutor::~FlashwrightActionExecutor() = default;
+
+void FlashwrightActionExecutor::Trace(Visitor* visitor) const {
+  visitor->Trace(document_);
+  visitor->Trace(script_state_);
+  visitor->Trace(runtime_);
+  visitor->Trace(receiver_);
+  visitor->Trace(navigation_client_);
+  ExecutionContextLifecycleObserver::Trace(visitor);
+}
+
+bool FlashwrightActionExecutor::OriginalDocumentIsLive() const {
+  return GetExecutionContext() && document_->IsActive() &&
+         document_->GetFrame() &&
+         document_->GetFrame()->GetDocument() == document_;
+}
+
+bool FlashwrightActionExecutor::OriginalWorldIsLive() const {
+  return OriginalDocumentIsLive() && script_state_ &&
+         script_state_->ContextIsValid() &&
+         ExecutionContext::From(script_state_) == GetExecutionContext();
+}
+
+void FlashwrightActionExecutor::ContextDestroyed() {
+  DisconnectNavigation();
+  receiver_.reset();
+  pending_.clear();
+  attempts_.clear();
+  runtime_.Reset();
+  script_state_.Clear();
+  keep_alive_.Clear();
+}
+
+void FlashwrightActionExecutor::ObserveNavigation(
+    mojo::PendingAssociatedRemote<mojom::blink::FlashwrightNavigationClient> client,
+    ObserveNavigationCallback callback) {
+  if (!OriginalWorldIsLive() || !document_->GetFrame()->IsMainFrame() ||
+      navigation_client_.is_bound() || !client.is_valid() ||
+      !FlashwrightActionNavigation::Add(*document_, this)) {
+    std::move(callback).Run(false);
+    return;
+  }
+  navigation_client_.Bind(std::move(client),
+                         document_->GetTaskRunner(TaskType::kInternalDefault));
+  navigation_client_.set_disconnect_handler(BindOnce(
+      &FlashwrightActionExecutor::DisconnectNavigation, WrapWeakPersistent(this)));
+  std::move(callback).Run(true);
+}
+
+void FlashwrightActionExecutor::NavigationRequested(uint64_t sequence) {
+  if (OriginalWorldIsLive() && navigation_client_.is_bound())
+    navigation_client_->Requested(sequence);
+}
+
+void FlashwrightActionExecutor::DisconnectNavigation() {
+  FlashwrightActionNavigation::Remove(*document_, this);
+  navigation_client_.reset();
+}
+
+void FlashwrightActionExecutor::Disconnect() {
+  if (OriginalWorldIsLive()) {
+    ScriptState::Scope scope(script_state_);
+    Vector<String> tokens;
+    for (const auto& entry : attempts_) {
+      tokens.push_back(entry.key);
+    }
+    for (const auto& token : tokens) {
+      if (!OriginalWorldIsLive()) {
+        break;
+      }
+      CleanupToken(token);
+    }
+  }
+  ContextDestroyed();
+}
+
+void FlashwrightActionExecutor::Initialize(
+    const DocumentToken& expected_document,
+    int32_t execution_context_id,
+    InitializeCallback callback) {
+  if (!OriginalDocumentIsLive() ||
+      document_->Token() != expected_document || execution_context_id <= 0) {
+    std::move(callback).Run(false);
+    return;
+  }
+  if (initialized_) {
+    if (!OriginalWorldIsLive()) {
+      std::move(callback).Run(false);
+      return;
+    }
+    ScriptState::Scope scope(script_state_);
+    std::move(callback).Run(
+        v8_inspector::V8ContextInfo::executionContextId(
+            script_state_->GetContext()) == execution_context_id);
+    return;
+  }
+  auto* frame = document_->GetFrame();
+  auto* isolate = frame->DomWindow()->GetIsolate();
+  v8::HandleScope scope(isolate);
+  HeapVector<Member<DOMWrapperWorld>> worlds;
+  DOMWrapperWorld::AllWorldsInIsolate(isolate, worlds);
+  for (const auto& world : worlds) {
+    if (world->IsMainWorld() || world->NonMainWorldHumanReadableName() !=
+                                    "__flashwright_locator_world__") {
+      continue;
+    }
+    auto* proxy = static_cast<LocalWindowProxy*>(
+        frame->GetWindowProxyManager()->GetWindowProxyMaybeUninitialized(
+            *world));
+    auto context = proxy->ContextIfInitialized();
+    if (context.IsEmpty() || v8_inspector::V8ContextInfo::executionContextId(
+                                 context) != execution_context_id) {
+      continue;
+    }
+    auto* state = ScriptState::From(isolate, context);
+    if (!state->ContextIsValid()) {
+      continue;
+    }
+    ScriptState::Scope script_scope(state);
+    auto runtime =
+        Property(state, context->Global(), "__flashwrightLocatorRuntime");
+    if (!OriginalDocumentIsLive() || !state->ContextIsValid()) {
+      std::move(callback).Run(false);
+      return;
+    }
+    if (!runtime->IsObject()) {
+      continue;
+    }
+    script_state_ = state;
+    runtime_.Reset(isolate, runtime.As<v8::Object>());
+    initialized_ = true;
+    std::move(callback).Run(true);
+    return;
+  }
+  std::move(callback).Run(false);
+}
+
+v8::MaybeLocal<v8::Value> FlashwrightActionExecutor::Call(
+    const char* name,
+    base::span<v8::Local<v8::Value>> arguments) {
+  if (!OriginalWorldIsLive()) {
+    return {};
+  }
+  auto* state = script_state_.Get();
+  auto* isolate = state->GetIsolate();
+  auto receiver = runtime_.Get(isolate);
+  auto method = Property(state, receiver, name);
+  if (!OriginalWorldIsLive() || script_state_ != state ||
+      !method->IsFunction()) {
+    return {};
+  }
+  return V8ScriptRunner::CallFunction(
+      method.As<v8::Function>(), GetExecutionContext(), receiver,
+      static_cast<int>(arguments.size()), arguments.data(), isolate);
+}
+
+void FlashwrightActionExecutor::CleanupToken(const String& token) {
+  auto* isolate = script_state_->GetIsolate();
+  v8::TryCatch catcher(isolate);
+  v8::Local<v8::Value> arguments[] = {V8String(isolate, token)};
+  v8::Local<v8::Value> ignored;
+  if (!Call("cleanupPointer", arguments).ToLocal(&ignored)) {
+    return;
+  }
+}
+
+void FlashwrightActionExecutor::Run(
+    mojom::blink::FlashwrightActionRequestPtr request,
+    RunCallback callback) {
+  if (!initialized_ || !OriginalWorldIsLive()) {
+    std::move(callback).Run(Reply(Status::kOwnerGone));
+    return;
+  }
+  if (!request->serial ||
+      request->serial == std::numeric_limits<uint64_t>::max() ||
+      request->serial <= last_serial_ || request->token.empty() ||
+      request->token.length() > 256 ||
+      request->selector_request.size() > 100000 ||
+      (request->deadline_epoch_ms &&
+       !std::isfinite(*request->deadline_epoch_ms))) {
+    std::move(callback).Run(Reply(Status::kError, "Invalid phase request"));
+    return;
+  }
+  const bool preparing = request->phase == Phase::kPrepare ||
+                         request->phase == Phase::kPrepareAndArm;
+  if (request->host_owned && request->phase != Phase::kPrepareAndArm) {
+    std::move(callback).Run(
+        Reply(Status::kError, "Host ownership requires compound preparation"));
+    return;
+  }
+  if (request->phase == Phase::kPrepareAndArm &&
+      (request->defer_readiness || request->scroll_alignment > 3 ||
+       !document_->GetFrame()->IsOutermostMainFrame())) {
+    std::move(callback).Run(
+        Reply(Status::kError,
+              "Compound preparation requires an outermost main frame, "
+              "fresh readiness and scroll alignment 0..3"));
+    return;
+  }
+  if (preparing && attempts_.size() >= 16) {
+    std::move(callback).Run(Reply(Status::kResourceLimit));
+    return;
+  }
+  auto attempt = attempts_.find(request->token);
+  if (preparing && attempt != attempts_.end()) {
+    std::move(callback).Run(Reply(Status::kError, "Attempt already exists"));
+    return;
+  }
+  if (!preparing && attempt == attempts_.end()) {
+    last_serial_ = request->serial;
+    std::move(callback).Run(Reply(request->phase == Phase::kCleanup
+                                      ? Status::kSuccess
+                                      : Status::kExpired));
+    return;
+  }
+  if (attempt != attempts_.end()) {
+    const auto& state = attempt->value;
+    const bool allowed =
+        request->phase == Phase::kCleanup
+            ? !state.cleanup_pending && state.stage != Stage::kRetired
+            : !state.busy && ((request->phase == Phase::kReadiness &&
+                               (state.stage == Stage::kNeedsReadiness ||
+                                state.stage == Stage::kReady)) ||
+                              (request->phase == Phase::kArm &&
+                               state.stage == Stage::kReady) ||
+                              (request->phase == Phase::kFinish &&
+                               state.stage == Stage::kArmed));
+    if (!allowed) {
+      std::move(callback).Run(
+          Reply(Status::kError, "Attempt phase is already pending or invalid"));
+      return;
+    }
+  }
+  // At most one ordinary phase and one cleanup per each of 16 retained
+  // attempts. Ordinary work cannot consume the reserved cleanup slots.
+  if (pending_.size() >= 32) {
+    std::move(callback).Run(Reply(Status::kResourceLimit));
+    return;
+  }
+  last_serial_ = request->serial;
+  ScriptState::Scope scope(script_state_);
+  auto* isolate = script_state_->GetIsolate();
+  auto context = script_state_->GetContext();
+  v8::TryCatch catcher(isolate);
+  v8::LocalVector<v8::Value> arguments(isolate);
+  const char* method = nullptr;
+  switch (request->phase) {
+    case Phase::kPrepare:
+    case Phase::kPrepareAndArm: {
+      if ((request->action != "click" && request->action != "dblclick" &&
+           request->action != "hover" && request->action != "check" &&
+           request->action != "uncheck" && request->action != "setChecked") ||
+          request->click_count == 0 || request->click_count > 100) {
+        std::move(callback).Run(
+            Reply(Status::kError, "Invalid pointer settings"));
+        return;
+      }
+      auto selector = v8::Array::New(isolate, request->selector_request.size());
+      for (wtf_size_t i = 0; i < request->selector_request.size(); ++i) {
+        selector
+            ->CreateDataProperty(context, i,
+                                 v8::Integer::NewFromUnsigned(
+                                     isolate, request->selector_request[i]))
+            .Check();
+      }
+      auto settings = v8::Object::New(isolate);
+      auto set = [&](const char* key, v8::Local<v8::Value> value) {
+        settings->CreateDataProperty(context, V8String(isolate, key), value)
+            .Check();
+      };
+      set("action", V8String(isolate, request->action));
+      set("force", v8::Boolean::New(isolate, request->force));
+      set("trial", v8::Boolean::New(isolate, request->trial));
+      set("clickCount",
+          v8::Integer::NewFromUnsigned(isolate, request->click_count));
+      if (request->checked) {
+        set("checked", v8::Boolean::New(isolate, *request->checked));
+      }
+      arguments.push_back(selector);
+      arguments.push_back(request->deadline_epoch_ms
+                              ? v8::Local<v8::Value>(v8::Number::New(
+                                    isolate, *request->deadline_epoch_ms))
+                              : v8::Local<v8::Value>(v8::Null(isolate)));
+      arguments.push_back(V8String(isolate, request->token));
+      arguments.push_back(settings);
+      arguments.push_back(v8::Boolean::New(isolate, request->defer_readiness));
+      method = "preparePointer";
+      break;
+    }
+    case Phase::kReadiness:
+      method = "pointerReadiness";
+      break;
+    case Phase::kArm:
+      method = "armPointer";
+      break;
+    case Phase::kFinish:
+      method = "finishPointer";
+      break;
+    case Phase::kCleanup:
+      method = "cleanupPointer";
+      break;
+  }
+  if (!preparing) {
+    arguments.push_back(V8String(isolate, request->token));
+  }
+  if (request->phase == Phase::kArm) {
+    if (!request->point || !std::isfinite(request->point->x) ||
+        !std::isfinite(request->point->y)) {
+      std::move(callback).Run(
+          Reply(Status::kError, "Missing finite hit point"));
+      return;
+    }
+    auto point = v8::Object::New(isolate);
+    point
+        ->CreateDataProperty(context, V8String(isolate, "x"),
+                             v8::Number::New(isolate, request->point->x))
+        .Check();
+    point
+        ->CreateDataProperty(context, V8String(isolate, "y"),
+                             v8::Number::New(isolate, request->point->y))
+        .Check();
+    arguments.push_back(point);
+  }
+  if (preparing) {
+    attempts_.insert(request->token, Attempt());
+  }
+  auto& state = attempts_.find(request->token)->value;
+  if (preparing) {
+    state.force = request->force;
+    state.host_owned = request->host_owned;
+    state.scroll_alignment = request->scroll_alignment;
+  }
+  if (request->phase == Phase::kCleanup) {
+    state.cleanup_pending = true;
+    state.stage = Stage::kClosing;
+  } else {
+    state.busy = true;
+    if (request->phase == Phase::kArm) {
+      state.stage = Stage::kArmed;
+    }
+    if (request->phase == Phase::kFinish) {
+      state.stage = Stage::kClosing;
+    }
+  }
+  auto* entered_state = script_state_.Get();
+  pending_.Set(request->serial, std::move(callback));
+  v8::Local<v8::Value> value;
+  const bool invoked = Call(method, arguments).ToLocal(&value);
+  ObservePromise(request->serial, request->token, request->phase,
+                 request->defer_readiness, entered_state, invoked, value);
+}
+
+void FlashwrightActionExecutor::ObservePromise(uint64_t serial,
+                                               const String& token,
+                                               Phase phase,
+                                               bool deferred,
+                                               ScriptState* entered_state,
+                                               bool invoked,
+                                               v8::Local<v8::Value> value) {
+  // Calls run a microtask checkpoint. Original context destruction closes the
+  // receiver and clears pending callbacks; never republish into a successor.
+  if (!OriginalWorldIsLive() || script_state_ != entered_state) {
+    Disconnect();
+    return;
+  }
+  if (!invoked) {
+    Settle(serial, token, phase, deferred, false, entered_state,
+           ScriptValue(entered_state->GetIsolate(),
+                       v8::Undefined(entered_state->GetIsolate())));
+    return;
+  }
+  auto* isolate = entered_state->GetIsolate();
+  if (phase == Phase::kCleanup || !value->IsPromise()) {
+    Settle(serial, token, phase, deferred, phase == Phase::kCleanup,
+           entered_state, ScriptValue(isolate, value));
+    return;
+  }
+  auto reaction =
+      ScriptPromise<IDLAny>::FromV8Promise(isolate, value.As<v8::Promise>())
+          .Then(entered_state,
+                MakeGarbageCollected<Settled>(this, serial, token, phase,
+                                              deferred, true),
+                MakeGarbageCollected<Settled>(this, serial, token, phase,
+                                              deferred, false));
+  if (!OriginalWorldIsLive() || script_state_ != entered_state) {
+    Disconnect();
+  } else if (reaction.IsEmpty()) {
+    Settle(serial, token, phase, deferred, false, entered_state,
+           ScriptValue(isolate, v8::Undefined(isolate)));
+  }
+}
+
+void FlashwrightActionExecutor::Settle(uint64_t serial,
+                                       const String& token,
+                                       Phase phase,
+                                       bool deferred,
+                                       bool fulfilled,
+                                       ScriptState* state,
+                                       ScriptValue value) {
+  auto found = pending_.find(serial);
+  if (found == pending_.end()) {
+    return;
+  }
+  if (!OriginalWorldIsLive() || state != script_state_) {
+    Disconnect();
+    return;
+  }
+  v8::TryCatch catcher(state->GetIsolate());
+  auto reply =
+      Reply(Status::kError, "Resident promise rejected or invalid result");
+  if (fulfilled && phase == Phase::kCleanup) {
+    reply = Reply(Status::kSuccess);
+  } else if (fulfilled && value.V8Value()->IsObject()) {
+    auto object = value.V8Value().As<v8::Object>();
+    auto status = StringValue(state, Property(state, object, "status"));
+    if (status == "ready") {
+      reply = Reply(Status::kReady);
+    } else if (status == "success") {
+      reply = Reply(Status::kSuccess);
+    } else if (status == "expired") {
+      reply = Reply(Status::kExpired);
+    } else if (status == "retry") {
+      reply = Reply(Status::kRetry,
+                    Detail(state, Property(state, object, "reason")));
+    } else {
+      reply = Reply(Status::kError,
+                    Detail(state, Property(state, object, "message")));
+    }
+  }
+  if (!OriginalWorldIsLive() || state != script_state_) {
+    Disconnect();
+    return;
+  }
+  auto attempt = attempts_.find(token);
+  if (phase == Phase::kPrepareAndArm && reply->status == Status::kReady &&
+      attempt != attempts_.end() && attempt->value.stage == Stage::kPreparing) {
+    CompletePreparation(serial, token, state);
+    return;
+  }
+  Deliver(serial, token, phase, deferred, fulfilled, std::move(reply));
+}
+
+void FlashwrightActionExecutor::Deliver(
+    uint64_t serial,
+    const String& token,
+    Phase phase,
+    bool deferred,
+    bool fulfilled,
+    mojom::blink::FlashwrightActionResultPtr reply) {
+  auto found = pending_.find(serial);
+  if (found == pending_.end()) {
+    return;
+  }
+  auto callback = std::move(found->value);
+  pending_.erase(found);
+  auto found_attempt = attempts_.find(token);
+  CHECK(found_attempt != attempts_.end());
+  auto& attempt = found_attempt->value;
+  if (phase == Phase::kCleanup) {
+    attempt.cleanup_pending = false;
+    if (attempt.stage != Stage::kRetired) {
+      attempt.stage = fulfilled ? Stage::kRetired : Stage::kFailed;
+    }
+  } else {
+    attempt.busy = false;
+    if (phase == Phase::kFinish) {
+      if (attempt.stage != Stage::kRetired) {
+        attempt.stage = fulfilled ? Stage::kRetired : Stage::kFailed;
+      }
+    } else if (attempt.stage != Stage::kClosing &&
+               attempt.stage != Stage::kRetired &&
+               attempt.stage != Stage::kFailed) {
+      if (reply->status != Status::kReady) {
+        attempt.stage = Stage::kFailed;
+      } else if (phase == Phase::kPrepare || phase == Phase::kReadiness) {
+        attempt.stage = phase == Phase::kPrepare && deferred
+                            ? Stage::kNeedsReadiness
+                            : Stage::kReady;
+      }
+    }
+  }
+  if (reply->status == Status::kReady &&
+      (attempt.stage == Stage::kClosing || attempt.stage == Stage::kRetired ||
+       attempt.stage == Stage::kFailed)) {
+    reply = Reply(Status::kExpired);
+  }
+  if (reply->status == Status::kReady && attempt.has_point) {
+    reply->point =
+        mojom::blink::FlashwrightActionPoint::New(attempt.x, attempt.y);
+  }
+  // The host owns its token before dispatch and retains cleanup custody even
+  // after timeout/lost reply. Do not stop its resident hit guard here.
+  if ((attempt.stage == Stage::kRetired || attempt.host_owned) &&
+      !attempt.busy && !attempt.cleanup_pending) {
+    attempts_.erase(found_attempt);
+  }
+  std::move(callback).Run(std::move(reply));
+}
+
+}  // namespace blink
