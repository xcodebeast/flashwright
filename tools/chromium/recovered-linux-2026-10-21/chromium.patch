+// physical site-isolation policy and must not be used for process placement.
+CONTENT_EXPORT bool IsStrictSiteIsolationConfiguredForDocumentPolicy();
+
+}  // namespace content
+
+#endif  // CONTENT_PUBLIC_BROWSER_DOCUMENT_POLICY_SITE_ISOLATION_H_
