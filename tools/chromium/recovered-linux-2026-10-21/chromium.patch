+RendererConnectionDiagnostic::RendererConnectionDiagnostic(
+    RenderProcessHostImpl& host,
+    Callback callback)
+    : host_(host.instance_weak_factory_.GetWeakPtr()),
+      process_id_(host.GetProcess().Pid()),
+      callback_(std::move(callback)) {}
+RendererConnectionDiagnostic::~RendererConnectionDiagnostic() {
+  ReleaseSuccessorHold();
+}
+
+void RendererConnectionDiagnostic::ReleaseSuccessorHold() {
+  if (!owns_successor_hold_) {
+    return;
+  }
+  owns_successor_hold_ = false;
+  auto* successor = RenderProcessHost::FromID(successor_host_id_);
+  if (successor && !successor->AreRefCountsDisabled()) {
+    successor->DecrementPendingReuseRefCount();
+  }
+}
+
+void RendererConnectionDiagnostic::Run(RenderProcessHost& host,
+                                       const std::string& action,
+                                       Callback callback,
+                                       ReplyInterceptor reply_interceptor) {
+  auto operation = base::MakeRefCounted<RendererConnectionDiagnostic>(
+      static_cast<RenderProcessHostImpl&>(host), std::move(callback));
+  std::string operation_action = action;
+  const std::string hold_attach_prefix = "adopt-hold-attach:";
+  const std::string hold_initialize_prefix = "adopt-hold-initialize:";
+  if (action.starts_with(hold_attach_prefix)) {
+    operation_action = "adopt:" + action.substr(hold_attach_prefix.size());
+    operation->held_reply_stage_ = HeldReplyStage::kAttach;
+  } else if (action.starts_with(hold_initialize_prefix)) {
+    operation_action = "adopt:" + action.substr(hold_initialize_prefix.size());
+    operation->held_reply_stage_ = HeldReplyStage::kInitialize;
+  }
+  operation->reply_interceptor_ = std::move(reply_interceptor);
+  if (action != "control-inspect" && action != "control-notify") {
+    auto& implementation = static_cast<RenderProcessHostImpl&>(host);
+    if (implementation.flashwright_connection_operation_pending_) {
+      operation->Finish(false, nullptr);
+      return;
+    }
+    implementation.flashwright_connection_operation_pending_ = true;
+    operation->owns_operation_ = true;
+  }
+  host.BindReceiver(operation->remote_.BindNewPipeAndPassReceiver());
+  operation->remote_.set_disconnect_handler(base::BindOnce(
+      &RendererConnectionDiagnostic::Finish, operation, false, nullptr));
+  operation->deadline_.Start(
+      FROM_HERE, base::Seconds(8),
+      base::BindOnce(&RendererConnectionDiagnostic::Finish, operation, false,
+                     nullptr));
+  if (action == "retire-workers") {
+    auto& implementation = static_cast<RenderProcessHostImpl&>(host);
+    if (implementation.listeners_.IsEmpty() &&
+        implementation.pending_views_ == 0 &&
+        implementation.GetRenderFrameHostCount() == 0) {
+      implementation.flashwright_connection_admission_closed_ = true;
+    }
+    host.GetRendererInterface()->RetireFlashwrightWorkers(
+        mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+            base::BindOnce(
+                [](scoped_refptr<RendererConnectionDiagnostic> operation,
+                   bool completed) { operation->Finish(completed, nullptr); },
+                operation),
+            false));
+    return;
+  }
+  operation->remote_->Inspect(base::BindOnce(
+      &RendererConnectionDiagnostic::DidInspect, operation, operation_action));
+}
+
+void RendererConnectionDiagnostic::DidInspect(
+    const std::string& action,
+    mojom::RendererConnectionStatePtr state) {
+  if (!callback_) {
+    return;
+  }
+  if (!host_ || !host_->GetProcess().IsValid() ||
+      host_->GetProcess().Pid() != process_id_) {
+    Finish(false, nullptr);
+    return;
+  }
+  if (action.starts_with("adopt:")) {
+    BeginAdopt(action.substr(6), std::move(state));
+    return;
+  }
+  if (action == "attach" || action == "attach-incompatible") {
+    BeginAttach(action == "attach-incompatible", std::move(state));
+    return;
+  }
+  if (action == "control-notify") {
+    if (state->phase != mojom::RendererConnectionPhase::kDetached) {
+      Finish(false, std::move(state));
+      return;
+    }
+    ThemeHelper::GetInstance()->SendSystemColorInfo(
+        host_->GetRendererInterface());
+    RenderProcessHostImpl::ClearAllResourceCaches();
+    Finish(true, std::move(state));
+    return;
+  }
+  if (action == "control-inspect") {
+    Finish(true, std::move(state));
+    return;
+  }
+  const auto identity = state->connection_identity;
+  if (action == "prepare-detach") {
+    // Live-document refusal remains a renderer check. Once browser documents
+    // are gone, reserve the host before any asynchronous retirement work.
+    if (host_->listeners_.IsEmpty() && host_->pending_views_ == 0 &&
+        host_->GetRenderFrameHostCount() == 0) {
+      host_->flashwright_connection_admission_closed_ = true;
+    }
+    remote_->PrepareDetach(identity,
+                           base::BindOnce(&RendererConnectionDiagnostic::Finish,
+                                          base::WrapRefCounted(this)));
+    return;
+  }
+  if (state->phase != mojom::RendererConnectionPhase::kPrepared &&
+      state->phase != mojom::RendererConnectionPhase::kDetached) {
+    Finish(false, std::move(state));
+    return;
+  }
+  if (state->phase == mojom::RendererConnectionPhase::kPrepared) {
+    // Do not invalidate the physical owner's weak pointers via ResetIPC.
+    // Keep the disconnected proxy bound: process-wide notifications still
+    // address initialized hosts. The renderer has already closed its receiver.
+    host_->ResetChannelProxy();
+  }
+  remote_->Detach(identity,
+                  base::BindOnce(&RendererConnectionDiagnostic::Finish,
+                                 base::WrapRefCounted(this)));
+}
+
+void RendererConnectionDiagnostic::BeginAdopt(
+    const std::string& context_id,
+    mojom::RendererConnectionStatePtr state) {
+  BrowserContext* destination = nullptr;
+  if (state->phase != mojom::RendererConnectionPhase::kDetached ||
+      !host_->sent_render_process_ready_ ||
+      !protocol::BrowserHandler::FindBrowserContext(context_id, &destination)
+           .IsSuccess() ||
+      !destination || destination == host_->GetBrowserContext() ||
+      destination->ShutdownStarted() || !destination->IsOffTheRecord() ||
+      !host_->GetBrowserContext()->IsOffTheRecord()) {
+    Finish(false, std::move(state));
+    return;
+  }
+  for (auto iterator = RenderProcessHost::AllHostsIterator();
+       !iterator.IsAtEnd(); iterator.Advance()) {
+    if (iterator.GetCurrentValue()->GetBrowserContext() == destination) {
+      Finish(false, std::move(state));
+      return;
+    }
+  }
+  const ProcessLock original_lock = host_->GetProcessLock();
+  if (original_lock.is_invalid() ||
+      (original_lock.IsLockedToSite() &&
+       !original_lock.GetProcessLockURL().SchemeIsHTTPOrHTTPS()) ||
+      original_lock.is_sandboxed() || original_lock.is_guest() ||
+      original_lock.is_pdf() || original_lock.is_fenced() ||
+      original_lock.GetWebExposedIsolationInfo().is_isolated() ||
+      host_->IsForTopChromeWebUI() ||
+      ChildProcessSecurityPolicyImpl::GetInstance()->HasWebUIBindings(
+          host_->GetDeprecatedID())) {
+    Finish(false, std::move(state));
+    return;
+  }
+  const GURL destination_url = original_lock.IsLockedToSite()
+                                   ? original_lock.GetProcessLockURL()
+                                   : GURL(url::kAboutBlankURL);
+  auto site = SiteInstanceImpl::CreateForURL(destination, destination_url);
+  site->PreventAssociationWithSpareProcess();
+  auto* successor =
+      static_cast<RenderProcessHostImpl*>(site->GetOrCreateProcess(
+          ProcessAllocationContext{ProcessAllocationSource::kEmbedder}));
+  successor_host_id_ = successor->GetDeprecatedID();
+  successor->IncrementPendingReuseRefCount();
+  owns_successor_hold_ = true;
+  const ProcessLock successor_lock = successor->GetProcessLock();
+  // Compare every retained lock policy except BrowserContext identity, which
+  // deliberately changes. Launch flags additionally cover JIT/V8 policies.
+  const bool compatible =
+      !successor->is_initialized_ && !successor->renderer_process_owner_ &&
+      successor->flags_ == host_->flags_ && !successor_lock.is_invalid() &&
+      successor_lock.IsLockedToSite() == original_lock.IsLockedToSite() &&
+      successor_lock.AllowsAnySite() == original_lock.AllowsAnySite() &&
+      successor_lock.agent_cluster_key() == original_lock.agent_cluster_key() &&
+      successor_lock.site_url() == original_lock.site_url() &&
+      successor_lock.is_sandboxed() == original_lock.is_sandboxed() &&
+      successor_lock.unique_sandbox_id() == original_lock.unique_sandbox_id() &&
+      successor_lock.is_pdf() == original_lock.is_pdf() &&
+      successor_lock.is_guest() == original_lock.is_guest() &&
+      successor_lock.is_fenced() == original_lock.is_fenced() &&
+      successor_lock.GetStoragePartitionConfig() ==
+          original_lock.GetStoragePartitionConfig() &&
+      successor_lock.GetWebExposedIsolationInfo() ==
+          original_lock.GetWebExposedIsolationInfo() &&
+      successor_lock.GetWebExposedIsolationLevel() ==
+          original_lock.GetWebExposedIsolationLevel();
+  site.reset();
+  if (!compatible ||
+      !AgentSchedulingGroupHost::CanRebindBrowserConnection(*successor)) {
+    Finish(false, std::move(state));
+    return;
+  }
+  successor->flashwright_connection_admission_closed_ = true;
+  successor->flashwright_connection_operation_pending_ = true;
+  BeginAttach(false, std::move(state));
+}
+
+void RendererConnectionDiagnostic::BeginAttach(
+    bool incompatible,
+    mojom::RendererConnectionStatePtr state) {
+  if (state->phase != mojom::RendererConnectionPhase::kDetached ||
+      !state->configuration || !host_->renderer_process_owner_ ||
+      !host_->renderer_process_owner_->CanTransferPhysicalCustody() ||
+      host_->shutdown_requested_ || host_->fast_shutdown_started_ ||
+      host_->within_process_died_observer_ || host_->deleting_soon_ ||
+      !host_->listeners_.IsEmpty() || host_->GetRenderFrameHostCount() != 0 ||
+      host_->pending_views_ != 0 || host_->keep_alive_ref_count_ != 0 ||
+      host_->worker_ref_count_ != 0 || host_->shutdown_delay_ref_count_ != 0 ||
+      host_->navigation_state_keepalive_count_ != 0 ||
+      host_->pending_reuse_ref_count_ != 1 ||
+      !AgentSchedulingGroupHost::CanRebindBrowserConnection(*host_)) {
+    Finish(false, std::move(state));
+    return;
+  }
+  // There are no assigned SiteInstanceGroups or pending owners. Closing reuse
+  // admission now prevents any new owner from entering before initialization.
+  host_->flashwright_connection_admission_closed_ = true;
+  auto bootstrap = mojom::RendererConnectionBootstrap::New();
+  auto* destination = successor_host_id_ < 0
+                          ? host_.get()
+                          : static_cast<RenderProcessHostImpl*>(
+                                RenderProcessHost::FromID(successor_host_id_));
+  if (!destination || destination->AreRefCountsDisabled() ||
+      !destination->GetBrowserContext() ||
+      destination->GetBrowserContext()->ShutdownStarted()) {
+    Finish(false, std::move(state));
+    return;
+  }
+  bootstrap->client_id = destination->GetDeprecatedID();
+  bootstrap->configuration = mojom::RendererConnectionConfiguration::New(
+      GetContentClient()->browser()->GetUserAgent(),
+      GetContentClient()->browser()->GetUserAgentMetadata(),
+      destination->storage_partition_impl_->cors_exempt_header_list(),
+      GetContentClient()->browser()->GetOriginTrialsSettings(),
+      GetContentClient()->browser()->GetCpuPerformanceTier());
+  if (incompatible) {
+    bootstrap->configuration->user_agent += " incompatible";
+  }
+  bootstrap->channel = channel_.InitWithNewPipeAndPassReceiver();
+  browser_host_ = bootstrap->browser_host.InitWithNewPipeAndPassReceiver();
+  bootstrap->worker_service = worker_service_.InitWithNewPipeAndPassReceiver();
+  if (successor_host_id_ >= 0) {
+    dispatched_adoption_transport_ = host_->renderer_process_transport_;
+  }
+  remote_->Attach(state->connection_identity, std::move(bootstrap),
+                  base::BindOnce(&RendererConnectionDiagnostic::DidAttach,
+                                 base::WrapRefCounted(this)));
+}
+
+void RendererConnectionDiagnostic::DidAttach(
+    bool accepted,
+    mojom::RendererConnectionStatePtr state) {
+  if (!callback_) {
+    return;
+  }
+  if (accepted && state && held_reply_stage_ == HeldReplyStage::kAttach &&
+      reply_interceptor_) {
+    std::move(reply_interceptor_)
+        .Run(base::BindOnce(&RendererConnectionDiagnostic::ContinueAttach,
+                            base::WrapRefCounted(this), accepted,
+                            std::move(state)));
+    return;
+  }
+  ContinueAttach(accepted, std::move(state));
+}
+
+void RendererConnectionDiagnostic::ContinueAttach(
+    bool accepted,
+    mojom::RendererConnectionStatePtr state) {
+  if (!callback_) {
+    return;
+  }
+  if (!host_ || !host_->GetProcess().IsValid() ||
+      host_->GetProcess().Pid() != process_id_) {
+    Finish(false, nullptr);
+    return;
+  }
+  if (!accepted) {
+    Finish(false, std::move(state));
+    return;
+  }
+  if (successor_host_id_ >= 0) {
+    auto* successor = static_cast<RenderProcessHostImpl*>(
+        RenderProcessHost::FromID(successor_host_id_));
+    if (!successor || !CommitAdoption(*successor)) {
+      Finish(false, std::move(state));
+      return;
+    }
+    host_->GetRendererInterface()->GetFlashwrightRendererState(
+        mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+            base::BindOnce(&RendererConnectionDiagnostic::DidInitialize,
+                           base::WrapRefCounted(this), std::move(state)),
+            nullptr));
+    return;
+  }
+  // Only install a browser listener after the renderer accepts. Rejection must
+  // not turn a staged bootstrap disconnect into physical process death.
+  host_->renderer_host_receiver_.reset();
+  host_->io_thread_host_impl_.reset();
+  host_->associated_interfaces_.reset();
+  host_->InitializeBrowserConnection(
+      std::move(browser_host_), std::move(worker_service_), channel_.PassPipe(),
+      /*pause_for_launch=*/false);
+  host_->RegisterMojoInterfaces();
+  const auto& configuration = *state->configuration;
+  host_->GetRendererInterface()->InitializeRenderer(
+      configuration.user_agent, configuration.user_agent_metadata,
+      configuration.cors_exempt_header_list,
+      configuration.origin_trials_settings.Clone(),
+      configuration.cpu_performance_tier, base::Token::CreateRandom().high());
+  FieldTrialSynchronizer::UpdateRendererVariationsHeader(host_.get());
+  ThemeHelper::GetInstance()->SendSystemColorInfo(
+      host_->GetRendererInterface());
+  AgentSchedulingGroupHost::RebindBrowserConnection(*host_);
+  host_->GetRendererInterface()->GetFlashwrightRendererState(
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(&RendererConnectionDiagnostic::DidInitialize,
+                         base::WrapRefCounted(this), std::move(state)),
+          nullptr));
+}
+
+void RendererConnectionDiagnostic::DidInitialize(
+    mojom::RendererConnectionStatePtr state,
+    mojom::FlashwrightRendererStatePtr initialized) {
+  if (!callback_) {
+    return;
+  }
+  if (initialized && held_reply_stage_ == HeldReplyStage::kInitialize &&
+      reply_interceptor_) {
+    std::move(reply_interceptor_)
+        .Run(base::BindOnce(&RendererConnectionDiagnostic::ContinueInitialize,
+                            base::WrapRefCounted(this), std::move(state),
+                            std::move(initialized)));
+    return;
+  }
+  ContinueInitialize(std::move(state), std::move(initialized));
+}
+
+void RendererConnectionDiagnostic::ContinueInitialize(
+    mojom::RendererConnectionStatePtr state,
+    mojom::FlashwrightRendererStatePtr initialized) {
+  if (!callback_) {
+    return;
+  }
+  bool ready = initialized && host_ && host_->GetProcess().IsValid() &&
+               host_->GetProcess().Pid() == process_id_ &&
+               host_->renderer_process_owner_ &&
+               host_->renderer_process_owner_->CanTransferPhysicalCustody() &&
+               !host_->shutdown_requested_ && !host_->deleting_soon_;
+  if (ready && adoption_committed_) {
+    for (auto iterator = RenderProcessHost::AllHostsIterator();
+         !iterator.IsAtEnd(); iterator.Advance()) {
+      auto* other = iterator.GetCurrentValue();
+      if (other != host_.get() &&
+          other->GetBrowserContext() == host_->GetBrowserContext()) {
+        ready = false;
+        break;
+      }
+    }
+  }
+  if (ready) {
+    host_->flashwright_connection_admission_closed_ = false;
+    if (adoption_committed_ && host_->channel_connected_) {
+      host_->OnChannelConnected(process_id_);
+    }
+  }
+  Finish(ready, std::move(state));
+}
+
+void RendererConnectionDiagnostic::Finish(
+    bool accepted,
+    mojom::RendererConnectionStatePtr state) {
+  if (!callback_) {
+    return;
+  }
+  auto keep_alive = base::WrapRefCounted(this);
+  auto completion = std::move(callback_);
+  if (!host_ || !host_->GetProcess().IsValid() ||
+      host_->GetProcess().Pid() != process_id_) {
+    accepted = false;
+    state.reset();
+  }
+  if (owns_operation_ && host_) {
+    host_->flashwright_connection_operation_pending_ = false;
+    owns_operation_ = false;
+  }
+  deadline_.Stop();
+  remote_.reset();
+  if (auto* successor = static_cast<RenderProcessHostImpl*>(
+          RenderProcessHost::FromID(successor_host_id_))) {
+    successor->flashwright_connection_operation_pending_ = false;
+  }
+  if (!accepted && dispatched_adoption_transport_ && host_ &&
+      host_->renderer_process_transport_ == dispatched_adoption_transport_ &&
+      host_->renderer_process_owner_ && host_->GetProcess().IsValid() &&
+      host_->GetProcess().Pid() == process_id_ && !host_->deleting_soon_ &&
+      !host_->within_process_died_observer_) {
+    // A detached logical channel cannot report process death. Retire only the
+    // dispatched physical owner now; its launcher owns bounded OS reaping.
+    auto retiring_host = host_;
+    auto* retiring_owner = retiring_host->renderer_process_owner_.get();
+    retiring_host->Shutdown(RESULT_CODE_KILLED);
+    auto termination_info = retiring_host->GetChildTerminationInfo(false);
+    if (termination_info.status == base::TERMINATION_STATUS_STILL_RUNNING) {
+      termination_info.status = base::TERMINATION_STATUS_PROCESS_WAS_KILLED;
+      termination_info.exit_code = RESULT_CODE_KILLED;
+    }
+    if (retiring_host &&
+        retiring_host->renderer_process_owner_.get() == retiring_owner &&
+        retiring_host->renderer_process_transport_ ==
+            dispatched_adoption_transport_ &&
+        !retiring_host->deleting_soon_ &&
+        !retiring_host->within_process_died_observer_) {
+      retiring_host->ProcessDied(termination_info);
+    }
+  }
+  std::move(completion).Run(accepted, std::move(state));
+  ReleaseSuccessorHold();
+}
