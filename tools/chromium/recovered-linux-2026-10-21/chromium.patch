index 0000000000..21f66f7be9
--- /dev/null
+++ 2/content/renderer/renderer_connection_control.cc
@@ -0,0 +1,122 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/renderer/renderer_connection_control.h"
+
+#include <utility>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "content/renderer/renderer_browser_connection.h"
+#include "third_party/blink/public/common/browser_interface_broker_identity.h"
+
+namespace content {
+using Phase = mojom::RendererConnectionPhase;
+
+RendererConnectionControl::RendererConnectionControl(
+    std::unique_ptr<RendererBrowserConnection> connection,
+    RetireCallback retire,
+    CreateConnectionCallback create_connection)
+    : connection_(std::move(connection)),
+      identity_(blink::BrowserInterfaceBrokerIdentity(
+          *connection_->GetOriginalBrowserInterfaceBroker())),
+      retire_(std::move(retire)),
+      create_connection_(std::move(create_connection)) {
+  CHECK(retire_);
+}
+RendererConnectionControl::~RendererConnectionControl() = default;
+
+RendererBrowserConnection& RendererConnectionControl::GetConnection() const {
+  return *connection_;
+}
+
+void RendererConnectionControl::SetConfiguration(
+    mojom::RendererConnectionConfigurationPtr configuration) {
+  CHECK(!configuration_);
+  CHECK(configuration);
+  configuration_ = std::move(configuration);
+}
+
+bool RendererConnectionControl::MatchesConfiguration(
+    const mojom::RendererConnectionConfiguration& configuration) const {
+  return configuration_ && configuration_->Equals(configuration);
+}
+
+void RendererConnectionControl::Bind(
+    mojo::PendingReceiver<mojom::RendererConnectionControl> receiver) {
+  receivers_.Add(this, std::move(receiver));
+}
+
+mojom::RendererConnectionStatePtr RendererConnectionControl::State() const {
+  return mojom::RendererConnectionState::New(identity_, phase_,
+                                             configuration_.Clone());
+}
+
+void RendererConnectionControl::Inspect(InspectCallback callback) {
+  std::move(callback).Run(State());
+}
+
+void RendererConnectionControl::PrepareDetach(
+    const base::UnguessableToken& expected_identity,
+    PrepareDetachCallback callback) {
+  if (expected_identity != identity_ || phase_ != Phase::kActive) {
+    std::move(callback).Run(
+        expected_identity == identity_ && phase_ == Phase::kPrepared, State());
+    return;
+  }
+  phase_ = Phase::kPreparing;
+  // Completion belongs to the physical controller, even if this client drops
+  // its pipe while workers are retiring.
+  retire_.Run(base::BindOnce(&RendererConnectionControl::DidRetire,
+                             weak_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void RendererConnectionControl::DidRetire(PrepareDetachCallback callback,
+                                          bool retired) {
+  CHECK_EQ(phase_, Phase::kPreparing);
+  const bool prepared = retired && connection_->PrepareForDetach();
+  phase_ = prepared ? Phase::kPrepared : Phase::kFailed;
+  std::move(callback).Run(prepared, State());
+}
+
+void RendererConnectionControl::Detach(
+    const base::UnguessableToken& expected_identity,
+    DetachCallback callback) {
+  if (expected_identity != identity_ ||
+      (phase_ != Phase::kPrepared && phase_ != Phase::kDetached)) {
+    std::move(callback).Run(false, State());
+    return;
+  }
+  if (phase_ == Phase::kPrepared) {
+    connection_->Detach();
+    phase_ = Phase::kDetached;
+  }
+  std::move(callback).Run(true, State());
+}
+void RendererConnectionControl::Attach(
+    const base::UnguessableToken& expected_identity,
+    mojom::RendererConnectionBootstrapPtr bootstrap,
+    AttachCallback callback) {
+  if (expected_identity != identity_ || phase_ != Phase::kDetached ||
+      !create_connection_ || !MatchesConfiguration(*bootstrap->configuration) ||
+      bootstrap->client_id <= 0 || !bootstrap->channel.is_valid() ||
+      !bootstrap->browser_host.is_valid() ||
+      !bootstrap->worker_service.is_valid()) {
+    std::move(callback).Run(false, State());
+    return;
+  }
+  auto successor = create_connection_.Run(std::move(bootstrap));
+  if (!successor) {
+    std::move(callback).Run(false, State());
+    return;
+  }
+  auto successor_identity = blink::BrowserInterfaceBrokerIdentity(
+      *successor->GetOriginalBrowserInterfaceBroker());
+  CHECK_NE(successor_identity, identity_);
+  connection_ = std::move(successor);
+  identity_ = successor_identity;
+  phase_ = Phase::kActive;
+  std::move(callback).Run(true, State());
+}
+}  // namespace content
