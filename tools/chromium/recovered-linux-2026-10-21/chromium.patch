@@ -0,0 +1,37 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/public/common/frame/renderer_frame_sink_id_allocator.h"
+
+#include <atomic>
+#include <limits>
+
+#include "base/check_op.h"
+
+namespace blink {
+namespace {
+
+// Browser routing IDs occupy the lower half. Keep renderer allocations unique
+// for the lifetime of the physical process, including across owner changes.
+std::atomic<uint32_t> g_next_renderer_frame_sink_id{
+    uint32_t{std::numeric_limits<int32_t>::max()} + 1};
+
+}  // namespace
+
+viz::FrameSinkId AllocateRendererFrameSinkId(uint32_t renderer_client_id) {
+  uint32_t sink_id =
+      g_next_renderer_frame_sink_id.load(std::memory_order_relaxed);
+  for (;;) {
+    CHECK_LT(sink_id, std::numeric_limits<uint32_t>::max());
+    // Check before incrementing so exhaustion cannot publish a wrapped value
+    // to another allocating thread. This counter does not publish other state.
+    if (g_next_renderer_frame_sink_id.compare_exchange_weak(
+            sink_id, sink_id + 1, std::memory_order_relaxed,
+            std::memory_order_relaxed)) {
+      return viz::FrameSinkId(renderer_client_id, sink_id);
+    }
+  }
+}
+
+}  // namespace blink
