diff --git c/cc/scheduler/scheduler_state_machine.cc w/cc/scheduler/scheduler_state_machine.cc
index b89a6baca7..60c6d8acaf 100644
--- c/cc/scheduler/scheduler_state_machine.cc
+++ w/cc/scheduler/scheduler_state_machine.cc
@@ -1309,6 +1309,18 @@ SchedulerStateMachine::CurrentBeginImplFrameDeadlineMode() const {
   } else {
     // The impl thread doesn't have anything it wants to draw and we are just
     // waiting for a new active tree.
+    if (settings_.disable_frame_rate_limit &&
+        !settings_.single_threaded_proxy &&
+        !settings_.wait_for_all_pipeline_stages_before_draw &&
+        !processing_animation_worklets_for_active_tree_ &&
+        !ShouldWaitForScrollEvent() &&
+        base::FeatureList::IsEnabled(
+            features::kFlashwrightEarlyIdleFrameDeadline)) {
+      // End this otherwise idle frame without waiting for display cadence.
+      // Demand, commit/activation ordering, draw admission and real timestamps
+      // remain owned by the classic scheduler; this does not request a frame.
+      return BeginImplFrameDeadlineMode::IMMEDIATE;
+    }
     return BeginImplFrameDeadlineMode::LATE;
   }
 }
