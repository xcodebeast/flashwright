+      event_type, x, y, handler->ScaleFactor(), modifiers, std::nullopt,
+      event_button,
+      buttons, click_count, std::nullopt, std::nullopt, std::nullopt,
+      std::nullopt, std::nullopt, std::nullopt, std::nullopt, std::nullopt);
