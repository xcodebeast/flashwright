+namespace blink {
+
+String ResourceCacheOwnerIdentifier(
+    const ThreadSafeBrowserInterfaceBrokerProxy& broker) {
+  return StrCat(
+      {"broker:", String(BrowserInterfaceBrokerIdentity(broker).ToString()),
+       ":"});
+}
+
+String ResourceCacheIdentifierForOwner(
+    const ThreadSafeBrowserInterfaceBrokerProxy& broker,
+    const String& partition) {
+  return StrCat({ResourceCacheOwnerIdentifier(broker), partition});
+}
+
+void RemoveResourceURLForCacheOwner(const KURL& url,
+                                    const String& owner_identifier) {
+  DCHECK(IsMainThread());
+  CHECK(!owner_identifier.empty());
+  MemoryCache* cache = MemoryCache::Get();
+  for (Resource* resource : cache->ResourcesForURL(url)) {
+    if (resource->CacheIdentifier().starts_with(owner_identifier)) {
+      cache->Remove(resource);
+    }
+  }
+}
+
+}  // namespace blink
