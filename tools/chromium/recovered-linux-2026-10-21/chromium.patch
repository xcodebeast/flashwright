+      widget->GetView(), position,
+      base::BindOnce(
+          [](base::WeakPtr<InputHandler> handler, WeakDocumentPtr owner,
+             uint64_t generation, base::RepeatingCallback<bool()> admission,
+             std::unique_ptr<blink::WebMouseEvent> event,
+             base::OnceCallback<void(Response, FlashwrightMouseAck)> reply,
+             base::OnceCallback<void(bool)> forwarded,
+             base::WeakPtr<RenderWidgetHostViewBase> target,
+             std::optional<gfx::PointF> point) {
+            auto* frame = owner.AsRenderFrameHostIfValid();
+            if (!handler || !frame || frame != handler->host_ ||
+                generation != handler->flashwright_generation_ ||
+                !target || !point || handler->drag_controller_.IsDragging()) {
+              std::move(reply).Run(
+                  Response::ServerError("Routed mouse owner changed"),
+                  FlashwrightMouseAck());
+              return;
+            }
+            event->SetPositionInWidget(*point);
+            event->SetPositionInScreen(
+                ConvertWidgetPointToScreenPoint(*target, *point));
+            auto widget = RenderWidgetHostImpl::From(
+                              target->GetRenderWidgetHost())->GetWeakPtr();
+            widget->Focus();
+            frame = owner.AsRenderFrameHostIfValid();
+            if (!handler || !widget || !target || !frame ||
+                frame != handler->host_ ||
+                generation != handler->flashwright_generation_ ||
+                handler->drag_controller_.IsDragging()) {
+              std::move(reply).Run(
+                  Response::ServerError("Routed mouse owner changed on focus"),
+                  FlashwrightMouseAck());
+              return;
+            }
+            if (admission) {
+              if (!admission.Run()) {
+                std::move(reply).Run(
+                    Response::ServerError("Routed mouse admission rejected"),
+                    FlashwrightMouseAck());
+                return;
+              }
+              // A predicate can reenter browser code. Revalidate lifecycle and
+              // drag state before touching the handler or forwarding the event.
+              frame = owner.AsRenderFrameHostIfValid();
+              if (!handler || !widget || !target || !frame ||
+                  frame != handler->host_ ||
+                  generation != handler->flashwright_generation_ ||
+                  widget->GetView() != target.get() ||
+                  handler->drag_controller_.IsDragging()) {
+                std::move(reply).Run(
+                    Response::ServerError(
+                        "Routed mouse owner changed during admission"),
+                    FlashwrightMouseAck());
+                return;
+              }
+            }
+            // This verified non-drag branch only updates local down/up/move
+            // state; it invokes no external callbacks before native forwarding.
+            std::unique_ptr<DispatchMouseEventCallback> unused;
