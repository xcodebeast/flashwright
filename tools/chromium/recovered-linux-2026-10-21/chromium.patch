+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef CONTENT_BROWSER_DEVTOOLS_PROTOCOL_FLASHWRIGHT_POINTER_CONTROLLER_H_
+#define CONTENT_BROWSER_DEVTOOLS_PROTOCOL_FLASHWRIGHT_POINTER_CONTROLLER_H_
+
+#include <deque>
+#include <map>
+#include <memory>
+#include <string>
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "base/values.h"
+#include "content/public/browser/weak_document_ptr.h"
+#include "content/browser/devtools/protocol/protocol.h"
+#include "flashwright_pointer_probe/action_journal.h"
+#include "third_party/blink/public/mojom/frame/flashwright_action.mojom.h"
+
+namespace content {
+struct FlashwrightMouseAck;
+namespace protocol {
+class InputHandler;
+
+// One original-document pointer attempt at a time. The Rust caller retains
+// outer retry/navigation policy and its original resident-token cleanup lease.
+// A navigation handoff is explicitly not a completed action or a settled lease.
+class FlashwrightPointerController final
+    : public std::enable_shared_from_this<FlashwrightPointerController> {
+ public:
+  using Reply = base::OnceCallback<void(std::string, base::DictValue)>;
+  FlashwrightPointerController(InputHandler* handler, uint64_t retired_serial);
+  ~FlashwrightPointerController();
+  bool CanRetire() const;
+  void Start(blink::mojom::FlashwrightActionRequestPtr request,
+             std::string fingerprint, Reply reply);
+  void Cancel(uint64_t id, Reply reply);
+  base::DictValue Snapshot(uint64_t id) const;
+
+ private:
+  using Journal = flashwright::native_action::ActionJournal;
+  using Result = blink::mojom::FlashwrightActionResultPtr;
+  struct Attempt;
+  struct Completed;
+  bool OwnerAlive() const;
+  bool Allowed(uint64_t id);
+  void Send(blink::mojom::FlashwrightActionPhase phase,
+            base::OnceCallback<void(Result)> callback);
+  void Prepared(Journal::WorkToken ticket, Result result);
+  void InputNext();
+  void InputForwarded(uint64_t id, int step, bool forwarded);
+  void InputProgress();
+  void ReleaseForwarded(uint64_t id, bool forwarded);
+  void InputAck(uint64_t id, int step, bool cleanup,
+                Response response, FlashwrightMouseAck ack);
+  void Finish();
+  void Finished(Journal::WorkToken ticket, Result result);
+  void NavigationChanged();
+  void Expired(uint64_t id);
+  void Cleanup();
+  void Cleaned(Journal::WorkToken ticket, Result result);
+  void Publish(std::string status);
+  void Release();
+  void Fail(std::string status, const std::u16string& detail = {});
+  bool IsCurrent(uint64_t id) const;
+
+  const base::WeakPtr<InputHandler> handler_;
+  const uint64_t generation_;
+  const uint64_t retired_serial_;
+  const WeakDocumentPtr document_;
+  const Journal::Owner owner_ = base::UnguessableToken::Create();
+  Journal journal_{1, 128, 8};
+  std::unique_ptr<Attempt> active_;
+  bool needs_disposal_ = false;
+  std::map<uint64_t, std::unique_ptr<Completed>> completed_;
+  std::deque<uint64_t> completed_order_;
+  base::OneShotTimer deadline_;
+  base::WeakPtrFactory<FlashwrightPointerController> weak_factory_{this};
+};
+}  // namespace protocol
+}  // namespace content
+#endif
