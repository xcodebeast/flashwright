+// found in the LICENSE file.
+
+#ifndef CONTENT_BROWSER_DEVTOOLS_PROTOCOL_FLASHWRIGHT_NAVIGATION_OBSERVER_H_
+#define CONTENT_BROWSER_DEVTOOLS_PROTOCOL_FLASHWRIGHT_NAVIGATION_OBSERVER_H_
+
+#include <stdint.h>
+
+#include <optional>
+#include "base/functional/callback.h"
+
+#include "base/containers/flat_map.h"
+#include "base/memory/weak_ptr.h"
+#include "base/unguessable_token.h"
+#include "base/values.h"
+#include "content/public/browser/frame_tree_node_id.h"
+#include "content/public/browser/weak_document_ptr.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "mojo/public/cpp/bindings/associated_receiver.h"
+#include "mojo/public/cpp/bindings/pending_associated_remote.h"
+#include "third_party/blink/public/mojom/frame/flashwright_action.mojom.h"
+
+namespace content {
+class NavigationHandle;
+class Page;
+class RenderFrameHost;
+class WebContents;
+
+namespace protocol {
+
+// Diagnostic state only. A serial observed at native navigation start is not
+// proof that the renderer intent caused that navigation. No action completion
+// decision may be inferred from this class alone. All calls use the browser UI
+// sequence, including binding and native modal notifications.
+class FlashwrightNavigationObserver final
+    : public WebContentsObserver,
+      public blink::mojom::FlashwrightNavigationClient {
+ public:
+  FlashwrightNavigationObserver(WebContents* contents,
+                                WeakDocumentPtr owner,
+                                int execution_context_id);
+  ~FlashwrightNavigationObserver() override;
+
+  FlashwrightNavigationObserver(const FlashwrightNavigationObserver&) = delete;
+  FlashwrightNavigationObserver& operator=(
+      const FlashwrightNavigationObserver&) = delete;
+
+  // One binding per instance. The caller sends this over the existing
+  // associated executor route. Retain the object separately from the endpoint
+  // if native terminals must remain observable after channel/document loss.
+  mojo::PendingAssociatedRemote<blink::mojom::FlashwrightNavigationClient>
+  Bind();
+  void Requested(uint64_t sequence) override;
+
+  // Native PageHandler calls only; opening and closing must belong to this
+  // WebContents and preserve native occurrence order. A descendant may supply
+  // the modal token while the original root navigation remains its owner.
+  // Rejection only cancels a still-matching intent without a native ID.
+  void BeforeUnloadOpened(const base::UnguessableToken& frame_token);
+  void DialogClosed(const base::UnguessableToken& frame_token, bool accepted);
+
+  // IDs and serials are decimal strings, preserving all 64 bits in JSON.
+  base::DictValue Snapshot();
+  void SetChangedCallback(base::RepeatingClosure callback);
+  bool CanRetire();
+
+ private:
+  struct PendingNavigation {
+    uint64_t request_serial = 0;
+    std::optional<int64_t> navigation_id;
+    bool operator==(const PendingNavigation&) const = default;
+  };
+
+  struct ModalSnapshot {
+    ModalSnapshot(const base::UnguessableToken& frame_token,
+                  std::optional<PendingNavigation> pending);
+    ~ModalSnapshot();
+    const base::UnguessableToken frame_token;
+    const std::optional<PendingNavigation> pending;
+  };
+
+  void DidStartNavigation(NavigationHandle* navigation) override;
+  void DidFinishNavigation(NavigationHandle* navigation) override;
+  void PrimaryPageChanged(Page& page) override;
+  void RenderFrameHostChanged(RenderFrameHost* old_host,
+                              RenderFrameHost* new_host) override;
+  void RenderFrameDeleted(RenderFrameHost* frame) override;
+  void WebContentsDestroyed() override;
+
+  bool OwnerIsCurrentlyPrimary() const;
+  bool RefreshOwner();
+  void LoseOwner();
+  bool IsOriginalRootNavigation(NavigationHandle* navigation) const;
+  void Disconnected();
+  void Record(base::DictValue record);
+
+  base::RepeatingClosure changed_;
+  const WeakDocumentPtr owner_;
+  const int execution_context_id_;
+  const FrameTreeNodeId root_frame_tree_node_id_;
+  bool owner_lost_ = false;
+  bool bound_once_ = false;
+  bool disconnected_ = false;
+  bool overflow_ = false;
+  bool tracking_overflow_ = false;
+  bool invalid_or_exhausted_intent_ = false;
+  bool non_monotonic_intent_ = false;
+  uint64_t record_serial_ = 0;
+  uint64_t dropped_records_ = 0;
+  uint64_t dropped_starts_ = 0;
+  uint64_t latest_request_serial_ = 0;
+  std::optional<PendingNavigation> pending_;
+  std::optional<ModalSnapshot> modal_;
+  // Entries survive logical owner loss until their exact native terminal.
+  // A value is only the pending request serial observed at DidStartNavigation.
+  base::flat_map<int64_t, uint64_t> navigations_;
+  base::ListValue observed_navigation_ids_;
+  base::ListValue records_;
+  mojo::AssociatedReceiver<blink::mojom::FlashwrightNavigationClient> receiver_{
+      this};
+  base::WeakPtrFactory<FlashwrightNavigationObserver> weak_factory_{this};
+};
+
+}  // namespace protocol
+}  // namespace content
+
+#endif  // CONTENT_BROWSER_DEVTOOLS_PROTOCOL_FLASHWRIGHT_NAVIGATION_OBSERVER_H_
diff --git 1/content/browser/devtools/protocol/flashwright_pointer_controller.cc 2/content/browser/devtools/protocol/flashwright_pointer_controller.cc
new file mode 100644
index 0000000000..55f3347de2
--- /dev/null
+++ 2/content/browser/devtools/protocol/flashwright_pointer_controller.cc
@@ -0,0 +1,437 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "content/browser/devtools/protocol/flashwright_pointer_controller.h"
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <utility>
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/trace_event/trace_event.h"
+#include "content/browser/devtools/protocol/flashwright_navigation_observer.h"
+#include "content/browser/devtools/protocol/input_handler.h"
+#include "content/browser/renderer_host/flashwright_mouse_ack.h"
+#include "mojo/public/cpp/bindings/callback_helpers.h"
+#include "flashwright_pointer_probe/pointer_sequence.h"
+
+namespace content::protocol {
+namespace {
+using Phase = blink::mojom::FlashwrightActionPhase;
+using Status = blink::mojom::FlashwrightActionStatus;
+void TracePointer(const void* controller, uint64_t id, const std::string& token,
+                  const char* phase, int step = -1) {
+  TRACE_EVENT_INSTANT("navigation.debug", "PointerPhase",
+                     "controller", reinterpret_cast<uintptr_t>(controller),
+                     "action", id, "token", token, "phase", phase, "step", step);
+}
+const char* StatusName(Status value) {
+  switch (value) {
+    case Status::kReady: return "ready";
+    case Status::kSuccess: return "success";
+    case Status::kRetry: return "retry";
+    case Status::kExpired: return "expired";
+    case Status::kError: return "error";
+    case Status::kOwnerGone: return "ownerGone";
+    case Status::kResourceLimit: return "resourceLimit";
+  }
+}
+}  // namespace
+
+struct FlashwrightPointerController::Attempt {
+  Attempt();
+  ~Attempt();
+  uint64_t id = 0;
+  std::string fingerprint;
+  blink::mojom::FlashwrightActionRequestPtr request;
+  Reply reply;
+  std::string status = "active";
+  std::u16string detail;
+  std::string delivery = "notDispatched";
+  double x = 0;
+  double y = 0;
+  std::unique_ptr<flashwright::native_action::PointerSequence> sequence;
+  bool pressed = false;
+  bool release_attempted = false;
+  bool release_pending = false;
+  bool release_route_pending = false;
+  bool input_complete = false;
+  bool finish_pending = false;
+  bool cleanup_started = false;
+  bool cleanup_done = false;
+  bool resident_released = false;
+  std::optional<Journal::WorkToken> input_ticket;
+};
+FlashwrightPointerController::Attempt::Attempt() = default;
+FlashwrightPointerController::Attempt::~Attempt() = default;
+struct FlashwrightPointerController::Completed {
+  Completed(std::string fingerprint, std::string status, base::DictValue value);
+  ~Completed();
+  const std::string fingerprint;
+  const std::string status;
+  const base::DictValue value;
+};
+FlashwrightPointerController::Completed::Completed(
+    std::string fingerprint, std::string status, base::DictValue value)
+    : fingerprint(std::move(fingerprint)), status(std::move(status)),
+      value(std::move(value)) {}
+FlashwrightPointerController::Completed::~Completed() = default;
+
+FlashwrightPointerController::FlashwrightPointerController(
+    InputHandler* handler, uint64_t retired_serial)
+    : handler_(handler->weak_factory_.GetWeakPtr()),
+      generation_(handler->flashwright_generation_),
+      retired_serial_(retired_serial),
+      document_(handler->flashwright_owner_) {}
+FlashwrightPointerController::~FlashwrightPointerController() = default;
+
+bool FlashwrightPointerController::CanRetire() const {
+  return !active_ && !needs_disposal_;
+}
+
+bool FlashwrightPointerController::IsCurrent(uint64_t id) const {
+  return active_ && active_->id == id;
+}
+bool FlashwrightPointerController::OwnerAlive() const {
+  return handler_ && handler_->flashwright_generation_ == generation_ &&
+         document_.AsRenderFrameHostIfValid() &&
+         handler_->flashwright_owner_.AsRenderFrameHostIfValid() ==
+             document_.AsRenderFrameHostIfValid() &&
+         handler_->flashwright_executor_.is_connected();
+}
+bool FlashwrightPointerController::Allowed(uint64_t id) {
+  if (!IsCurrent(id) || active_->status != "active" || !OwnerAlive()) return false;
+  journal_.Expire(id, owner_, base::TimeTicks::Now());
+  auto state = journal_.Inspect(id);
+  return state && state->owner_active &&
+         state->outcome == Journal::Outcome::kPending;
+}
+
+base::DictValue FlashwrightPointerController::Snapshot(uint64_t id) const {
+  if (auto found = completed_.find(id); found != completed_.end())
+    return found->second->value.Clone();
+  base::DictValue result;
+  result.Set("id", base::NumberToString(id));
+  if (!IsCurrent(id)) { result.Set("status", "unknown"); return result; }
+  result.Set("status", active_->status);
+  result.Set("delivery", active_->delivery);
+  result.Set("inputComplete", active_->input_complete);
+  result.Set("residentReleased", active_->resident_released);
+  result.Set("pressed", active_->pressed);
+  result.Set("needsDisposal",
+             needs_disposal_ || (active_->pressed && active_->cleanup_done));
+  auto state = journal_.Inspect(id);
+  result.Set("unsettledWork", static_cast<int>(state->unsettled_work));
+  base::ListValue units;
+  for (char16_t unit : active_->detail) units.Append(static_cast<int>(unit));
+  result.Set("detailUnits", std::move(units));
+  return result;
+}
+
+void FlashwrightPointerController::Start(
+    blink::mojom::FlashwrightActionRequestPtr request,
+    std::string fingerprint, Reply reply) {
+  auto keep_alive = shared_from_this();
+  const uint64_t id = request->serial;
+  if (id <= retired_serial_) {
+    std::move(reply).Run("staleId", base::DictValue()); return;
+  }
+  if (auto found = completed_.find(id); found != completed_.end()) {
+    const bool same = fingerprint == found->second->fingerprint;
+    std::move(reply).Run(same ? found->second->status : "identityMismatch",
+                         found->second->value.Clone());
+    return;
+  }
+  if (IsCurrent(id)) {
+    std::move(reply).Run(fingerprint == active_->fingerprint ? "active" :
+                         "identityMismatch", Snapshot(id));
+    return;
+  }
+  if (needs_disposal_) {
+    std::move(reply).Run("cleanupUnsettled", base::DictValue()); return;
+  }
+  if (!OwnerAlive() || !handler_->flashwright_navigation_) {
+    std::move(reply).Run("ownerGone", base::DictValue()); return;
+  }
+  auto navigation = handler_->flashwright_navigation_->Snapshot();
+  if (navigation.FindBool("pending").value_or(true) ||
+      !navigation.FindBool("ownerAlive").value_or(false) ||
+      navigation.FindBool("overflow").value_or(true) ||
+      navigation.FindBool("disconnected").value_or(true)) {
+    std::move(reply).Run("navigationBusy", std::move(navigation)); return;
+  }
+  auto deadline = base::TimeTicks();
+  const auto now = base::TimeTicks::Now();
+  if (request->deadline_epoch_ms) {
+    const double remaining = *request->deadline_epoch_ms -
+        base::Time::Now().InMillisecondsFSinceUnixEpoch();
+    deadline = now + base::Milliseconds(std::max(0.0, remaining));
+  }
+  auto admission = journal_.Admit(id, owner_, deadline, now);
+  if (admission != Journal::Admission::kAccepted) {
+    std::move(reply).Run(admission == Journal::Admission::kAtCapacity ?
+                         "resourceLimit" : "staleId", base::DictValue()); return;
+  }
+  active_ = std::make_unique<Attempt>();
+  active_->id = id; active_->fingerprint = std::move(fingerprint);
+  active_->request = std::move(request); active_->reply = std::move(reply);
+  TracePointer(this, id, active_->request->token, "begin");
+  active_->sequence = std::make_unique<flashwright::native_action::PointerSequence>(
+      active_->request->action == "hover" ? 1 :
+      1 + 2 * static_cast<int>(active_->request->click_count));
+  // Post notifications rather than reentering an observer's native callback.
+  handler_->flashwright_navigation_->SetChangedCallback(base::BindRepeating(
+      [](base::WeakPtr<FlashwrightPointerController> self) {
+        base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+            FROM_HERE, base::BindOnce(&FlashwrightPointerController::NavigationChanged, self));
+      }, weak_factory_.GetWeakPtr()));
+  if (!deadline.is_null()) {
+    deadline_.Start(FROM_HERE, std::max(base::TimeDelta(), deadline - now),
+        base::BindOnce(&FlashwrightPointerController::Expired,
+                       weak_factory_.GetWeakPtr(), id));
+  }
+  if (!Allowed(id)) { Fail("expired"); return; }
+  auto ticket = journal_.Issue(id, owner_, Journal::WorkKind::kPrepare, now);
+  CHECK(ticket);
+  Send(Phase::kPrepareAndArm, base::BindOnce(
+      &FlashwrightPointerController::Prepared, keep_alive, *ticket));
+}
+
+void FlashwrightPointerController::Send(
+    Phase phase, base::OnceCallback<void(Result)> callback) {
+  if (!OwnerAlive() || handler_->flashwright_phase_serial_ ==
+                          std::numeric_limits<uint64_t>::max() - 1) {
+    std::move(callback).Run(blink::mojom::FlashwrightActionResult::New(
+        Status::kOwnerGone, std::u16string(), nullptr)); return;
+  }
+  auto request = active_->request->Clone();
+  request->phase = phase; request->host_owned = false;
+  request->serial = ++handler_->flashwright_phase_serial_;
+  handler_->flashwright_executor_->Run(std::move(request),
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(std::move(callback),
+          blink::mojom::FlashwrightActionResult::New(
+              Status::kOwnerGone, std::u16string(), nullptr)));
+}
+void FlashwrightPointerController::Prepared(Journal::WorkToken ticket, Result result) {
+  CHECK(journal_.Settle(ticket));
+  if (!IsCurrent(ticket.operation)) return;
+  TracePointer(this, active_->id, active_->request->token, "prepared");
+  if (!Allowed(active_->id)) { Fail(OwnerAlive() ? "expired" : "ownerGone"); return; }
+  if (result->status != Status::kReady || !result->point) {
+    active_->status = StatusName(result->status); active_->detail = result->detail;
+    Cleanup(); return;
+  }
+  active_->x = std::trunc(result->point->x * 100) / 100;
+  active_->y = std::trunc(result->point->y * 100) / 100;
+  active_->input_ticket = journal_.Issue(active_->id, owner_,
+      Journal::WorkKind::kInputSequence, base::TimeTicks::Now());
+  if (!active_->input_ticket) { Fail("expired"); return; }
+  InputNext();
+}
+void FlashwrightPointerController::InputNext() {
+  const auto id = active_->id;
+  if (!Allowed(id)) { Fail(OwnerAlive() ? "expired" : "ownerGone"); return; }
+  const int step = active_->sequence->Issue();
+  TracePointer(this, id, active_->request->token, "dispatch", step);
+  const bool move = step == 0, down = !move && step % 2 == 1;
+  active_->delivery = "uncertain";
+  handler_->DispatchFlashwrightMouseEvent(document_,
+      move ? "mouseMoved" : down ? "mousePressed" : "mouseReleased",
+      active_->x, active_->y, move ? "none" : "left", 0, down ? 1 : 0,
+      move ? 0 : (step + 1) / 2,
+      base::BindOnce(&FlashwrightPointerController::InputAck,
+                     shared_from_this(), id, step, false),
+      base::BindRepeating([](base::WeakPtr<FlashwrightPointerController> self, uint64_t id) {
+        return self && self->Allowed(id);
+      }, weak_factory_.GetWeakPtr(), id),
+      base::BindOnce(&FlashwrightPointerController::InputForwarded,
+                     shared_from_this(), id, step));
+}
+void FlashwrightPointerController::InputForwarded(
+    uint64_t id, int step, bool forwarded) {
+  CHECK(IsCurrent(id));
+  TracePointer(this, id, active_->request->token,
+               forwarded ? "forwarded" : "routeRejected", step);
+  active_->sequence->Forwarded(step, forwarded);
+  active_->pressed = active_->sequence->Pressed();
+  if (!forwarded) {
+    Fail("error", u"Native input route did not forward"); return;
+  }
+  InputProgress();
+}
+void FlashwrightPointerController::InputAck(
+    uint64_t id, int step, bool cleanup, Response response, FlashwrightMouseAck ack) {
+  CHECK(IsCurrent(id));
+  TracePointer(this, id, active_->request->token,
+               cleanup ? "cleanupAck" : "ack", step);
+  const bool acknowledged = response.IsSuccess() && ack.disposition ==
+      FlashwrightMouseAck::Disposition::kAcknowledged;
+  if (cleanup) {
+    active_->release_pending = false;
+    active_->pressed = !acknowledged;
+    Cleanup(); return;
+  }
+  active_->sequence->Acknowledge(step, acknowledged);
+  active_->pressed = active_->sequence->Pressed();
+  if (!acknowledged) {
+    Fail("error", u"Native input did not acknowledge delivery"); return;
+  }
+  InputProgress();
+}
+void FlashwrightPointerController::InputProgress() {
+  if (active_->status != "active") { Cleanup(); return; }
+  if (active_->sequence->CanIssue()) { InputNext(); return; }
+  if (!active_->sequence->Complete()) return;
+  CHECK(!active_->input_complete);
+  active_->input_complete = true; active_->delivery = "acknowledged";
+  CHECK(journal_.Settle(*active_->input_ticket)); active_->input_ticket.reset();
+  NavigationChanged();
+  if (active_) {
+    if (active_->status == "active") Finish();
+    else Cleanup();
+  }
+}
+void FlashwrightPointerController::Finish() {
+  if (!Allowed(active_->id)) { Fail(OwnerAlive() ? "expired" : "ownerGone"); return; }
+  auto ticket = journal_.Issue(active_->id, owner_, Journal::WorkKind::kCleanup,
+                               base::TimeTicks::Now()); CHECK(ticket);
+  active_->finish_pending = true;
+  TracePointer(this, active_->id, active_->request->token, "finishBegin");
+  Send(Phase::kFinish, base::BindOnce(&FlashwrightPointerController::Finished,
+                                    shared_from_this(), *ticket));
+}
+void FlashwrightPointerController::Finished(Journal::WorkToken ticket, Result result) {
+  CHECK(journal_.Settle(ticket));
+  if (!IsCurrent(ticket.operation)) return;
+  active_->finish_pending = false;
+  TracePointer(this, active_->id, active_->request->token, "finishEnd");
+  NavigationChanged();
+  if (!active_) return;
+  if (active_->status == "active") {
+    active_->status = StatusName(result->status); active_->detail = result->detail;
+  }
+  Cleanup();
+}
+void FlashwrightPointerController::NavigationChanged() {
+  if (!active_ || active_->status != "active" || !active_->input_complete ||
+      !handler_ || !handler_->flashwright_navigation_) return;
+  auto navigation = handler_->flashwright_navigation_->Snapshot();
+  if (!navigation.FindBool("pending").value_or(false) && OwnerAlive()) return;
+  if (!journal_.Handoff(active_->id, owner_, base::TimeTicks::Now())) {
+    Fail("expired"); return;
+  }
+  if (!OwnerAlive()) journal_.RetireOwner(owner_);
+  Publish("navigation");
+  Cleanup();
+}
+void FlashwrightPointerController::Expired(uint64_t id) {
+  if (!IsCurrent(id)) return;
+  journal_.Expire(id, owner_, base::TimeTicks::Now());
+  if (journal_.Inspect(id)->outcome == Journal::Outcome::kTimedOut) {
+    Publish("expired"); Cleanup();
+  }
+}
+void FlashwrightPointerController::Cancel(uint64_t id, Reply reply) {
+  auto keep_alive = shared_from_this();
+  if (journal_.Cancel(id, owner_, base::TimeTicks::Now()) && IsCurrent(id)) {
+    Publish("cancelled"); Cleanup();
+  }
+  if (IsCurrent(id) && journal_.Inspect(id)->outcome == Journal::Outcome::kTimedOut)
+    Expired(id);
+  std::move(reply).Run("observed", Snapshot(id));
+}
+void FlashwrightPointerController::Fail(std::string status, const std::u16string& detail) {
+  if (!active_) return;
+  active_->sequence->Stop();
+  if (active_->status == "active") active_->detail = detail;
+  if (!OwnerAlive()) journal_.RetireOwner(owner_);
+  if (active_->status == "active") active_->status = std::move(status);
+  if (journal_.Inspect(active_->id)->outcome == Journal::Outcome::kTimedOut)
+    Publish("expired");
+  Cleanup();
+}
+void FlashwrightPointerController::Cleanup() {
+  if (!active_ || active_->release_pending || active_->release_route_pending ||
+      active_->sequence->Pending()) return;
+  if (active_->pressed && !active_->release_attempted && OwnerAlive()) {
+    active_->release_attempted = true;
+    active_->release_pending = true;
+    active_->release_route_pending = true;
+    handler_->DispatchFlashwrightMouseEvent(document_, "mouseReleased",
+        active_->x, active_->y, "left", 0, 0, 1,
+        base::BindOnce(&FlashwrightPointerController::InputAck,
+            shared_from_this(), active_->id, -1, true),
+        base::BindRepeating([](base::WeakPtr<FlashwrightPointerController> self) {
+          return self && self->OwnerAlive();
+        }, weak_factory_.GetWeakPtr()),
+        base::BindOnce(&FlashwrightPointerController::ReleaseForwarded,
+                       shared_from_this(), active_->id));
+    return;
+  }
+  if (active_->input_ticket) {
+    CHECK(journal_.Settle(*active_->input_ticket)); active_->input_ticket.reset();
+  }
+  if (active_->cleanup_started) { Release(); return; }
+  active_->cleanup_started = true;
+  TracePointer(this, active_->id, active_->request->token, "cleanupBegin");
+  auto ticket = journal_.Issue(active_->id, owner_, Journal::WorkKind::kCleanup,
+                               base::TimeTicks::Now()); CHECK(ticket);
+  Send(Phase::kCleanup, base::BindOnce(&FlashwrightPointerController::Cleaned,
+                                     shared_from_this(), *ticket));
+}
+void FlashwrightPointerController::ReleaseForwarded(uint64_t id, bool forwarded) {
+  CHECK(IsCurrent(id));
+  CHECK(active_->release_route_pending);
+  active_->release_route_pending = false;
+  TracePointer(this, id, active_->request->token,
+               forwarded ? "cleanupForwarded" : "cleanupRouteRejected");
+  Cleanup();
+}
+void FlashwrightPointerController::Cleaned(Journal::WorkToken ticket, Result result) {
+  CHECK(journal_.Settle(ticket));
+  if (!IsCurrent(ticket.operation)) return;
+  TracePointer(this, active_->id, active_->request->token, "cleanupEnd");
+  active_->cleanup_done = true;
+  active_->resident_released = result->status == Status::kSuccess;
+  needs_disposal_ |= !active_->resident_released && OwnerAlive();
+  Release();
+}
+void FlashwrightPointerController::Publish(std::string status) {
+  active_->status = std::move(status);
+  if (active_->reply) {
+    TracePointer(this, active_->id, active_->request->token, "publish");
+    auto value = Snapshot(active_->id);
+    std::move(active_->reply).Run(active_->status, std::move(value));
+  }
+}
+void FlashwrightPointerController::Release() {
+  if (!active_ || !active_->cleanup_done ||
+      journal_.Inspect(active_->id)->unsettled_work) return;
+  auto state = journal_.Inspect(active_->id);
+  if (state->outcome == Journal::Outcome::kPending) {
+    const bool succeeded = active_->status == "success" && active_->resident_released && !active_->pressed;
+    if (state->input_started) journal_.Finish(active_->id, owner_, succeeded, base::TimeTicks::Now());
+    else journal_.FinishWithoutInput(active_->id, owner_, succeeded, base::TimeTicks::Now());
+  }
+  state = journal_.Inspect(active_->id);
+  if (state->outcome == Journal::Outcome::kTimedOut) active_->status = "expired";
+  if (state->outcome == Journal::Outcome::kCancelled) active_->status = "cancelled";
+  if ((!active_->resident_released || active_->pressed) && active_->status == "success") active_->status = "cleanupUnsettled";
+  // A terminal response cannot authorize another action over unreleased input
+  // or a live resident attempt. Only disposing this page settles that boundary.
+  needs_disposal_ |= active_->pressed ||
+                     (!active_->resident_released && OwnerAlive());
+  deadline_.Stop();
+  Publish(active_->status);
+  const auto id = active_->id;
+  auto value = Snapshot(id);
+  completed_[id] = std::make_unique<Completed>(active_->fingerprint, active_->status, std::move(value));
+  completed_order_.push_back(id);
+  TracePointer(this, id, active_->request->token, "retire");
+  CHECK(journal_.Release(id, owner_)); active_.reset();
+  while (completed_order_.size() > 128) { completed_.erase(completed_order_.front()); completed_order_.pop_front(); }
+}
+}  // namespace content::protocol
