+TEST_F(ResourceCacheOwnerTest, BrokerIdentitiesAreStableAndDistinct) {
+  auto first_broker = CreateBroker();
+  auto second_broker = CreateBroker();
+  const auto first_identity = BrowserInterfaceBrokerIdentity(*first_broker);
+  const auto second_identity = BrowserInterfaceBrokerIdentity(*second_broker);
+  EXPECT_FALSE(first_identity.is_empty());
+  EXPECT_FALSE(second_identity.is_empty());
+  EXPECT_NE(first_identity, second_identity);
+  EXPECT_EQ(first_identity, BrowserInterfaceBrokerIdentity(*first_broker));
+  EXPECT_EQ(second_identity, BrowserInterfaceBrokerIdentity(*second_broker));
+  platform_->SelectBroker(second_broker);
+  EXPECT_EQ(first_identity, BrowserInterfaceBrokerIdentity(*first_broker));
+}
+
+TEST_F(ResourceCacheOwnerTest, DestroyedBrokerIdentityIsNotReused) {
+  auto destruction_count = base::MakeRefCounted<base::RefCountedData<int>>(0);
+  auto original_broker = platform_->CreateBroker(destruction_count);
+  const auto original_identity =
+      BrowserInterfaceBrokerIdentity(*original_broker);
+  original_broker.reset();
+  EXPECT_EQ(1, destruction_count->data);
+
+  auto successor_broker = platform_->CreateBroker(destruction_count);
+  const auto successor_identity =
+      BrowserInterfaceBrokerIdentity(*successor_broker);
+  EXPECT_NE(original_identity, successor_identity);
+  EXPECT_EQ(successor_identity,
+            BrowserInterfaceBrokerIdentity(*successor_broker));
+  successor_broker.reset();
+  EXPECT_EQ(2, destruction_count->data);
+}
