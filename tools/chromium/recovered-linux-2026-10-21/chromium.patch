+#include "third_party/blink/renderer/core/page/page_process_service_owner.h"
+
+#include <utility>
+
+#include "base/check.h"
+#include "third_party/blink/public/common/thread_safe_browser_interface_broker_proxy.h"
+#include "third_party/blink/renderer/core/page/page.h"
+#include "third_party/blink/renderer/platform/wtf/threading.h"
+
+namespace blink {
+
+const char PageProcessServiceOwner::kSupplementName[] =
+    "PageProcessServiceOwner";
+
+void PageProcessServiceOwner::Install(
+    Page& page,
+    scoped_refptr<ThreadSafeBrowserInterfaceBrokerProxy> broker) {
+  DCHECK(IsMainThread());
+  CHECK(broker);
+  CHECK(!Supplement<Page>::From<PageProcessServiceOwner>(page));
+  Supplement<Page>::ProvideTo(
+      page,
+      MakeGarbageCollected<PageProcessServiceOwner>(page, std::move(broker)));
+}
+
+PageProcessServiceOwner& PageProcessServiceOwner::From(Page& page) {
+  DCHECK(IsMainThread());
+  auto* owner = Supplement<Page>::From<PageProcessServiceOwner>(page);
+  CHECK(owner);
+  return *owner;
+}
+
+PageProcessServiceOwner::PageProcessServiceOwner(
+    Page& page,
+    scoped_refptr<ThreadSafeBrowserInterfaceBrokerProxy> broker)
+    : Supplement<Page>(page), broker_(std::move(broker)) {
+  CHECK(broker_);
+}
+
+PageProcessServiceOwner::~PageProcessServiceOwner() = default;
+
+scoped_refptr<ThreadSafeBrowserInterfaceBrokerProxy>
+PageProcessServiceOwner::Broker() const {
+  DCHECK(IsMainThread());
+  return broker_;
+}
+
+void PageProcessServiceOwner::Trace(Visitor* visitor) const {
+  Supplement<Page>::Trace(visitor);
+}
+
+}  // namespace blink
