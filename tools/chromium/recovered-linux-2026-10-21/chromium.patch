+// found in the LICENSE file.
+
+#include <algorithm>
+#include <cmath>
+#include <memory>
+#include <utility>
+
+#include "base/environment.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/logging.h"
+#include "base/strings/utf_string_conversions.h"
+#include "content/browser/devtools/protocol/handler_helpers.h"
+#include "content/browser/devtools/protocol/input_handler.h"
+#include "content/browser/devtools/protocol/flashwright_pointer_controller.h"
+#include "content/browser/devtools/protocol/flashwright_navigation_observer.h"
+#include "content/browser/renderer_host/frame_tree_node.h"
+#include "content/browser/renderer_host/flashwright_mouse_ack.h"
+#include "content/browser/renderer_host/render_frame_host_impl.h"
+#include "content/browser/renderer_host/render_widget_host_impl.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_delegate.h"
+#include "mojo/public/cpp/bindings/callback_helpers.h"
+#include "third_party/blink/public/common/input/web_mouse_event.h"
+#include "third_party/blink/public/common/associated_interfaces/associated_interface_provider.h"
+
+namespace content::protocol {
+namespace {
+using Phase = blink::mojom::FlashwrightActionPhase;
+using Status = blink::mojom::FlashwrightActionStatus;
+
+// Fault injection belongs only to the explicitly enabled diagnostic endpoint.
+// Keep the observer alive if closing the page destroys its own callback owner.
+class NativeMouseCloseProbe
+    : public RenderWidgetHost::InputEventObserver,
+      public std::enable_shared_from_this<NativeMouseCloseProbe> {
+ public:
+  NativeMouseCloseProbe(RenderWidgetHostImpl* widget,
+                       WeakDocumentPtr owner,
+                       std::string stage,
+                       const blink::WebMouseEvent& event,
+                       int serial)
+      : widget_(widget->GetWeakPtr()), owner_(owner), stage_(std::move(stage)),
+        timestamp_(event.TimeStamp()), type_(event.GetType()), serial_(serial) {
+    if (stage_ == "filter") {
+      filter_ = base::BindRepeating(&NativeMouseCloseProbe::Filter,
+                                    base::Unretained(this));
+      widget->AddMouseEventCallback(filter_);
+    } else {
+      widget->AddInputEventObserver(this);
+    }
+  }
+  ~NativeMouseCloseProbe() override {
+    if (widget_) {
+      if (stage_ == "filter") {
+        widget_->RemoveMouseEventCallback(filter_);
+      } else {
+        widget_->RemoveInputEventObserver(this);
+      }
+    }
+  }
+  void OnInputEvent(const RenderWidgetHost&,
+                    const blink::WebInputEvent& event,
+                    InputEventSource) override {
+    Close("dispatch", event);
+  }
+  void OnInputEventAck(const RenderWidgetHost&,
+                       blink::mojom::InputEventResultSource,
+                       blink::mojom::InputEventResultState,
+                       const blink::WebInputEvent& event) override {
+    Close("ack", event);
+  }
+
+ private:
+  bool Filter(const blink::WebMouseEvent& event) {
+    Close("filter", event);
+    return false;
+  }
+  void Close(const char* stage, const blink::WebInputEvent& event) {
+    if (closed_ || stage_ != stage || event.TimeStamp() != timestamp_ ||
+        event.GetType() != type_) {
+      return;
+    }
+    auto keep_alive = shared_from_this();
+    auto* frame = owner_.AsRenderFrameHostIfValid();
+    if (!frame || !widget_ || frame->GetRenderWidgetHost() != widget_.get()) {
+      return;
+    }
+    auto* contents = WebContents::FromRenderFrameHost(frame);
+    if (!contents || !contents->GetDelegate()) {
+      return;
+    }
+    closed_ = true;
+    contents->GetDelegate()->CloseContents(contents);
+    LOG(ERROR) << "FW_NATIVE_MOUSE_CLOSE serial=" << serial_
+               << " stage=" << stage_ << " destroyed=" << !widget_;
+  }
+  base::WeakPtr<RenderWidgetHostImpl> widget_;
+  WeakDocumentPtr owner_;
+  std::string stage_;
+  base::TimeTicks timestamp_;
+  blink::WebInputEvent::Type type_;
+  int serial_;
+  bool closed_ = false;
+  RenderWidgetHost::MouseEventCallback filter_;
+};
+
+const char* StatusName(Status status) {
+  switch (status) {
+    case Status::kReady:
+      return "ready";
+    case Status::kSuccess:
+      return "success";
+    case Status::kRetry:
+      return "retry";
+    case Status::kExpired:
+      return "expired";
+    case Status::kError:
+      return "error";
+    case Status::kOwnerGone:
+      return "ownerGone";
+    case Status::kResourceLimit:
+      return "resourceLimit";
+  }
+}
+}  // namespace
+
+void InputHandler::FlashwrightBeforeUnloadOpened(
+    const base::UnguessableToken& frame) {
+  if (flashwright_navigation_) {
+    flashwright_navigation_->BeforeUnloadOpened(frame);
+  }
+}
+
+void InputHandler::FlashwrightDialogClosed(
+    const base::UnguessableToken& frame, bool accepted) {
+  if (flashwright_navigation_) {
+    flashwright_navigation_->DialogClosed(frame, accepted);
+  }
+}
+
+void InputHandler::ResetFlashwrightChannel() {
+  // Invalidate callbacks before reset, which can destroy pending Mojo replies.
+  ++flashwright_generation_;
+  flashwright_executor_.reset();
+  flashwright_document_.reset();
+  flashwright_owner_ = WeakDocumentPtr();
+  flashwright_context_ = 0;
+  flashwright_phase_serial_ = 0;
+}
+
+// This diagnostic transport exercises the typed channel. It is deliberately
+// separate from the future coarse action/controller. Explicit mouse phases
+// exercise input primitives without claiming locator or completion semantics.
+void InputHandler::FlashwrightActionPhase(
+    int execution_context_id,
+    const std::string& json,
+    std::unique_ptr<FlashwrightActionPhaseCallback> callback) {
+  if (base::Environment::Create()
+          ->GetVar("FLASHWRIGHT_NATIVE_ACTION_CHANNEL_PROBE")
+          .value_or("") != "1") {
+    callback->sendFailure(
+        Response::ServerError("Native channel probe disabled"));
+    return;
+  }
+  if (!host_ || !host_->IsRenderFrameLive() || execution_context_id <= 0 ||
+      json.size() > 1024 * 1024) {
+    callback->sendFailure(
+        Response::InvalidParams("Invalid probe owner or input"));
+    return;
+  }
+  auto data = base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  const auto* phase = data ? data->FindString("phase") : nullptr;
+  if (!phase) {
+    callback->sendFailure(Response::InvalidParams("Missing phase"));
+    return;
+  }
+  if (*phase == "cancelAction" || *phase == "actionSnapshot") {
+    const auto id = data->FindInt("serial");
+    if (!id || *id <= 0 || !flashwright_pointer_controller_ ||
+        execution_context_id != flashwright_navigation_context_) {
+      callback->sendFailure(Response::InvalidParams("Missing original action"));
+      return;
+    }
+    auto reply = base::BindOnce(
+        [](std::unique_ptr<FlashwrightActionPhaseCallback> callback,
+           std::string status, base::DictValue detail) {
+          callback->sendSuccess(status, base::WriteJson(detail).value(),
+                                std::nullopt, std::nullopt);
+        }, std::move(callback));
+    if (*phase == "cancelAction") flashwright_pointer_controller_->Cancel(*id, std::move(reply));
+    else std::move(reply).Run("observed", flashwright_pointer_controller_->Snapshot(*id));
+    return;
+  }
+  if (*phase == "navigationSnapshot") {
+    if (!flashwright_navigation_ ||
+        execution_context_id != flashwright_navigation_context_) {
+      callback->sendFailure(Response::InvalidParams("No original observer"));
+      return;
+    }
+    auto detail = base::WriteJson(flashwright_navigation_->Snapshot());
+    callback->sendSuccess("ready", detail.value_or(""), std::nullopt,
+                          std::nullopt);
+    return;
+  }
+  if (*phase == "initialize") {
+    if (flashwright_executor_.is_bound() &&
+        !flashwright_owner_.AsRenderFrameHostIfValid()) {
+      ResetFlashwrightChannel();
+    }
+    auto* selected = host_.get();
+    if (const auto* frame_id = data->FindString("frameId")) {
+      auto* node = FrameTreeNodeFromDevToolsFrameToken(host_->frame_tree_node(),
+                                                       *frame_id);
+      if (!node || !node->current_frame_host()->IsRenderFrameLive()) {
+        callback->sendFailure(
+            Response::InvalidParams("Missing live selected frame"));
+        return;
+      }
+      selected = node->current_frame_host();
+    }
+    const bool reuse = flashwright_executor_.is_bound();
+    if (reuse &&
+        (!data->FindBool("resume").value_or(false) ||
+         flashwright_owner_.AsRenderFrameHostIfValid() != selected ||
+         flashwright_context_ != execution_context_id)) {
+      callback->sendFailure(Response::ServerError("Channel already bound"));
+      return;
+    }
+    if (!reuse) {
+      flashwright_document_ = selected->GetDocumentToken();
+      flashwright_owner_ = selected->GetWeakDocumentPtr();
+      flashwright_context_ = execution_context_id;
+      ++flashwright_generation_;
+      selected->GetRemoteAssociatedInterfaces()->GetInterface(
+          flashwright_executor_.BindNewEndpointAndPassReceiver());
+      flashwright_executor_.set_disconnect_handler(base::BindOnce(
+          [](base::WeakPtr<InputHandler> handler, uint64_t generation) {
+            if (handler && handler->flashwright_generation_ == generation) {
+              handler->ResetFlashwrightChannel();
+            }
+          },
+          weak_factory_.GetWeakPtr(), flashwright_generation_));
+    }
+    // A lost initialization reply may leave this exact owner bound. Revalidate
+    // the renderer's original world before acknowledging an explicit resume.
+    const auto generation = flashwright_generation_;
+    flashwright_executor_->Initialize(
+        *flashwright_document_, execution_context_id,
+        mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+            base::BindOnce(
+                [](base::WeakPtr<InputHandler> handler, uint64_t generation,
+                   std::unique_ptr<FlashwrightActionPhaseCallback> reply,
+                   bool ready) {
+                  if (!handler ||
+                      handler->flashwright_generation_ != generation) {
+                    reply->sendSuccess("ownerGone", "", std::nullopt,
+                                       std::nullopt);
+                    return;
+                  }
+                  ready =
+                      ready &&
+                      handler->flashwright_owner_.AsRenderFrameHostIfValid() &&
+                      handler->flashwright_executor_.is_connected();
+                  if (!ready) {
+                    handler->ResetFlashwrightChannel();
+                  }
+                  reply->sendSuccess(ready ? "ready" : "ownerGone", "",
+                                     std::nullopt, std::nullopt);
+                },
+                weak_factory_.GetWeakPtr(), generation, std::move(callback)),
+            false));
+    return;
+  }
+  if (!flashwright_executor_.is_bound() ||
+      !flashwright_owner_.AsRenderFrameHostIfValid() ||
+      flashwright_context_ != execution_context_id) {
+    callback->sendSuccess("ownerGone", "", std::nullopt, std::nullopt);
+    return;
+  }
+  if (*phase == "observeNavigation") {
+    auto* owner = flashwright_owner_.AsRenderFrameHostIfValid();
+    auto* contents = WebContents::FromRenderFrameHost(owner);
+    if (!contents ||
+        owner != contents->GetPrimaryMainFrame() ||
+        owner->GetOutermostMainFrame() != owner) {
+      callback->sendFailure(Response::InvalidParams("Invalid observer scope"));
+      return;
+    }
+    if (flashwright_navigation_) {
+      if (flashwright_navigation_generation_ == flashwright_generation_ &&
+          data->FindBool("resume").value_or(false)) {
+        callback->sendSuccess(flashwright_navigation_ready_ ? "ready" : "busy",
+                              "", std::nullopt, std::nullopt);
+        return;
+      }
+      if (!data->FindBool("replace").value_or(false) ||
+          !flashwright_navigation_->CanRetire() ||
+          (flashwright_pointer_controller_ &&
+           !flashwright_pointer_controller_->CanRetire())) {
+        callback->sendSuccess("ownerBusy", "", std::nullopt, std::nullopt);
+        return;
+      }
+      flashwright_retired_action_serial_ = flashwright_action_high_watermark_;
+      flashwright_pointer_controller_.reset();
+      flashwright_navigation_.reset();
+    }
+    flashwright_navigation_ready_ = false;
+    flashwright_navigation_generation_ = flashwright_generation_;
+    flashwright_navigation_context_ = execution_context_id;
+    flashwright_navigation_ = std::make_unique<FlashwrightNavigationObserver>(
+        contents, flashwright_owner_, execution_context_id);
+    auto remote = flashwright_navigation_->Bind();
+    if (!remote.is_valid()) {
+      callback->sendSuccess("ownerGone", "", std::nullopt, std::nullopt);
+      return;
+    }
+    const auto generation = flashwright_generation_;
+    flashwright_executor_->ObserveNavigation(
+        std::move(remote),
+        mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+            base::BindOnce(
+                [](base::WeakPtr<InputHandler> handler, uint64_t generation,
+                   std::unique_ptr<FlashwrightActionPhaseCallback> reply,
+                   bool ready) {
+                  if (!handler ||
+                      handler->flashwright_generation_ != generation ||
+                      !handler->flashwright_owner_.AsRenderFrameHostIfValid()) {
+                    reply->sendSuccess("ownerGone", "", std::nullopt,
+                                       std::nullopt);
+                    return;
+                  }
+                  handler->flashwright_navigation_ready_ = ready;
+                  reply->sendSuccess(ready ? "ready" : "error", "",
+                                     std::nullopt, std::nullopt);
+                },
+                weak_factory_.GetWeakPtr(), generation, std::move(callback)),
+            false));
+    return;
+  }
+  if (*phase == "routedMouse") {
+    auto x = data->FindDouble("x");
+    auto y = data->FindDouble("y");
+    auto serial = data->FindInt("serial");
+    const auto* type = data->FindString("type");
+    const auto* button = data->FindString("button");
+    auto modifiers = data->FindInt("modifiers");
+    auto buttons = data->FindInt("buttons");
+    auto count = data->FindInt("clickCount");
+    if (!x || !y || !serial || *serial <= 0 || !type || !button ||
+        !modifiers || !buttons || !count) {
+      callback->sendFailure(
+          Response::InvalidParams("Missing routed mouse properties"));
+      return;
+    }
+    DispatchFlashwrightMouseEvent(
+        flashwright_owner_, *type, *x, *y, *button, *modifiers, *buttons, *count,
+        base::BindOnce(
+            [](int serial,
+               std::unique_ptr<FlashwrightActionPhaseCallback> callback,
+               Response response, FlashwrightMouseAck result) {
+              if (!response.IsSuccess()) {
+                LOG(ERROR) << "FW_ROUTED_MOUSE_REJECT serial=" << serial;
+                callback->sendFailure(std::move(response));
+                return;
+              }
+              const char* status = "uncertain";
+              switch (result.disposition) {
+                case FlashwrightMouseAck::Disposition::kAcknowledged:
+                  status = "acknowledged";
+                  break;
+                case FlashwrightMouseAck::Disposition::kIgnored:
+                  status = "ignored";
+                  break;
+                case FlashwrightMouseAck::Disposition::kIntercepted:
+                  status = "intercepted";
+                  break;
+                case FlashwrightMouseAck::Disposition::kUncertain:
+                  break;
+              }
+              base::DictValue detail;
+              detail.Set("source", static_cast<int>(result.source));
+              detail.Set("state", static_cast<int>(result.state));
+              LOG(ERROR) << "FW_ROUTED_MOUSE_ACK serial=" << serial
+                         << " status=" << status;
+              callback->sendSuccess(status, base::WriteJson(detail).value(),
+                                    std::nullopt, std::nullopt);
+            },
+            *serial, std::move(callback)));
+    return;
+  }
+  if (*phase == "nativeMouse") {
+    // Diagnostic primitive only: root-widget mouse input without locator,
+    // drag, child-frame routing or action completion. The future controller
+    // must supply those contracts before using this in ordinary actions.
+    auto x = data->FindDouble("x");
+    auto y = data->FindDouble("y");
+    auto serial = data->FindInt("serial");
+    const auto* kind = data->FindString("kind");
+    const auto* destroy = data->FindString("destroy");
+    auto* widget = host_->GetRenderWidgetHost();
+    if (flashwright_owner_.AsRenderFrameHostIfValid() != host_.get() ||
+        !host_->IsOutermostMainFrame() || !widget || !widget->GetView() ||
+        !serial || *serial <= 0 || !x || !y ||
+        !std::isfinite(*x) || !std::isfinite(*y) ||
+        std::abs(*x) > 1000000 || std::abs(*y) > 1000000 || !kind ||
+        (*kind != "move" && *kind != "down" && *kind != "up") ||
+        (data->contains("destroy") &&
+         (!destroy || (*destroy != "filter" && *destroy != "dispatch" &&
+                       *destroy != "ack")))) {
+      callback->sendFailure(Response::InvalidParams("Invalid native mouse probe"));
+      return;
+    }
+    using Event = blink::WebInputEvent;
+    const bool move = *kind == "move";
+    blink::WebMouseEvent event(
+        move ? Event::Type::kMouseMove
+             : *kind == "down" ? Event::Type::kMouseDown : Event::Type::kMouseUp,
+        Event::kFromDebugger | (move ? 0 : Event::kLeftButtonDown),
+        base::TimeTicks::Now());
+    event.button = move ? blink::WebPointerProperties::Button::kNoButton
+                        : blink::WebPointerProperties::Button::kLeft;
+    event.click_count = move ? 0 : 1;
+    event.SetPositionInWidget(gfx::PointF(*x * ScaleFactor(), *y * ScaleFactor()));
+    event.SetPositionInScreen(event.PositionInWidget());
+    auto weak_widget = widget->GetWeakPtr();
+    auto weak_handler = weak_factory_.GetWeakPtr();
+    auto original_owner = flashwright_owner_;
+    widget->Focus();
+    auto* live_owner = original_owner.AsRenderFrameHostIfValid();
+    if (!weak_widget || !weak_handler || !live_owner ||
+        live_owner != weak_handler->host_.get()) {
+      callback->sendSuccess("ownerGone", "", std::nullopt, std::nullopt);
+      return;
+    }
+    std::shared_ptr<NativeMouseCloseProbe> close_probe;
+    if (destroy) {
+      close_probe = std::make_shared<NativeMouseCloseProbe>(
+          weak_widget.get(), original_owner, *destroy, event, *serial);
+    }
+    weak_widget->ForwardFlashwrightMouseEvent(
+        event,
+        base::BindOnce(
+            [](int serial,
+               std::shared_ptr<NativeMouseCloseProbe> close_probe,
+               std::unique_ptr<FlashwrightActionPhaseCallback> reply,
+               FlashwrightMouseAck result) {
+              const char* status = "uncertain";
+              switch (result.disposition) {
+                case FlashwrightMouseAck::Disposition::kAcknowledged:
+                  status = "acknowledged";
+                  break;
+                case FlashwrightMouseAck::Disposition::kIgnored:
+                  status = "ignored";
+                  break;
+                case FlashwrightMouseAck::Disposition::kIntercepted:
+                  status = "intercepted";
+                  break;
+                case FlashwrightMouseAck::Disposition::kUncertain:
+                  break;
+              }
+              base::DictValue detail;
+              detail.Set("source", static_cast<int>(result.source));
+              detail.Set("state", static_cast<int>(result.state));
+              LOG(ERROR) << "FW_NATIVE_MOUSE_ACK serial=" << serial
+                         << " status=" << status
+                         << " source=" << static_cast<int>(result.source)
+                         << " state=" << static_cast<int>(result.state);
+              close_probe.reset();
+              reply->sendSuccess(status, base::WriteJson(detail).value(),
+                                 std::nullopt, std::nullopt);
+            },
+            *serial, std::move(close_probe), std::move(callback)));
+    return;
+  }
+  auto request = blink::mojom::FlashwrightActionRequest::New();
+  if (*phase == "action" || *phase == "prepareAndArm") {
+    request->phase = Phase::kPrepareAndArm;
+  } else if (*phase == "prepare") {
+    request->phase = Phase::kPrepare;
+  } else if (*phase == "readiness") {
+    request->phase = Phase::kReadiness;
+  } else if (*phase == "arm") {
+    request->phase = Phase::kArm;
+  } else if (*phase == "finish") {
+    request->phase = Phase::kFinish;
+  } else if (*phase == "cleanup") {
+    request->phase = Phase::kCleanup;
+  } else {
+    callback->sendFailure(Response::InvalidParams("Unknown phase"));
+    return;
+  }
+  auto serial = data->FindInt("serial");
+  auto* token = data->FindString("token");
+  if (!serial || *serial <= 0 || !token || token->empty()) {
+    callback->sendFailure(Response::InvalidParams("Missing phase identity"));
+    return;
+  }
+  request->serial = *serial;
+  request->token = *token;
+  if (data->contains("selectorUnits")) {
+    const auto* units = data->FindList("selectorUnits");
+    if (!units || units->size() > 100000) {
+      callback->sendFailure(Response::InvalidParams("Invalid selector units"));
+      return;
+    }
+    for (const auto& value : *units) {
+      const auto unit = value.GetIfInt();
+      if (!unit || *unit < 0 || *unit > 65535) {
+        callback->sendFailure(Response::InvalidParams("Invalid selector unit"));
+        return;
+      }
+      request->selector_request.push_back(*unit);
+    }
+  } else if (const auto* selector = data->FindString("selector")) {
+    auto units = base::UTF8ToUTF16(*selector);
+    request->selector_request.assign(units.begin(), units.end());
+  }
+  request->deadline_epoch_ms = data->FindDouble("deadline");
+  request->action =
+      data->FindString("action") ? *data->FindString("action") : "click";
+  request->force = data->FindBool("force").value_or(false);
+  request->trial = data->FindBool("trial").value_or(false);
+  request->checked = data->FindBool("checked");
+  request->defer_readiness = data->FindBool("defer").value_or(false);
+  const auto count = data->FindInt("clickCount").value_or(1);
+  if (count < 1 || count > 100) {
+    callback->sendFailure(Response::InvalidParams("Invalid click count"));
+    return;
+  }
+  request->click_count = count;
+  const auto alignment = data->FindInt("alignment").value_or(0);
+  if (alignment < 0 || alignment > 3) {
+    callback->sendFailure(Response::InvalidParams("Invalid scroll alignment"));
+    return;
+  }
+  request->scroll_alignment = alignment;
+  request->host_owned = data->FindBool("hostOwned").value_or(false);
+  auto x = data->FindDouble("x");
+  auto y = data->FindDouble("y");
+  if (x && y && std::isfinite(*x) && std::isfinite(*y)) {
+    request->point = blink::mojom::FlashwrightActionPoint::New(*x, *y);
+  }
+  if (*phase == "action") {
+    if (!flashwright_navigation_ || !flashwright_navigation_ready_ ||
+        flashwright_navigation_generation_ != flashwright_generation_ ||
+        request->host_owned || request->defer_readiness ||
+        (request->deadline_epoch_ms && !std::isfinite(*request->deadline_epoch_ms)) ||
+        data->contains("button") || data->contains("modifiers") ||
+        data->contains("delay") || data->contains("x") || data->contains("y")) {
+      callback->sendFailure(Response::InvalidParams("Unsupported coarse attempt settings or observer missing"));
+      return;
+    }
+    if (request->action == "dblclick") request->click_count = 2;
+    flashwright_action_high_watermark_ =
+        std::max(flashwright_action_high_watermark_, request->serial);
+    if (!flashwright_pointer_controller_)
+      flashwright_pointer_controller_ = std::make_shared<FlashwrightPointerController>(
+          this, flashwright_retired_action_serial_);
+    flashwright_pointer_controller_->Start(std::move(request), json,
+        base::BindOnce(
+            [](std::unique_ptr<FlashwrightActionPhaseCallback> callback,
+               std::string status, base::DictValue detail) {
+              callback->sendSuccess(status, base::WriteJson(detail).value(),
+                                    std::nullopt, std::nullopt);
+            }, std::move(callback)));
+    return;
+  }
+  if (flashwright_pointer_controller_) {
+    callback->sendFailure(Response::ServerError("Executor is owned by coarse controller"));
+    return;
+  }
+  flashwright_phase_serial_ = std::max(flashwright_phase_serial_, request->serial);
+  flashwright_executor_->Run(
+      std::move(request),
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(
+              [](bool exact_units,
+                 std::unique_ptr<FlashwrightActionPhaseCallback> reply,
+                 blink::mojom::FlashwrightActionResultPtr result) {
+                std::string detail;
+                if (exact_units) {
+                  base::ListValue units;
+                  for (char16_t unit : result->detail) {
+                    units.Append(static_cast<int>(unit));
+                  }
+                  detail = base::WriteJson(units).value();
+                } else {
+                  detail = base::UTF16ToUTF8(result->detail);
+                }
+                reply->sendSuccess(
+                    StatusName(result->status), detail,
+                    result->point ? std::optional<double>(result->point->x)
+                                  : std::nullopt,
+                    result->point ? std::optional<double>(result->point->y)
+                                  : std::nullopt);
+              },
+              data->FindBool("detailUnits").value_or(false),
+              std::move(callback)),
+          blink::mojom::FlashwrightActionResult::New(
+              Status::kOwnerGone, std::u16string(), nullptr)));
+}
