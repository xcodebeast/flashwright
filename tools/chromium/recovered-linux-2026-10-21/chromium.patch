+#include "third_party/blink/renderer/bindings/core/v8/script_promise_resolver.h"
+#include "third_party/blink/renderer/bindings/core/v8/v8_binding_for_testing.h"
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "third_party/blink/renderer/core/fileapi/blob.h"
+#include "third_party/blink/renderer/core/html/canvas/canvas_async_blob_creator.h"
+#include "third_party/blink/renderer/platform/blob/blob_registry_owner.h"
+#include "third_party/blink/renderer/platform/blob/testing/fake_blob_registry.h"
+#include "third_party/blink/renderer/platform/graphics/unaccelerated_static_bitmap_image.h"
+#include "third_party/blink/renderer/platform/heap/persistent.h"
+#include "third_party/blink/renderer/platform/testing/task_environment.h"
+#include "third_party/blink/renderer/platform/wtf/functional.h"
+#include "third_party/skia/include/core/SkSurface.h"
+
+namespace blink {
+namespace {
+
+// Inject completion only; production registration and callback scheduling run
+// unchanged. The three payload bytes are not an encoded image.
+class CanvasCompletionProbe final : public CanvasAsyncBlobCreator {
+ public:
+  CanvasCompletionProbe(scoped_refptr<StaticBitmapImage> image,
+                        ExecutionContext* context,
+                        ScriptPromiseResolver<Blob>* resolver)
+      : CanvasAsyncBlobCreator(std::move(image),
+                               GetImageEncodeOptionsForMimeType(kMimeTypePng),
+                               kOffscreenCanvasConvertToBlobPromise,
+                               base::TimeTicks::Now(),
+                               context,
+                               resolver) {}
+
+  void Complete(ExecutionContext* original_context) {
+    completion_entered = true;
+    context_was_destroyed = original_context->IsContextDestroyed();
+    CreateBlobAndReturnResult(Vector<unsigned char>{1, 2, 3});
+    completion_returned = true;
+  }
+
+  bool completion_entered = false;
+  bool context_was_destroyed = false;
+  bool completion_returned = false;
+};
+
+class BlobRegistryOwnerTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    main_task_runner_ = base::SingleThreadTaskRunner::GetCurrentDefault();
+    SelectRegistry(false);
+  }
+
+  void TearDown() override {
+    Platform::Current()->GetBrowserInterfaceBroker()->SetBinderForTesting(
+        mojom::blink::BlobRegistry::Name_, {});
+    task_environment_.RunUntilIdle();
+  }
+
+  // This changes only future bindings. Existing real Mojo pipes keep their
+  // original receivers, unlike the old direct-pointer registry testing hook.
+  void SelectRegistry(bool replacement) {
+    auto* broker = Platform::Current()->GetBrowserInterfaceBroker();
+    broker->SetBinderForTesting(mojom::blink::BlobRegistry::Name_, {});
+    ASSERT_TRUE(broker->SetBinderForTesting(
+        mojom::blink::BlobRegistry::Name_,
+        base::BindRepeating(&BlobRegistryOwnerTest::BindRegistry,
+                            base::Unretained(this), replacement)));
+  }
+
+  void BindRegistry(bool replacement, mojo::ScopedMessagePipeHandle pipe) {
+    if (!main_task_runner_->RunsTasksInCurrentSequence()) {
+      main_task_runner_->PostTask(
+          FROM_HERE,
+          base::BindOnce(&BlobRegistryOwnerTest::BindRegistry,
+                         base::Unretained(this), replacement, std::move(pipe)));
+      return;
+    }
+    auto receiver =
+        mojo::PendingReceiver<mojom::blink::BlobRegistry>(std::move(pipe));
+    if (replacement) {
+      replacement_receivers_.Add(&replacement_registry_, std::move(receiver));
+    } else {
+      original_receivers_.Add(&original_registry_, std::move(receiver));
+    }
+  }
+
+  CanvasCompletionProbe* QueueCompletion(V8TestingScope& scope) {
+    auto surface = SkSurfaces::Raster(SkImageInfo::MakeN32Premul(20, 20));
+    CHECK(surface);
+    auto* resolver = MakeGarbageCollected<ScriptPromiseResolver<Blob>>(
+        scope.GetScriptState());
+    resolver->Promise();
+    auto* completion = MakeGarbageCollected<CanvasCompletionProbe>(
+        UnacceleratedStaticBitmapImage::Create(surface->makeImageSnapshot()),
+        scope.GetExecutionContext(), resolver);
+    scope.GetExecutionContext()
+        ->GetTaskRunner(TaskType::kCanvasBlobSerialization)
+        ->PostTask(FROM_HERE,
+                   BindOnce(&CanvasCompletionProbe::Complete,
+                            WrapPersistent(completion),
+                            WrapPersistent(scope.GetExecutionContext())));
+    return completion;
+  }
+
+  void CheckCompletion(bool close_page, bool replacement, bool disconnect) {
+    Persistent<CanvasCompletionProbe> completion;
+    Persistent<ExecutionContext> original_context;
+    {
+      V8TestingScope scope;
+      original_context = scope.GetExecutionContext();
+      completion = QueueCompletion(scope);
+      EXPECT_FALSE(completion->completion_entered);
+      if (!close_page) {
+        task_environment_.RunUntilIdle();
+        EXPECT_TRUE(completion->completion_returned);
+        EXPECT_FALSE(completion->context_was_destroyed);
+      }
+    }
+    ASSERT_TRUE(original_context->IsContextDestroyed());
+    if (replacement) {
+      SelectRegistry(true);
+    }
+    if (disconnect) {
+      original_receivers_.Clear();
+    }
+    task_environment_.RunUntilIdle();
+    EXPECT_TRUE(completion->completion_entered);
+    EXPECT_TRUE(completion->completion_returned);
+    EXPECT_EQ(completion->context_was_destroyed, close_page);
+    EXPECT_EQ(original_registry_.registrations.size(), disconnect ? 0u : 1u);
+    EXPECT_TRUE(replacement_registry_.registrations.empty());
+    if (!disconnect) {
+      ASSERT_EQ(original_registry_.registrations.size(), 1u);
+      const auto& registration = original_registry_.registrations[0];
+      EXPECT_EQ(registration.content_type, "image/png");
+      ASSERT_EQ(registration.elements.size(), 1u);
+      ASSERT_TRUE(registration.elements[0]->is_bytes());
+      EXPECT_EQ(registration.elements[0]->get_bytes()->embedded_data,
+                (Vector<uint8_t>{1, 2, 3}));
+    }
+  }
+
+  test::TaskEnvironment task_environment_;
+  scoped_refptr<base::SingleThreadTaskRunner> main_task_runner_;
+  FakeBlobRegistry original_registry_;
+  FakeBlobRegistry replacement_registry_;
+  mojo::ReceiverSet<mojom::blink::BlobRegistry> original_receivers_;
+  mojo::ReceiverSet<mojom::blink::BlobRegistry> replacement_receivers_;
+};
+
+TEST_F(BlobRegistryOwnerTest, LivePageCompletionRegistersBlob) {
+  CheckCompletion(false, false, false);
+}
+
+TEST_F(BlobRegistryOwnerTest, QueuedCompletionRunsAfterPageClose) {
+  CheckCompletion(true, false, false);
+}
+
+TEST_F(BlobRegistryOwnerTest, QueuedCompletionKeepsOriginalRegistry) {
+  CheckCompletion(true, true, false);
+}
+
+TEST_F(BlobRegistryOwnerTest, DisconnectedOriginalDoesNotUseReplacement) {
+  CheckCompletion(true, true, true);
+}
+
+TEST_F(BlobRegistryOwnerTest, FreshCanvasUsesReplacementRegistry) {
+  CheckCompletion(true, true, false);
+  {
+    V8TestingScope scope;
+    Persistent<CanvasCompletionProbe> completion = QueueCompletion(scope);
+    task_environment_.RunUntilIdle();
+    EXPECT_TRUE(completion->completion_returned);
+    EXPECT_FALSE(completion->context_was_destroyed);
+  }
+  EXPECT_EQ(original_registry_.registrations.size(), 1u);
+  EXPECT_EQ(replacement_registry_.registrations.size(), 1u);
+}
+
+TEST_F(BlobRegistryOwnerTest, DerivedSliceKeepsOriginalRegistry) {
+  V8TestingScope scope;
+  auto owner = BlobRegistryOwner::Capture(
+      *Platform::Current()->GetBrowserInterfaceBroker());
+  const Vector<uint8_t> bytes{1, 2, 3};
+  Persistent<Blob> original = Blob::Create(bytes, "text/plain", owner);
+  owner.reset();
+  SelectRegistry(true);
+  auto* slice = original->slice(1, 3, "text/slice", scope.GetExceptionState());
+  ASSERT_FALSE(scope.GetExceptionState().HadException());
+  ASSERT_EQ(original_registry_.registrations.size(), 2u);
+  EXPECT_TRUE(replacement_registry_.registrations.empty());
+  EXPECT_EQ(slice->size(), 2u);
+  EXPECT_EQ(slice->type(), "text/slice");
+  const auto& registration = original_registry_.registrations[1];
+  ASSERT_EQ(registration.elements.size(), 1u);
+  ASSERT_TRUE(registration.elements[0]->is_blob());
+  EXPECT_EQ(registration.elements[0]->get_blob()->offset, 1u);
+  EXPECT_EQ(registration.elements[0]->get_blob()->length, 2u);
+}
+
+TEST_F(BlobRegistryOwnerTest, CrossSequenceRegistrationKeepsOriginalRegistry) {
+  auto owner = BlobRegistryOwner::Capture(
+      *Platform::Current()->GetBrowserInterfaceBroker());
+  SelectRegistry(true);
+  base::Thread worker("blob-owner-test");
+  ASSERT_TRUE(worker.Start());
+  bool registered = false;
+  base::RunLoop run_loop;
+  worker.task_runner()->PostTaskAndReply(
+      FROM_HERE,
+      base::BindOnce(
+          [](scoped_refptr<BlobRegistryOwner> captured_owner, bool* result) {
+            mojo::PendingRemote<mojom::blink::Blob> blob;
+            *result =
+                captured_owner->Register(blob.InitWithNewPipeAndPassReceiver(),
+                                         "cross-sequence", "text/plain", {});
+          },
+          std::move(owner), &registered),
+      run_loop.QuitClosure());
+  run_loop.Run();
+  worker.Stop();
+  EXPECT_TRUE(registered);
+  ASSERT_EQ(original_registry_.registrations.size(), 1u);
+  EXPECT_EQ(original_registry_.registrations[0].uuid, "cross-sequence");
+  EXPECT_TRUE(replacement_registry_.registrations.empty());
+}
+
+TEST_F(BlobRegistryOwnerTest, WorkerCreatedOwnerSurvivesWorkerStop) {
+  base::Thread worker("blob-owner-creation-test");
+  ASSERT_TRUE(worker.Start());
+  scoped_refptr<BlobRegistryOwner> owner;
+  base::RunLoop run_loop;
+  worker.task_runner()->PostTaskAndReply(
+      FROM_HERE,
+      base::BindOnce(
+          [](scoped_refptr<BlobRegistryOwner>* result) {
+            *result = BlobRegistryOwner::Capture(
+                *Platform::Current()->GetBrowserInterfaceBroker());
+          },
+          &owner),
+      run_loop.QuitClosure());
+  run_loop.Run();
+  worker.Stop();
+  SelectRegistry(true);
+  mojo::PendingRemote<mojom::blink::Blob> blob;
+  EXPECT_TRUE(owner->Register(blob.InitWithNewPipeAndPassReceiver(),
+                              "worker-created", "text/plain", {}));
+  ASSERT_EQ(original_registry_.registrations.size(), 1u);
+  EXPECT_EQ(original_registry_.registrations[0].uuid, "worker-created");
+  EXPECT_TRUE(replacement_registry_.registrations.empty());
+}
+
+}  // namespace
+}  // namespace blink
