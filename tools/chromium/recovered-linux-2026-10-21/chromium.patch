+void WorkerThread::BeginFlashwrightRetirement() {
+  Vector<std::pair<scoped_refptr<base::SingleThreadTaskRunner>, int>> requests;
+  {
+    base::AutoLock locker(ThreadSetLock());
+    auto& retirement = FlashwrightRetirement();
+    if (retirement.admission_closed) {
+      return;
+    }
+    retirement.admission_closed = true;
+    for (const auto* workers :
+         {&InitializingWorkerThreads(), &WorkerThreads()}) {
+      for (auto* worker : *workers) {
+        requests.emplace_back(worker->parent_thread_default_task_runner_,
+                              worker->worker_thread_id_);
+      }
+    }
+  }
+  for (auto& [task_runner, identifier] : requests) {
+    RequestFlashwrightWorkerTermination(*task_runner, identifier);
+  }
+}
