+void WorkerThread::RequestFlashwrightWorkerTermination(
+    base::SingleThreadTaskRunner& task_runner,
+    int worker_thread_id,
+    base::TimeDelta delay) {
+  if (!PostDelayedCrossThreadTask(
+          task_runner, FROM_HERE,
+          CrossThreadBindOnce(
+              &WorkerThread::TerminateFlashwrightWorkerOnParentThread,
+              worker_thread_id),
+          delay)) {
+    base::AutoLock locker(ThreadSetLock());
+    FlashwrightRetirement().dispatch_failed = true;
+  }
+}
