+  if ((type != "mouseMoved" && type != "mousePressed" &&
+       type != "mouseReleased") ||
+      !std::isfinite(x) || !std::isfinite(y) ||
+      std::abs(x) > 1000000 || std::abs(y) > 1000000 ||
+      modifiers < 0 || modifiers > 15 || buttons < 0 || buttons > 31 ||
+      click_count < 0 || click_count > 100 ||
+      (type == "mouseMoved" && (buttons != 0 || button != "none"))) {
+    std::move(callback).Run(Response::InvalidParams("Invalid routed mouse"),
+                            FlashwrightMouseAck());
