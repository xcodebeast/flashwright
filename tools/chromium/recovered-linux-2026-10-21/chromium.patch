+void SystemInfoHandler::GetFlashwrightRendererState(
+    int process_id,
+    const String& requested_action,
+    std::unique_ptr<GetFlashwrightRendererStateCallback> callback) {
+  const bool retain_context = requested_action.starts_with("retain-context:");
+  const String original_context = retain_context
+      ? requested_action.substr(sizeof("retain-context:") - 1) : String();
+  const String action = retain_context ? "retain" : requested_action;
+  if (!is_browser_session_ ||
+      base::Environment::Create()->GetVar(
+          "FLASHWRIGHT_RENDERER_RETIREMENT_PROBE") != "1") {
+    callback->sendFailure(Response::ServerError(
+        "Private renderer retirement diagnostic unavailable"));
+    return;
+  }
+  if (action == "adoption-reply-held" || action == "release-adoption-reply") {
+    auto found = held_adoption_replies_.find(process_id);
+    const bool held = found != held_adoption_replies_.end() && found->second;
+    auto result = std::make_unique<base::DictValue>();
+    result->Set("processId", process_id);
+    if (action == "adoption-reply-held") {
+      result->Set("held", held);
+    } else {
+      result->Set("released", held);
+      if (held) {
+        auto continuation = std::move(found->second);
+        held_adoption_replies_.erase(found);
+        std::move(continuation).Run();
+      }
+    }
+    callback->sendSuccess(std::move(result));
+    return;
+  }
+  const bool held_adoption = action.starts_with("adopt-hold-attach:") ||
+                             action.starts_with("adopt-hold-initialize:");
+  const bool physical_control =
+      action == "control-inspect" || action == "prepare-detach" ||
+      action == "detach" || action == "control-notify" || action == "attach" ||
+      action == "attach-incompatible" || action.starts_with("adopt:") ||
+      held_adoption;
+  if (action != "inspect" && action != "retain" && action != "release" &&
+      action != "retire-workers" && !physical_control) {
+    callback->sendFailure(Response::InvalidParams("Unknown diagnostic action"));
+    return;
+  }
+  // Destruction of the original context overrides diagnostic references.
+  // Remove those identities before enforcing the bound on still-owned holds.
+  for (auto iterator = flashwright_retained_host_ids_.begin();
+       iterator != flashwright_retained_host_ids_.end();) {
+    auto* host = RenderProcessHost::FromID(*iterator);
+    if (!host || host->AreRefCountsDisabled()) {
+      iterator = flashwright_retained_host_ids_.erase(iterator);
+    } else {
+      ++iterator;
+    }
+  }
+  RenderProcessHost* selected_host = nullptr;
+  for (auto iterator = RenderProcessHost::AllHostsIterator();
+       !iterator.IsAtEnd(); iterator.Advance()) {
+    auto* host = iterator.GetCurrentValue();
+    if ((host->IsReady() ||
+         ((physical_control || action == "release" || action == "inspect") &&
+          host->IsInitializedAndNotDead())) &&
+        host->GetProcess().IsValid() &&
+        !host->AreRefCountsDisabled() && host->GetBrowserContext() &&
+        host->GetBrowserContext()->IsOffTheRecord() &&
+        (retain_context
+             ? (!host->GetBrowserContext()->ShutdownStarted() &&
+                host->GetBrowserContext()->UniqueId() == original_context)
+             : host->GetProcess().Pid() == process_id)) {
+      if (selected_host) {
+        auto state = std::make_unique<base::DictValue>();
+        state->Set("eligible", false);
+        state->Set("reason", "multiple-context-renderers");
+        callback->sendSuccess(std::move(state));
+        return;
+      }
+      selected_host = host;
+      if (!retain_context)
+        break;
+    }
+  }
+  if (!selected_host && retain_context) {
+    auto state = std::make_unique<base::DictValue>();
+    state->Set("eligible", false);
+    state->Set("reason", "no-ready-context-renderer");
+    callback->sendSuccess(std::move(state));
+    return;
+  }
+  if (!selected_host) {
+    callback->sendFailure(
+        Response::ServerError("Live private renderer absent"));
+    return;
+  }
+  // Selection and hold admission occur on the UI sequence without yielding.
+  // Never retain a globally selected PID on behalf of a different context.
+  process_id = selected_host->GetProcess().Pid();
+  const int host_id = selected_host->GetDeprecatedID();
+  if (physical_control) {
+    if (!flashwright_retained_host_ids_.contains(host_id)) {
+      callback->sendFailure(Response::ServerError("Renderer was not retained"));
+      return;
+    }
+    if (held_adoption) {
+      if (held_adoption_replies_.size() >= 16 ||
+          held_adoption_replies_.contains(process_id)) {
+        callback->sendFailure(Response::ServerError(
+            "Private adoption reply reservation unavailable"));
+        return;
+      }
+      held_adoption_replies_.try_emplace(process_id);
+    }
+    RendererConnectionDiagnostic::Run(
+        *selected_host, action,
+        base::BindOnce(
+            [](base::WeakPtr<SystemInfoHandler> handler,
+               std::unique_ptr<GetFlashwrightRendererStateCallback> completion,
+               int host_id, int process_id, bool held_adoption, bool accepted,
+               mojom::RendererConnectionStatePtr observed) {
+              if (handler && held_adoption) {
+                auto reservation =
+                    handler->held_adoption_replies_.find(process_id);
+                if (reservation != handler->held_adoption_replies_.end() &&
+                    !reservation->second) {
+                  handler->held_adoption_replies_.erase(reservation);
+                }
+              }
+              if (!observed) {
+                completion->sendFailure(Response::ServerError(
+                    "Physical renderer control disconnected or timed out"));
+                return;
+              }
+              if (accepted && handler) {
+                for (auto iterator = RenderProcessHost::AllHostsIterator();
+                     !iterator.IsAtEnd(); iterator.Advance()) {
+                  auto* successor = iterator.GetCurrentValue();
+                  if (!successor->GetProcess().IsValid() ||
+                      successor->GetProcess().Pid() != process_id ||
+                      successor->GetDeprecatedID() == host_id) {
+                    continue;
+                  }
+                  if (handler->flashwright_retained_host_ids_
+                          .insert(successor->GetDeprecatedID())
+                          .second) {
+                    successor->IncrementPendingReuseRefCount();
+                  }
+                  if (handler->flashwright_retained_host_ids_.erase(host_id)) {
+                    auto* original = RenderProcessHost::FromID(host_id);
+                    if (original && !original->AreRefCountsDisabled()) {
+                      original->DecrementPendingReuseRefCount();
+                    }
+                  }
+                  host_id = successor->GetDeprecatedID();
+                  break;
+                }
+              }
+              auto state = std::make_unique<base::DictValue>();
+              state->Set("hostId", host_id);
+              state->Set("processId", process_id);
+              state->Set("accepted", accepted);
+              state->Set("connectionIdentity",
+                         observed->connection_identity.ToString());
+              state->Set("phase", static_cast<int>(observed->phase));
+              completion->sendSuccess(std::move(state));
+            },
+            weak_factory_.GetWeakPtr(), std::move(callback), host_id,
+            process_id, held_adoption),
+        base::BindOnce(&SystemInfoHandler::HoldAdoptionReply,
+                       weak_factory_.GetWeakPtr(), process_id));
+    return;
+  }
+  if (action == "retire-workers") {
+    if (!flashwright_retained_host_ids_.contains(host_id)) {
+      callback->sendFailure(Response::ServerError("Renderer was not retained"));
+      return;
+    }
+    RendererConnectionDiagnostic::Run(
+        *selected_host, action,
+        base::BindOnce(
+            [](std::unique_ptr<GetFlashwrightRendererStateCallback> completion,
+               int host_id, int process_id, bool completed,
+               mojom::RendererConnectionStatePtr ignored) {
+              auto state = std::make_unique<base::DictValue>();
+              state->Set("hostId", host_id);
+              state->Set("processId", process_id);
+              state->Set("workerRetirementCompleted", completed);
+              completion->sendSuccess(std::move(state));
+            },
+            std::move(callback), host_id, process_id));
+    return;
+  }
+  if (action == "release") {
+    if (!flashwright_retained_host_ids_.erase(host_id)) {
+      callback->sendFailure(Response::ServerError("Renderer was not retained"));
+      return;
+    }
+    selected_host->DecrementPendingReuseRefCount();
+    auto state = std::make_unique<base::DictValue>();
+    state->Set("released", true);
+    callback->sendSuccess(std::move(state));
+    return;
+  }
+  if (action == "retain" && !flashwright_retained_host_ids_.contains(host_id)) {
+    if (flashwright_retained_host_ids_.size() >= 16) {
+      callback->sendFailure(
+          Response::ServerError("Renderer hold limit reached"));
+      return;
+    }
+    selected_host->IncrementPendingReuseRefCount();
+    flashwright_retained_host_ids_.insert(host_id);
+  }
+  selected_host->GetRendererInterface()->GetFlashwrightRendererState(
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(
+              [](std::unique_ptr<GetFlashwrightRendererStateCallback>
+                     completion,
+                 int host_id, int process_id, bool retained,
+                 String context_id,
+                 mojom::FlashwrightRendererStatePtr observed) {
+                if (!observed) {
+                  completion->sendFailure(Response::ServerError(
+                      "Renderer disconnected before state observation"));
+                  return;
+                }
+                auto state = std::make_unique<base::DictValue>();
+                state->Set("hostId", host_id);
+                state->Set("processId", process_id);
+                state->Set("browserContextId", context_id);
+                state->Set("eligible", true);
+                state->Set("retained", retained);
+                state->Set("frames", static_cast<int>(observed->frames));
+                state->Set("views", static_cast<int>(observed->views));
+                state->Set("workers", static_cast<int>(observed->workers));
+                state->Set("schedulingGroups",
+                           static_cast<int>(observed->scheduling_groups));
+                completion->sendSuccess(std::move(state));
+              },
+              std::move(callback), host_id, process_id,
+              flashwright_retained_host_ids_.contains(host_id),
+              selected_host->GetBrowserContext()->UniqueId()),
+          mojom::FlashwrightRendererStatePtr()));
+}
