+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/platform/blob/blob_registry_owner.h"
+
+#include "base/task/bind_post_task.h"
+#include "base/task/sequenced_task_runner.h"
+#include "mojo/public/cpp/bindings/callback_helpers.h"
+#include "third_party/blink/public/common/thread_safe_browser_interface_broker_proxy.h"
+#include "third_party/blink/public/mojom/blob/data_element.mojom-blink.h"
+#include "third_party/blink/renderer/platform/blob/blob_data.h"
+#include "third_party/blink/renderer/platform/scheduler/public/main_thread.h"
+
+namespace blink {
+
+scoped_refptr<BlobRegistryOwner> BlobRegistryOwner::Capture(
+    ThreadSafeBrowserInterfaceBrokerProxy& broker) {
+  mojo::PendingRemote<mojom::blink::BlobRegistry> registry;
+  broker.GetInterface(registry.InitWithNewPipeAndPassReceiver());
+  return base::AdoptRef(new BlobRegistryOwner(std::move(registry)));
+}
+
+BlobRegistryOwner::BlobRegistryOwner(
+    mojo::PendingRemote<mojom::blink::BlobRegistry> registry)
+    // Derived blobs can outlive the worker that created the original blob.
+    : registry_task_runner_(Thread::MainThread()->GetTaskRunner(
+          MainThreadTaskRunnerRestricted())),
+      registry_(std::move(registry), registry_task_runner_) {}
+
+BlobRegistryOwner::~BlobRegistryOwner() = default;
+
+mojo::SharedRemote<mojom::blink::BlobRegistry> BlobRegistryOwner::CopyRegistry()
+    const {
+  base::AutoLock lock(registry_lock_);
+  return registry_;
+}
+
+bool BlobRegistryOwner::Register(
+    mojo::PendingReceiver<mojom::blink::Blob> receiver,
+    const String& identifier,
+    const String& content_type,
+    Vector<mojom::blink::DataElementPtr> elements) const {
+  auto registry = CopyRegistry();
+  return registry->Register(std::move(receiver), identifier, content_type, "",
+                            std::move(elements));
+}
+
+void BlobRegistryOwner::RegisterFromStream(
+    const String& content_type,
+    mojo::ScopedDataPipeConsumerHandle data,
+    CrossThreadOnceFunction<void(const scoped_refptr<BlobDataHandle>&)>
+        callback) const {
+  auto reply = mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+      base::BindPostTask(base::SequencedTaskRunner::GetCurrentDefault(),
+                         ConvertToBaseOnceCallback(std::move(callback))),
+      scoped_refptr<BlobDataHandle>());
+  auto register_stream = base::BindOnce(
+      [](mojo::SharedRemote<mojom::blink::BlobRegistry> registry, String type,
+         mojo::ScopedDataPipeConsumerHandle data,
+         mojom::blink::BlobRegistry::RegisterFromStreamCallback reply) {
+        registry->RegisterFromStream(
+            type.IsNull() ? "" : type, "", 0, std::move(data),
+            mojo::PendingAssociatedRemote<mojom::blink::ProgressClient>(),
+            std::move(reply));
+      },
+      CopyRegistry(), content_type, std::move(data), std::move(reply));
+  // Calling on the registry sequence avoids SharedRemote's DeleteSoon reply
+  // cleanup, which retains responders when a calling worker has stopped.
+  // Our cross-thread reply can instead be destroyed when return posting fails.
+  // Always post: main-thread callers may have an ASG-specific default runner.
+  registry_task_runner_->PostTask(FROM_HERE, std::move(register_stream));
+}
+
+}  // namespace blink
