+  // raw frame/widget pointers only afterward, through the retained weak owner.
+  if (admission && !admission.Run()) {
+    std::move(callback).Run(
+        Response::ServerError("Routed mouse admission rejected"),
+        FlashwrightMouseAck());
+    return;
+  }
+  auto* frame = owner.AsRenderFrameHostIfValid();
+  auto* widget = handler && handler->host_
+                     ? handler->host_->GetRenderWidgetHost()
+                     : nullptr;
