+namespace content {
+
+class RenderProcessHost;
+class RenderProcessHostImpl;
+
+// Owns one renderer's primordial endpoints and physical process services.
+// Unknown requests retain the original logical host's weak fallback; this
+// transport never selects a successor host or another browser context.
+class CONTENT_EXPORT RendererProcessTransport final
+    : public base::RefCountedDeleteOnSequence<RendererProcessTransport> {
+ public:
+  RendererProcessTransport(
+      ChildProcessId child_process_id,
+      base::WeakPtr<RenderProcessHostImpl> original_host,
+      mojo::PendingRemote<mojom::ChildProcess> child_process,
+      mojo::PendingReceiver<mojom::ChildProcessHost> physical_host_receiver);
+  RendererProcessTransport(const RendererProcessTransport&) = delete;
+  RendererProcessTransport& operator=(const RendererProcessTransport&) = delete;
+
+  mojom::ChildProcess* GetChildProcess() const;
+  viz::GpuClient* GetGpuClient() const;
+
+  // UI-only. Accepts the same PID repeatedly, never a new physical process.
+  void OnProcessLaunched(base::ProcessId process_id);
+
+  // A logical host only borrows these services. Ending the physical lifetime
+  // closes its endpoints even when another reference retains the transport.
+  void AttachToHost(RenderProcessHost& host);
+  void OnProcessExited();
+
+  base::ReadOnlySharedMemoryRegion DuplicateLastForegroundTimeRegion(
+      base::TimeTicks initial_time);
+  void SetLastForegroundTime(base::TimeTicks time);
+  void BindAecDumpManager(
+      mojo::PendingReceiver<blink::mojom::AecDumpManager> receiver);
+  void StartAecDump(const base::FilePath& file_path);
+  void StopAecDump();
+  void OnMemoryPressure(base::MemoryPressureLevel level);
+
+  void CreateMetricsAllocator(bool is_webium_renderer);
+  scoped_refptr<base::RefCountedData<base::UnsafeSharedMemoryRegion>>
+  GetMetricsMemoryRegion() const;
+  std::unique_ptr<base::PersistentMemoryAllocator> TakeMetricsAllocator();
+  void ShareMetricsMemoryRegion();
+
+ private:
+  friend class base::RefCountedDeleteOnSequence<RendererProcessTransport>;
+  friend class base::DeleteHelper<RendererProcessTransport>;
+  ~RendererProcessTransport();
+
+  class Impl;
+  const std::unique_ptr<Impl> implementation_;
+};
+
+}  // namespace content
+
+#endif  // CONTENT_BROWSER_RENDERER_HOST_RENDERER_PROCESS_TRANSPORT_H_
