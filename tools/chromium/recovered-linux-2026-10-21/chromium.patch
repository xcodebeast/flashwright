@@ -0,0 +1,70 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/renderer/renderer_worker_service_dispatcher.h"
+
+#include <utility>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/task/bind_post_task.h"
+#include "base/task/sequenced_task_runner.h"
+#include "content/renderer/renderer_worker_service_context.h"
+
+namespace content {
+
+RendererWorkerServiceDispatcher::RendererWorkerServiceDispatcher(
+    scoped_refptr<RendererWorkerServiceContext> service_context,
+    mojo::BinderMap binders,
+    mojo::PendingReceiver<mojom::RendererWorkerService> receiver)
+    : service_context_(std::move(service_context)),
+      binders_(std::move(binders)) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  CHECK(service_context_);
+  service_registration_ = service_context_->RegisterService(
+      base::BindPostTask(base::SequencedTaskRunner::GetCurrentDefault(),
+                         base::BindOnce(&RendererWorkerServiceDispatcher::Close,
+                                        weak_factory_.GetWeakPtr())));
+  if (!service_registration_) {
+    Close();
+    return;
+  }
+
+  receiver_.Bind(std::move(receiver));
+  receiver_.set_disconnect_handler(
+      base::BindOnce(&RendererWorkerServiceDispatcher::OnDisconnected,
+                     weak_factory_.GetWeakPtr()));
+}
+
+RendererWorkerServiceDispatcher::~RendererWorkerServiceDispatcher() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  Close();
+}
+
+void RendererWorkerServiceDispatcher::BindReceiver(
+    mojo::GenericPendingReceiver receiver) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!service_registration_ || service_context_->IsRetired() ||
+      !receiver.is_valid()) {
+    return;
+  }
+  if (!binders_.TryBind(&receiver)) {
+    return;
+  }
+}
+
+void RendererWorkerServiceDispatcher::Close() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  receiver_.reset();
+  binders_ = mojo::BinderMap();
+  service_registration_.reset();
+}
+
+void RendererWorkerServiceDispatcher::OnDisconnected() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  service_context_->Retire();
+  Close();
+}
+
+}  // namespace content
