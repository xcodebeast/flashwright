+bool AgentSchedulingGroupHost::CanRebindBrowserConnection(
+    RenderProcessHost& process) {
+  auto* data = static_cast<AgentSchedulingGroupHostUserData*>(
+      process.GetUserData(kAgentSchedulingGroupHostDataKey));
+  if (!data) {
+    return true;
+  }
+  for (const auto& host : data->owned_host_set) {
+    if (host->state_ != LifecycleState::kBound ||
+        !host->listener_map_.IsEmpty() ||
+        host->live_site_instance_groups_ != 0) {
+      return false;
+    }
+  }
+  return true;
+}
+
+void AgentSchedulingGroupHost::RebindBrowserConnection(
+    RenderProcessHost& process) {
+  CHECK(CanRebindBrowserConnection(process));
+  auto* data = static_cast<AgentSchedulingGroupHostUserData*>(
+      process.GetUserData(kAgentSchedulingGroupHostDataKey));
+  if (!data) {
+    return;
+  }
+  for (const auto& host : data->owned_host_set) {
+    host->SetState(LifecycleState::kConnectionDetached);
+    host->ResetIPC();
+    host->SetUpIPC();
+  }
+}
