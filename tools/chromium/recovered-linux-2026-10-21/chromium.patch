+int main(int argc, char** argv) {
+  base::AtExitManager at_exit;
+  base::CommandLine::Init(argc, argv);
+  const auto* command = base::CommandLine::ForCurrentProcess();
+  ConfigureManagedForkProbe(command->HasSwitch("omit-cpp-member-trace"),
+                            command->HasSwitch("omit-cpp-js-trace"));
+  const bool fork_mode = command->HasSwitch("fork");
+  const int children = command->HasSwitch("children")
+      ? std::stoi(command->GetSwitchValueASCII("children")) : 4;
+  CHECK(children > 0 && children <= 32);
+  CHECK(base::i18n::InitializeICU());
+#ifdef V8_USE_EXTERNAL_STARTUP_DATA
+  gin::V8Initializer::LoadV8Snapshot();
+#endif
+  base::FeatureList::SetInstance(std::make_unique<base::FeatureList>());
+  base::ThreadPoolInstance::Create("fork-feasibility");
+  auto runner = base::MakeRefCounted<DeferredRunner>();
+  gin::IsolateHolder::Initialize(
+      command->HasSwitch("application-source")
+          ? gin::IsolateHolder::kNonStrictMode
+          : gin::IsolateHolder::kStrictMode,
+      gin::ArrayBufferAllocator::SharedInstance());
+  auto params = gin::IsolateHolder::getDefaultIsolateParams();
+  if (command->HasSwitch("blink-spaces"))
+    params->cpp_heap = CreateBlinkConfiguredForkHeap().release();
+  auto holder = std::make_unique<gin::IsolateHolder>(runner,
+      gin::IsolateHolder::kSingleThread,
+      gin::IsolateHolder::IsolateType::kBlinkMainThread, std::move(params));
+  v8::Global<v8::UnboundScript> compiled;
+  std::string application_text;
+  v8::Global<v8::UnboundScript> application_compiled;
+  if (command->HasSwitch("application-source")) {
+    CHECK(base::ReadFileToStringWithMaxSize(
+        command->GetSwitchValuePath("application-source"), &application_text,
+        16 * 1024 * 1024));
+    CHECK(!application_text.empty());
+    CHECK_EQ(application_text.find('\0'), std::string::npos);
+  }
+  {
+    auto* isolate = holder->isolate();
+    v8::Isolate::Scope scope(isolate); v8::HandleScope handles(isolate);
+    auto context = v8::Context::New(isolate); v8::Context::Scope realm(context);
+    std::string text;
+    for (int i=0; i<512; ++i)
+      text += "function f"+std::to_string(i)+"(x){return x+"+std::to_string(i)+";}\n";
+    v8::ScriptCompiler::Source source(Str(isolate, text));
+    compiled.Reset(isolate, v8::ScriptCompiler::CompileUnboundScript(isolate,
+        &source, v8::ScriptCompiler::kEagerCompile).ToLocalChecked());
+    if (!application_text.empty()) {
+      v8::ScriptOrigin origin(
+          Str(isolate, "https://flashwright.invalid/application.js"));
+      v8::ScriptCompiler::Source application_source(
+          Str(isolate, application_text), origin);
+      application_compiled.Reset(isolate,
+          v8::ScriptCompiler::CompileUnboundScript(
+              isolate, &application_source, v8::ScriptCompiler::kEagerCompile)
+              .ToLocalChecked());
+      printf("{\"event\":\"application-prepared\",\"pid\":%d,"
+             "\"sourceBytes\":%zu,\"applicationExecutions\":0}\n",
+             getpid(), application_text.size());
+      fflush(stdout);
+    }
+  }
+  if (command->HasSwitch("managed"))
+    PrepareManagedForkHeap(holder->isolate(), command->HasSwitch("blink-spaces"));
+  CHECK_EQ(Threads(), 1);
+  CheckForkHeapQuiescence(holder->isolate());
+  int foreground_count = 0;
+  auto foreground = gin::V8Platform::Get()->GetForegroundTaskRunner(
+      holder->isolate(), v8::TaskPriority::kUserBlocking);
+  foreground->PostTask(std::make_unique<CallbackTask>(base::BindOnce(
+      [](int* count) { ++*count; }, &foreground_count)));
+  foreground->PostNonNestableTask(std::make_unique<CallbackTask>(base::BindOnce(
+      [](int* count) { ++*count; }, &foreground_count)));
+  foreground->PostDelayedTask(std::make_unique<CallbackTask>(base::BindOnce(
+      [](int* count) { ++*count; }, &foreground_count)), 0.01);
+  foreground->PostNonNestableDelayedTask(std::make_unique<CallbackTask>(base::BindOnce(
+      [](int* count) { ++*count; }, &foreground_count)), 0.01);
+  std::atomic<int> pending{0}, completed{0};
+  auto job = gin::V8Platform::Get()->PostJob(v8::TaskPriority::kUserVisible,
+      std::make_unique<EmptyThenActiveJob>(&pending, &completed));
+  CHECK_EQ(foreground_count, 0); CHECK_EQ(completed.load(), 0);
+  CHECK_EQ(Threads(), 1);
+  printf("{\"event\":\"prepared\",\"pid\":%d,\"threads\":1,\"functions\":512,\"applicationExecutions\":0}\n", getpid());
+  fflush(stdout);
+  int child_index = 0;
+  bool donor = fork_mode;
+  std::vector<std::pair<int, pid_t>> children_to_reap;
+  if (fork_mode) {
+    for (int i=0; i<children; ++i) {
+      CHECK_EQ(Threads(), 1);
+      pid_t pid = command->HasSwitch("raw-clone")
+          ? syscall(SYS_clone, SIGCHLD, nullptr, nullptr, nullptr, 0)
+          : fork();
+      CHECK_GE(pid, 0);
+      if (pid == 0) {
+        base::internal::InvalidateTidCache();
+        if (command->HasSwitch("reset-thread-cache") ||
+            command->HasSwitch("repair-heap"))
+          InvalidateForkThreadCache();
+        if (command->HasSwitch("repair-heap"))
+          RebindForkHeap(holder->isolate());
+        if (command->HasSwitch("repair-randomness"))
+          RepairForkRandomness(holder->isolate(), base::RandUint64(),
+                               base::RandUint64());
+        child_index=i; donor=false; break;
+      }
+      if (command->HasSwitch("concurrent")) {
+        children_to_reap.emplace_back(i, pid);
+        continue;
+      }
+      int status = 0; CHECK_EQ(waitpid(pid, &status, 0), pid);
+      CHECK(WIFEXITED(status)); CHECK_EQ(WEXITSTATUS(status), 0);
+      printf("{\"event\":\"reaped\",\"child\":%d,\"pid\":%d,\"exit\":0}\n", i, pid);
+      fflush(stdout);
+    }
+  }
+  if (donor) for (const auto& [index, pid] : children_to_reap) {
+    int status=0; CHECK_EQ(waitpid(pid, &status, 0), pid);
+    CHECK(WIFEXITED(status)); CHECK_EQ(WEXITSTATUS(status), 0);
+    printf("{\"event\":\"reaped\",\"child\":%d,\"pid\":%d,\"exit\":0}\n", index, pid);
+    fflush(stdout);
+  }
+  base::SingleThreadTaskExecutor executor;
+  printf("{\"event\":\"heap-owner\",\"pid\":%d,\"kernelTid\":%ld,\"v8Tid\":%d,\"matchesCurrentThread\":%s}\n",
+         getpid(), syscall(SYS_gettid), ForkV8ThreadId(),
+         ForkHeapThreadMatches(holder->isolate()) ? "true" : "false");
+  fflush(stdout);
+  runner->Activate(base::SingleThreadTaskRunner::GetCurrentDefault());
+  base::ThreadPoolInstance::Get()->Start(base::ThreadPoolInstance::InitParams(4));
+  pending.store(32); job->NotifyConcurrencyIncrease(); job->Join();
+  CHECK_EQ(completed.load(), 32); job.reset();
+  base::RunLoop delayed;
+  auto delay_started = base::TimeTicks::Now();
+  foreground->PostNonNestableDelayedTask(
+      std::make_unique<CallbackTask>(delayed.QuitClosure()), 0.02);
+  delayed.Run();
+  CHECK_GE(base::TimeTicks::Now() - delay_started, base::Milliseconds(20));
+  CHECK_EQ(foreground_count, 4);
+  foreground.reset();
+  printf("{\"event\":\"scheduler\",\"pid\":%d,\"foregroundCallbacks\":4,\"jobItems\":32,\"delayPreserved\":true}\n",getpid());
+  if (!donor && !application_compiled.IsEmpty())
+    CheckApplicationCompilation(holder->isolate(), application_text,
+                                application_compiled, "before-gc-exercise");
+  if (command->HasSwitch("managed")) {
+    CHECK_EQ(ForkV8ThreadId(), syscall(SYS_gettid));
+    CHECK(ForkHeapThreadMatches(holder->isolate()));
+    CheckInheritedManagedForkHeap(holder->isolate(), command->HasSwitch("blink-spaces"));
+    printf("{\"event\":\"inherited-managed\",\"pid\":%d,\"donor\":%s,\"retained\":2,\"finallyLive\":0,\"cppToJsRetainedAndReleased\":true}\n",getpid(),donor?"true":"false");
+  }
+  if (!donor) Exercise(holder->isolate(), compiled, fork_mode ? "fork" : "fresh", child_index, command->HasSwitch("managed"), command->HasSwitch("blink-spaces"));
+  if (!donor && !application_compiled.IsEmpty())
+    CheckApplicationCompilation(holder->isolate(), application_text,
+                                application_compiled, "after-gc-exercise");
+  application_compiled.Reset();
+  compiled.Reset(); holder.reset();
+  base::RunLoop().RunUntilIdle();
+  base::ThreadPoolInstance::Get()->Shutdown();
+  base::ThreadPoolInstance::Get()->JoinForTesting();
+  printf("{\"event\":\"disposed\",\"pid\":%d,\"donor\":%s}\n",getpid(),donor?"true":"false");
+  return 0;
+}
