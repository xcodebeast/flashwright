+
+struct RendererBrowserConnection::WorkerServiceDispatcherOwner {
+  WorkerServiceDispatcherOwner(
+      scoped_refptr<base::SingleThreadTaskRunner> io_task_runner,
+      scoped_refptr<RendererWorkerServiceContext> context,
+      mojo::BinderMap binders,
+      mojo::PendingReceiver<mojom::RendererWorkerService> receiver);
+  ~WorkerServiceDispatcherOwner();
+
+  base::SequenceBound<RendererWorkerServiceDispatcher> dispatcher;
+};
+
+RendererBrowserConnection::WorkerServiceDispatcherOwner::
+    WorkerServiceDispatcherOwner(
+        scoped_refptr<base::SingleThreadTaskRunner> io_task_runner,
+        scoped_refptr<RendererWorkerServiceContext> context,
+        mojo::BinderMap binders,
+        mojo::PendingReceiver<mojom::RendererWorkerService> receiver)
+    : dispatcher(std::move(io_task_runner),
+                 std::move(context),
+                 std::move(binders),
+                 std::move(receiver)) {}
+
+RendererBrowserConnection::WorkerServiceDispatcherOwner::
+    ~WorkerServiceDispatcherOwner() = default;
+
+RendererBrowserConnection::RendererBrowserConnection(
+    RenderThread& render_thread,
+    mojom::Renderer& physical_renderer,
+    scoped_refptr<blink::ThreadSafeBrowserInterfaceBrokerProxy> original_broker,
+    mojo::PendingAssociatedRemote<mojom::RendererHost> renderer_host,
+    bool use_frame_routing_cache)
+    : render_thread_(render_thread),
+      physical_renderer_(physical_renderer),
+      original_broker_(std::move(original_broker)),
+      worker_service_context_(
+          base::MakeRefCounted<RendererWorkerServiceContext>(original_broker_)),
+      renderer_host_(std::move(renderer_host)),
+      frame_routing_info_provider_(original_broker_, use_frame_routing_cache) {
+  CHECK(original_broker_);
+}
+RendererBrowserConnection::~RendererBrowserConnection() {
+  // Destruction synchronously detaches the listener before connection state
+  // dies.
+  if (channel_) {
+    channel_.reset();
+  }
+  RetireExecutionContextServices();
+  worker_service_dispatcher_.reset();
+}
+
+void RendererBrowserConnection::InitializeChannel(
+    mojo::ScopedMessagePipeHandle bootstrap,
+    scoped_refptr<base::SingleThreadTaskRunner> io_task_runner,
+    scoped_refptr<base::SingleThreadTaskRunner> dispatch_task_runner,
+    base::WaitableEvent* shutdown_event,
+    IPC::UrgentMessageObserver* urgent_message_observer,
+    base::RepeatingClosure channel_error_callback) {
+  CHECK(!channel_);
+  CHECK(!renderer_host_.is_bound());
+  CHECK(bootstrap.is_valid());
+  CHECK(io_task_runner);
+  CHECK(dispatch_task_runner);
+  CHECK(shutdown_event);
+  CHECK(channel_error_callback);
+  channel_error_callback_ = std::move(channel_error_callback);
+  associated_interfaces_.AddInterface<mojom::Renderer>(base::BindRepeating(
+      [](RendererBrowserConnection* connection,
+         scoped_refptr<base::SingleThreadTaskRunner> task_runner,
+         mojo::PendingAssociatedReceiver<mojom::Renderer> receiver) {
+        connection->Bind(std::move(receiver), std::move(task_runner));
+      },
+      base::Unretained(this), dispatch_task_runner));
+  channel_ = IPC::SyncChannel::Create(this, io_task_runner,
+                                      dispatch_task_runner, shutdown_event);
+  if (urgent_message_observer) {
+    channel_->SetUrgentMessageObserver(urgent_message_observer);
+  }
+  channel_->Init(
+      IPC::ChannelFactory::CreateClientFactory(
+          std::move(bootstrap), io_task_runner, dispatch_task_runner),
+      /*create_pipe_now=*/true);
+  channel_->GetRemoteAssociatedInterface(&renderer_host_);
+}
+
+void RendererBrowserConnection::InitializeWorkerServices(
+    mojo::ScopedMessagePipeHandle receiver,
+    mojo::BinderMap binders,
+    scoped_refptr<base::SingleThreadTaskRunner> io_task_runner) {
+  CHECK(!worker_service_dispatcher_);
+  CHECK(receiver.is_valid());
+  CHECK(io_task_runner);
+  worker_service_dispatcher_ = std::make_unique<WorkerServiceDispatcherOwner>(
+      std::move(io_task_runner), worker_service_context_, std::move(binders),
+      mojo::PendingReceiver<mojom::RendererWorkerService>(std::move(receiver)));
+}
+
+IPC::SyncChannel* RendererBrowserConnection::GetChannel() {
+  CHECK(channel_);
+  return channel_.get();
+}
+
+blink::AssociatedInterfaceRegistry*
+RendererBrowserConnection::GetAssociatedInterfaceRegistry() {
+  return &associated_interfaces_;
+}
+
+blink::ThreadSafeBrowserInterfaceBrokerProxy*
+RendererBrowserConnection::GetOriginalBrowserInterfaceBroker() const {
+  return original_broker_.get();
+}
+
+scoped_refptr<RendererWorkerServiceContext>
+RendererBrowserConnection::GetWorkerServiceContext() const {
+  return worker_service_context_;
+}
+
+bool RendererBrowserConnection::RetireDocumentAdmission() {
+  if (document_admission_retired_) {
+    return true;
+  }
+  for (const auto& group : agent_scheduling_groups_) {
+    if (!group->CanRetireDocumentAdmission()) {
+      return false;
+    }
+  }
+  document_admission_retired_ = true;
+  for (const auto& group : agent_scheduling_groups_) {
+    group->RetireDocumentAdmission();
+  }
+  return true;
+}
+
+void RendererBrowserConnection::RetireExecutionContextServices() {
+  blink::RetireBrowserInterfaceBroker(*original_broker_);
+  worker_service_context_->Retire();
+}
+
+bool RendererBrowserConnection::PrepareForDetach() {
+  if (!document_admission_retired_ ||
+      !blink::IsBrowserInterfaceBrokerRetired(*original_broker_) ||
+      !worker_service_context_->IsRetirementComplete()) {
+    return false;
+  }
+  renderer_receiver_.reset();
+  detach_prepared_ = true;
+  return true;
+}
+
+bool RendererBrowserConnection::ReclaimRetiredDocumentMemory() {
+  if (!document_admission_retired_ ||
+      !blink::IsBrowserInterfaceBrokerRetired(*original_broker_) ||
+      !worker_service_context_->IsRetirementComplete() ||
+      !blink::IsFlashwrightWorkerRetirementComplete() ||
+      blink::WebView::GetWebViewCount() != 0) {
+    return false;
+  }
+  std::set<v8::Isolate*> isolates;
+  for (const auto& group : agent_scheduling_groups_) {
+    if (!group->CanRetireDocumentAdmission()) {
+      return false;
+    }
+    isolates.insert(group->agent_group_scheduler().Isolate());
+  }
+  // Fresh broker identities leave unreachable resource-cache namespaces behind.
+  // With every document and worker retired, no namespace remains reusable.
+  blink::WebCache::Clear();
+  // Reclaim retired documents without treating an ordinary test boundary as
+  // memory exhaustion. All access and worker fences above remain mandatory.
+  if (base::FeatureList::IsEnabled(
+          kFlashwrightCachePreservingRetirementCollection)) {
+    for (auto* isolate : isolates) {
+      v8::CollectGarbageAfterContextRetirement(
+          isolate, base::FeatureList::IsEnabled(
+                       kFlashwrightSingleRetirementCollection)
+                       ? 1
+                       : 2);
+    }
+    return true;
+  }
+  for (auto* isolate : isolates) {
+    // Process reuse removes the ordinary process-exit reclamation boundary.
+    // Release closed Blink/V8 documents after removing strong cache roots.
+    isolate->LowMemoryNotification();
+  }
+  return true;
+}
+
+void RendererBrowserConnection::Detach() {
+  CHECK(detach_prepared_);
+  channel_.reset();
+  renderer_host_.reset();
+  worker_service_dispatcher_.reset();
+}
+
+void RendererBrowserConnection::AddObserver(RenderThreadObserver* observer) {
+  observer->RegisterMojoInterfaces(&associated_interfaces_);
+}
+
+void RendererBrowserConnection::RemoveObserver(RenderThreadObserver* observer) {
+  observer->UnregisterMojoInterfaces(&associated_interfaces_);
+}
+
+void RendererBrowserConnection::OnAssociatedInterfaceRequest(
+    const std::string& interface_name,
+    mojo::ScopedInterfaceEndpointHandle handle) {
+  if (document_admission_retired_) {
+    return;
+  }
+  if (!associated_interfaces_.TryBindInterface(interface_name, &handle)) {
+    LOG(ERROR) << "Receiver for unknown Channel-associated interface: "
+               << interface_name;
+    DUMP_WILL_BE_NOTREACHED();
+  }
+}
+
+void RendererBrowserConnection::OnChannelError() {
+  // This handles only the logical channel. ChildThreadImpl still terminates
+  // the renderer when the primordial physical process pipe disconnects.
+  if (detach_prepared_) {
+    return;
+  }
+  auto channel_error_callback = channel_error_callback_;
+  channel_error_callback.Run();
+}
+
+void RendererBrowserConnection::Bind(
+    mojo::PendingAssociatedReceiver<mojom::Renderer> receiver,
+    scoped_refptr<base::SingleThreadTaskRunner> task_runner) {
+  if (document_admission_retired_) {
+    return;
+  }
+  CHECK(!renderer_receiver_.is_bound());
+  renderer_receiver_.Bind(std::move(receiver), std::move(task_runner));
+}
+mojom::RendererHost* RendererBrowserConnection::GetRendererHost() {
+  return renderer_host_.get();
+}
+mojom::FrameRoutingInfoPtr
+RendererBrowserConnection::GenerateFrameRoutingInfo() {
+  if (document_admission_retired_) {
+    return nullptr;
+  }
+  return frame_routing_info_provider_.GenerateFrameRoutingInfo();
+}
+size_t RendererBrowserConnection::SchedulingGroupCount() const {
+  return agent_scheduling_groups_.size();
+}
+void RendererBrowserConnection::CreateAgentSchedulingGroup(
+    mojo::PendingReceiver<IPC::mojom::ChannelBootstrap> bootstrap) {
+  if (document_admission_retired_) {
+    return;
+  }
+  agent_scheduling_groups_.emplace(std::make_unique<AgentSchedulingGroup>(
+      *render_thread_, std::move(bootstrap), original_broker_,
+      frame_routing_info_provider_.GetRoutingInformationCallback()));
+}
+void RendererBrowserConnection::CreateAssociatedAgentSchedulingGroup(
+    mojo::PendingAssociatedReceiver<mojom::AgentSchedulingGroup> receiver) {
+  if (document_admission_retired_) {
+    return;
+  }
+  agent_scheduling_groups_.emplace(std::make_unique<AgentSchedulingGroup>(
+      *render_thread_, std::move(receiver), original_broker_,
+      frame_routing_info_provider_.GetRoutingInformationCallback()));
+}
