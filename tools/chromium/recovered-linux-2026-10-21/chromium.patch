+// Component-only evidence: never execute the application in the donor or in
+// these plain contexts. The browser integration and preparation cost are separate.
+void CheckApplicationCompilation(
+    v8::Isolate* isolate, const std::string& text,
+    const v8::Global<v8::UnboundScript>& prepared, const char* phase) {
+  v8::Isolate::Scope entered(isolate);
+  v8::HandleScope handles(isolate);
+  for (int realm = 0; realm < 2; ++realm) {
+    auto context = v8::Context::New(isolate);
+    v8::Context::Scope scope(context);
+    for (int variant = 0; variant < 4; ++variant) {
+      const std::string content =
+          variant == 1 ? text + "\n// distinct source identity\n" : text;
+      auto url = Str(isolate, variant == 2
+          ? "https://flashwright.invalid/other.js"
+          : "https://flashwright.invalid/application.js");
+      v8::ScriptOrigin origin(url, variant == 3 ? 1 : 0);
+      v8::ScriptCompiler::Source source(Str(isolate, content), origin);
+      auto script = v8::ScriptCompiler::Compile(context, &source)
+          .ToLocalChecked();
+      const bool same = script->GetUnboundScript() == prepared.Get(isolate);
+      const auto cache = source.GetCompilationDetails().in_memory_cache_result;
+      const bool hit = cache == v8::ScriptCompiler::InMemoryCacheResult::kHit;
+      if (variant != 0) CHECK(!same);
+      std::cout << "{\"event\":\"application-compile\",\"pid\":" << getpid()
+                << ",\"phase\":\"" << phase << "\",\"realm\":" << realm
+                << ",\"variant\":" << variant << ",\"sameUnboundObject\":"
+                << (same ? "true" : "false") << ",\"cacheHit\":"
+                << (hit ? "true" : "false") << ",\"cacheResult\":"
+                << static_cast<int>(cache) << ",\"applicationExecutions\":0}"
+                << std::endl;
+    }
+  }
+}
