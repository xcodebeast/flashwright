+ZygoteCommunication* CreateRendererProbeZygote(ZygoteLaunchCallback launch_cb) {
+  for (auto& donor : g_renderer_probe_zygotes) {
+    if (donor) continue;
+    donor = new ZygoteCommunication(ZygoteCommunication::ZygoteType::kSandboxed);
+    donor->Init(std::move(launch_cb));
