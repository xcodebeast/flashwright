# Private Linux scheduler feasibility build; same binary for feature off/on.
is_debug = false
is_component_build = false
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
chrome_pgo_phase = 0
use_thin_lto = false
use_remoteexec = false
use_siso = false

# Performance build: non-official release defaults otherwise keep debug checks.
dcheck_always_on = false
enable_expensive_dchecks = false

# Explicit custom native stage 1; OS sandbox and site isolation remain compiled.
flashwright_remove_v8_sandbox = true
v8_enable_sandbox = false
v8_enable_sandbox_hardware_support = false
v8_enable_memory_corruption_api = false
v8_enable_pointer_compression = true
v8_enable_pointer_compression_shared_cage = true
v8_enable_external_code_space = true
v8_embedder_string = "-flashwright-idea02-v8-core-001"

# Reviewed composed Idea 02 Linux OS source removal.
flashwright_remove_linux_sandbox = true

# Reviewed printing split plus partial site-policy revision 002.
flashwright_remove_site_isolation_policy = true

# Reviewed narrow physical jail/citadel omission only.
flashwright_remove_site_isolation_enforcement = true

# Explicit unbuilt remaining-check experiment.
flashwright_remove_v8_sandbox_checks = true
