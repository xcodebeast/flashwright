diff --git 1/components/viz/service/frame_sinks/first_sink_copy_unittest.cc 2/components/viz/service/frame_sinks/first_sink_copy_unittest.cc
new file mode 100644
index 00000000..68a7a391
--- /dev/null
+++ 2/components/viz/service/frame_sinks/first_sink_copy_unittest.cc
@@ -0,0 +1,283 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/test/task_environment.h"
+#include "components/viz/common/frame_sinks/begin_frame_source.h"
+#include "components/viz/common/frame_sinks/copy_output_request.h"
+#include "components/viz/common/surfaces/parent_local_surface_id_allocator.h"
+#include "components/viz/service/frame_sinks/compositor_frame_sink_support.h"
+#include "components/viz/service/frame_sinks/frame_sink_manager_impl.h"
+#include "components/viz/service/surfaces/pending_copy_output_request.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace viz {
+namespace {
+constexpr FrameSinkId kA(51, 1);
+constexpr FrameSinkId kB(51, 2);
+constexpr FrameSinkId kRoot(51, 3);
+
+class FirstSinkCopyTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    manager_ = std::make_unique<FrameSinkManagerImpl>(
+        FrameSinkManagerImpl::InitParams());
+    allocator_.GenerateId();
+  }
+  void TearDown() override {
+    manager_.reset();
+    tasks_.RunUntilIdle();
+  }
+  std::unique_ptr<CompositorFrameSinkSupport> Support(FrameSinkId id = kA) {
+    return std::make_unique<CompositorFrameSinkSupport>(nullptr, manager_.get(),
+                                                        id, false);
+  }
+  CopyOutputRequest* Request(FrameSinkId id = kA,
+                             bool exact = false,
+                             base::TimeDelta timeout = base::TimeDelta()) {
+    auto request = std::make_unique<CopyOutputRequest>(
+        CopyOutputRequest::ResultFormat::RGBA,
+        CopyOutputRequest::ResultDestination::kSystemMemory,
+        base::BindOnce(
+            [](FirstSinkCopyTest* self,
+               std::unique_ptr<CopyOutputResult> result) {
+              ++self->callbacks_;
+              EXPECT_TRUE(result->IsEmpty());
+              self->last_error_ = result->error();
+            },
+            base::Unretained(this)));
+    auto* original = request.get();
+    request->set_result_task_runner(
+        base::SingleThreadTaskRunner::GetCurrentDefault());
+    manager_->RequestCopyOfOutput(
+        SurfaceId(id, allocator_.GetCurrentLocalSurfaceId()),
+        std::move(request), exact, timeout);
+    return original;
+  }
+  base::test::TaskEnvironment tasks_{
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  ParentLocalSurfaceIdAllocator allocator_;
+  std::unique_ptr<FrameSinkManagerImpl> manager_;
+  int callbacks_ = 0;
+  CopyOutputResult::Error last_error_ = CopyOutputResult::Error::kNone;
+};
+
+TEST_F(FirstSinkCopyTest, OriginalRequestReachesFirstSupport) {
+  manager_->RegisterFrameSinkId(kA, false);
+  auto* original = Request();
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(callbacks_, 0);
+  auto support = Support();
+  auto copies =
+      support->TakeCopyOutputRequests(allocator_.GetCurrentLocalSurfaceId());
+  ASSERT_EQ(copies.size(), 1u);
+  EXPECT_EQ(copies[0]->copy_output_request.get(), original);
+  copies.clear();
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(callbacks_, 1);
+}
+
+TEST_F(FirstSinkCopyTest, UnknownAndExactRequestsStillFail) {
+  Request();
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(callbacks_, 1);
+  manager_->RegisterFrameSinkId(kA, false);
+  Request(kA, true);
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(callbacks_, 2);
+  auto support = Support();
+  EXPECT_TRUE(
+      support->TakeCopyOutputRequests(allocator_.GetCurrentLocalSurfaceId())
+          .empty());
+}
+
+TEST_F(FirstSinkCopyTest, InvalidationDoesNotTransferToNewRegistration) {
+  manager_->RegisterFrameSinkId(kA, false);
+  Request();
+  manager_->InvalidateFrameSinkId(kA, {});
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(callbacks_, 1);
+  manager_->RegisterFrameSinkId(kA, false);
+  auto support = Support();
+  EXPECT_TRUE(
+      support->TakeCopyOutputRequests(allocator_.GetCurrentLocalSurfaceId())
+          .empty());
+}
+
+TEST_F(FirstSinkCopyTest, DestroyCancelsAndClosesFirstSupportWindow) {
+  manager_->RegisterFrameSinkId(kA, false);
+  Request();
+  manager_->DestroyCompositorFrameSink(kA, base::DoNothing());
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(callbacks_, 1);
+  Request();
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(callbacks_, 2);
+  auto support = Support();
+  EXPECT_TRUE(
+      support->TakeCopyOutputRequests(allocator_.GetCurrentLocalSurfaceId())
+          .empty());
+}
+
+TEST_F(FirstSinkCopyTest, DeadlineRunsBeforeSupportCreation) {
+  manager_->RegisterFrameSinkId(kA, false);
+  Request(kA, false, base::Milliseconds(10));
+  tasks_.FastForwardBy(base::Milliseconds(11));
+  EXPECT_EQ(callbacks_, 1);
+  auto support = Support();
+  EXPECT_TRUE(
+      support->TakeCopyOutputRequests(allocator_.GetCurrentLocalSurfaceId())
+          .empty());
+  tasks_.FastForwardBy(base::Seconds(1));
+  EXPECT_EQ(callbacks_, 1);
+}
+
+TEST_F(FirstSinkCopyTest, LostSupportDoesNotRedirectToReplacement) {
+  manager_->RegisterFrameSinkId(kA, false);
+  auto first = Support();
+  first.reset();
+  Request();
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(callbacks_, 1);
+  auto second = Support();
+  EXPECT_TRUE(
+      second->TakeCopyOutputRequests(allocator_.GetCurrentLocalSurfaceId())
+          .empty());
+}
+
+TEST_F(FirstSinkCopyTest, DeadlineSurvivesTransferToFirstSupport) {
+  manager_->RegisterFrameSinkId(kA, false);
+  Request(kA, false, base::Milliseconds(10));
+  tasks_.FastForwardBy(base::Milliseconds(4));
+  auto support = Support();
+  tasks_.FastForwardBy(base::Milliseconds(5));
+  EXPECT_EQ(callbacks_, 0);
+  tasks_.FastForwardBy(base::Milliseconds(1));
+  EXPECT_EQ(callbacks_, 1);
+  EXPECT_EQ(last_error_, CopyOutputResult::Error::kTimeout);
+  EXPECT_TRUE(
+      support->TakeCopyOutputRequests(allocator_.GetCurrentLocalSurfaceId())
+          .empty());
+  support.reset();
+  tasks_.FastForwardBy(base::Seconds(1));
+  EXPECT_EQ(callbacks_, 1);
+}
+
+TEST_F(FirstSinkCopyTest, TransferredRequestDiesWithFirstSupport) {
+  manager_->RegisterFrameSinkId(kA, false);
+  Request();
+  auto first = Support();
+  first.reset();
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(callbacks_, 1);
+  auto replacement = Support();
+  EXPECT_TRUE(
+      replacement->TakeCopyOutputRequests(allocator_.GetCurrentLocalSurfaceId())
+          .empty());
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(callbacks_, 1);
+}
+
+TEST_F(FirstSinkCopyTest, ExternalFrameDiscardCancelsOnlyItsSubtree) {
+  manager_->RegisterFrameSinkId(kRoot, false);
+  manager_->RegisterFrameSinkId(kA, false);
+  manager_->RegisterFrameSinkId(kB, false);
+  manager_->RegisterFrameSinkHierarchy(kRoot, kA);
+  StubBeginFrameSource source;
+  manager_->RegisterBeginFrameSource(&source, kRoot);
+  Request(kRoot);
+  Request(kA);
+  auto* unrelated_request = Request(kB);
+  manager_->DiscardPendingCopyOfOutputRequests(&source);
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(callbacks_, 2);
+  auto root = Support(kRoot);
+  auto child = Support(kA);
+  EXPECT_TRUE(
+      root->TakeCopyOutputRequests(allocator_.GetCurrentLocalSurfaceId())
+          .empty());
+  EXPECT_TRUE(
+      child->TakeCopyOutputRequests(allocator_.GetCurrentLocalSurfaceId())
+          .empty());
+  auto unrelated = Support(kB);
+  auto copies =
+      unrelated->TakeCopyOutputRequests(allocator_.GetCurrentLocalSurfaceId());
+  ASSERT_EQ(copies.size(), 1u);
+  EXPECT_EQ(copies[0]->copy_output_request.get(), unrelated_request);
+  copies.clear();
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(callbacks_, 3);
+  manager_->UnregisterBeginFrameSource(&source);
+  manager_->UnregisterFrameSinkHierarchy(kRoot, kA);
+}
+
+TEST_F(FirstSinkCopyTest, ExternalFrameDiscardAllowsNewFirstSupportRequest) {
+  manager_->RegisterFrameSinkId(kA, false);
+  StubBeginFrameSource source;
+  manager_->RegisterBeginFrameSource(&source, kA);
+  Request();
+  manager_->DiscardPendingCopyOfOutputRequests(&source);
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(callbacks_, 1);
+  auto* fresh_request = Request();
+  auto support = Support();
+  auto copies =
+      support->TakeCopyOutputRequests(allocator_.GetCurrentLocalSurfaceId());
+  ASSERT_EQ(copies.size(), 1u);
+  EXPECT_EQ(copies[0]->copy_output_request.get(), fresh_request);
+  copies.clear();
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(callbacks_, 2);
+  manager_->UnregisterBeginFrameSource(&source);
+}
+
+TEST_F(FirstSinkCopyTest, SurfaceThresholdIsPreserved) {
+  manager_->RegisterFrameSinkId(kA, false);
+  auto older = allocator_.GetCurrentLocalSurfaceId();
+  allocator_.GenerateId();
+  auto* original = Request();
+  auto support = Support();
+  EXPECT_TRUE(support->TakeCopyOutputRequests(older).empty());
+  auto copies =
+      support->TakeCopyOutputRequests(allocator_.GetCurrentLocalSurfaceId());
+  ASSERT_EQ(copies.size(), 1u);
+  EXPECT_EQ(copies[0]->copy_output_request.get(), original);
+}
+
+TEST_F(FirstSinkCopyTest, DifferentFrameSinkCannotConsumeRequest) {
+  manager_->RegisterFrameSinkId(kA, false);
+  manager_->RegisterFrameSinkId(kB, false);
+  Request();
+  auto other = Support(kB);
+  EXPECT_TRUE(
+      other->TakeCopyOutputRequests(allocator_.GetCurrentLocalSurfaceId())
+          .empty());
+  auto original = Support();
+  auto copies =
+      original->TakeCopyOutputRequests(allocator_.GetCurrentLocalSurfaceId());
+  EXPECT_EQ(copies.size(), 1u);
+}
+
+TEST_F(FirstSinkCopyTest, ManagerDestructionSettlesPendingRequest) {
+  manager_->RegisterFrameSinkId(kA, false);
+  Request();
+  manager_.reset();
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(callbacks_, 1);
+}
+
+TEST_F(FirstSinkCopyTest, ZeroTimeoutHasNoHiddenDeadline) {
+  manager_->RegisterFrameSinkId(kA, false);
+  Request();
+  tasks_.FastForwardBy(base::Days(1));
+  EXPECT_EQ(callbacks_, 0);
+  auto support = Support();
+  auto copies =
+      support->TakeCopyOutputRequests(allocator_.GetCurrentLocalSurfaceId());
+  EXPECT_EQ(copies.size(), 1u);
+}
+}  // namespace
+}  // namespace viz
