--- /dev/null
+++ b/crates/flashwright-engine/src/pointer/wait_audit.rs
@@ -0,0 +1,32 @@
+use serde_json::{json, Value};
+use std::{io::Write, time::Instant};
+
+pub(super) struct Audit {
+    started: Option<Instant>,
+    method: String,
+    page: String,
+    request: String,
+    events: Vec<Value>,
+    truncated: bool,
+}
+impl Audit {
+    pub(super) fn new(method: &str, page: &str, request: &[u16]) -> Self {
+        let enabled = std::env::var("FLASHWRIGHT_POINTER_WAIT_AUDIT").as_deref() == Ok("1");
+        Self { started: enabled.then(Instant::now), method: if enabled { method.into() } else { String::new() }, page: if enabled { page.into() } else { String::new() }, request: if enabled { String::from_utf16_lossy(request) } else { String::new() }, events: Vec::new(), truncated: false }
+    }
+    pub(super) fn record(&mut self, event: &str, detail: impl FnOnce() -> Value) {
+        if let Some(started) = self.started {
+            if self.events.len() < 256 {
+                self.events.push(json!({"event":event,"microseconds":started.elapsed().as_micros() as u64,"detail":detail()}));
+            } else { self.truncated = true; }
+        }
+    }
+}
+impl Drop for Audit {
+    fn drop(&mut self) {
+        if let Some(started) = self.started {
+            let record = json!({"pid":std::process::id(),"method":self.method,"page":self.page,"request":self.request,"totalMicroseconds":started.elapsed().as_micros() as u64,"events":self.events,"truncated":self.truncated});
+            let _ = writeln!(std::io::stderr().lock(), "flashwright-pointer-wait-audit {}", record);
+        }
+    }
+}
